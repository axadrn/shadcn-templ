package direction

import "github.com/axadrn/shadcn-templ/v2/utils"

type Direction string

const (
	DirectionLTR Direction = "ltr"
	DirectionRTL Direction = "rtl"
)

type Props struct {
	// Direction is the text direction of everything inside. Defaults to ltr.
	Direction Direction
}

// DirectionProvider is Base UI's DirectionProvider (shadcn's direction.tsx
// re-exports it): it renders no element and sets the direction the
// components below read for their keyboard navigation and positioning. Set
// dir on <html> as well, the layout follows the attribute, not the provider.
templ DirectionProvider(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Direction == "" {
		{{ p.Direction = DirectionLTR }}
	}
	{{ ctx = utils.WithDirection(ctx, string(p.Direction)) }}
	{ children... }
}
