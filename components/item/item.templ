package item

import "github.com/axadrn/shadcn-templ/v2/utils"

type Variant string
type Size string

const (
	VariantDefault Variant = "default"
	VariantOutline Variant = "outline"
	VariantMuted   Variant = "muted"
)

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
	SizeXs      Size = "xs"
)

type MediaVariant string

const (
	MediaVariantDefault MediaVariant = "default"
	MediaVariantIcon    MediaVariant = "icon"
	MediaVariantImage   MediaVariant = "image"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Size       Size
	Href       string
	Target     string
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type MediaProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    MediaVariant
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ActionsProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// 1:1 base/ui/item.tsx: structure lives here, the look comes from the
// active style-*.css via the cn-item-* classes.
func itemClasses(variant Variant, size Size) string {
	base := "cn-item group/item flex w-full flex-wrap items-center transition-colors duration-100 outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 [a]:transition-colors"
	return utils.CN(base, variantClasses(variant), sizeClasses(size))
}

func variantClasses(variant Variant) string {
	switch variant {
	case VariantOutline:
		return "cn-item-variant-outline"
	case VariantMuted:
		return "cn-item-variant-muted"
	default:
		return "cn-item-variant-default"
	}
}

func sizeClasses(size Size) string {
	switch size {
	case SizeSm:
		return "cn-item-size-sm"
	case SizeXs:
		return "cn-item-size-xs"
	default:
		return "cn-item-size-default"
	}
}

func mediaClasses(variant MediaVariant) string {
	switch variant {
	case MediaVariantIcon:
		return "cn-item-media-variant-icon"
	case MediaVariantImage:
		return "cn-item-media-variant-image"
	default:
		return "cn-item-media-variant-default"
	}
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ class := "cn-item-group group/item-group flex w-full flex-col" }}
	{{ class = utils.CN(class, p.Class) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="list"
		data-slot="item-group"
		class={ class }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Item(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	if p.Href != "" {
		<a
			if p.ID != "" {
				id={ p.ID }
			}
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			data-slot="item"
			data-variant={ string(p.Variant) }
			data-size={ string(p.Size) }
			class={ utils.CN(itemClasses(p.Variant, p.Size), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="item"
			data-variant={ string(p.Variant) }
			data-size={ string(p.Size) }
			class={ utils.CN(itemClasses(p.Variant, p.Size), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Media(props ...MediaProps) {
	{{ var p MediaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = MediaVariantDefault }}
	}
	{{ class := "cn-item-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none" }}
	{{ class = utils.CN(class, mediaClasses(p.Variant), p.Class) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="item-media"
		data-variant={ string(p.Variant) }
		class={ class }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ class := "cn-item-content flex flex-1 flex-col [&+[data-slot=item-content]]:flex-none" }}
	{{ class = utils.CN(class, p.Class) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="item-content"
		class={ class }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

