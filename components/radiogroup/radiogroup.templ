package radiogroup

import (
	"context"

	"github.com/axadrn/shadcn-templ/v2/utils"
)

type ctxKey string

const stateKey ctxKey = "radioGroupState"

type ctxState struct {
	name       string
	value      string
	disabled   bool
	readOnly   bool
	required   bool
	form       string
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Name is shared by all items in the group; a random name is generated
	// when empty so the radios stay mutually exclusive.
	Name string
	// Value is the controlled selected value. Use DefaultValue when the
	// browser should own selection after the initial render.
	Value        *string
	DefaultValue string
	Disabled     bool
	ReadOnly     bool
	Required     bool
	Form         string
}

// ItemProps are Base UI's Radio.Root props. Name, form and the checked
// state come from the group, as in Base UI.
type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
}

func initialValue(p Props) string {
	if p.Value != nil {
		return *p.Value
	}
	return p.DefaultValue
}

// RadioGroup is the vanilla port of Base UI's RadioGroup
// (radio-group/RadioGroup.tsx): a div with role="radiogroup" that shares the
// name and the selected value with the items (via ctx). radiogroup.js ports
// the composite arrow-key navigation and roving tab stop.
templ RadioGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Name == "" {
		{{ p.Name = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{name: p.Name, value: initialValue(p), disabled: p.Disabled, readOnly: p.ReadOnly, required: p.Required, form: p.Form}) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="radio-group"
		if p.Value != nil {
			data-templ-value={ *p.Value }
		}
		role="radiogroup"
		if p.Disabled {
			aria-disabled="true"
			data-disabled
		}
		class={ utils.CN("cn-radio-group w-full", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Item is the vanilla port of Base UI's Radio.Root
// (radio/root/RadioRoot.tsx): a span root carries role="radio", aria-checked
// and the data-checked/data-unchecked/data-disabled state attributes the
// style CSS keys on, and a visually hidden native radio rendered beside it
// carries id/name/value/form for label association and form submission. The
// checked item is the group's roving tab stop (CompositeItem, tabindex 0;
// when no item is checked, radiogroup.js promotes the first enabled item);
// radiogroup.js ports the runtime behavior.
templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		s := state(ctx)
		checked := s.value != "" && s.value == p.Value
		disabled := p.Disabled || s.disabled
	}}
	<span
		data-slot="radio-group-item"
		role="radio"
		if checked {
			aria-checked="true"
			data-checked
		} else {
			aria-checked="false"
			data-unchecked
		}
		if disabled {
			data-disabled
			aria-disabled="true"
		}
		aria-readonly?={ s.readOnly }
		data-readonly?={ s.readOnly }
		aria-required?={ s.required }
		data-required?={ s.required }
		if checked && !disabled {
			tabindex="0"
		} else {
			tabindex="-1"
		}
		class={
			utils.CN(
				// 1:1 base/ui/radio-group.tsx: structure lives here, the look comes
				// from the active style-*.css via cn-radio-group-item.
				"cn-radio-group-item group/radio-group-item peer relative aspect-square shrink-0 border outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		// Base UI unmounts the indicator while unchecked; our pendant toggles
		// the hidden attribute instead (same precedent as the context-menu
		// indicator), radiogroup.js keeps it in sync.
		<span
			data-slot="radio-group-indicator"
			if checked {
				data-checked
			} else {
				data-unchecked
				hidden
			}
			class="cn-radio-group-indicator"
		>
			<span class="cn-radio-group-indicator-icon"></span>
		</span>
	</span>
	// Base UI renders the hidden input beside the root. It owns the id, so
	// native <label for> association keeps working; the inline styles are the
	// visuallyHiddenInput/visuallyHidden pendants from
	// @base-ui/utils/visuallyHidden.ts (named inputs stay absolute so native
	// validation popups anchor near the control).
	<input
		type="radio"
		aria-hidden="true"
		tabindex="-1"
		checked?={ checked }
		disabled?={ disabled }
		readonly?={ s.readOnly }
		required?={ s.required }
		if p.ID != "" {
			id={ p.ID }
		}
		if s.name != "" {
			name={ s.name }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if s.form != "" {
			form={ s.form }
		}
		if s.name != "" {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:absolute"
		} else {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:fixed;top:0;left:0"
		}
	/>
}
