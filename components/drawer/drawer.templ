package drawer

import (
	"context"
	"encoding/json"

	"github.com/axadrn/shadcn-templ/v2/utils"
)

type ctxKey string

const stateKey ctxKey = "drawerState"

// SwipeDirection is the swipe direction used to dismiss the drawer. It also sets
// the edge of the screen the drawer rests on: down = bottom, up = top,
// left = left edge, right = right edge (1:1 Base UI swipeSwipeDirection).
type SwipeDirection string

const (
	SwipeDirectionDown  SwipeDirection = "down"
	SwipeDirectionUp    SwipeDirection = "up"
	SwipeDirectionLeft  SwipeDirection = "left"
	SwipeDirectionRight SwipeDirection = "right"
)

type ctxState struct {
	id               string
	parentID         string
	open             bool
	controlled       bool
	disableClickAway bool
	disableModal     bool
	direction        SwipeDirection
	showSwipeHandle  bool
	snapJSON         string
	snapSequential   bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID string
	// Open is the controlled open state. Use DefaultOpen when the browser
	// should own the state after the initial render.
	Open        *bool
	DefaultOpen bool
	// DisableDismissible keeps the drawer open when clicking the backdrop
	// (Base UI's disablePointerDismissal).
	DisableDismissible bool
	// DisableModal opens the drawer without backdrop, focus trap and body
	// scroll lock (Base UI's modal={false}).
	DisableModal bool
	// SwipeDirection the drawer is swiped in to dismiss. Defaults to down.
	SwipeDirection SwipeDirection
	// ShowSwipeHandle renders the drag handle bar inside the panel.
	ShowSwipeHandle bool
	// SnapPoints snaps a vertical drawer to preset heights (Base UI's
	// snapPoints). Numbers between 0 and 1 are fractions of the viewport,
	// numbers greater than 1 are pixels, strings support px and rem units
	// (e.g. []any{"31rem", 1}). The first entry is the initial snap point.
	SnapPoints []any
	// SnapToSequentialPoints disables velocity-based snap skipping so drag
	// distance determines the next snap point (Base UI's
	// snapToSequentialPoints).
	SnapToSequentialPoints bool
}

func initialOpen(p Props) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
}

type SwipeHandleProps struct {
	Class      string
	Attributes templ.Attributes
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Drawer renders no element: it only carries the id and options that link
// Trigger, Content and Close (via ctx). 1:1 base/ui/drawer.tsx Drawer, which
// wraps the Base UI Drawer.Root without its own DOM. A Drawer rendered inside
// another Drawer's subtree is nested (Base UI's context nesting): its dialog
// links to the parent so drawer.js can drive the stacking behavior, and it
// renders no overlay (DrawerBackdrop enabled: !nested).
templ Drawer(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.SwipeDirection == "" {
		{{ p.SwipeDirection = SwipeDirectionDown }}
	}
	{{ parentID := state(ctx).id }}
	{{ snapJSON := "" }}
	if len(p.SnapPoints) > 0 {
		{{
			if b, err := json.Marshal(p.SnapPoints); err == nil {
				snapJSON = string(b)
			}
		}}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, parentID: parentID, open: initialOpen(p), controlled: p.Open != nil, disableClickAway: p.DisableDismissible, disableModal: p.DisableModal, direction: p.SwipeDirection, showSwipeHandle: p.ShowSwipeHandle, snapJSON: snapJSON, snapSequential: p.SnapToSequentialPoints}) }}
	{ children... }
}

// Trigger returns the attributes that turn any element (usually a button)
// into the drawer trigger — the render prop equivalent: no wrapper element.
func Trigger(ctx context.Context) templ.Attributes {
	return TriggerFor(state(ctx).id)
}

// TriggerFor targets a drawer outside the current Drawer root by id.
func TriggerFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-drawer-trigger": true,
		"aria-controls":           id,
		"aria-haspopup":           "dialog",
		"aria-expanded":           "false",
	}
}

// Close returns the attributes that make any element close the drawer.
func Close(ctx context.Context) templ.Attributes {
	return CloseFor(state(ctx).id)
}

// CloseFor targets a drawer outside the current Drawer root by id.
func CloseFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-drawer-close":  true,
		"data-tui-drawer-target": id,
	}
}

// Content is the 1:1 pendant of base/ui/drawer.tsx DrawerContent, which
// composes DrawerPortal > DrawerOverlay + Drawer.Viewport > Drawer.Popup >
// Drawer.Content:
//
//   - The native <dialog> plays the Drawer.Viewport role: a fullscreen,
//     visually empty positioning container that hosts the swipe listeners
//     (DrawerViewport does exactly that). showModal() gives it the top
//     layer, focus trap and inertness Base UI builds by hand.
//   - The overlay <div> is DrawerOverlay (cn-drawer-overlay), rendered for
//     modal drawers only and, like Base UI's DrawerBackdrop (enabled:
//     !nested), never for nested drawers.
//   - The popup <div> is Drawer.Popup and carries the verbatim class blocks
//     from the reference; drawer.js drives the Base UI lifecycle attributes
//     (data-starting-style, data-ending-style, data-swiping, data-expanded,
//     data-nested-drawer-open, data-nested-drawer-swiping) on popup and
//     overlay, so the blocks apply 1:1.
//
// The hidden portal node keeps the SSRd content hidden until drawer.js portals it
// (DrawerPortal pendant). data-tui-dialog-show-modal is shared with
// dialog.js: both scripts key the body scroll lock release on
// dialog[open][data-tui-dialog-show-modal="true"], so a closing dialog never
// unlocks scroll under an open drawer.
//
// The inline styles seed the vars the reference registers with initial
// values via CSS.registerProperty (DrawerPopup removeCSSVariableInheritance)
// or sets inline on popup and backdrop, so every calc() in the class strings
// resolves before drawer.js touches them.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := state(ctx) }}
	{{ axis := "y" }}
	if s.direction == SwipeDirectionLeft || s.direction == SwipeDirectionRight {
		{{ axis = "x" }}
	}
	{{ hasSnapPoints := s.snapJSON != "" }}
	<div data-tui-drawer-portal hidden>
		<dialog
			id={ s.id }
			data-tui-drawer-content
			data-tui-portal
			data-modal={ utils.IfElse(!s.disableModal, "true", "false") }
			data-tui-dialog-show-modal={ utils.IfElse(!s.disableModal, "true", "false") }
			data-tui-drawer-initial-open={ utils.IfElse(s.open, "true", "false") }
			data-tui-drawer-controlled?={ s.controlled }
			if s.parentID != "" {
				data-tui-drawer-parent={ s.parentID }
			}
			if s.disableClickAway {
				data-tui-drawer-disable-dismissible="true"
			}
			if hasSnapPoints {
				data-tui-drawer-snap-points={ s.snapJSON }
			}
			if s.snapSequential {
				data-tui-drawer-snap-sequential="true"
			}
			class={
				utils.CN(
					// 1:1 DrawerContent's Drawer.Viewport class. data-[modal=true]
					// makes the fullscreen viewport swallow outside presses; non
					// modal drawers stay pointer-events-none so the page keeps
					// working underneath.
					"pointer-events-none fixed inset-0 z-50 select-none data-[modal=true]:pointer-events-auto",
					// Native <dialog> resets: the UA gives dialogs padding, border,
					// background, fit-content sizing and auto margins that the
					// reference's viewport <div> does not have. size-auto with
					// inset-0 stretches it over the viewport. The UA ::backdrop is
					// hidden because the overlay element below is the real
					// DrawerOverlay. dialog:not([open]) keeps the UA display:none,
					// the SSR pendant of Base UI unmounting while closed; while
					// closing, [open] stays set until drawer.js calls close() after
					// the exit transition, so the animation still plays.
					"m-0 size-auto max-w-none max-h-none border-0 bg-transparent p-0 outline-none [&::backdrop]:hidden",
				),
			}
			{ p.Attributes... }
		>
			if !s.disableModal && s.parentID == "" {
				<div
					data-slot="drawer-overlay"
					data-tui-drawer-overlay
					role="presentation"
					if hasSnapPoints {
						data-snap-points=""
					}
					style="--drawer-swipe-progress:0;--drawer-swipe-strength:1"
					class="cn-drawer-overlay fixed inset-0 z-50 min-h-dvh opacity-[max(var(--drawer-overlay-min-opacity,0),calc(1-var(--drawer-swipe-progress)))] transition-opacity duration-450 ease-[cubic-bezier(0.32,0.72,0,1)] select-none data-ending-style:pointer-events-none data-ending-style:opacity-0 data-ending-style:duration-[calc(var(--drawer-swipe-strength)*400ms)] data-snap-points:[--drawer-overlay-min-opacity:0.5] data-starting-style:opacity-0 data-swiping:duration-0 supports-[-webkit-touch-callout:none]:absolute"
				></div>
			}
			<div
				data-slot="drawer-popup"
				data-tui-drawer-popup
				data-swipe-direction={ string(s.direction) }
				data-swipe-axis={ axis }
				if hasSnapPoints {
					data-snap-points=""
				}
				tabindex="-1"
				style="--drawer-swipe-progress:0;--nested-drawers:0;--drawer-swipe-strength:1;--drawer-swipe-movement-x:0px;--drawer-swipe-movement-y:0px;--drawer-snap-point-offset:0px"
				class={
					utils.CN(
						// 1:1 base/ui/drawer.tsx DrawerContent popup (Base UI
						// Drawer.Popup), the look comes from cn-drawer-popup.
						// Base.
						"cn-drawer-popup group/drawer-popup pointer-events-auto fixed z-50 m-(--drawer-inset,0px) flex h-(--drawer-content-height) max-h-(--drawer-content-max-height,none) min-h-0 w-(--drawer-content-width,auto) transform-[translate3d(var(--translate-x,0px),var(--translate-y,0px),0)_scale(var(--stack-scale))] flex-col transition-[transform,height,opacity,filter] duration-450 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform outline-none select-none [interpolate-size:allow-keywords]",
						// Nested.
						"data-nested-drawer-open:overflow-hidden data-nested-drawer-open:brightness-95",
						// Bleed.
						"after:pointer-events-none after:absolute after:bg-(--drawer-bleed-background,var(--color-popover)) data-[swipe-axis=x]:after:inset-y-0 data-[swipe-axis=x]:after:w-(--bleed) data-[swipe-axis=y]:after:inset-x-0 data-[swipe-axis=y]:after:h-(--bleed) data-[swipe-direction=down]:after:top-full data-[swipe-direction=left]:after:right-full data-[swipe-direction=right]:after:left-full data-[swipe-direction=up]:after:bottom-full",
						// Sizing.
						"[--drawer-content-height:var(--drawer-height,auto)] data-[swipe-axis=x]:[--drawer-content-width:75%] data-[swipe-axis=y]:[--drawer-content-max-height:calc(100dvh-6rem)] data-[swipe-axis=y]:data-snap-points:[--drawer-content-height:100dvh] data-[swipe-axis=x]:sm:[--drawer-content-width:24rem]",
						// Stack.
						"[--bleed:3rem] [--peek:1rem] [--stack-height:var(--drawer-frontmost-height,var(--drawer-height,0px))] [--stack-peek-offset:max(0px,calc((var(--nested-drawers)-var(--stack-progress))*var(--peek)))] [--stack-progress:clamp(0,var(--drawer-swipe-progress),1)] [--stack-scale-base:max(0,calc(1-(var(--nested-drawers)*var(--stack-step))))] [--stack-scale:clamp(0,calc(var(--stack-scale-base)+(var(--stack-step)*var(--stack-progress))),1)] [--stack-shrink:calc(1-var(--stack-scale))] [--stack-step:0.05]",
						// Transitions.
						"data-ending-style:transform-(--closed-transform) data-ending-style:opacity-[0.9999] data-ending-style:duration-[calc(var(--drawer-swipe-strength)*400ms)] data-nested-drawer-swiping:duration-0 data-ending-style:data-nested-drawer-swiping:duration-[calc(var(--drawer-swipe-strength)*400ms)] data-starting-style:transform-(--closed-transform) data-swiping:duration-0 data-ending-style:data-swiping:duration-[calc(var(--drawer-swipe-strength)*400ms)]",
						// Axis: y.
						"data-[swipe-axis=y]:inset-x-0 data-[swipe-axis=y]:data-nested-drawer-open:h-(--stack-height)",
						// Axis: x.
						"data-[swipe-axis=x]:inset-y-0 data-[swipe-axis=x]:flex-row",
						// SwipeDirection: down.
						"data-[swipe-direction=down]:bottom-0 data-[swipe-direction=down]:origin-bottom data-[swipe-direction=down]:[--closed-transform:translate3d(0,calc(100%+var(--drawer-inset,0px)+2px),0)] data-[swipe-direction=down]:[--translate-y:calc(var(--drawer-snap-point-offset,0px)+var(--drawer-swipe-movement-y)-var(--stack-peek-offset)-(var(--stack-shrink)*var(--stack-height)))]",
						// SwipeDirection: up.
						"data-[swipe-direction=up]:top-0 data-[swipe-direction=up]:origin-top data-[swipe-direction=up]:[--closed-transform:translate3d(0,calc(-100%-var(--drawer-inset,0px)-2px),0)] data-[swipe-direction=up]:[--translate-y:calc(var(--drawer-snap-point-offset,0px)+var(--drawer-swipe-movement-y)+var(--stack-peek-offset)+(var(--stack-shrink)*var(--stack-height)))]",
						// SwipeDirection: left.
						"data-[swipe-direction=left]:left-0 data-[swipe-direction=left]:origin-left data-[swipe-direction=left]:[--closed-transform:translate3d(calc(-100%-var(--drawer-inset,0px)-2px),0,0)] data-[swipe-direction=left]:[--translate-x:calc(var(--drawer-swipe-movement-x)+var(--stack-peek-offset)+(var(--stack-shrink)*100%))]",
						// SwipeDirection: right.
						"data-[swipe-direction=right]:right-0 data-[swipe-direction=right]:origin-right data-[swipe-direction=right]:[--closed-transform:translate3d(calc(100%+var(--drawer-inset,0px)+2px),0,0)] data-[swipe-direction=right]:[--translate-x:calc(var(--drawer-swipe-movement-x)-var(--stack-peek-offset)-(var(--stack-shrink)*100%))]",
						p.Class,
					),
				}
			>
				if s.showSwipeHandle {
					@SwipeHandle()
				}
				<div
					data-slot="drawer-content"
					class="cn-drawer-content-base flex min-h-0 flex-1 flex-col overflow-hidden overscroll-contain rounded-[inherit] transition-opacity duration-300 ease-[cubic-bezier(0.45,1.005,0,1.005)] select-text group-data-nested-drawer-open/drawer-popup:opacity-0 group-data-nested-drawer-swiping/drawer-popup:opacity-100 group-data-swiping/drawer-popup:select-none"
				>
					{ children... }
				</div>
			</div>
		</dialog>
	</div>
}

// SwipeHandle is the drag handle bar. Content renders it automatically when
// ShowSwipeHandle is set on the Drawer root; it is exported for custom
// compositions like the reference's DrawerSwipeHandle.
templ SwipeHandle(props ...SwipeHandleProps) {
	{{ var p SwipeHandleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		data-slot="drawer-swipe-handle"
		aria-hidden="true"
		class={ utils.CN("cn-drawer-swipe-handle relative z-10 flex shrink-0 cursor-grab transition-opacity duration-200 group-data-nested-drawer-open/drawer-popup:opacity-0 group-data-nested-drawer-swiping/drawer-popup:opacity-100 group-data-[swipe-direction=left]/drawer-popup:order-last group-data-[swipe-direction=up]/drawer-popup:order-last active:cursor-grabbing", p.Class) }
		{ p.Attributes... }
	></div>
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="drawer-header"
		class={ utils.CN("cn-drawer-header-base flex shrink-0 flex-col group-data-[swipe-axis=y]/drawer-popup:text-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="drawer-footer"
		class={ utils.CN("cn-drawer-footer-base mt-auto flex shrink-0 flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="drawer-title"
		class={ utils.CN("cn-drawer-title cn-font-heading", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="drawer-description"
		class={ utils.CN("cn-drawer-description text-balance", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
