package accordion

import (
	"context"
	"strconv"
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Props struct {
	ID           string
	Class        string
	Attributes   templ.Attributes
	Value        []string
	DefaultValue []string
	Multiple     bool
	Disabled     bool
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
}

type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ctxKey string

const (
	rootKey ctxKey = "accordionRoot"
	itemKey ctxKey = "accordionItem"
)

type rootState struct {
	values     map[string]bool
	controlled bool
	disabled   bool
	// value is the root's value as its state attribute renders it, the
	// open values joined by commas.
	value string
	// next counts the items for their index.
	next *int
}

type itemState struct {
	open     bool
	disabled bool
	id       string
	index    int
}

func root(ctx context.Context) rootState {
	state, _ := ctx.Value(rootKey).(rootState)
	return state
}

func item(ctx context.Context) itemState {
	state, _ := ctx.Value(itemKey).(itemState)
	return state
}

func itemOpen(ctx context.Context) bool {
	return item(ctx).open
}

func itemDisabled(ctx context.Context) bool {
	return item(ctx).disabled
}

func itemID(ctx context.Context) string {
	return item(ctx).id
}

// triggerID and panelID derive the aria-controls / aria-labelledby pair from
// the item's id. Pass ItemProps.ID to keep them stable across renders, as an
// htmx swap of one half needs.
func triggerID(itemID string) string {
	return itemID + "-trigger"
}

func panelID(itemID string) string {
	return itemID + "-panel"
}

templ Accordion(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ values := p.DefaultValue }}
	if p.Value != nil {
		{{ values = p.Value }}
	}
	{{ expanded := make(map[string]bool, len(values)) }}
	for _, value := range values {
		{{ expanded[value] = true }}
	}
	{{ ctx = context.WithValue(ctx, rootKey, rootState{values: expanded, controlled: p.Value != nil, disabled: p.Disabled, value: strings.Join(values, ","), next: new(int)}) }}
	// AccordionRoot renders the direction and its state.
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="accordion"
		data-orientation="vertical"
		dir={ utils.Direction(ctx) }
		data-templ-multiple?={ p.Multiple }
		data-disabled?={ p.Disabled }
		if p.Value != nil {
			data-templ-value={ templ.JSONString(p.Value) }
		}
		class={
			utils.CN(
				"cn-accordion flex w-full flex-col",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Value == "" {
		{{ p.Value = utils.RandomID() }}
	}
	{{ id := p.ID }}
	if id == "" {
		{{ id = utils.RandomID() }}
	}
	{{ r := root(ctx) }}
	{{ open := r.values[p.Value] }}
	{{ disabled := p.Disabled || r.disabled }}
	{{ index := *r.next }}
	{{ *r.next++ }}
	{{ ctx = context.WithValue(ctx, itemKey, itemState{open: open, disabled: disabled, id: id, index: index}) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="accordion-item"
		data-templ-value={ p.Value }
		{ itemStateAttrs(ctx)... }
		class={
			utils.CN(
				"cn-accordion-item",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// itemStateAttrs is the item state as AccordionItem, AccordionHeader and
// AccordionPanel render it (accordionStateAttributesMapping): the index, open
// or closed, hidden while closed and unmounted, the orientation.
func itemStateAttrs(ctx context.Context) templ.Attributes {
	it := item(ctx)
	return templ.Attributes{
		"data-index":       strconv.Itoa(it.index),
		"data-open":        it.open,
		"data-closed":      !it.open,
		"data-hidden":      !it.open,
		"data-disabled":    it.disabled,
		"data-orientation": "vertical",
	}
}

// Trigger is Base UI's Accordion.Trigger: aria-expanded for the state and
// aria-controls for the panel it discloses. Its state attributes follow the
// default mapping: the root's value, an index other than 0, and focusable
// while disabled (aria-disabled, no disabled attribute).
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = triggerID(itemID(ctx)) }}
	}
	<h3 class="flex" { itemStateAttrs(ctx)... }>
		<button
			id={ p.ID }
			type="button"
			if _, ok := p.Attributes["tabindex"]; !ok {
				tabindex="0"
			}
			data-slot="accordion-trigger"
			aria-expanded={ utils.IfElse(itemOpen(ctx), "true", "false") }
			if itemOpen(ctx) {
				aria-controls={ panelID(itemID(ctx)) }
			}
			data-value={ root(ctx).value }
			data-orientation="vertical"
			if item(ctx).index != 0 {
				data-index={ strconv.Itoa(item(ctx).index) }
			}
			data-panel-open?={ itemOpen(ctx) }
			data-hidden?={ !itemOpen(ctx) }
			data-disabled?={ itemDisabled(ctx) }
			aria-disabled={ utils.IfElse(itemDisabled(ctx), "true", "false") }
			class={
				utils.CN(
					"cn-accordion-trigger group/accordion-trigger relative flex flex-1 items-start justify-between border border-transparent transition-all outline-none aria-disabled:pointer-events-none aria-disabled:opacity-50",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
			@icon.ChevronDown(icon.Props{
				Class:      "cn-accordion-trigger-icon pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden",
				Attributes: templ.Attributes{"data-slot": "accordion-trigger-icon"},
			})
			@icon.ChevronUp(icon.Props{
				Class:      "cn-accordion-trigger-icon pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline",
				Attributes: templ.Attributes{"data-slot": "accordion-trigger-icon"},
			})
		</button>
	</h3>
}

// Content is Base UI's Accordion.Panel: the region role labelled by its
// trigger, so what the button revealed can be reached directly.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = panelID(itemID(ctx)) }}
	}
	<div
		id={ p.ID }
		role="region"
		aria-labelledby={ triggerID(itemID(ctx)) }
		data-slot="accordion-content"
		{ itemStateAttrs(ctx)... }
		hidden?={ !itemOpen(ctx) }
		class="cn-accordion-content overflow-hidden"
		{ p.Attributes... }
	>
		<div
			class={
				utils.CN(
					"cn-accordion-content-inner h-(--accordion-panel-height) data-ending-style:h-0 data-starting-style:h-0 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground [&_p:not(:last-child)]:mb-4",
					p.Class,
				),
			}
		>
			{ children... }
		</div>
	</div>
}
