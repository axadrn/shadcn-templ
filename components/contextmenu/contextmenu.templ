package contextmenu

import (
	"context"
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type ItemVariant string

const (
	ItemVariantDefault     ItemVariant = "default"
	ItemVariantDestructive ItemVariant = "destructive"
)

type ctxKey string

const stateKey ctxKey = "contextmenuState"
const radioStateKey ctxKey = "contextmenuRadioState"

type ctxState struct {
	id          string
	initialOpen bool
	controlled  bool
}

// menuID returns the id shared by Root, Trigger and Content via ctx.
func menuID(ctx context.Context) string {
	if state, ok := ctx.Value(stateKey).(ctxState); ok {
		return state.id
	}
	return ""
}

type Props struct {
	ID          string
	Open        *bool
	DefaultOpen bool
}

func initialOpen(p Props) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Side string

const (
	SideTop    Side = "top"
	SideRight  Side = "right"
	SideBottom Side = "bottom"
	SideLeft   Side = "left"
)

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
	// Side of the cursor the menu opens on. Defaults to right (Base UI);
	// flips automatically when there is no room.
	Side Side
	// SideOffset is the gap to the cursor in px. Defaults to 0.
	SideOffset int
	// AlignOffset shifts the menu along the aligned edge in px. Defaults to 4.
	AlignOffset int
}

type ItemProps struct {
	ID                  string
	Class               string
	Attributes          templ.Attributes
	Variant             ItemVariant
	Disabled            bool
	Inset               bool
	Href                string
	Target              string
	DisableCloseOnClick bool
}

type CheckboxItemProps struct {
	ID             string
	Class          string
	Attributes     templ.Attributes
	Checked        *bool
	DefaultChecked bool
	Disabled       bool
}

type RadioGroupProps struct {
	ID           string
	Class        string
	Attributes   templ.Attributes
	Value        *string
	DefaultValue string
	Disabled     bool
}

type RadioItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
}

type radioState struct {
	value      string
	controlled bool
	disabled   bool
}

func initialChecked(p CheckboxItemProps) bool {
	if p.Checked != nil {
		return *p.Checked
	}
	return p.DefaultChecked
}

func initialRadioValue(p RadioGroupProps) string {
	if p.Value != nil {
		return *p.Value
	}
	return p.DefaultValue
}

type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Inset      bool
}

type ShortcutProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SubProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Open        *bool
	DefaultOpen bool
}

func initialSubOpen(p SubProps) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type SubTriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Inset      bool
}

type SubContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Items highlight via real focus (Base UI menus move focus to the item under
// the pointer and with the arrow keys), so there are no hover: styles here.
// 1:1 base/ui/context-menu.tsx ContextMenuItem, the look comes from
// cn-context-menu-item; the inset padding keys on the data-inset attribute.
func itemClasses(disabled bool) string {
	return utils.CN(
		"cn-context-menu-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
		// Base UI's item primitive fills the menu row. Native buttons and links
		// need that layout semantics explicitly.
		"w-full text-left",
		map[string]bool{"pointer-events-none opacity-50": disabled},
	)
}

// 1:1 base/ui/context-menu.tsx ContextMenuCheckboxItem/RadioItem, cnClass is
// cn-context-menu-checkbox-item or cn-context-menu-radio-item.
func checkItemClasses(cnClass string, disabled bool) string {
	return utils.CN(
		cnClass+" relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
		// Base UI unmounts the indicator when unchecked; our indicator toggles
		// on the checked state via the group instead.
		"group/cmitem w-full text-left",
		map[string]bool{"pointer-events-none opacity-50": disabled},
	)
}

// contentClasses is the shared 1:1 base/ui/context-menu.tsx ContextMenuContent
// class list, the look comes from cn-context-menu-content (animations key on
// Base UI's data-open/data-closed attributes). The --available-height/--transform-origin
// variables become our JS variable names.
const contentClasses = "cn-context-menu-content cn-context-menu-content-logical cn-menu-target cn-menu-translucent z-50 max-h-(--tui-contextmenu-available-height) origin-(--tui-contextmenu-transform-origin) overflow-x-hidden overflow-y-auto outline-none"

// Root renders no element: it only generates the id that links Trigger and
// Content (via ctx).
templ ContextMenu(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, initialOpen: initialOpen(p), controlled: p.Open != nil}) }}
	{ children... }
}

templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-trigger"
		data-tui-contextmenu-trigger
		data-tui-contextmenu-for={ menuID(ctx) }
		class={ utils.CN("cn-context-menu-trigger select-none", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// PortalProps is the reference Portal's surface: the portal node renders
// no visible element of its own.
type PortalProps struct {
	Attributes templ.Attributes
}

// Portal is 1:1 the reference Portal slot: a hidden portal node until the script portals
// the content to <body> on open.
templ Portal(props ...PortalProps) {
	{{ var p PortalProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div data-tui-contextmenu-portal hidden { p.Attributes... }>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Side == "" {
		{{ p.Side = SideRight }}
	}
	if p.AlignOffset == 0 {
		{{ p.AlignOffset = 4 }}
	}
	{{ s, _ := ctx.Value(stateKey).(ctxState) }}
	// Hidden until the script portals it to <body> on open, so the SSRd
	// content never participates in layout or sibling CSS.
	@Portal() {
		<div
			id={ menuID(ctx) }
			data-tui-contextmenu-content
			data-tui-contextmenu-initial-open={ strconv.FormatBool(s.initialOpen) }
			data-tui-contextmenu-controlled?={ s.controlled }
			data-tui-contextmenu-side={ string(p.Side) }
			data-tui-contextmenu-side-offset={ strconv.Itoa(p.SideOffset) }
			data-tui-contextmenu-align-offset={ strconv.Itoa(p.AlignOffset) }
			data-closed
			hidden
			data-tui-portal
			class="pointer-events-none isolate fixed inset-auto z-50 m-0 overflow-visible border-0 bg-transparent p-0"
		>
			<div
				data-slot="context-menu-content"
				data-tui-contextmenu-popup
				data-closed
				role="menu"
				tabindex="-1"
				class={
					utils.CN(
						contentClasses,
						// JS wiring: the positioner wrapper is pointer-events-none, and the
						// popup stays mounted after animate-out until hidePopover runs.
						"pointer-events-auto relative isolate data-closed:fill-mode-forwards",
						p.Class,
					),
				}
				{ p.Attributes... }
			>
				{ children... }
			</div>
		</div>
	}
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.Variant == "" {
		{{ p.Variant = ItemVariantDefault }}
	}
	if p.Href != "" {
		<a
			id={ p.ID }
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			data-slot="context-menu-item"
			data-variant={ string(p.Variant) }
			data-inset?={ p.Inset }
			data-tui-contextmenu-item
			if p.DisableCloseOnClick {
				data-tui-contextmenu-disable-close-on-click="true"
			}
			if p.Disabled {
				aria-disabled="true"
			}
			role="menuitem"
			class={ utils.CN(itemClasses(p.Disabled), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			id={ p.ID }
			type="button"
			data-slot="context-menu-item"
			data-variant={ string(p.Variant) }
			data-inset?={ p.Inset }
			data-tui-contextmenu-item
			if p.DisableCloseOnClick {
				data-tui-contextmenu-disable-close-on-click="true"
			}
			disabled?={ p.Disabled }
			role="menuitem"
			class={ utils.CN(itemClasses(p.Disabled), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}

templ CheckboxItem(props ...CheckboxItemProps) {
	{{ var p CheckboxItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ checked := initialChecked(p) }}
	<button
		id={ p.ID }
		type="button"
		data-slot="context-menu-checkbox-item"
		data-tui-contextmenu-checkbox-item
		data-tui-contextmenu-checkbox-controlled?={ p.Checked != nil }
		role="menuitemcheckbox"
		if checked {
			data-checked
			aria-checked="true"
		} else {
			data-unchecked
			aria-checked="false"
		}
		disabled?={ p.Disabled }
		class={ utils.CN(checkItemClasses("cn-context-menu-checkbox-item", p.Disabled), p.Class) }
		{ p.Attributes... }
	>
		<span class="cn-context-menu-item-indicator pointer-events-none opacity-0 group-data-checked/cmitem:opacity-100">
			@icon.Check()
		</span>
		{ children... }
	</button>
}

templ RadioGroup(props ...RadioGroupProps) {
	{{ var p RadioGroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ value := initialRadioValue(p) }}
	{{ ctx = context.WithValue(ctx, radioStateKey, radioState{value: value, controlled: p.Value != nil, disabled: p.Disabled}) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="context-menu-radio-group"
		data-tui-contextmenu-radio-group
		data-tui-contextmenu-radio-controlled?={ p.Value != nil }
		data-tui-contextmenu-radio-value={ value }
		data-disabled?={ p.Disabled }
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ RadioItem(props ...RadioItemProps) {
	{{ var p RadioItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ group, _ := ctx.Value(radioStateKey).(radioState) }}
	{{ checked := group.value != "" && group.value == p.Value }}
	{{ disabled := p.Disabled || group.disabled }}
	<button
		id={ p.ID }
		type="button"
		data-slot="context-menu-radio-item"
		data-tui-contextmenu-radio-item
		if p.Value != "" {
			data-tui-contextmenu-radio-value={ p.Value }
		}
		role="menuitemradio"
		if checked {
			data-checked
			aria-checked="true"
		} else {
			data-unchecked
			aria-checked="false"
		}
		disabled?={ disabled }
		class={ utils.CN(checkItemClasses("cn-context-menu-radio-item", disabled), p.Class) }
		{ p.Attributes... }
	>
		<span class="cn-context-menu-item-indicator pointer-events-none opacity-0 group-data-checked/cmitem:opacity-100">
			@icon.Check()
		</span>
		{ children... }
	</button>
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="context-menu-group"
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-label"
		data-inset?={ p.Inset }
		class={ utils.CN("cn-context-menu-label", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="separator"
		data-slot="context-menu-separator"
		class={ utils.CN("cn-context-menu-separator", p.Class) }
		{ p.Attributes... }
	></div>
}

templ Shortcut(props ...ShortcutProps) {
	{{ var p ShortcutProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-shortcut"
		class={ utils.CN("cn-context-menu-shortcut", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Sub(props ...SubProps) {
	{{ var p SubProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-sub"
		data-tui-contextmenu-sub
		data-tui-contextmenu-sub-open={ strconv.FormatBool(initialSubOpen(p)) }
		data-tui-contextmenu-sub-controlled?={ p.Open != nil }
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ SubTrigger(props ...SubTriggerProps) {
	{{ var p SubTriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		data-slot="context-menu-sub-trigger"
		data-inset?={ p.Inset }
		data-tui-contextmenu-sub-trigger
		data-closed
		role="menuitem"
		aria-haspopup="menu"
		aria-expanded="false"
		class={
			utils.CN(
				// 1:1 base/ui/context-menu.tsx ContextMenuSubTrigger, the look comes
				// from cn-context-menu-sub-trigger (the open highlight keys on our
				// Base UI data-open/data-closed attributes).
				"cn-context-menu-sub-trigger flex cursor-default items-center outline-hidden select-none [&_svg]:pointer-events-none [&_svg]:shrink-0",
				"w-full text-left",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
		@icon.ChevronRight(icon.Props{Class: "cn-rtl-flip ml-auto"})
	</button>
}

templ SubContent(props ...SubContentProps) {
	{{ var p SubContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-sub-content"
		data-tui-contextmenu-sub-content
		data-closed
		role="menu"
		tabindex="-1"
		class={
			utils.CN(
				// 1:1 base/ui/context-menu.tsx ContextMenuSubContent: the sub content
				// is the content plus cn-context-menu-subcontent, the look comes from
				// the cn classes (animations key on Base UI's state attributes). max-h
				// drops out because our JS only sets the available-height variable on
				// the root positioner.
				"cn-context-menu-content cn-context-menu-content-logical cn-menu-target cn-menu-translucent cn-context-menu-subcontent z-50 origin-(--tui-contextmenu-transform-origin) overflow-x-hidden overflow-y-auto outline-none",
				// JS wiring: floatingui positions the sub content as a fixed layer and
				// toggles the hidden class around the exit animation.
				"hidden fixed inset-auto left-0 top-0 data-closed:fill-mode-forwards",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
