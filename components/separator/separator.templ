package separator

import "github.com/axadrn/shadcn-templ/v2/utils"

type Orientation string

const (
	OrientationHorizontal Orientation = "horizontal"
	OrientationVertical   Orientation = "vertical"
)

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Orientation Orientation
}

// Base UI's Separator renders data-orientation, and that is what the vendored
// data-horizontal / data-vertical variants match
// (&:where([data-orientation="horizontal"])). Without it the
// data-horizontal:h-px in the class string never lands and the separator
// renders 0px high.
templ Separator(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationHorizontal }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="separator"
		data-orientation={ string(p.Orientation) }
		role="separator"
		aria-orientation={ string(p.Orientation) }
		class={
			utils.CN(
				"shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch",
				p.Class,
			),
		}
		{ p.Attributes... }
	></div>
}
