package selectcomp

import (
	"context"
	"fmt"
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Size string

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
)

type Align string

const (
	AlignStart  Align = "start"
	AlignCenter Align = "center"
	AlignEnd    Align = "end"
)

type ctxKey string

const stateKey ctxKey = "selectState"

type ctxState struct {
	id              string
	name            string
	value           string
	valueControlled bool
	open            *bool
	defaultOpen     bool
	disabled        bool
	readOnly        bool
	required        bool
	form            string
	items           []ItemData
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

// ItemData is one entry of Base UI's items prop: the label Value shows for
// the value. Label is a string or a templ.Component, Base UI's ReactNode.
// The value "" is Base UI's null, the placeholder item.
type ItemData struct {
	Value string
	Label any
}

type Props struct {
	ID string
	// Name makes the select submit its value in forms (hidden input).
	Name string
	// Items is Base UI's items: the labels Value renders for the values.
	Items []ItemData
	// Value is the controlled selected value. Use DefaultValue when the
	// browser should own selection after the initial render.
	Value        *string
	DefaultValue string
	Open         *bool
	DefaultOpen  bool
	Disabled     bool
	ReadOnly     bool
	Required     bool
	Form         string
}

// label is the items entry of the value, if any.
func (s ctxState) label() (any, bool) {
	for _, item := range s.items {
		if item.Value == s.value {
			return item.Label, true
		}
	}
	return nil, false
}

func initialValue(p Props) string {
	if p.Value != nil {
		return *p.Value
	}
	return p.DefaultValue
}

type TriggerProps struct {
	// ID for the trigger button (e.g. to point a label at it).
	ID         string
	Class      string
	Attributes templ.Attributes
	// Size of the trigger. Options: 'default' (h-8), 'sm' (h-7).
	Size Size
}

type ValueProps struct {
	Class      string
	Attributes templ.Attributes
	// Placeholder is shown until an item is selected.
	Placeholder string
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
	// AlignItemWithTrigger is Base UI's alignItemWithTrigger: the popup
	// overlays the selected item on the trigger. nil means true; false opens
	// it below the trigger edge like a dropdown.
	AlignItemWithTrigger *bool
	// Align along the trigger edge in popper mode. Defaults to center.
	Align Align
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
	// Label overrides the text shown on the trigger when this item is
	// selected (Base UI Select.Item label).
	Label string
}

type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Select is SelectRoot: it carries the id, name and value that link Trigger
// and Content (via ctx), and renders the hidden input after its children.
templ Select(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ s := ctxState{id: p.ID, name: p.Name, value: initialValue(p), valueControlled: p.Value != nil, open: p.Open, defaultOpen: p.DefaultOpen, disabled: p.Disabled, readOnly: p.ReadOnly, required: p.Required, form: p.Form, items: p.Items} }}
	{{ ctx = context.WithValue(ctx, stateKey, s) }}
	{ children... }
	// The input that carries the value for forms and autofill, visually
	// hidden, focus moves on to the trigger.
	<input
		if s.name == "" {
			id={ s.id + "-hidden-input" }
		} else {
			name={ s.name }
		}
		if s.form != "" {
			form={ s.form }
		}
		value={ s.value }
		disabled?={ s.disabled }
		required?={ s.required }
		readonly?={ s.readOnly }
		if s.name != "" {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:absolute"
		} else {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:fixed;top:0;left:0"
		}
		tabindex="-1"
		aria-hidden="true"
	/>
}

templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	{{ s := state(ctx) }}
	if p.ID == "" {
		{{ p.ID = s.id + "-trigger" }}
	}
	// useButton: a disabled trigger leaves the tab order.
	<button
		type="button"
		id={ p.ID }
		if _, ok := p.Attributes["tabindex"]; !ok {
			tabindex={ utils.IfElse(s.disabled, "-1", "0") }
		}
		data-slot="select-trigger"
		data-size={ string(p.Size) }
		role="combobox"
		data-templ-controls={ s.id }
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-readonly?={ s.readOnly }
		aria-required?={ s.required }
		if s.valueControlled {
			data-templ-value={ s.value }
		}
		if s.value == "" {
			data-placeholder
		}
		disabled?={ s.disabled }
		data-disabled?={ s.disabled }
		class={
			utils.CN(
				// 1:1 base/ui/select.tsx SelectTrigger, the look comes from
				// cn-select-trigger.
				"cn-select-trigger flex w-fit items-center justify-between whitespace-nowrap outline-none disabled:cursor-not-allowed disabled:opacity-50 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center [&_svg]:pointer-events-none [&_svg]:shrink-0",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
		// SelectIcon.
		@icon.ChevronDown(icon.Props{Class: "cn-select-trigger-icon pointer-events-none", Attributes: templ.Attributes{"aria-hidden": "true"}})
	</button>
}

templ Value(props ...ValueProps) {
	{{ var p ValueProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := state(ctx) }}
	{{ label, hasLabel := s.label() }}
	// SelectValue: the selected value's label, else the placeholder; while no
	// value is selected (the null item counts as none) it is a placeholder.
	<span
		data-slot="select-value"
		data-placeholder?={ s.value == "" }
		if p.Placeholder != "" {
			data-templ-placeholder={ p.Placeholder }
		}
		class={ utils.CN("cn-select-value", p.Class) }
		{ p.Attributes... }
	>
		if hasLabel {
			@itemLabel(label)
		} else if s.value == "" {
			{ p.Placeholder }
		} else {
			{ s.value }
		}
		// The labels of the items, for the value a later selection picks.
		if len(s.items) > 0 {
			<template data-templ-items>
				for _, item := range s.items {
					<span data-templ-value={ item.Value }>
						@itemLabel(item.Label)
					</span>
				}
			</template>
		}
	</span>
}

// itemLabel renders an items label: a templ.Component, or text.
templ itemLabel(label any) {
	if c, ok := label.(templ.Component); ok {
		@c
	} else if label != nil {
		{ fmt.Sprint(label) }
	}
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignCenter }}
	}
	{{ s := state(ctx) }}
	{{ alignItem := p.AlignItemWithTrigger == nil || *p.AlignItemWithTrigger }}
	// Hidden until the script portals it to <body> on open, so the SSRd
	// content never participates in layout or sibling CSS.
	<div data-templ-portal hidden>
		<div data-base-ui-portal hidden>
		<div
			if !alignItem {
				data-templ-align-item-with-trigger="false"
			}
			data-templ-align={ string(p.Align) }
			if s.open != nil {
				data-templ-open={ strconv.FormatBool(*s.open) }
			}
			data-templ-default-open?={ s.open == nil && s.defaultOpen }
			data-closed
			hidden
			role="presentation"
			class="isolate z-50"
			{ utils.DirectionAttributes(ctx)... }
		>
			<div
				id={ s.id }
				data-slot="select-content"
				tabindex="-1"
				data-base-ui-focusable
				if !alignItem {
					data-align-trigger="false"
				} else {
					data-align-trigger="true"
				}
				data-closed
				role="presentation"
				class={
					utils.CN(
						// 1:1 base/ui/select.tsx SelectContent, the look comes from
						// cn-select-content and Base UI's standard positioner variables.
						"cn-select-content cn-select-content-logical cn-menu-target cn-menu-translucent relative isolate z-50 max-h-(--available-height) w-(--anchor-width) origin-(--transform-origin) overflow-x-hidden overflow-y-auto data-[align-trigger=true]:animate-none",
						// The popup stays mounted after animate-out until it unmounts.
						"data-closed:fill-mode-forwards",
						p.Class,
					),
				}
				{ p.Attributes... }
			>
				// SelectScrollUpArrow, mounted while the list can scroll up.
				<div data-slot="select-scroll-up-button" data-direction="up" aria-hidden="true" hidden style="position:absolute" class="cn-select-scroll-up-button top-0 w-full">
					@icon.ChevronUp()
				</div>
				// SelectList.
				<div id={ s.id + "-list" } role="listbox">
					{ children... }
				</div>
				<div data-slot="select-scroll-down-button" data-direction="down" aria-hidden="true" hidden style="position:absolute" class="cn-select-scroll-down-button bottom-0 w-full">
					@icon.ChevronDown()
				</div>
			</div>
		</div>
		</div>
	</div>
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="select-group"
		class={ utils.CN("cn-select-group", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="select-label"
		class={ utils.CN("cn-select-label", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := state(ctx) }}
	{{ selected := s.value == p.Value }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="option"
		tabindex="-1"
		data-slot="select-item"
		data-templ-value={ p.Value }
		if p.Label != "" {
			data-templ-label={ p.Label }
		}
		if selected {
			data-selected
			aria-selected="true"
		} else {
			aria-selected="false"
		}
		if p.Disabled {
			data-disabled
			aria-disabled="true"
		}
		class={
			utils.CN(
				// 1:1 base/ui/select.tsx SelectItem, the look comes from
				// cn-select-item (items highlight via real focus, our JS moves focus
				// to the item under the pointer like Base UI).
				"cn-select-item relative flex w-full cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		// SelectItemText.
		<div class="cn-select-item-text shrink-0 whitespace-nowrap">
			{ children... }
		</div>
		// SelectItemIndicator: mounted while the item is selected, the script
		// toggles [hidden] for the unmount.
		<span class="cn-select-item-indicator" aria-hidden="true" data-selected hidden?={ !selected }>
			@icon.Check(icon.Props{Class: "cn-select-item-indicator-icon pointer-events-none"})
		</span>
	</div>
}

templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="separator"
		aria-orientation="horizontal"
		data-orientation="horizontal"
		data-slot="select-separator"
		class={ utils.CN("cn-select-separator pointer-events-none", p.Class) }
		{ p.Attributes... }
	></div>
}
