package navigationmenu

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Side string

const (
	SideTop    Side = "top"
	SideRight  Side = "right"
	SideBottom Side = "bottom"
	SideLeft   Side = "left"
)

type Align string

const (
	AlignStart  Align = "start"
	AlignCenter Align = "center"
	AlignEnd    Align = "end"
)

// Props of NavigationMenu, Base UI's NavigationMenu.Root plus the align
// shadcn's wrapper hands to its positioner.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Align of the popup against the active trigger. Defaults to start.
	Align Align
	// Delay is how long the pointer rests on a trigger before the menu
	// opens, in ms. Defaults to 50 (Base UI).
	Delay int
	// CloseDelay is how long the menu stays open after the pointer left,
	// in ms. Defaults to 50 (Base UI).
	CloseDelay int
}

type ListProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LinkProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Href renders the link's target, the pendant of rendering a router
	// link through Base UI's render prop.
	Href string
}

type IndicatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// PositionerProps of NavigationMenuPositioner, rendered by NavigationMenu.
type PositionerProps struct {
	Class string
	// Side of the active trigger the popup opens on. Defaults to bottom.
	Side Side
	// SideOffset is the gap to the trigger in px. Defaults to 8.
	SideOffset *int
	// Align along the trigger edge. Defaults to start.
	Align Align
	// AlignOffset shifts the popup along the aligned edge, in px.
	AlignOffset int
}

// TriggerStyle is shadcn's navigationMenuTriggerStyle(): the trigger look,
// for a Link that sits in the list next to the triggers.
func TriggerStyle() string {
	return "cn-navigation-menu-trigger group/navigation-menu-trigger inline-flex h-9 w-max items-center justify-center outline-none disabled:pointer-events-none"
}

templ NavigationMenu(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignStart }}
	}
	<nav
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="navigation-menu"
		{ utils.DirectionAttributes(ctx)... }
		if p.Delay != 0 {
			data-templ-delay={ strconv.Itoa(p.Delay) }
		}
		if p.CloseDelay != 0 {
			data-templ-close-delay={ strconv.Itoa(p.CloseDelay) }
		}
		class={ utils.CN("cn-navigation-menu group/navigation-menu relative flex max-w-max flex-1 items-center justify-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
		@Positioner(PositionerProps{Align: p.Align})
	</nav>
}

templ List(props ...ListProps) {
	{{ var p ListProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<ul
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="navigation-menu-list"
		class={ utils.CN("cn-navigation-menu-list group flex flex-1 list-none items-center justify-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</ul>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="navigation-menu-item"
		class={ utils.CN("cn-navigation-menu-item relative", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</li>
}

// Trigger opens its item's Content on hover and on click. The attributes are
// the closed state Base UI renders; the script keeps them current.
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		tabindex="0"
		aria-disabled="false"
		aria-expanded="false"
		data-base-ui-navigation-menu-trigger
		data-slot="navigation-menu-trigger"
		class={ utils.CN(TriggerStyle(), "group", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
		{ " " }
		@icon.ChevronDown(icon.Props{Class: "cn-navigation-menu-trigger-icon", Attributes: templ.Attributes{"aria-hidden": "true"}})
	</button>
}

// Content stays in its hidden holder next to the trigger until its item is
// active; the script mounts it into the shared viewport then, like Base UI
// portals it there.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div data-templ-portal hidden>
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="navigation-menu-content"
			class={ utils.CN(
				"cn-navigation-menu-content data-ending-style:data-activation-direction=left:translate-x-[50%] data-ending-style:data-activation-direction=right:translate-x-[-50%] data-starting-style:data-activation-direction=left:translate-x-[-50%] data-starting-style:data-activation-direction=right:translate-x-[50%] h-full w-auto transition-[opacity,transform,translate] duration-[0.35s] data-ending-style:opacity-0 data-starting-style:opacity-0 **:data-[slot=navigation-menu-link]:focus:ring-0 **:data-[slot=navigation-menu-link]:focus:outline-none",
				p.Class,
			) }
			{ p.Attributes... }
		>
			{ children... }
		</div>
	</div>
}

// Positioner is the portaled positioner with the popup and the viewport the
// active Content moves into. NavigationMenu renders it.
templ Positioner(props ...PositionerProps) {
	{{ var p PositionerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Side == "" {
		{{ p.Side = SideBottom }}
	}
	if p.Align == "" {
		{{ p.Align = AlignStart }}
	}
	{{
		sideOffset := 8
		if p.SideOffset != nil {
			sideOffset = *p.SideOffset
		}
	}}
	<div data-templ-portal hidden>
		<div data-base-ui-portal>
			<div
				role="presentation"
				data-templ-side={ string(p.Side) }
				data-templ-side-offset={ strconv.Itoa(sideOffset) }
				data-templ-align={ string(p.Align) }
				if p.AlignOffset != 0 {
					data-templ-align-offset={ strconv.Itoa(p.AlignOffset) }
				}
				data-closed
				hidden
				class={ utils.CN("cn-navigation-menu-positioner isolate z-50 h-(--positioner-height) w-(--positioner-width) max-w-(--available-width) transition-[top,left,right,bottom] duration-[0.35s] data-instant:transition-none", p.Class) }
				{ utils.DirectionAttributes(ctx)... }
			>
				<nav
					id={ "base-ui-" + utils.RandomID() }
					tabindex="-1"
					data-closed
					class="cn-navigation-menu-popup data-[ending-style]:easing-[ease] xs:w-(--popup-width) relative h-(--popup-height) w-(--popup-width) origin-(--transform-origin) transition-[opacity,transform,width,height,scale,translate] duration-[0.35s] ease-[cubic-bezier(0.22,1,0.36,1)]"
				>
					<div id={ utils.RandomID() } class="relative size-full overflow-hidden"></div>
				</nav>
			</div>
		</div>
	</div>
}

templ Link(props ...LinkProps) {
	{{ var p LinkProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<a
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Href != "" {
			href={ templ.SafeURL(p.Href) }
		}
		data-slot="navigation-menu-link"
		class={ utils.CN("cn-navigation-menu-link", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</a>
}

// Indicator is Base UI's NavigationMenu.Icon with shadcn's arrow, open while
// its item is active.
templ Indicator(props ...IndicatorProps) {
	{{ var p IndicatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		aria-hidden="true"
		data-slot="navigation-menu-indicator"
		class={ utils.CN("cn-navigation-menu-indicator top-full z-1 flex h-1.5 items-end justify-center overflow-hidden", p.Class) }
		{ p.Attributes... }
	>
		<div class="cn-navigation-menu-indicator-arrow relative top-[60%] h-2 w-2 rotate-45"></div>
	</span>
}
