package avatar

import "github.com/axadrn/shadcn-templ/v2/utils"

type Size string

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
	SizeLg      Size = "lg"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Size       Size
}

type ImageProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Alt        string
	Src        string
}

type FallbackProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type BadgeProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type GroupCountProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ Avatar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	<div
		data-slot="avatar"
		data-size={ string(p.Size) }
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-avatar group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Image keeps the absolute/opacity classes as shadcn-templ infra: the image sits
// above the fallback and fades in once avatar.js flags it loaded.
templ Image(props ...ImageProps) {
	{{ var p ImageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<img
		data-slot="avatar-image"
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Src != "" {
			src={ p.Src }
		}
		alt={ p.Alt }
		class={ utils.CN("cn-avatar-image aspect-square size-full object-cover", "absolute inset-0 transition-opacity duration-300 [@media(scripting:enabled)]:not-data-[loaded=true]:opacity-0", p.Class) }
		{ p.Attributes... }
	/>
}

templ Fallback(props ...FallbackProps) {
	{{ var p FallbackProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		data-slot="avatar-fallback"
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-avatar-fallback flex size-full items-center justify-center text-sm group-data-[size=sm]/avatar:text-xs", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Badge(props ...BadgeProps) {
	{{ var p BadgeProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		data-slot="avatar-badge"
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-avatar-badge absolute right-0 bottom-0 z-10 inline-flex items-center justify-center rounded-full bg-blend-color ring-2 select-none", "group-data-[size=sm]/avatar:size-2 group-data-[size=sm]/avatar:[&>svg]:hidden", "group-data-[size=default]/avatar:size-2.5 group-data-[size=default]/avatar:[&>svg]:size-2", "group-data-[size=lg]/avatar:size-3 group-data-[size=lg]/avatar:[&>svg]:size-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		data-slot="avatar-group"
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-avatar-group group/avatar-group flex -space-x-2 *:data-[slot=avatar]:ring-2 *:data-[slot=avatar]:ring-background", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ GroupCount(props ...GroupCountProps) {
	{{ var p GroupCountProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		data-slot="avatar-group-count"
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-avatar-group-count relative flex shrink-0 items-center justify-center ring-2 ring-background", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
