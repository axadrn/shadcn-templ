package inputgroup

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Align string

const (
	AlignInlineStart Align = "inline-start"
	AlignInlineEnd   Align = "inline-end"
	AlignBlockStart  Align = "block-start"
	AlignBlockEnd    Align = "block-end"
)

type ButtonSize string

const (
	ButtonSizeXs     ButtonSize = "xs"
	ButtonSizeSm     ButtonSize = "sm"
	ButtonSizeIconXs ButtonSize = "icon-xs"
	ButtonSizeIconSm ButtonSize = "icon-sm"
)

type AddonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Align      Align
}

type InputProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Type        string
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
}

type TextareaProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
	Rows        int
}

type ButtonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Type       button.Type
	Variant    button.Variant
	Size       ButtonSize
	Disabled   bool
}

type TextProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ InputGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="input-group"
		class={ utils.CN("group/input-group cn-input-group relative flex w-full min-w-0 items-center outline-none has-[>textarea]:h-auto", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Input wraps the base Input component with the input-group control override,
// exactly like shadcn's InputGroupInput wraps <Input/>. All base sizing
// (h-8, w-full, px-2.5, …) comes from input.Input — no local re-styling.
templ Input(props ...InputProps) {
	{{ var p InputProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@input.Input(input.Props{
		ID:          p.ID,
		Type:        p.Type,
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Disabled:    p.Disabled,
		Class:       utils.CN("cn-input-group-input flex-1", p.Class),
		Attributes:  attrs,
	})
}

// Textarea wraps the base Textarea component with the input-group control
// override, exactly like shadcn's InputGroupTextarea wraps <Textarea/>.
templ Textarea(props ...TextareaProps) {
	{{ var p TextareaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@textarea.Textarea(textarea.Props{
		ID:          p.ID,
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Rows:        p.Rows,
		Disabled:    p.Disabled,
		Class:       utils.CN("cn-input-group-textarea flex-1 resize-none", p.Class),
		Attributes:  attrs,
	})
}

templ Addon(props ...AddonProps) {
	{{ var p AddonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignInlineStart }}
	}
	{{
		// 1:1 the inputGroupAddonVariants cva from base/ui/input-group.tsx.
		align := "cn-input-group-addon-align-inline-start order-first"
		switch p.Align {
		case AlignInlineEnd:
			align = "cn-input-group-addon-align-inline-end order-last"
		case AlignBlockStart:
			align = "cn-input-group-addon-align-block-start order-first w-full justify-start"
		case AlignBlockEnd:
			align = "cn-input-group-addon-align-block-end order-last w-full justify-start"
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		if _, ok := p.Attributes["data-slot"]; !ok {
			data-slot="input-group-addon"
		}
		data-align={ string(p.Align) }
		class={ utils.CN("cn-input-group-addon flex cursor-text items-center justify-center select-none", align, p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// 1:1 the inputGroupButtonVariants cva from base/ui/input-group.tsx.
func inputGroupButtonClasses(size ButtonSize) string {
	switch size {
	case ButtonSizeSm:
		return "cn-input-group-button-size-sm"
	case ButtonSizeIconXs:
		return "cn-input-group-button-size-icon-xs"
	case ButtonSizeIconSm:
		return "cn-input-group-button-size-icon-sm"
	default:
		return "cn-input-group-button-size-xs"
	}
}

templ Button(props ...ButtonProps) {
	{{ var p ButtonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = button.TypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = button.VariantGhost }}
	}
	if p.Size == "" {
		{{ p.Size = ButtonSizeXs }}
	}
	{{
		attrs := templ.Attributes{"data-size": string(p.Size)}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		Type:       p.Type,
		Variant:    p.Variant,
		Disabled:   p.Disabled,
		Class:      utils.CN("cn-input-group-button flex items-center shadow-none", inputGroupButtonClasses(p.Size), p.Class),
		Attributes: attrs,
	}) {
		{ children... }
	}
}

templ Text(props ...TextProps) {
	{{ var p TextProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.CN("cn-input-group-text flex items-center [&_svg]:pointer-events-none", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
