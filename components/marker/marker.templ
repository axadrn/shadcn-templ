package marker

import "github.com/axadrn/shadcn-templ/v2/utils"

type Variant string

const (
	VariantDefault   Variant = "default"
	VariantSeparator Variant = "separator"
	VariantBorder    Variant = "border"
)

// Props are shadcn's Marker props; Href renders the marker as a link (the
// render prop with an a element).
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Href       string
}

type IconProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func variantClasses(v Variant) string {
	switch v {
	case VariantSeparator:
		return "cn-marker-variant-separator"
	case VariantBorder:
		return "cn-marker-variant-border"
	default:
		return "cn-marker-variant-default"
	}
}

// Variants is shadcn's markerVariants, for a marker rendered through an
// element of its own (the render prop with a button).
func Variants(p Props) string {
	return utils.CN("cn-marker group/marker relative flex w-full items-center", variantClasses(p.Variant), p.Class)
}

// Marker renders useRender's state as data-slot and data-variant.
templ Marker(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Href != "" {
		<a
			href={ templ.SafeURL(p.Href) }
			if p.ID != "" {
				id={ p.ID }
			}
			class={ Variants(p) }
			data-slot="marker"
			data-variant={ string(p.Variant) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ Variants(p) }
			data-slot="marker"
			data-variant={ string(p.Variant) }
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Icon(props ...IconProps) {
	{{ var p IconProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="marker-icon"
		aria-hidden="true"
		class={ utils.CN("cn-marker-icon shrink-0", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="marker-content"
		class={ utils.CN("cn-marker-content min-w-0 wrap-break-word", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
