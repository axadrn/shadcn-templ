package sheet

import (
	"context"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type ctxKey string

const stateKey ctxKey = "sheetState"

type Side string

const (
	SideTop    Side = "top"
	SideRight  Side = "right"
	SideBottom Side = "bottom"
	SideLeft   Side = "left"
)

type ctxState struct {
	id               string
	open             bool
	controlled       bool
	disableClickAway bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID string
	// Open is the controlled open state. Use DefaultOpen when the browser
	// should own the state after the initial render.
	Open        *bool
	DefaultOpen bool
	// DisableDismissible keeps the sheet open when clicking the backdrop.
	DisableDismissible bool
}

func initialOpen(p Props) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
	// Side of the screen the sheet slides in from. Defaults to right.
	Side            Side
	HideCloseButton bool
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Sheet renders no element: it only carries the id and options that link
// Trigger, Content and Close (via ctx). Like shadcn, the sheet IS the dialog
// primitive with side styling; the dialog script drives it.
templ Sheet(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, open: initialOpen(p), controlled: p.Open != nil, disableClickAway: p.DisableDismissible}) }}
	{ children... }
}

// Trigger returns the attributes that turn any element (usually a button)
// into the sheet trigger — the asChild equivalent: no wrapper element.
func Trigger(ctx context.Context) templ.Attributes {
	return TriggerFor(state(ctx).id)
}

// TriggerFor targets a sheet outside the current Sheet root by id.
func TriggerFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-trigger": true,
		"aria-controls":           id,
		"aria-haspopup":           "dialog",
		"aria-expanded":           "false",
	}
}

// Close returns the attributes that make any element close the sheet.
func Close(ctx context.Context) templ.Attributes {
	return CloseFor(state(ctx).id)
}

// CloseFor targets a sheet outside the current Sheet root by id.
func CloseFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-close":  true,
		"data-tui-dialog-target": id,
	}
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Side == "" {
		{{ p.Side = SideRight }}
	}
	{{ s := state(ctx) }}
	// Hidden until the script portals it to <body> on open, so the SSRd
	// content never participates in layout or sibling CSS.
	<div data-tui-dialog-portal hidden>
		<div data-tui-dialog-root hidden>
			// 1:1 base/ui/sheet.tsx SheetOverlay (Dialog.Backdrop): the look
			// comes from cn-sheet-overlay. user-select none is Base UI's
			// inline style on the backdrop.
			<div
				data-slot="sheet-overlay"
				data-tui-dialog-backdrop
				role="presentation"
				style="user-select: none; -webkit-user-select: none;"
				class="cn-sheet-overlay fixed inset-0 z-50 transition-opacity duration-150 data-ending-style:opacity-0 data-starting-style:opacity-0"
			></div>
			// 1:1 base/ui/sheet.tsx SheetContent (Dialog.Popup): the look
			// comes from cn-sheet-content; the data-starting-style/
			// data-ending-style variants are Base UI's transition lifecycle,
			// driven by dialog.js.
			<div
				id={ s.id }
				role="dialog"
				tabindex="-1"
				data-slot="sheet-content"
				data-tui-dialog-content
				data-side={ string(p.Side) }
				data-tui-dialog-initial-open={ utils.IfElse(s.open, "true", "false") }
				data-tui-dialog-controlled?={ s.controlled }
				data-tui-dialog-show-modal="true"
				if s.disableClickAway {
					data-tui-dialog-disable-dismissible="true"
				}
				class={
					utils.CN(
						"cn-sheet-content data-ending-style:opacity-0 data-starting-style:opacity-0 data-[side=bottom]:data-ending-style:translate-y-[2.5rem] data-[side=bottom]:data-starting-style:translate-y-[2.5rem] data-[side=left]:data-ending-style:translate-x-[-2.5rem] data-[side=left]:data-starting-style:translate-x-[-2.5rem] data-[side=right]:data-ending-style:translate-x-[2.5rem] data-[side=right]:data-starting-style:translate-x-[2.5rem] data-[side=top]:data-ending-style:translate-y-[-2.5rem] data-[side=top]:data-starting-style:translate-y-[-2.5rem]",
						p.Class,
					),
				}
				{ p.Attributes... }
			>
				{ children... }
				if !p.HideCloseButton {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIconSm,
						Class:   "cn-sheet-close",
						Attributes: templ.Attributes{
							"data-slot":             "sheet-close",
							"data-tui-dialog-close": true,
							"aria-label":            "Close",
						},
					}) {
						@icon.X()
						<span class="sr-only">Close</span>
					}
				}
			</div>
		</div>
	</div>
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="sheet-header"
		class={ utils.CN("cn-sheet-header flex flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="sheet-footer"
		class={ utils.CN("cn-sheet-footer mt-auto flex flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="sheet-title"
		data-tui-dialog-title
		class={ utils.CN("cn-sheet-title cn-font-heading", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="sheet-description"
		data-tui-dialog-description
		class={ utils.CN("cn-sheet-description", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
