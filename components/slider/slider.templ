package slider

import (
	"fmt"
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Orientation string

const (
	OrientationHorizontal Orientation = "horizontal"
	OrientationVertical   Orientation = "vertical"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Value is the controlled value, Base UI's number | number[]: a float64
	// or a []float64. Use DefaultValue when the browser should own the value
	// after the initial render.
	Value        any
	DefaultValue any
	Min          float64
	// Max defaults to 100.
	Max float64
	// Step defaults to 1.
	Step float64
	// Orientation defaults to horizontal.
	Orientation Orientation
	// Name is Base UI's name: every thumb's range input submits under it.
	Name     string
	Disabled bool
}

// thumbSize is size-3 in px; Base UI's edge thumb alignment keeps the thumb
// inside the track by shifting it up to its own width.
const thumbSize = 12

func fmtF(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

func fraction(v, min, max float64) float64 {
	if max == min {
		return 0
	}
	f := (v - min) / (max - min)
	if f < 0 {
		f = 0
	}
	if f > 1 {
		f = 1
	}
	return f
}

// thumbStyle positions the thumb edge aligned: offset = f * (100% - thumb).
// Horizontal grows from the left, vertical from the bottom.
func thumbStyle(f float64, vertical bool) string {
	if vertical {
		g := 1 - f
		return fmt.Sprintf("position:absolute;top:calc(%.4f%% - %.2fpx);left:50%%;transform:translateX(-50%%)", g*100, g*thumbSize)
	}
	return fmt.Sprintf("position:absolute;left:calc(%.4f%% - %.2fpx);top:50%%;transform:translateY(-50%%)", f*100, f*thumbSize)
}

// asValues reads a Value or DefaultValue: Base UI wraps a number in an
// array, isArray tells shadcn's wrapper whether it renders one thumb per
// value.
func asValues(v any) (values []float64, isArray bool) {
	switch v := v.(type) {
	case []float64:
		return v, true
	case float64:
		return []float64{v}, false
	case int:
		return []float64{float64(v)}, false
	}
	return nil, false
}

// valueText is Base UI's default aria-valuetext: a two thumb range names
// its start and end, a single value has none.
func valueText(values []float64, i int) string {
	if len(values) != 2 {
		return ""
	}
	if i == 0 {
		return fmtF(values[i]) + " start range"
	}
	return fmtF(values[i]) + " end range"
}

// inputStyle is SliderThumb's input style: visually hidden over the thumb,
// vertical writing for a vertical slider.
func inputStyle(vertical bool) string {
	style := "clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:100%;height:100%;margin:-1px;position:fixed;top:0;left:0"
	if vertical {
		style += ";writing-mode:vertical-lr"
	}
	return style
}

// indicatorStyle spans from the start (one thumb) or between the outer thumb
// centers (multiple thumbs).
func indicatorStyle(fs []float64, vertical bool) string {
	lo, hi := 0.0, 0.0
	if len(fs) == 1 {
		hi = fs[0]
	} else if len(fs) > 1 {
		lo, hi = fs[0], fs[len(fs)-1]
		for _, f := range fs {
			if f < lo {
				lo = f
			}
			if f > hi {
				hi = f
			}
		}
	}
	if vertical {
		if len(fs) > 1 {
			return fmt.Sprintf("position:absolute;left:0;bottom:calc(%.4f%% + %.2fpx);height:calc(%.4f%% - %.2fpx)",
				lo*100, thumbSize/2.0-lo*thumbSize, (hi-lo)*100, (hi-lo)*thumbSize)
		}
		return fmt.Sprintf("position:absolute;left:0;bottom:0;height:calc(%.4f%% + %.2fpx)", hi*100, thumbSize/2.0-hi*thumbSize)
	}
	if len(fs) > 1 {
		return fmt.Sprintf("position:absolute;top:0;left:calc(%.4f%% + %.2fpx);width:calc(%.4f%% - %.2fpx)",
			lo*100, thumbSize/2.0-lo*thumbSize, (hi-lo)*100, (hi-lo)*thumbSize)
	}
	return fmt.Sprintf("position:absolute;top:0;left:0;width:calc(%.4f%% + %.2fpx)", hi*100, thumbSize/2.0-hi*thumbSize)
}

templ Slider(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.Max == 0 {
		{{ p.Max = 100 }}
	}
	if p.Step == 0 {
		{{ p.Step = 1 }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationHorizontal }}
	}
	{{
		// shadcn renders a thumb per array value, else the two of [min, max];
		// Base UI shows its own values, a number on every thumb (index 0).
		values, isArray := asValues(p.DefaultValue)
		if p.Value != nil {
			values, isArray = asValues(p.Value)
		}
		thumbs := values
		if !isArray {
			thumbs = []float64{p.Min, p.Max}
		}
		if values == nil {
			values = thumbs
		}
		vertical := p.Orientation == OrientationVertical
		fs := make([]float64, len(values))
		for i, v := range values {
			fs[i] = fraction(v, p.Min, p.Max)
		}
	}}
	// The data-horizontal:/data-vertical: variants match data-orientation
	// (shadcn-tailwind.css). min, max and step are Base UI props that React
	// keeps in memory, so they are data-templ-* here.
	// SliderRoot is a group; SliderControl and SliderIndicator carry Base UI's
	// markers, every SliderThumb holds the range input that takes the focus.
	<div
		id={ p.ID }
		role="group"
		data-slot="slider"
		{ utils.DirectionAttributes(ctx)... }
		if p.Value != nil {
			data-templ-value={ templ.JSONString(p.Value) }
		}
		data-orientation={ string(p.Orientation) }
		data-templ-min={ fmtF(p.Min) }
		data-templ-max={ fmtF(p.Max) }
		data-templ-step={ fmtF(p.Step) }
		if p.Disabled {
			data-disabled
		}
		class={ utils.CN("data-horizontal:w-full data-vertical:h-full", p.Class) }
		{ p.Attributes... }
	>
		<div
			data-orientation={ string(p.Orientation) }
			data-base-ui-slider-control
			if p.Disabled {
				data-disabled
			}
			class="cn-slider relative flex w-full touch-none items-center select-none data-disabled:opacity-50 data-vertical:h-full data-vertical:w-auto data-vertical:flex-col"
		>
			<div
				data-slot="slider-track"
				data-orientation={ string(p.Orientation) }
				data-disabled?={ p.Disabled }
				class="cn-slider-track relative grow overflow-hidden select-none"
			>
				<div
					data-slot="slider-range"
					data-base-ui-slider-indicator
					data-orientation={ string(p.Orientation) }
					data-disabled?={ p.Disabled }
					class="cn-slider-range select-none data-horizontal:h-full data-vertical:w-full"
					style={ indicatorStyle(fs, vertical) }
				></div>
			</div>
			for t := range thumbs {
				{{
					i := 0
					if len(values) > 1 {
						i = t
					}
					v := values[i]
				}}
				// The thumb's disabled:* classes are dead CSS on a div, exactly
				// like in shadcn's thumb: only the control dims to 50%.
				<div
					data-slot="slider-thumb"
					data-index={ strconv.Itoa(i) }
					data-orientation={ string(p.Orientation) }
					data-disabled?={ p.Disabled }
					style={ thumbStyle(fs[i], vertical) }
					class="cn-slider-thumb block shrink-0 select-none disabled:pointer-events-none disabled:opacity-50"
				>
					<input
						type="range"
						id={ p.ID + "-thumb-" + strconv.Itoa(t) }
						if p.Name != "" {
							name={ p.Name }
						}
						min={ fmtF(p.Min) }
						max={ fmtF(p.Max) }
						step={ fmtF(p.Step) }
						value={ fmtF(v) }
						aria-orientation={ string(p.Orientation) }
						aria-valuenow={ fmtF(v) }
						if valueText(values, i) != "" {
							aria-valuetext={ valueText(values, i) }
						}
						disabled?={ p.Disabled }
						style={ inputStyle(vertical) }
					/>
				</div>
			}
		</div>
	</div>
}
