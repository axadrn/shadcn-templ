package calendar

import (
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type Day int

var (
	Sunday    = Day(0)
	Monday    = Day(1)
	Tuesday   = Day(2)
	Wednesday = Day(3)
	Thursday  = Day(4)
	Friday    = Day(5)
	Saturday  = Day(6)
)

type Mode string

const (
	ModeSingle Mode = "single"
	ModeRange  Mode = "range"
)

type CaptionLayout string

const (
	// CaptionLayoutLabel shows "July 2026" as a static caption (default).
	CaptionLayoutLabel CaptionLayout = "label"
	// CaptionLayoutDropdown shows month and year dropdowns.
	CaptionLayoutDropdown CaptionLayout = "dropdown"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Mode: 'single' (default) or 'range'.
	Mode Mode
	// CaptionLayout: 'label' (default) or 'dropdown'.
	CaptionLayout CaptionLayout
	// Selected preselects a date (single mode) or the range start.
	Selected time.Time
	// EndValue preselects the range end (range mode).
	EndValue time.Time
	// Month controls the initially displayed month. Defaults to Selected or now.
	Month time.Time
	// Name renders a hidden input that submits the selected date (ISO).
	Name string
	// EndName is the hidden input name for the range end. Defaults to Name + "-end".
	EndName   string
	// Locale is a BCP 47 tag like "de-DE", the browser's Intl handles
	// every locale natively. Defaults to "en-US".
	Locale string
	// WeekStartsOn: 0-6, Sunday-Saturday. Defaults to Sunday, like shadcn.
	WeekStartsOn Day
	// HideOutsideDays hides the leading/trailing days of adjacent months.
	HideOutsideDays bool
	// FixedWeeks always renders six weeks, keeping the height stable.
	FixedWeeks bool
	// ShowWeekNumber renders an ISO week number column.
	ShowWeekNumber bool
	// MinDate/MaxDate bound the selectable dates.
	MinDate time.Time
	MaxDate time.Time
	// Disabled are not selectable.
	Disabled []time.Time
	// BookedDates are not selectable and render struck through.
	BookedDates []time.Time
	// NumberOfMonths renders several months side by side. Defaults to 1.
	NumberOfMonths int
}

func isoList(dates []time.Time) string {
	parts := make([]string, len(dates))
	for i, d := range dates {
		parts[i] = d.Format("2006-01-02")
	}
	return strings.Join(parts, ",")
}

templ Calendar(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		if p.ID == "" {
			p.ID = utils.RandomID()
		}
		if p.Mode == "" {
			p.Mode = ModeSingle
		}
		if p.CaptionLayout == "" {
			p.CaptionLayout = CaptionLayoutLabel
		}
		if p.Locale == "" {
			p.Locale = "en-US"
		}
		if p.Mode == ModeRange && p.Name != "" && p.EndName == "" {
			p.EndName = p.Name + "-end"
		}
		view := time.Now()
		if !p.Selected.IsZero() {
			view = p.Selected
		}
		if !p.Month.IsZero() {
			view = p.Month
		}
		selectedISO := ""
		if !p.Selected.IsZero() {
			selectedISO = p.Selected.Format("2006-01-02")
		}
		endISO := ""
		if !p.EndValue.IsZero() {
			endISO = p.EndValue.Format("2006-01-02")
		}
		monthNames := []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
		months := p.NumberOfMonths
		if months < 1 {
			months = 1
		}
	}}
	<div
		id={ p.ID }
		data-slot="calendar"
		data-templ-mode={ string(p.Mode) }
		data-templ-locale={ p.Locale }
		data-templ-week-starts-on={ strconv.Itoa(int(p.WeekStartsOn)) }
		data-templ-month={ view.Format("2006-01-02") }
		if selectedISO != "" {
			data-templ-selected={ selectedISO }
		}
		if endISO != "" {
			data-templ-selected-to={ endISO }
		}
		if p.HideOutsideDays {
			data-templ-show-outside-days="false"
		}
		if p.FixedWeeks {
			data-templ-fixed-weeks
		}
		if p.ShowWeekNumber {
			data-templ-show-week-number
		}
		if !p.MinDate.IsZero() {
			data-templ-min-date={ p.MinDate.Format("2006-01-02") }
		}
		if !p.MaxDate.IsZero() {
			data-templ-max-date={ p.MaxDate.Format("2006-01-02") }
		}
		if len(p.Disabled) > 0 {
			data-templ-disabled={ isoList(p.Disabled) }
		}
		if len(p.BookedDates) > 0 {
			data-templ-booked-dates={ isoList(p.BookedDates) }
		}
		class={
			utils.CN(
				// 1:1 base/ui/calendar.tsx className + classNames.root. The rtl
				// chevron flip lives on the icons as cn-rtl-flip (the tsx's extra
				// rtl:**:[.rdp-button_next>svg] selectors target rdp-* classes our
				// DOM does not have).
				"cn-calendar group/calendar bg-background in-data-[slot=card-content]:bg-transparent in-data-[slot=popover-content]:bg-transparent w-fit",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ selectedISO } aria-hidden="true" tabindex="-1"/>
			if p.Mode == ModeRange {
				<input type="hidden" name={ p.EndName } value={ endISO } aria-hidden="true" tabindex="-1"/>
			}
		}
		<div class="relative flex flex-col gap-4 md:flex-row">
			<nav aria-label="Navigation bar" class="absolute inset-x-0 top-0 flex w-full items-center justify-between gap-1">
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Class:   "size-(--cell-size) p-0 select-none aria-disabled:opacity-50",
						Attributes: templ.Attributes{
							"aria-label": "Go to the previous month",
						},
					}) {
						@icon.ChevronLeft(icon.Props{Class: "cn-rtl-flip size-4"})
					}
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Class:   "size-(--cell-size) p-0 select-none aria-disabled:opacity-50",
						Attributes: templ.Attributes{
							"aria-label": "Go to the next month",
						},
					}) {
						@icon.ChevronRight(icon.Props{Class: "cn-rtl-flip size-4"})
					}
			</nav>
			for m := 0; m < months; m++ {
				<div class="flex w-full flex-col gap-4">
					<div class="flex h-(--cell-size) w-full items-center justify-center px-(--cell-size)">
						if p.CaptionLayout == CaptionLayoutDropdown && months == 1 {
						<div class="flex h-(--cell-size) w-full items-center justify-center gap-1.5 text-sm font-medium">
							<div class="cn-calendar-dropdown-root relative rounded-(--cell-radius)">
								<select
									class="absolute inset-0 bg-popover opacity-0"
									aria-label="Choose the month"
								>
									for i := 0; i < 12; i++ {
										<option value={ strconv.Itoa(i) } selected?={ i == int(view.Month())-1 }>{ monthNames[i] }</option>
									}
								</select>
								<span class="font-medium select-none cn-calendar-caption-label flex items-center gap-1 rounded-(--cell-radius) text-sm [&>svg]:size-3.5 [&>svg]:text-muted-foreground" aria-hidden="true">
									<span>{ monthNames[int(view.Month())-1] }</span>
									@icon.ChevronDown(icon.Props{Class: "size-4"})
								</span>
							</div>
							<div class="cn-calendar-dropdown-root relative rounded-(--cell-radius)">
								<select
									class="absolute inset-0 bg-popover opacity-0"
									aria-label="Choose the year"
								>
									for year := time.Now().Year() - 100; year <= time.Now().Year(); year++ {
										<option value={ strconv.Itoa(year) } selected?={ year == view.Year() }>{ strconv.Itoa(year) }</option>
									}
								</select>
								<span class="font-medium select-none cn-calendar-caption-label flex items-center gap-1 rounded-(--cell-radius) text-sm [&>svg]:size-3.5 [&>svg]:text-muted-foreground" aria-hidden="true">
									<span>{ strconv.Itoa(view.Year()) }</span>
									@icon.ChevronDown(icon.Props{Class: "size-4"})
								</span>
							</div>
						</div>
					} else {
						<span class="font-medium select-none cn-calendar-caption text-sm">
							{ view.AddDate(0, m, 0).Format("January 2006") }
						</span>
					}
				</div>
				<table class="w-full border-collapse">
					<thead>
						<tr class="flex"></tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
			}
		</div>
		<template>
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeIcon,
				Class:   "cn-calendar-day-button relative isolate z-10 flex aspect-square size-auto w-full min-w-(--cell-size) flex-col gap-1 border-0 leading-none font-normal group-data-[focused=true]/day:relative group-data-[focused=true]/day:z-10 group-data-[focused=true]/day:border-ring group-data-[focused=true]/day:ring-[3px] group-data-[focused=true]/day:ring-ring/50 data-[range-end=true]:rounded-(--cell-radius) data-[range-end=true]:rounded-r-(--cell-radius) data-[range-end=true]:bg-primary data-[range-end=true]:text-primary-foreground data-[range-middle=true]:rounded-none data-[range-middle=true]:bg-muted data-[range-middle=true]:text-foreground data-[range-start=true]:rounded-(--cell-radius) data-[range-start=true]:rounded-l-(--cell-radius) data-[range-start=true]:bg-primary data-[range-start=true]:text-primary-foreground data-[selected-single=true]:bg-primary data-[selected-single=true]:text-primary-foreground dark:hover:text-foreground [&>span]:text-xs [&>span]:opacity-70",
			})
		</template>
	</div>
}
