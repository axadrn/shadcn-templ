package collapsible

import (
	"context"

	"github.com/axadrn/shadcn-templ/v2/utils"
)

type ctxKey string

const stateKey ctxKey = "collapsibleState"

type ctxState struct {
	id         string
	open       bool
	controlled bool
	disabled   bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Open is the controlled expanded state. Use DefaultOpen when the browser
	// should own the state after the initial render.
	Open        *bool
	DefaultOpen bool
	Disabled    bool
}

func initialOpen(p Props) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
}

// Collapsible links Trigger and Content via ctx and carries the open state
// (data-open/data-closed, like Base UI).
templ Collapsible(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ open := initialOpen(p) }}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, open: open, controlled: p.Open != nil, disabled: p.Disabled}) }}
	<div
		data-slot="collapsible"
		data-open?={ open }
		data-closed?={ !open }
		data-disabled?={ p.Disabled }
		data-templ-open?={ p.Open != nil }
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Trigger returns the attributes that turn any element (usually a button)
// into the collapsible trigger — the asChild equivalent: no wrapper element.
// On an element with its own data-slot (sidebar.MenuButton) that slot wins,
// as with Base UI's render prop, so collapsible.js finds a trigger by its
// aria-controls link to the panel.
func Trigger(ctx context.Context) templ.Attributes {
	s := state(ctx)
	attrs := templ.Attributes{
		"data-slot":     "collapsible-trigger",
		"aria-controls": s.id,
		"aria-expanded": utils.IfElse(s.open, "true", "false"),
	}
	if s.disabled {
		attrs["data-disabled"] = true
		attrs["aria-disabled"] = "true"
	}
	if s.open {
		attrs["data-panel-open"] = true
	}
	return attrs
}

// Content is the collapsible panel: hidden while closed, unstyled like
// Base UI. Its measured height is exposed as
// --collapsible-panel-height/width for custom animations.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := state(ctx) }}
	<div
		id={ s.id }
		data-slot="collapsible-content"
		data-open?={ s.open }
		data-closed?={ !s.open }
		hidden?={ !s.open }
		class={ utils.CN("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
