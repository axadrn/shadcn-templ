.claude/worktrees/

# Ignore internal generated files
internal/**/*_templ.go
parity/**/*_templ.go
**/*_templ.txt
meta.json

# Allow public library–mode generated files
!components/**/*_templ.go
!utils/**/*_templ.go

# System / build / cache
.DS_Store
bin
node_modules
tmp
parity/out
parity/*.log

# Env
.env

# Build outputs
assets/css/output.css
assets/js/shadcn-templ-*.js

.gocache


# Root-level markdown is personal notes by default; whitelist the real docs.
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md
assets/highlight-cache.json.gz
