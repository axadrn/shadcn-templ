package layouts

import (
	"fmt"
	"github.com/axadrn/shadcn-templ/v2/components"
	"github.com/axadrn/shadcn-templ/v2/internal/config"
	"github.com/axadrn/shadcn-templ/v2/internal/ctxkeys"
	"github.com/axadrn/shadcn-templ/v2/components/toast"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ BaseLayout(title, description string) {
	<!DOCTYPE html>
	// The header height lives on <html> like shadcn's app/layout.tsx: 14
	// spacing units, 16 from lg up. Everything sticky (navbar, docs sidebar,
	// toc) offsets against it.
	<html lang="en" class="[--announcement-height:calc(var(--spacing)*10)] [--header-height:calc(var(--spacing)*14)] lg:[--header-height:calc(var(--spacing)*16)]">
		<head>
			// Google
			<meta name="google-site-verification" content="lcKF60IRUofKfZpOIYKOD7xyvrL220KpjmGjJcflde4"/>
			// SEO
			@modules.SEO(title, description, ctx.Value(ctxkeys.URLPathValue).(string))
			// Preload fonts to prevent flickering
			<link rel="preload" href="/assets/fonts/geist/geist-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/assets/fonts/geist/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			// Component JS bundle
			@components.Scripts()
			// Umami Analytics
			if config.AppConfig.GoEnv == "production" {
				<script defer data-website-id="f02fb8a0-1528-4e24-8484-5bd56aa46f98" src="https://umami.axeladrian.com/script.js" nonce={ templ.GetNonce(ctx) }></script>
			}
			// Shiki Highlighter Script
			@modules.CodeHighlightingScript()
			// Tailwind CSS (style-*.css and shadcn-tailwind.css are bundled in via globals.css)
			<link href={ utils.ScriptURL("/assets/css/output.css") } rel="stylesheet"/>
			// HTMX
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js"></script>
			// Set script nonce for HTMX // without this, HTMX will not work with CSP
			<meta
				name="htmx-config"
				content={ fmt.Sprintf(`{
			    "inlineScriptNonce": "%s"
			}`, templ.GetNonce(ctx)) }
			/>
			// Theme initialization - must run before body renders to prevent flash
			<script nonce={ templ.GetNonce(ctx) }>
				(function() {
					// Get current theme preference (system, light, or dark)
					function getThemePreference() {
						return localStorage.getItem('theme') || 'system';
					}
					
					// Apply theme based on preference
					const preference = getThemePreference();
					let isDark = false;
					
					if (preference === 'system') {
						// Use system preference
						isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					} else {
						// Use explicit preference
						isDark = preference === 'dark';
					}
					
					// Apply theme immediately to prevent flash
					if (isDark) {
						document.documentElement.classList.add('dark');
					}

					// Keep same-origin frames in sync like next-themes: the
					// storage event fires in every other window (including
					// the chart and block preview iframes) when the
					// preference changes.
					window.addEventListener('storage', function(e) {
						if (e.key !== 'theme') return;
						const p = e.newValue || 'system';
						const dark = p === 'system'
							? window.matchMedia('(prefers-color-scheme: dark)').matches
							: p === 'dark';
						document.documentElement.classList.toggle('dark', dark);
					});
				})();
			</script>
		</head>
		// 1:1 their body classes, plus the style-* class that picks the active
		// style for our cn-* components (shadcn's site scopes that per preview).
		<body
			class="group/body style-nova overscroll-none antialiased transition-colors duration-200 [--footer-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]"
		>
			// shadcn's app/layout.tsx renders its children right in <body>: the
			// (view) routes (examples, block and chart views) are bare, the
			// (app) routes wrap themselves in AppLayout.
			{ children... }
			@toast.Toaster()
		</body>
		// HTMX
		<script nonce={ templ.GetNonce(ctx) }>
			document.body.addEventListener('htmx:after:swap', (e) => {
				// Active link updater: the docs sidebar sits outside the swapped
				// fragment, so data-active follows the pushed URL here (their
				// usePathname). The first group matches by prefix like
				// TOP_LEVEL_SECTIONS, the section groups match exactly.
				const sidebar = document.querySelector('[data-docs-sidebar-content]');
				if (sidebar) {
					const path = location.pathname;
					sidebar.querySelectorAll('[data-slot="sidebar-group"]').forEach((group, index) => {
						group.querySelectorAll('[data-slot="sidebar-menu-button"]').forEach((link) => {
							const href = link.getAttribute('href');
							const active = index === 0
								? (href === '/docs' ? path === href : path.startsWith(href))
								: path === href;
							link.setAttribute('data-active', String(active));
						});
					});
				}

				// Scroll to top after content swap. The page scrolls on the
				// body since the docs layout rework, not on #main-content.
				const target = e.detail.ctx.target;
				if (target && target.id === 'main-content') {
					window.scrollTo({ top: 0, behavior: 'instant' });
				}
			});
		</script>
	</html>
}

// AppLayout is shadcn's app/(app)/layout.tsx inside the root layout: the
// group/layout wrapper with the designer gates. Designer pages
// (data-slot="designer") pin the layout to the viewport, and the navbar's
// designer actions show via group-has-data-[slot=designer]/layout.
templ AppLayout(title, description string) {
	@BaseLayout(title, description) {
		<div data-slot="layout" class="group/layout relative z-10 flex min-h-svh flex-col bg-background has-data-[slot=designer]:h-svh has-data-[slot=designer]:overflow-hidden">
			{ children... }
		</div>
	}
}
