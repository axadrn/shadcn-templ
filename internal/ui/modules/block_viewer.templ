package modules

import (
	"strconv"
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/resizable"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
	"github.com/axadrn/shadcn-templ/v2/components/tabs"
	"github.com/axadrn/shadcn-templ/v2/components/togglegroup"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// BlockViewer is the pendant of shadcn's components/block-viewer.tsx: the
// toolbar (view tabs, viewport toggles, add command), the resizable
// preview iframe and the code tab with file tree. React state becomes the
// wrapper's data-view attribute plus inline styles, driven by
// BlocksPageScript.
templ BlockViewer(entry BlockEntry) {
	<div
		id={ entry.Name }
		data-view="preview"
		data-templ-block-wrapper
		class="group/block-view-wrapper flex min-w-0 scroll-mt-24 flex-col-reverse items-stretch gap-4 overflow-hidden md:flex-col"
		style={ "--height: " + entry.Height() }
	>
		@blockViewerToolbar(entry)
		@blockViewerView(entry)
		@blockViewerCode(entry)
		@blockViewerMobile(entry)
	</div>
}

// blockViewerToolbar is the BlockViewerToolbar pendant: view tabs, the
// description anchor, viewport toggle group, open-in-new-tab, refresh and
// the CLI add command copy button. The OpenInV0 button has no shadcn-templ
// pendant and stays out.
templ blockViewerToolbar(entry BlockEntry) {
	<div class="hidden w-full items-center gap-2 pl-2 md:pr-6 lg:flex">
		@tabs.Tabs(tabs.Props{
			ID:           entry.Name + "-view-tabs",
			DefaultValue: "preview",
			Attributes:   templ.Attributes{"data-templ-block-tabs": ""},
		}) {
			@tabs.List(tabs.ListProps{Class: "grid h-8! grid-cols-2 items-center rounded-lg p-1 *:data-[slot=tabs-trigger]:h-6 *:data-[slot=tabs-trigger]:rounded-sm *:data-[slot=tabs-trigger]:px-2 *:data-[slot=tabs-trigger]:text-xs"}) {
				@tabs.Trigger(tabs.TriggerProps{Value: "preview", Attributes: templ.Attributes{"data-templ-block-set-view": "preview"}}) {
					Preview
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "code", Attributes: templ.Attributes{"data-templ-block-set-view": "code"}}) {
					Code
				}
			}
		}
		@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mx-2 h-4! self-center!"})
		<a
			href={ templ.SafeURL("#" + entry.Name) }
			class="flex-1 text-center text-sm font-medium underline-offset-2 hover:underline md:flex-auto md:text-left"
		>
			{ strings.TrimSuffix(entry.Description, ".") }
		</a>
		<div class="ml-auto flex items-center gap-2">
			<div class="h-8 items-center gap-1.5 rounded-md border p-[3px] shadow-none">
				@togglegroup.ToggleGroup(togglegroup.Props{Spacing: utils.Ptr(1), DefaultValue: []string{"100%"}, Class: "*:data-[slot=toggle-group-item]:size-6! *:data-[slot=toggle-group-item]:rounded-sm!"}) {
					@togglegroup.Item(togglegroup.ItemProps{Value: "100%", Attributes: templ.Attributes{"data-templ-block-size": "100%", "title": "Desktop"}}) {
						@icon.Monitor()
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "60%", Attributes: templ.Attributes{"data-templ-block-size": "60%", "title": "Tablet"}}) {
						@icon.Tablet()
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "30%", Attributes: templ.Attributes{"data-templ-block-size": "30%", "title": "Mobile"}}) {
						@icon.Smartphone()
					}
					@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-4! self-center!"})
					@button.Button(button.Props{
						Size:       button.SizeIcon,
						Variant:    button.VariantGhost,
						Class:      "size-6 rounded-sm p-0",
						Href:       "/view/" + entry.Name,
						Target:     "_blank",
						Attributes: templ.Attributes{"title": "Open in New Tab"},
					}) {
						<span class="sr-only">Open in New Tab</span>
						@icon.Fullscreen()
					}
					@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-4! self-center!"})
					@button.Button(button.Props{
						Size:       button.SizeIcon,
						Variant:    button.VariantGhost,
						Class:      "size-6 rounded-sm p-0",
						Attributes: templ.Attributes{"title": "Refresh Preview", "data-templ-block-refresh": entry.Name},
					}) {
						@icon.RotateCw()
						<span class="sr-only">Refresh Preview</span>
					}
				}
			</div>
			@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mx-1 h-4! self-center!"})
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Size:       button.SizeSm,
				Class:      "w-fit gap-1 px-2 shadow-none",
				Attributes: templ.Attributes{"data-templ-block-add": "shadcn-templ add " + entry.Name},
			}) {
				<span data-templ-block-add-idle>
					@icon.Terminal()
				</span>
				<span data-templ-block-add-done class="hidden">
					@icon.Check()
				</span>
				<span>shadcn-templ add { entry.Name }</span>
			}
		</div>
	</div>
}

// blockViewerView is the BlockViewerView pendant: the dotted canvas and
// the same PanelGroup -> Panel -> Handle -> Panel composition as shadcn.
templ blockViewerView(entry BlockEntry) {
	<div class="hidden group-data-[view=code]/block-view-wrapper:hidden md:h-(--height) lg:flex">
		<div class="relative grid w-full gap-4">
			<div class="absolute inset-0 right-4 [background-image:radial-gradient(#d4d4d4_1px,transparent_1px)] [background-size:20px_20px] dark:[background-image:radial-gradient(#404040_1px,transparent_1px)]"></div>
			@resizable.PanelGroup(resizable.PanelGroupProps{
				ID:          entry.Name + "-preview-group",
				Orientation: resizable.OrientationHorizontal,
				Class:       "relative z-10 after:absolute after:inset-0 after:right-3 after:z-0 after:rounded-xl after:bg-surface/50",
				Attributes:  templ.Attributes{"data-templ-block-resizable": ""},
			}) {
				@resizable.Panel(resizable.PanelProps{
					ID:          entry.Name + "-preview-panel",
					DefaultSize: "100%",
					MinSize:     "30%",
					Class:       "relative aspect-[4/2.5] overflow-hidden rounded-lg border bg-background md:aspect-auto md:rounded-xl",
					Attributes:  templ.Attributes{"data-templ-block-panel": ""},
				}) {
					<iframe
						src={ templ.SafeURL("/view/" + entry.Name) }
						height={ strconv.Itoa(entry.HeightPx()) }
						loading="lazy"
						class="relative z-20 no-scrollbar w-full bg-background"
						title={ entry.Name }
						data-templ-block-iframe={ entry.Name }
					></iframe>
				}
				@resizable.Handle(resizable.HandleProps{
					Class:      "relative hidden w-3 bg-transparent p-0 after:absolute after:top-1/2 after:right-0 after:h-8 after:w-[6px] after:translate-x-[-1px] after:-translate-y-1/2 after:rounded-full after:bg-border after:transition-all after:hover:h-10 md:block",
					Attributes: templ.Attributes{"data-templ-block-handle": "", "aria-label": "Resize preview"},
				})
				@resizable.Panel(resizable.PanelProps{
					ID:          entry.Name + "-preview-spacer",
					DefaultSize: "0%",
					MinSize:     "0%",
				})
			}
		</div>
	</div>
}

// blockViewerCode is the BlockViewerCode pendant: file tree on the left,
// the highlighted active file on the right. Every file pane is
// pre-rendered; BlocksPageScript switches the active one.
templ blockViewerCode(entry BlockEntry) {
	<div class="mr-[14px] flex overflow-hidden rounded-xl border bg-code text-code-foreground group-data-[view=preview]/block-view-wrapper:hidden md:h-(--height)">
		<div class="w-72 shrink-0">
			@blockViewerFileTree(entry)
		</div>
		for i, file := range entry.Files {
			<figure
				data-rehype-pretty-code-figure=""
				data-templ-block-file-pane={ file.Path }
				if i != 0 {
					hidden
				}
				class="mx-0! mt-0 flex min-w-0 flex-1 flex-col rounded-xl border-none"
			>
				<figcaption
					class="flex h-12 shrink-0 items-center gap-2 border-b px-4 py-2 text-code-foreground [&_svg]:size-4 [&_svg]:text-code-foreground [&_svg]:opacity-70"
					data-language={ blockFileLanguage(file.Path) }
				>
					@icon.FileCode()
					{ file.Path }
					<div class="ml-auto flex items-center gap-2">
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "size-7",
							Attributes: templ.Attributes{"data-templ-block-copy-file": file.Path, "aria-label": "Copy code"},
						}) {
							<span data-templ-block-copy-idle>
								@icon.Clipboard()
							</span>
							<span data-templ-block-copy-done class="hidden">
								@icon.Check()
							</span>
						}
					</div>
				</figcaption>
				<div class="no-scrollbar min-h-0 flex-1 overflow-y-auto [&_pre]:px-0 [&_pre]:py-3.5" data-templ-block-file-scroll data-templ-code-line-numbers>
					@templ.Raw(GetHighlightedHTML(ctx, file.Content, blockFileLanguage(file.Path)))
				</div>
				<textarea hidden readonly data-templ-block-file-source={ file.Path }>{ file.Content }</textarea>
			</figure>
		}
	</div>
}

// blockViewerFileTree is the BlockViewerFileTree pendant, hand-rolled
// instead of nesting a full sidebar per gallery card: the Files header and
// the folder tree, folders open, the first file active.
templ blockViewerFileTree(entry BlockEntry) {
	<div class="flex min-h-full flex-col border-r bg-sidebar text-sidebar-foreground">
		<div class="flex h-12 shrink-0 items-center rounded-none border-b px-4 text-sm font-medium">
			Files
		</div>
		<div class="flex flex-1 flex-col gap-1.5 py-2">
			for _, node := range buildBlockFileTree(entry.Files) {
				@blockViewerTreeNode(entry, node, 1)
			}
		</div>
	</div>
}

templ blockViewerTreeNode(entry BlockEntry, node *blockFileTree, index int) {
	if len(node.Children) == 0 {
		<button
			type="button"
			data-templ-block-file={ node.Path }
			data-active={ utils.IfElse(len(entry.Files) > 0 && entry.Files[0].Path == node.Path, "true", "false") }
			class="flex h-8 w-full items-center gap-2 rounded-none pl-(--index) text-sm whitespace-nowrap hover:bg-muted-foreground/15 focus:bg-muted-foreground/15 focus-visible:bg-muted-foreground/15 active:bg-muted-foreground/15 data-[active=true]:bg-muted-foreground/15 [&_svg]:size-4"
			style={ "--index: " + strconv.FormatFloat(float64(index)*utils.IfElse(index == 2, 1.2, 1.3), 'g', -1, 64) + "rem" }
		>
			@icon.ChevronRight(icon.Props{Class: "invisible"})
			@icon.File()
			{ node.Name }
		</button>
	} else {
		<div data-templ-block-folder class="group/block-folder">
			<button
				type="button"
				data-templ-block-folder-trigger
				aria-expanded="true"
				class="flex h-8 w-full items-center gap-2 rounded-none pl-(--index) text-sm whitespace-nowrap hover:bg-muted-foreground/15 focus:bg-muted-foreground/15 focus-visible:bg-muted-foreground/15 active:bg-muted-foreground/15 data-[active=true]:bg-muted-foreground/15 [&_svg]:size-4"
				style={ "--index: " + strconv.FormatFloat(float64(index)*utils.IfElse(index == 1, 1.0, 1.2), 'g', -1, 64) + "rem" }
			>
				@icon.ChevronRight(icon.Props{Class: "rotate-90 transition-transform group-data-[closed]/block-folder:rotate-0"})
				@icon.Folder()
				{ node.Name }
			</button>
			<div class="group-data-[closed]/block-folder:hidden">
				for _, child := range node.Children {
					@blockViewerTreeNode(entry, child, index+1)
				}
			</div>
		</div>
	}
}

// blockViewerMobile is the BlockViewerMobile pendant. shadcn shows baked
// screenshots below lg; shadcn-templ has no image pipeline, so the live
// iframe rides in the 4/2.5 box instead.
templ blockViewerMobile(entry BlockEntry) {
	<div class="flex flex-col gap-2 lg:hidden">
		<div class="flex items-center gap-2 px-2">
			<div class="line-clamp-1 text-sm font-medium">
				{ entry.Description }
			</div>
			<div class="ml-auto shrink-0 font-mono text-xs text-muted-foreground">
				{ entry.Name }
			</div>
		</div>
		<div class="overflow-hidden rounded-xl border">
			<iframe
				src={ templ.SafeURL("/view/" + entry.Name) }
				loading="lazy"
				class="aspect-[4/2.5] w-full bg-background"
				title={ entry.Name }
			></iframe>
		</div>
	</div>
}
