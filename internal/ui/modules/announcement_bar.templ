package modules

import "github.com/templui/templui/components/icon"

// AnnouncementBar marks the v1 docs as archived and sends readers to
// shadcn-templ 2.0, the maintained successor.
templ AnnouncementBar() {
	<div class="relative z-50 flex items-center justify-center bg-foreground px-4 py-1.5 text-center text-background">
		<div class="inline-flex flex-wrap items-center justify-center gap-2 text-sm">
			<span>You are viewing the archived templUI v1 docs. templUI is now shadcn-templ, and 2.0 is stable.</span>
			<a href="https://shadcn-templ.com/?ref=templui-v1" class="group inline-flex items-center gap-1 font-semibold underline">
				Go to shadcn-templ
				@icon.ArrowRight(icon.Props{Class: "size-3.5 transition-transform group-hover:translate-x-0.5"})
			</a>
		</div>
	</div>
}
