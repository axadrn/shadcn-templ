package modules

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

type TableOfContentsItem struct {
	ID       string
	Text     string
	Children []TableOfContentsItem
}

type TableOfContentsProps struct {
	Items []TableOfContentsItem
}

// TableOfContents is the pendant of shadcn's components/docs-toc.tsx in its
// "list" variant: a flat list of anchors carrying data-depth for the indent
// and data-active for the scroll spy. Their toc entries are flat with a depth
// number, ours nest, so the nesting is flattened to the same depths (h2 = 2).
templ TableOfContents(props TableOfContentsProps) {
	if len(props.Items) > 0 {
		<div class="flex flex-col gap-2 p-4 pt-0 text-sm" data-toc="container">
			<p class="h-6 bg-background text-xs font-medium text-muted-foreground">On This Page</p>
			@tocItems(props.Items, 2)
		</div>
	}
}

templ tocItems(items []TableOfContentsItem, depth int) {
	for _, item := range items {
		<a
			href={ templ.SafeURL("#" + item.ID) }
			class="text-[0.8rem] text-muted-foreground no-underline transition-colors hover:text-foreground data-[active=true]:font-medium data-[active=true]:text-foreground data-[depth=3]:pl-4 data-[depth=4]:pl-6"
			data-active="false"
			data-depth={ strconv.Itoa(depth) }
			data-toc-link={ item.ID }
		>
			{ item.Text }
		</a>
		if len(item.Children) > 0 {
			@tocItems(item.Children, depth+1)
		}
	}
}

// TableOfContentsScript is their useActiveItem hook: an IntersectionObserver
// over the headings with the same "0% 0% -80% 0%" root margin. It re-arms
// after every htmx swap, because the toc is replaced out of band.
templ TableOfContentsScript() {
	<script defer nonce={ templ.GetNonce(ctx) }>
		(function () {
			var observer = null;

			function arm() {
				if (observer) {
					observer.disconnect();
					observer = null;
				}

				var links = Array.prototype.slice.call(document.querySelectorAll("[data-toc-link]"));
				if (!links.length) return;

				function setActive(id) {
					links.forEach(function (link) {
						link.setAttribute("data-active", link.dataset.tocLink === id ? "true" : "false");
					});
				}

				observer = new IntersectionObserver(
					function (entries) {
						for (var i = 0; i < entries.length; i++) {
							if (entries[i].isIntersecting) setActive(entries[i].target.id);
						}
					},
					{ rootMargin: "0% 0% -80% 0%" }
				);

				links.forEach(function (link) {
					var heading = document.getElementById(link.dataset.tocLink);
					if (heading) observer.observe(heading);
				});
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", arm);
			} else {
				arm();
			}
			document.addEventListener("htmx:after:swap", arm);
			document.addEventListener("htmx:afterSwap", arm);
		})();
	</script>
}

// TocAdCard is a compact goilerplate card below the toc.
templ TocAdCard() {
	<a
		href="https://goilerplate.com/?ref=shadcn-templ-toc"
		target="_blank"
		rel="noopener"
		class="relative block overflow-hidden rounded-2xl border bg-surface p-4 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
	>
		<div class="relative flex items-start justify-between gap-3">
			<span class="mt-1 inline-flex items-center gap-1.5 text-[10px] leading-none font-semibold tracking-[0.12em] text-muted-foreground uppercase">
				<span class="size-1.5 rounded-full bg-foreground"></span>
				Go SaaS starter
			</span>
			<img src="/assets/img/goilerplate-mark.svg" alt="" width="64" height="84" class="h-11 w-auto shrink-0 dark:invert"/>
		</div>
		<div class="relative mt-4 text-base leading-tight font-semibold tracking-tight text-balance text-foreground">
			Auth, billing, teams.
			<br/>
			Already done.
		</div>
		<div class="relative mt-3 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
			$99 until Dec 1, then $149
			@icon.ArrowUpRight(icon.Props{Class: "size-3.5"})
		</div>
	</a>
}
