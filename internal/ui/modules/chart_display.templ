package modules

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
	"github.com/axadrn/shadcn-templ/v2/components/sheet"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
	"github.com/axadrn/shadcn-templ/v2/utils"
	"strings"
)

// ChartEntry is one gallery chart, the pendant of chart-display.tsx's
// Chart shape: registry id and source code, rendered via the /view iframe.
type ChartEntry struct {
	ID        string
	FullWidth bool
	Code      string
}

// ChartDisplay is the ChartDisplay pendant: toolbar plus the chart in a
// lazy iframe (ChartIframe), fullWidth entries span the grid.
templ ChartDisplay(entry ChartEntry) {
	<div
		class={ utils.CN(
			"themes-wrapper group relative flex flex-col overflow-hidden rounded-xl transition-all duration-200 ease-in-out hover:z-30",
			utils.IfElse(entry.FullWidth, "md:col-span-2 lg:col-span-3", ""),
		) }
	>
		@chartToolbar(entry)
		<div class="relative z-10 overflow-hidden rounded-xl bg-background">
			<iframe
				src={ templ.SafeURL("/view/" + entry.ID) }
				class="w-full border-none opacity-0 transition-opacity duration-300"
				height="460"
				loading="lazy"
				title={ entry.ID }
				data-templ-chart-iframe
			></iframe>
		</div>
	</div>
}

// chartToolbar is the ChartToolbar pendant: chart type title on the left,
// copy button, separator and the code viewer trigger on the right.
templ chartToolbar(entry ChartEntry) {
	<div class="relative z-20 flex items-center gap-2 justify-end px-3 py-2.5">
		<div class="flex items-center gap-1.5 pl-1 text-[13px] text-muted-foreground [&>svg]:h-[0.9rem] [&>svg]:w-[0.9rem]">
			@chartTitle(entry.ID)
		</div>
		<div class="ml-auto flex items-center gap-2 [&>form]:flex">
			@chartCopyButton(entry.ID, "[&_svg]:h-3 h-6 w-6 rounded-[6px] bg-transparent text-foreground shadow-none hover:bg-muted dark:text-foreground [&_svg]:w-3")
			@separator.Separator(separator.Props{
				Orientation: separator.OrientationVertical,
				// self-center neutralizes the base self-stretch, the fixed
				// h-4 would otherwise pin the line to the flex start.
				Class:       "mx-0 hidden h-4! self-center! md:flex",
			})
			@chartCodeViewer(entry)
		</div>
	</div>
	<textarea hidden readonly data-templ-chart-code={ entry.ID }>{ entry.Code }</textarea>
}

// chartTitle mirrors ChartToolbar's ChartTitle switch on the chart name.
templ chartTitle(name string) {
	if strings.Contains(name, "chart-line") {
		@icon.ChartLine()
		Line Chart
	} else if strings.Contains(name, "chart-bar") {
		@icon.ChartColumnBig()
		Bar Chart
	} else if strings.Contains(name, "chart-pie") {
		@icon.ChartPie()
		Pie Chart
	} else if strings.Contains(name, "chart-area") {
		@icon.ChartArea()
		Area Chart
	} else if strings.Contains(name, "chart-radar") {
		@icon.Hexagon()
		Radar Chart
	} else if strings.Contains(name, "chart-radial") {
		@icon.Radar()
		Radial Chart
	} else if strings.Contains(name, "chart-tooltip") {
		@icon.MousePointer2()
		Tooltip
	} else {
		{ name }
	}
}

// chartCopyButton is the ChartCopyButton pendant: ghost icon button with a
// "Copy code" tooltip that copies the chart source and swaps to a check
// for two seconds.
templ chartCopyButton(name, class string) {
	@tooltip.Tooltip() {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   utils.CN("h-7 w-7 rounded-[6px] [&_svg]:h-3.5 [&_svg]:w-3.5", class),
			Attributes: utils.MergeAttributes(tooltip.Trigger(ctx), templ.Attributes{
				"data-templ-chart-copy": name,
				"aria-label":          "Copy code",
			}),
		}) {
			<span class="sr-only">Copy</span>
			<span data-templ-chart-copy-idle>
				@icon.Copy()
			</span>
			<span data-templ-chart-copy-done class="hidden">
				@icon.Check()
			</span>
		}
		@tooltip.Content() {
			Copy code
		}
	}
}

// chartCodeViewer is the ChartCodeViewer pendant: the View Code button
// opens a right side sheet with the chart preview on top and the
// highlighted source below.
templ chartCodeViewer(entry ChartEntry) {
	@sheet.Sheet() {
		@button.Button(button.Props{
			Size:       button.SizeSm,
			Variant:    button.VariantOutline,
			Class:      "h-6 rounded-[6px] border bg-transparent px-2 text-xs text-foreground shadow-none hover:bg-muted dark:text-foreground",
			Attributes: sheet.Trigger(ctx),
		}) {
			View Code
		}
		@sheet.Content(sheet.ContentProps{
			Side: sheet.SideRight,
			// The charts app uses shadcn's app-level sheet: keyframe
			// slide-in from the right (500ms in, 300ms out), no fade. The
			// important markers beat the base sheet's transition styles
			// (transition-none plus neutralized data-starting-style/
			// data-ending-style translates) and its
			// data-[side=right]:sm:max-w-sm width; the keyframes ride Base
			// UI's data-open/data-closed lifecycle driven by dialog.js.
			// Below md the viewer comes up from the bottom like shadcn's
			// Drawer variant, from md on it is the right side sheet.
			Class: "flex flex-col gap-0 border-l-0 p-0 sm:max-w-sm! md:w-[700px]! md:max-w-[700px]! dark:border-l bg-background ease-in-out transition-none data-starting-style:translate-x-0! data-starting-style:translate-y-0! data-starting-style:opacity-100! data-ending-style:translate-x-0! data-ending-style:translate-y-0! data-ending-style:opacity-100! data-open:animate-in data-closed:animate-out data-open:duration-500 data-closed:duration-300 max-md:inset-x-0! max-md:bottom-0! max-md:top-auto! max-md:h-auto! max-md:max-h-[80vh]! max-md:w-full! max-md:max-w-none! max-md:rounded-t-2xl max-md:border-t max-md:border-l-0 max-md:data-open:slide-in-from-bottom max-md:data-closed:slide-out-to-bottom md:data-open:slide-in-from-right md:data-closed:slide-out-to-right",
		}) {
			<div class="sr-only">
				@sheet.Title() {
					Code
				}
				@sheet.Description() {
					View the code for the chart.
				}
			</div>
			<div class="flex min-h-0 flex-1 flex-col gap-0">
				// Like shadcn's ChartCodeViewer usage: the preview slot
				// stays empty, the sheet shows the code only.
				<div class="chart-wrapper hidden theme-container sm:block [&_[data-chart]]:mx-auto [&_[data-chart]]:max-h-[35vh] [&>div]:rounded-none [&>div]:border-0 [&>div]:border-b [&>div]:shadow-none"></div>
				<div class="flex min-w-0 flex-1 flex-col overflow-hidden p-4">
					<figure data-rehype-pretty-code-figure="" class="mt-0 flex h-auto min-w-0 flex-1 flex-col overflow-hidden rounded-2xl bg-code text-sm text-code-foreground outline-none">
						<figcaption
							class="flex h-12 shrink-0 items-center gap-2 border-b py-2 pr-2 pl-4 text-foreground [&>svg]:size-4 [&>svg]:text-foreground [&>svg]:opacity-70"
							data-language="templ"
						>
							@icon.FileCode()
							{ entry.ID }
							<div class="ml-auto flex items-center gap-2">
								@chartCopyButton(entry.ID, "")
							</div>
						</figcaption>
						<div class="no-scrollbar min-h-0 flex-1 overflow-y-auto [&_pre]:px-0 [&_pre]:py-3.5" data-templ-code-line-numbers>
							@templ.Raw(GetHighlightedHTML(ctx, entry.Code, "go"))
						</div>
					</figure>
				</div>
			</div>
		}
	}
}
