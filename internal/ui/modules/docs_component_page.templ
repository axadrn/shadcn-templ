package modules

import (
	"context"
	"net/url"
	"strings"

	componentsrc "github.com/axadrn/shadcn-templ/v2/components"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/internal/ctxkeys"
	"github.com/axadrn/shadcn-templ/v2/internal/registry"
	"github.com/axadrn/shadcn-templ/v2/internal/shared"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/examples"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// Modules for the markdown-based component docs (the shadcn docs shell):
// preview with a clamped expandable code block, installation tabs, page
// header with copy-page and prev/next, and the bottom pager.

// ComponentPreviewBlock mirrors shadcn's ComponentPreview: one rounded-2xl
// bordered container with the live demo on top and the source attached below
// (border-t), clamped to a few lines behind a View Code button. The demo
// renders as the compiled utility build of its style (see
// InlinedStyleHTML), like shadcn's docs render compiled registry output.
templ ComponentPreviewBlock(entry examples.RegistryEntry, attrs map[string]string) {
	{{ align := attrs["align"] }}
	if align == "" {
		{{ align = "center" }}
	}
	{{ _, hideCode := attrs["hideCode"] }}
	{{ previewHTML, previewErr := InlinedStyleHTML(ctx, entry.Component, attrs["styleName"]) }}
	<div
		data-slot="component-preview"
		data-not-typeset
		class={ utils.CN(
			"group relative mt-4 mb-12 flex flex-col overflow-hidden rounded-2xl border",
			attrs["className"],
		) }
	>
		<div data-slot="preview">
			<div
				data-align={ align }
				class={ utils.CN(
					"preview relative flex h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-end data-[align=start]:items-start",
					attrs["previewClassName"],
				) }
			>
				@templ.Raw(previewHTML, previewErr)
			</div>
		</div>
		if !hideCode {
			@CollapsibleCodeBlock(entry.File)
		}
	</div>
}

// ComponentSourceBlock is shadcn's ComponentSource: one source file as a
// collapsible code figure. The hand written title picks the file, like
// shadcn's title attribute; without a title every file of the component
// renders (the fallback for pages that predate per file tags).
templ ComponentSourceBlock(name, title string) {
	for _, file := range componentSourceFiles(name) {
		if title == "" || title == file {
			@CodeCollapsibleWrapper() {
				@CodeFigure(CodeFigureProps{
					Language:        sourceLanguage(file),
					Title:           file,
					ShowLineNumbers: true,
					Code:            componentSourceCode(file),
				})
			}
		}
	}
}

// componentSourceFiles returns a component's source paths from the registry.
func componentSourceFiles(name string) []string {
	if item := registry.Find(name); item != nil {
		return item.FilePaths()
	}
	return nil
}

func componentSourceCode(path string) string {
	content, err := componentsrc.SourceFiles.ReadFile(strings.TrimPrefix(path, "components/"))
	if err != nil {
		return ""
	}
	return strings.TrimRight(string(content), "\n")
}

func sourceLanguage(path string) string {
	if strings.HasSuffix(path, ".js") {
		return "javascript"
	}
	return "templ"
}

// CodeCollapsibleWrapper is shadcn's CodeCollapsibleWrapper: source clamped
// to max-h-64 with an Expand/Collapse button next to the copy button and a
// gradient trigger across the bottom.
templ CodeCollapsibleWrapper() {
	<div data-templ-docs-collapsible data-open="false" class="group/collapsible relative md:-mx-1">
		<div class="absolute top-1.5 right-9 z-10 flex items-center">
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Class:      "h-7 rounded-md px-2 text-muted-foreground",
				Attributes: templ.Attributes{"data-templ-docs-collapsible-toggle": true},
			}) {
				<span class="group-data-[open=true]/collapsible:hidden">Expand</span>
				<span class="hidden group-data-[open=true]/collapsible:inline">Collapse</span>
			}
			<div class="mx-1.5 h-4 w-px bg-border"></div>
		</div>
		<div class="relative mt-6 overflow-hidden group-data-[open=false]/collapsible:max-h-64 [&>figure]:mt-0 md:[&>figure]:mx-0">
			{ children... }
		</div>
		<button
			type="button"
			data-templ-docs-collapsible-toggle
			class="absolute inset-x-0 -bottom-2 flex h-20 items-center justify-center rounded-b-lg bg-gradient-to-b from-code/70 to-code text-sm text-muted-foreground group-data-[open=true]/collapsible:hidden"
		>Expand</button>
	</div>
}

// CollapsibleCodeBlock is shadcn's preview source: while collapsed a
// separate 3-line render (their sourcePreview) sits behind the View Code
// button; expanding swaps in the full source (one-way).
templ CollapsibleCodeBlock(file string) {
	<div
		data-templ-docs-code
		data-templ-code-line-numbers
		data-open="false"
		class="group/code relative border-t"
	>
		<div class="relative group-data-[open=true]/code:hidden">
			@codeSnippetPreview(file, 3)
			<div class="absolute inset-0 flex items-center justify-center">
				<div class="absolute inset-0" style="background: linear-gradient(to top, var(--color-code), color-mix(in oklab, var(--color-code) 60%, transparent), transparent);"></div>
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Class:      "relative z-10 h-8 rounded-lg bg-background px-3 text-sm text-foreground shadow-none hover:bg-muted dark:bg-background dark:text-foreground dark:hover:bg-muted",
					Attributes: templ.Attributes{"data-templ-docs-code-toggle": true},
				}) {
					View Code
				}
			</div>
		</div>
		<div class="hidden group-data-[open=true]/code:block">
			@CodeSnippetFromEmbeddedStyled(file, "templ", examples.TemplFiles, "[&_pre]:my-0 [&_pre]:max-h-72 [&_pre]:rounded-none [&_pre]:!bg-code [&_pre]:px-0")
		</div>
	</div>
}

// codeSnippetPreview renders only the first maxLines lines of a source, the
// pendant of shadcn's ComponentSource maxLines={3}.
templ codeSnippetPreview(file string, maxLines int) {
	{{ preview := sourcePreviewLines(file, maxLines) }}
	@Code(CodeProps{
		Language:    "templ",
		CodeContent: preview,
		CodeClass:   "[&_pre]:my-0 [&_pre]:max-h-none [&_pre]:rounded-none [&_pre]:!bg-code [&_pre]:px-0",
	})
}

func sourcePreviewLines(file string, maxLines int) string {
	content, err := examples.TemplFiles.ReadFile(file)
	if err != nil {
		return ""
	}
	lines := strings.Split(string(content), "\n")
	if len(lines) > maxLines {
		lines = lines[:maxLines]
	}
	return strings.Join(lines, "\n")
}

// InstallTabTriggerClass restyles our tabs trigger to shadcn's docs mdx
// TabsTrigger (default variant, underline via border-b-2; the list height
// clamps the trigger so the underline sits tight under the text).
const InstallTabTriggerClass = "rounded-none border-0 border-b-2 border-transparent bg-transparent px-0 pt-1 pb-3 text-base text-muted-foreground hover:text-primary data-active:border-primary data-active:bg-transparent data-active:!shadow-none data-active:text-foreground dark:data-active:border-primary dark:data-active:bg-transparent"

// DocsPageHeader: title, description and the copy-page/prev-next controls
// (no breadcrumbs, like shadcn).
templ DocsPageHeader(title, description, prevHref, nextHref string) {
	<div class="flex flex-col gap-2">
		<div class="flex items-center justify-between md:items-start">
			<h1 class="scroll-m-24 text-3xl font-semibold tracking-tight sm:text-3xl">{ title }</h1>
			<div class="docs-nav flex items-center gap-2">
				// The reference hides the copy-page menu below sm.
				<div class="hidden sm:block">
					@CopyPageMenu()
				</div>
				<div class="ml-auto flex gap-2">
					@pagerArrow(prevHref, false)
					@pagerArrow(nextHref, true)
				</div>
			</div>
		</div>
		<p class="text-[1.05rem] text-muted-foreground sm:text-base sm:text-balance md:max-w-[80%]">{ description }</p>
	</div>
}

templ pagerArrow(href string, next bool) {
	if href != "" {
		@button.Button(button.Props{
			Variant: button.VariantSecondary,
			Size:    button.SizeIconSm,
			Class:   "size-8 shadow-none md:size-7",
			Href:    href,
		}) {
			if next {
				@icon.ArrowRight()
				<span class="sr-only">Next</span>
			} else {
				@icon.ArrowLeft()
				<span class="sr-only">Previous</span>
			}
		}
	}
}

// CopyPageMenu: Copy Page with check feedback plus the shadcn dropdown
// (View as Markdown, Open in ChatGPT, Open in Claude — brand SVGs inlined,
// they do not exist in lucide; shadcn inlines them too).
templ CopyPageMenu() {
	<div class="group/buttons relative flex rounded-lg bg-secondary">
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeSm,
			Class:      "h-8 shadow-none md:h-7 md:text-[0.8rem]",
			Attributes: templ.Attributes{"data-templ-docs-copy-md": true, "data-copied": "false"},
		}) {
			<span class="[[data-copied=true]_&]:hidden">
				@icon.Copy()
			</span>
			<span class="hidden [[data-copied=true]_&]:inline">
				@icon.Check()
			</span>
			Copy Page
		}
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Class:      "peer -ml-0.5 size-8 shadow-none md:size-7 md:text-[0.8rem]",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				@icon.ChevronDown()
				<span class="sr-only">More options</span>
			}
			@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Class: "w-56 rounded-lg shadow-none"}) {
				@dropdownmenu.Item(dropdownmenu.ItemProps{Href: docsMarkdownHref(ctx), Target: "_blank"}) {
					@markdownBrandIcon()
					View as Markdown
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{Href: docsPromptURL(ctx, "https://chatgpt.com"), Target: "_blank"}) {
					@chatgptBrandIcon()
					Open in ChatGPT
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{Href: docsPromptURL(ctx, "https://claude.ai/new"), Target: "_blank"}) {
					@claudeBrandIcon()
					Open in Claude
				}
			}
		}
		<div class="absolute top-1 right-8 z-0 h-6 w-px bg-foreground/5 sm:right-7 sm:h-5"></div>
	</div>
}

