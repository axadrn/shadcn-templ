// docsPromptURL builds the "open in AI chat" link; like shadcn it points to
// the doc page itself (View as Markdown is the one that links the .md).
func docsPromptURL(ctx context.Context, base string) string {
	path, _ := ctx.Value(ctxkeys.URLPathValue).(string)
	prompt := "I'm looking at this shadcn-templ documentation: " + shared.BaseURL() + path + ".\nHelp me understand how to use it. Be ready to explain concepts, give examples, or help debug based on it.\n  "
	return base + "?q=" + url.QueryEscape(prompt)
}

// docsMarkdownHref points to the raw markdown of the current page.
func docsMarkdownHref(ctx context.Context) string {
	if path, ok := ctx.Value(ctxkeys.URLPathValue).(string); ok {
		return path + ".md"
	}
	return ""
}

// DocsPager renders the bottom previous/next component buttons.
templ DocsPager(prevTitle, prevHref, nextTitle, nextHref string) {
	<div class="mt-12 flex items-center justify-between">
		if prevHref != "" {
			@button.Button(button.Props{Variant: button.VariantSecondary, Href: prevHref}) {
				@icon.ArrowLeft()
				{ prevTitle }
			}
		} else {
			<span></span>
		}
		if nextHref != "" {
			@button.Button(button.Props{Variant: button.VariantSecondary, Href: nextHref}) {
				{ nextTitle }
				@icon.ArrowRight()
			}
		} else {
			<span></span>
		}
	</div>
}

// DocsCodeToggleScript powers the clamped code blocks and the copy-page
// button.
templ DocsCodeToggleScript() {
	<script defer nonce={ templ.GetNonce(ctx) }>
		document.addEventListener('click', (e) => {
			if (!(e.target instanceof Element)) return;
			const collapsibleToggle = e.target.closest('[data-templ-docs-collapsible-toggle]');
			if (collapsibleToggle) {
				const wrapper = collapsibleToggle.closest('[data-templ-docs-collapsible]');
				if (wrapper) wrapper.dataset.open = wrapper.dataset.open === 'true' ? 'false' : 'true';
				return;
			}
			const toggle = e.target.closest('[data-templ-docs-code-toggle]');
			if (toggle) {
				const block = toggle.closest('[data-templ-docs-code]');
				if (block) block.dataset.open = 'true';
				return;
			}
			const copy = e.target.closest('[data-templ-docs-copy-md]');
			if (copy) {
				fetch(window.location.pathname + '.md')
					.then((r) => (r.ok ? r.text() : Promise.reject()))
					.then((text) => navigator.clipboard.writeText(text))
					.then(() => {
						copy.setAttribute('data-copied', 'true');
						setTimeout(() => copy.setAttribute('data-copied', 'false'), 1500);
					})
					.catch(() => {});
			}
		});
	</script>
}

// MarkdownProse styles raw markdown HTML like shadcn's mdx typography.
templ MarkdownProse() {
	<div
		class={ utils.CN(
			"[&_h2]:mt-12 [&_h2]:scroll-m-24 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight",
			"[&_h3]:mt-8 [&_h3]:scroll-m-24 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:tracking-tight",
			"[&_p]:leading-7 [&_p:not(:first-child)]:mt-4 [&_p]:text-sm",
			"[&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4",
			"[&_code:not(pre_code)]:rounded [&_code:not(pre_code)]:bg-muted [&_code:not(pre_code)]:px-1.5 [&_code:not(pre_code)]:py-0.5 [&_code:not(pre_code)]:font-mono [&_code:not(pre_code)]:text-[0.8rem]",
			"[&_table]:my-6 [&_table]:w-full [&_table]:text-sm [&_th]:border-b [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-medium [&_td]:border-b [&_td]:border-border/50 [&_td]:px-3 [&_td]:py-2 [&_td_code]:whitespace-nowrap",
			"[&_ul]:my-4 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:text-sm [&_li]:mt-1",
			"[&>div[data-code-block]]:my-4",
		) }
	>
		{ children... }
	</div>
}

// CalloutBlock renders shadcn's Callout (surface alert box) around inner
// markdown.
templ CalloutBlock(class ...string) {
	{{ extra := "" }}
	if len(class) > 0 {
		{{ extra = class[0] }}
	}
	<div data-not-typeset class={ utils.CN("mt-6 w-auto rounded-2xl border border-surface bg-surface p-4 text-sm text-surface-foreground md:-mx-1 [&_code]:border [&_p]:text-card-foreground/80 [&_p:not(:first-child)]:mt-2", extra) }>
		{ children... }
	</div>
}

// BlockPreview is shadcn's ComponentPreview type="block": the demo renders
// as a full app page inside an iframe, clipped to a 4/2.5 desktop viewport.
templ BlockPreview(name string, attrs map[string]string) {
	<figure class="flex flex-col gap-4" data-not-typeset>
		<div class="relative mt-6 aspect-[4/2.5] w-full overflow-hidden rounded-2xl border md:-mx-1">
			<div class="absolute inset-0 w-[1600px] bg-background">
				<iframe src={ "/preview/" + name } class="size-full" title={ name }></iframe>
			</div>
		</div>
		if attrs["caption"] != "" {
			<figcaption class="text-center text-sm text-muted-foreground">{ attrs["caption"] }</figcaption>
		}
	</figure>
}
