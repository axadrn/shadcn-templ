package modules

import (
	"compress/gzip"
	"crypto/sha256"
	"encoding/hex"
	"fmt"
	"bytes"
	"context"
	"encoding/json"
	"github.com/axadrn/shadcn-templ/v2/components/copybutton"
	"github.com/axadrn/shadcn-templ/v2/utils"
	"html"
	"io"
	"log"
	"net/http"
	"os"
	"strings"
	"sync"
	"time"
)

type CodeProps struct {
	ID             string
	Class          string
	Attrs          templ.Attributes
	Language       string
	ShowCopyButton bool
	CodeClass      string
	CodeContent    string
}

templ Code(p CodeProps) {
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ highlightedHTML := GetHighlightedHTML(ctx, p.CodeContent, p.Language) }}
	<div
		id={ p.ID }
		class={ utils.CN("relative code-highlighting-container", p.Class) }
		{ p.Attrs... }
		data-templ-code-highlighting=""
	>
		<div
			class={ utils.CN(
			"[&_pre]:block",
			"[&_pre]:overflow-x-auto",
			"[&_pre]:overflow-y-auto",
			"[&_pre]:max-h-96",
			"[&_pre]:p-4",
			"[&_pre]:rounded-md",
			"[&_pre]:text-sm",
			p.CodeClass,
		) }
			data-templ-code-container=""
		>
			@templ.Raw(highlightedHTML)
		</div>
		if p.ShowCopyButton {
			<div class="absolute top-3 right-2 z-10">
				@copybutton.CopyButton(copybutton.Props{
					TargetID: p.ID,
					Class:    "size-7 bg-code",
				})
			</div>
		}
	</div>
}

// Configurable URL for the Shiki service
var shikiServiceURL = getShikiServiceURL()

// Helper function to read URL from environment variable
// with fallback for local development
func getShikiServiceURL() string {
	url := os.Getenv("SHIKI_URL")
	if url == "" {
		// Fallback when environment variable is not set
		// Useful for local development without Docker Compose
		url = "http://localhost:3000/highlight"
	}
	log.Printf("INFO: Using Shiki Service URL: %s", url)
	return url
}

type ShikiRequest struct {
	Code           string   `json:"code"`
	Lang           string   `json:"lang"`
	HighlightLines []int    `json:"highlightLines,omitempty"`
	HighlightWords []string `json:"highlightWords,omitempty"`
}

var (
	httpClient = &http.Client{
		Timeout: 5 * time.Second, // Timeout for HTTP requests
		Transport: &http.Transport{
			MaxIdleConns:        10, // Pool size for reused connections
			IdleConnTimeout:     30 * time.Second,
			MaxIdleConnsPerHost: 10,
		},
	}
	// Simple cache to avoid repeated requests for identical code
	// For production, a more robust cache (e.g., with LRU) would be advisable
	cache      = make(map[string]string)
	cacheMutex sync.RWMutex

	// bakedCache is the build-time highlight cache (cmd/highlight-gen):
	// hashed cache key -> highlighted HTML. In the production image it
	// replaces the node shiki service entirely.
	bakedCache map[string]string
	bakedOnce  sync.Once
)

// bakedCachePath is overridable so the generator stage can point elsewhere.
func bakedCachePath() string {
	if p := os.Getenv("HIGHLIGHT_CACHE"); p != "" {
		return p
	}
	return "assets/highlight-cache.json.gz"
}

func loadBakedCache() {
	bakedOnce.Do(func() {
		f, err := os.Open(bakedCachePath())
		if err != nil {
			return // no baked cache: dev mode, the live service handles it
		}
		defer f.Close()
		zr, err := gzip.NewReader(f)
		if err != nil {
			log.Printf("WARN: highlight cache unreadable: %v", err)
			return
		}
		defer zr.Close()
		var m map[string]string
		if err := json.NewDecoder(zr).Decode(&m); err != nil {
			log.Printf("WARN: highlight cache undecodable: %v", err)
			return
		}
		bakedCache = m
		log.Printf("INFO: highlight cache loaded (%d entries)", len(m))
	})
}

func hashCacheKey(key string) string {
	sum := sha256.Sum256([]byte(key))
	return hex.EncodeToString(sum[:])
}

// DumpHighlightCache serializes the runtime cache with hashed keys - the
// build-time generator (cmd/highlight-gen) fetches it after crawling all
// pages against the live shiki service.
func DumpHighlightCache(w io.Writer) error {
	cacheMutex.RLock()
	defer cacheMutex.RUnlock()
	m := make(map[string]string, len(cache))
	for k, v := range cache {
		m[hashCacheKey(k)] = v
	}
	return json.NewEncoder(w).Encode(m)
}

// GetHighlightedHTML calls the Shiki service and returns HTML.
// Returns HTML-escaped original code on errors.
// Uses a simple in-memory cache.
func GetHighlightedHTML(ctx context.Context, codeContent string, language string) string {
	return GetHighlightedHTMLMeta(ctx, codeContent, language, nil, nil)
}

// GetHighlightedHTMLMeta additionally passes rehype-pretty-code style line
// and word highlights ({4-6} and /word/ fence meta) to the shiki service.
func GetHighlightedHTMLMeta(ctx context.Context, codeContent string, language string, highlightLines []int, highlightWords []string) string {
	// log.Printf("INFO: GetHighlightedHTML called for lang '%s'", language)
	if codeContent == "" {
		return ""
	}
	// A file's trailing newline would render as an extra empty line with
	// its own line number, so it is trimmed like rehype-pretty-code does.
	codeContent = strings.TrimRight(codeContent, "\n")
	if language == "" {
		language = "templ" // Default
	}

	// Create cache key
	cacheKey := fmt.Sprintf("%s|%v|%v|%s", language, highlightLines, highlightWords, codeContent)

	// Check cache (with read lock)
	cacheMutex.RLock()
	cachedValue, ok := cache[cacheKey]
	if ok {
		// log.Println("Shiki Cache Hit for lang:", language)
		cacheMutex.RUnlock()
		return cachedValue
	}
	cacheMutex.RUnlock()

	// Baked build-time cache: a hit always wins (the key hashes the code
	// content, so a stale file can never serve wrong HTML - changed code
	// is a new key). On a miss the environment decides: production has no
	// node service, so log and serve plain code instead of dialing a dead
	// URL; development always falls through to the live service.
	loadBakedCache()
	if baked, ok := bakedCache[hashCacheKey(cacheKey)]; ok {
		cacheMutex.Lock()
		cache[cacheKey] = baked
		cacheMutex.Unlock()
		return baked
	}
	if os.Getenv("GO_ENV") == "production" && os.Getenv("SHIKI_URL") == "" {
		log.Printf("WARN: highlight cache miss for lang %s (%d bytes), serving plain code", language, len(codeContent))
		return html.EscapeString(codeContent)
	}

	// log.Println("Shiki Cache Miss for lang:", language)

	// log.Printf("INFO: Calling Shiki for lang '%s'...", language)
	requestBody, err := json.Marshal(ShikiRequest{
		Code:           codeContent,
		Lang:           language,
		HighlightLines: highlightLines,
		HighlightWords: highlightWords,
	})
	if err != nil {
		log.Printf("WARN: Error marshalling Shiki request: %v. Returning escaped code.", err)
		return html.EscapeString(codeContent) // Fallback
	}

	// Use a context with timeout if the passed context doesn't have one
	reqCtx, cancel := context.WithTimeout(ctx, httpClient.Timeout)
	defer cancel()

	req, err := http.NewRequestWithContext(reqCtx, "POST", shikiServiceURL, bytes.NewBuffer(requestBody))
	if err != nil {
		log.Printf("WARN: Error creating Shiki request: %v. Returning escaped code.", err)
		return html.EscapeString(codeContent) // Fallback
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Accept", "text/html")

	resp, err := httpClient.Do(req)
	// log.Printf("INFO: Shiki call finished for lang '%s'. Error: %v", language, err)
	if err != nil {
		// Distinguish between timeout and other errors
		if reqCtx.Err() == context.DeadlineExceeded { // Check reqCtx for timeout
			log.Printf("WARN: Shiki service request timed out for lang %s. Returning escaped code.", language)
		} else {
			log.Printf("WARN: Error calling Shiki service: %v. Returning escaped code.", err)
		}
		return html.EscapeString(codeContent) // Fallback
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		bodyBytes, _ := io.ReadAll(resp.Body)
		log.Printf("WARN: Shiki service returned error (%d) for lang %s: %s. Returning escaped code.", resp.StatusCode, language, string(bodyBytes))
		return html.EscapeString(codeContent) // Fallback
	}

	highlightedBytes, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Printf("WARN: Error reading Shiki service response: %v. Returning escaped code.", err)
		return html.EscapeString(codeContent) // Fallback
	}

	highlightedHTML := string(highlightedBytes)

	// Store in cache (with write lock)
	cacheMutex.Lock()
	defer cacheMutex.Unlock()
	cache[cacheKey] = highlightedHTML

	// IMPORTANT: Since we use templ.Raw, we assume Shiki
	// generates safe HTML. No additional escape function needed.
	return highlightedHTML
}

// CodeHighlightingScript can be removed or kept empty if needed for compatibility
templ CodeHighlightingScript() {
	// No longer needed - copy functionality is handled by CopyButton component
}
