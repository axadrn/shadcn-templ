package pages

import (
	"github.com/axadrn/shadcn-templ/v2/components/alertdialog"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/command"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/drawer"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/radiogroup"
	"github.com/axadrn/shadcn-templ/v2/components/togglegroup"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/layouts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The /create designer, 1:1 pendant of shadcn's app/(app)/(create)/create:
// customizer card (customizer.tsx), preview iframe host (preview.tsx) and the
// picker DOM from picker.tsx, SSRd here with the DEFAULT_CONFIG state.
// Behavior lives in assets/js/create.js; the state is the ?preset= param.

// Class blocks verbatim from app/(app)/(create)/components/picker.tsx.
const (
	createTriggerClass   = "relative w-36 shrink-0 touch-manipulation rounded-xl p-3 ring-1 ring-foreground/10 select-none hover:bg-muted focus-visible:ring-foreground/50 focus-visible:outline-none disabled:opacity-50 data-popup-open:bg-muted md:w-full md:rounded-lg md:px-2.5 md:py-2"
	createContentClass   = "cn-menu-target fixed z-50 no-scrollbar max-h-(--available-height) w-[calc(var(--available-width)-(--spacing(6)))] min-w-32 origin-(--transform-origin) translate-y-2 overflow-x-hidden overflow-y-auto rounded-xl border-0 bg-neutral-950/80 p-1.5 text-neutral-100 ring-1 ring-neutral-950/80 backdrop-blur-xl outline-none md:w-52 dark:bg-neutral-800/90 dark:ring-neutral-700/50 data-closed:overflow-hidden"
	createRadioItemClass = "relative flex cursor-default items-center gap-2 rounded-lg py-1.5 pr-8 pl-2 text-sm font-medium outline-hidden select-none **:text-neutral-100 focus:bg-neutral-600 focus:text-neutral-100 focus:**:text-neutral-100 data-inset:pl-8 dark:focus:bg-neutral-700/80 pointer-coarse:gap-3 pointer-coarse:py-2.5 pointer-coarse:pl-3 pointer-coarse:text-base data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
	createMenuItemClass  = "group/dropdown-menu-item relative flex cursor-default items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-medium outline-hidden select-none **:text-neutral-100 focus:bg-neutral-600 focus:text-neutral-100 focus:**:text-neutral-100 data-inset:pl-8 dark:focus:bg-neutral-700/80 pointer-coarse:gap-3 pointer-coarse:py-2.5 pointer-coarse:pl-3 pointer-coarse:text-base data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
	createLabelClass     = "px-2 py-1.5 text-xs font-medium text-neutral-400 data-inset:pl-8"
	createSeparatorClass = "-mx-1.5 my-1.5 h-px bg-neutral-600 dark:bg-neutral-700"
	createShortcutClass  = "ml-auto text-xs tracking-widest text-neutral-400! group-focus/dropdown-menu-item:text-neutral-100"
	// Footer button override, verbatim from copy-preset.tsx / open-preset.tsx /
	// random-button.tsx.
	createFooterButtonClass = "touch-manipulation bg-transparent! px-2! py-0! text-sm! transition-none select-none hover:bg-muted! pointer-coarse:h-10!"
	// Lock button, verbatim from lock-button.tsx.
	createLockClass = "flex size-4 cursor-pointer items-center justify-center rounded opacity-0 ring-foreground/60 transition-opacity outline-none group-focus-within/picker:opacity-100 group-hover/picker:opacity-100 focus:opacity-100 focus-visible:ring-1 data-[locked=true]:opacity-100 pointer-coarse:hidden absolute top-1/2 right-8 -translate-y-1/2"
)

// Default style icon (Nova) from registry/styles.tsx; create.js swaps it per
// state from window.templCreateConfig.STYLES.
const createNovaIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" role="img" color="currentColor" class="size-4"><path d="M2 12C2 9.19974 2 7.79961 2.54497 6.73005C3.02433 5.78924 3.78924 5.02433 4.73005 4.54497C5.79961 4 7.19974 4 10 4H14C16.8003 4 18.2004 4 19.27 4.54497C20.2108 5.02433 20.9757 5.78924 21.455 6.73005C22 7.79961 22 9.19974 22 12C22 14.8003 22 16.2004 21.455 17.27C20.9757 18.2108 20.2108 18.9757 19.27 19.455C18.2004 20 16.8003 20 14 20H10C7.19974 20 5.79961 20 4.73005 19.455C3.78924 18.9757 3.02433 18.2108 2.54497 17.27C2 16.2004 2 14.8003 2 12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>`

// Lucide logo from icon-library-picker.tsx logos.lucide.
const createLucideLogo = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path stroke="currentColor" d="M14 12a4 4 0 0 0-8 0 8 8 0 1 0 16 0 11.97 11.97 0 0 0-4-8.944"></path><path stroke="currentColor" d="M10 12a4 4 0 0 0 8 0 8 8 0 1 0-16 0 11.97 11.97 0 0 0 4.063 9"></path></svg>`

type createOption struct {
	Value    string
	Label    string
	Disabled bool
}

// registry/styles.tsx order.
var createStyles = []createOption{
	{Value: "vega", Label: "Vega"},
	{Value: "nova", Label: "Nova"},
	{Value: "maia", Label: "Maia"},
	{Value: "lyra", Label: "Lyra"},
	{Value: "mira", Label: "Mira"},
	{Value: "luma", Label: "Luma"},
	{Value: "sera", Label: "Sera"},
	{Value: "rhea", Label: "Rhea"},
}

// registry/base-colors.ts order.
var createBaseColors = []createOption{
	{Value: "neutral", Label: "Neutral"},
	{Value: "stone", Label: "Stone"},
	{Value: "zinc", Label: "Zinc"},
	{Value: "mauve", Label: "Mauve"},
	{Value: "olive", Label: "Olive"},
	{Value: "mist", Label: "Mist"},
	{Value: "taupe", Label: "Taupe"},
}

// The colored themes in registry/themes.ts order (base colors excluded);
// second group of the theme and chart color pickers.
var createColorThemes = []createOption{
	{Value: "amber", Label: "Amber"},
	{Value: "blue", Label: "Blue"},
	{Value: "cyan", Label: "Cyan"},
	{Value: "emerald", Label: "Emerald"},
	{Value: "fuchsia", Label: "Fuchsia"},
	{Value: "green", Label: "Green"},
	{Value: "indigo", Label: "Indigo"},
	{Value: "lime", Label: "Lime"},
	{Value: "orange", Label: "Orange"},
	{Value: "pink", Label: "Pink"},
	{Value: "purple", Label: "Purple"},
	{Value: "red", Label: "Red"},
	{Value: "rose", Label: "Rose"},
	{Value: "sky", Label: "Sky"},
	{Value: "teal", Label: "Teal"},
	{Value: "violet", Label: "Violet"},
	{Value: "yellow", Label: "Yellow"},
}

// app/(app)/(create)/lib/fonts.ts order, grouped by type like font-picker.tsx.
var createFontsSans = []createOption{
	{Value: "geist", Label: "Geist"},
	{Value: "inter", Label: "Inter"},
	{Value: "noto-sans", Label: "Noto Sans"},
	{Value: "nunito-sans", Label: "Nunito Sans"},
	{Value: "figtree", Label: "Figtree"},
	{Value: "roboto", Label: "Roboto"},
	{Value: "raleway", Label: "Raleway"},
	{Value: "dm-sans", Label: "DM Sans"},
	{Value: "public-sans", Label: "Public Sans"},
	{Value: "outfit", Label: "Outfit"},
	{Value: "oxanium", Label: "Oxanium"},
	{Value: "manrope", Label: "Manrope"},
	{Value: "space-grotesk", Label: "Space Grotesk"},
	{Value: "montserrat", Label: "Montserrat"},
	{Value: "ibm-plex-sans", Label: "IBM Plex Sans"},
	{Value: "source-sans-3", Label: "Source Sans 3"},
	{Value: "instrument-sans", Label: "Instrument Sans"},
}

var createFontsMono = []createOption{
	{Value: "geist-mono", Label: "Geist Mono"},
	{Value: "jetbrains-mono", Label: "JetBrains Mono"},
}

var createFontsSerif = []createOption{
	{Value: "noto-serif", Label: "Noto Serif"},
	{Value: "roboto-slab", Label: "Roboto Slab"},
	{Value: "merriweather", Label: "Merriweather"},
	{Value: "lora", Label: "Lora"},
	{Value: "playfair-display", Label: "Playfair Display"},
	{Value: "eb-garamond", Label: "EB Garamond"},
	{Value: "instrument-serif", Label: "Instrument Serif"},
}

// shadcn/icons libraries order. Only lucide ships in shadcn-templ.
var createIconLibraries = []createOption{
	{Value: "lucide", Label: "Lucide"},
	{Value: "tabler", Label: "Tabler Icons", Disabled: true},
	{Value: "hugeicons", Label: "HugeIcons", Disabled: true},
	{Value: "phosphor", Label: "Phosphor Icons", Disabled: true},
	{Value: "remixicon", Label: "Remix Icon", Disabled: true},
}

// registry/config.ts RADII, minus "default" (its own group in radius-picker.tsx).
var createOtherRadii = []createOption{
	{Value: "none", Label: "None"},
	{Value: "small", Label: "Small"},
	{Value: "medium", Label: "Medium"},
	{Value: "large", Label: "Large"},
}

templ Create() {
	@layouts.BaseLayout("New Project", "Customize everything. Pick your base color, theme, fonts and create your own version of shadcn-templ.") {
		@modules.AnnouncementBar()
		@modules.Navbar()
		<link rel="stylesheet" href={ utils.ScriptURL("/assets/css/create-fonts.css") }/>
		<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/preset.js") }></script>
		<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create-config.js") }></script>
		<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create-themes.js") }></script>
		<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create.js") }></script>
		// create/page.tsx shell.
		<main
			data-templ-create
			class="section-soft relative z-10 flex min-h-0 flex-1 flex-col overflow-hidden [--customizer-width:--spacing(48)] [--gap:--spacing(4)] md:[--gap:--spacing(6)] 2xl:[--customizer-width:--spacing(56)]"
		>
			<div
				data-slot="designer"
				class="flex min-h-0 flex-1 flex-col gap-(--gap) p-(--gap) pt-[calc(var(--gap)*0.25)] md:flex-row-reverse"
			>
				@createPreviewHost()
				@createCustomizer()
			</div>
			// PickerContent portal: position:fixed popups must not live inside
			// the backdrop-blur card (backdrop-filter creates a containing
			// block), so like Base UI's portal they render at shell level.
			<div data-templ-create-portal>
				// The transparent hover shield from PickerContent's portal.
				<div data-templ-create-shield hidden class="fixed inset-y-0 right-0 left-62 z-40 bg-transparent"></div>
				@createMainMenuContent()
				@createPickerContent("style", "") {
					@createRadioGroup("style") {
						@createGroup() {
							for _, opt := range createStyles {
								@createRadioItem(opt.Value, opt.Label, opt.Value == "nova", false)
							}
						}
					}
				}
				@createPickerContent("baseColor", "") {
					@createRadioGroup("baseColor") {
						@createGroup() {
							for _, opt := range createBaseColors {
								@createRadioItem(opt.Value, opt.Label, opt.Value == "neutral", false)
							}
						}
					}
				}
				@createPickerContent("theme", "max-h-92") {
					@createRadioGroup("theme") {
						@createThemeItems("neutral")
					}
				}
				@createPickerContent("chartColor", "max-h-92") {
					@createRadioGroup("chartColor") {
						@createThemeItems("neutral")
					}
				}
				@createPickerContent("fontHeading", "max-h-96") {
					@createRadioGroup("fontHeading") {
						@createGroup() {
							// Inherit item; its label is the current body font
							// name (font-picker.tsx inheritFontLabel).
							@createRadioItem("inherit", "Inter", true, false)
						}
						@createPopupSeparator()
						@createFontGroups()
					}
				}
				@createPickerContent("font", "max-h-96") {
					@createRadioGroup("font") {
						@createFontGroups()
					}
				}
				@createPickerContent("iconLibrary", "") {
					@createRadioGroup("iconLibrary") {
						@createGroup() {
							for _, opt := range createIconLibraries {
								@createRadioItem(opt.Value, opt.Label, opt.Value == "lucide", opt.Disabled)
							}
						}
					}
				}
				@createPickerContent("radius", "") {
					@createRadioGroup("radius") {
						@createGroup() {
							@createRadioItem("default", "Default", true, false)
						}
						@createPopupSeparator()
						@createGroup() {
							for _, opt := range createOtherRadii {
								@createRadioItem(opt.Value, opt.Label, false, false)
							}
						}
					}
				}
				@createPickerContent("menuColor", "") {
					@createGroup() {
						@createPopupLabel("Color")
						@createRadioGroup("menuColorColor") {
							@createRadioItem("default", "Default", true, false)
							@createRadioItem("inverted", "Inverted", false, false)
						}
					}
					@createPopupSeparator()
					@createGroup() {
						@createPopupLabel("Appearance")
						@createRadioGroup("menuColorSurface") {
							@createRadioItem("solid", "Solid", true, false)
							@createRadioItem("translucent", "Translucent", false, false)
						}
					}
				}
				@createPickerContent("menuAccent", "") {
					@createRadioGroup("menuAccent") {
						@createGroup() {
							@createRadioItem("subtle", "Subtle", true, false)
							@createRadioItem("bold", "Bold", false, false)
						}
					}
				}
			</div>
		</main>
		@createOpenPresetDialog()
		@createOpenPresetDrawer()
		@createResetDialog()
		@createCodeDialog()
		@createActionMenu()
		@createWelcomeDialog()
	}
}

// createPreviewHost is the pendant of preview.tsx: the iframe with the
// bg-muted layer, plus the PreviewSwitcher (preview-switcher.tsx). create.js
// sets the iframe src (item + preset serialized) before the first load.
templ createPreviewHost() {
	<div class="relative flex flex-1 flex-col justify-center overflow-hidden rounded-2xl ring ring-foreground/10 md:ring-muted dark:ring-foreground/10">
		<div class="relative z-0 mx-auto flex w-full flex-1 flex-col overflow-hidden">
			<div class="absolute inset-0 bg-muted dark:bg-muted/30"></div>
			<iframe
				data-templ-create-preview
				class="z-10 size-full flex-1"
				title="Preview"
			></iframe>
		</div>
		<div class="dark absolute right-3 bottom-3 z-20 flex items-center gap-1 rounded-xl bg-card/90 p-1 shadow-xl backdrop-blur-xl">
			@createPreviewSwitchButton("01", "preview-02")
			@createPreviewSwitchButton("02", "preview")
		</div>
	</div>
}

templ createPreviewSwitchButton(label, item string) {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeSm,
		Class:   "h-7 min-w-8 cursor-pointer rounded-lg px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-accent data-[active=true]:text-accent-foreground",
		Attributes: templ.Attributes{
			"data-templ-create-preview-item": item,
			"data-active":                  utils.IfElse(item == "preview-02", "true", "false"),
		},
	}) {
		{ label }
	}
}

// createCustomizer is the pendant of customizer.tsx: the dark card with the
// MainMenu header, the picker rows in exact order and the two footers.
templ createCustomizer() {
	@card.Card(card.Props{
		Size:  card.SizeSm,
		Class: "dark top-24 right-12 isolate z-10 max-h-full min-h-0 w-full self-start rounded-2xl bg-card/90 backdrop-blur-xl md:w-(--customizer-width)",
	}) {
		@card.Header(card.HeaderProps{Class: "hidden items-center justify-between gap-2 border-b group-data-reversed/layout:flex-row-reverse md:flex"}) {
			@createMainMenuTrigger()
		}
		@card.Content(card.ContentProps{Class: "no-scrollbar min-h-0 flex-1 overflow-x-auto overflow-y-hidden md:overflow-y-auto"}) {
			@field.Group(field.GroupProps{Class: "flex-row gap-2.5 py-px **:data-[slot=field-separator]:-mx-4 **:data-[slot=field-separator]:w-auto md:flex-col md:gap-3.25"}) {
				@createPickerRow("style", "Style", "Nova", "") {
					<div data-templ-create-indicator="style" class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center select-none md:right-2.5">
						@templ.Raw(createNovaIcon)
					</div>
				}
				@field.Separator(field.SeparatorProps{Class: "hidden md:block"})
				@createPickerRow("baseColor", "Base Color", "Neutral", "") {
					<div data-templ-create-indicator="baseColor" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 rounded-full bg-(--color) select-none md:right-2.5"></div>
				}
				@createPickerRow("theme", "Theme", "Neutral", "") {
					<div data-templ-create-indicator="theme" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 rounded-full bg-(--color) select-none md:right-2.5"></div>
				}
				@createPickerRow("chartColor", "Chart Color", "Neutral", "") {
					<div data-templ-create-indicator="chartColor" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 rounded-full bg-(--color) select-none md:right-2.5"></div>
				}
				@field.Separator(field.SeparatorProps{Class: "hidden md:block"})
				@createPickerRow("fontHeading", "Heading", "Inter", "") {
					<div data-templ-create-indicator="fontHeading" class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5">Aa</div>
				}
				@createPickerRow("font", "Font", "Inter", "") {
					<div data-templ-create-indicator="font" class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5">Aa</div>
				}
				@field.Separator(field.SeparatorProps{Class: "hidden md:block"})
				@createPickerRow("iconLibrary", "Icon Library", "Lucide", "") {
					<div class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5 *:[svg]:text-foreground!">
						@templ.Raw(createLucideLogo)
					</div>
				}
				@createPickerRow("radius", "Radius", "Default", "") {
					<div class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 rotate-90 items-center justify-center text-base text-foreground select-none md:right-2.5">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="text-foreground">
							<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20v-5C4 8.925 8.925 4 15 4h5"></path>
						</svg>
					</div>
				}
				@field.Separator(field.SeparatorProps{Class: "hidden md:block"})
				@createPickerRow("menuColor", "Menu", "Default / Solid", "") {
					<div class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5">
						// Hugeicons Menu02Icon (menu-picker.tsx).
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
							<path d="M4 5L16 5"></path>
							<path d="M4 12L20 12"></path>
							<path d="M4 19L12 19"></path>
						</svg>
					</div>
				}
				@createPickerRow("menuAccent", "Menu Accent", "Subtle", "pr-3 md:pr-0") {
					<div class="pointer-events-none absolute top-1/2 right-4 flex size-4 -translate-y-1/2 items-center justify-center text-base text-foreground select-none md:right-2.5">
						// accent-picker.tsx trigger svg; create.js keeps
						// data-accent in sync with the state.
						<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 24 24" fill="none" class="size-4 text-foreground" data-templ-create-indicator="menuAccent">
							<path d="M19 12.1294L12.9388 18.207C11.1557 19.9949 10.2641 20.8889 9.16993 20.9877C8.98904 21.0041 8.80705 21.0041 8.62616 20.9877C7.53195 20.8889 6.64039 19.9949 4.85726 18.207L2.83687 16.1811C1.72104 15.0622 1.72104 13.2482 2.83687 12.1294M19 12.1294L10.9184 4.02587M19 12.1294H2.83687M10.9184 4.02587L2.83687 12.1294M10.9184 4.02587L8.89805 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-accent="subtle" class="fill-muted-foreground/30 data-[accent=bold]:fill-foreground"></path>
							<path d="M22 20C22 21.1046 21.1046 22 20 22C18.8954 22 18 21.1046 18 20C18 18.8954 20 17 20 17C20 17 22 18.8954 22 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-accent="subtle" class="fill-muted-foreground/30 data-[accent=bold]:fill-foreground"></path>
						</svg>
					</div>
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex min-w-0 gap-2 md:flex-col md:rounded-b-none md:**:[button,a]:w-full"}) {
			// CopyPreset: the label IS the command (copy-preset.tsx).
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   utils.CN(createFooterButtonClass, "min-w-0 flex-1 md:flex-none"),
				Attributes: templ.Attributes{
					"data-templ-create-copy": true,
					"title":                "--preset b0",
				},
			}) {
				<span class="block min-w-0 truncate" data-templ-create-copy-label>--preset b0</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      utils.CN(createFooterButtonClass, "max-w-20 min-w-0 flex-1 sm:max-w-none md:flex-none"),
				Attributes: templ.Attributes{"data-templ-create-open-preset": true},
			}) {
				<span class="hidden md:inline">Open Preset</span>
				<span class="md:hidden">Open</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      utils.CN(createFooterButtonClass, "max-w-20 min-w-0 flex-1 sm:max-w-none md:flex-none"),
				Attributes: templ.Attributes{"data-templ-create-shuffle": true},
			}) {
				<span class="w-full truncate text-center font-medium">Shuffle</span>
			}
		}
		@card.Footer(card.FooterProps{Class: "-mt-3 hidden min-w-0 gap-2 md:flex md:flex-col md:**:[button,a]:w-full"}) {
			@button.Button(button.Props{
				Attributes: dialog.TriggerFor("create-code-dialog"),
			}) {
				Get Code
			}
		}
	}
}

// createPickerRow is a picker trigger row (picker.tsx PickerTrigger inside the
// group/picker wrapper from the *-picker.tsx components); the children slot is
// the trailing indicator.
templ createPickerRow(param, label, value, wrapperClass string) {
	<div class={ utils.CN("group/picker relative", wrapperClass) }>
		<button
			type="button"
			data-templ-create-trigger={ param }
			data-slot="dropdown-menu-trigger"
			aria-haspopup="menu"
			aria-expanded="false"
			class={ createTriggerClass }
		>
			<div class="flex flex-col justify-start text-left">
				<div class="text-xs text-muted-foreground">{ label }</div>
				if param == "fontHeading" || param == "font" || param == "menuColor" {
					<div class="line-clamp-1 max-w-[80%] truncate text-sm font-medium text-foreground" data-templ-create-value={ param }>{ value }</div>
				} else {
					<div class="text-sm font-medium text-foreground" data-templ-create-value={ param }>{ value }</div>
				}
			</div>
			{ children... }
		</button>
		@createLockButton(param)
	</div>
}

// createLockButton is the lock-button.tsx pendant with the two Hugeicons
// (SquareLock01Icon / SquareUnlock01Icon) inline.
templ createLockButton(param string) {
	<button
		type="button"
		title="Lock"
		aria-label="Lock"
		data-templ-create-lock={ param }
		data-locked="false"
		class={ createLockClass }
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-foreground" data-templ-create-lock-icon="locked" hidden>
			<path d="M4.26781 18.8447C4.49269 20.515 5.87613 21.8235 7.55966 21.9009C8.97627 21.966 10.4153 22 12 22C13.5847 22 15.0237 21.966 16.4403 21.9009C18.1239 21.8235 19.5073 20.515 19.7322 18.8447C19.879 17.7547 20 16.6376 20 15.5C20 14.3624 19.879 13.2453 19.7322 12.1553C19.5073 10.485 18.1239 9.17649 16.4403 9.09909C15.0237 9.03397 13.5847 9 12 9C10.4153 9 8.97627 9.03397 7.55966 9.09909C5.87613 9.17649 4.49269 10.485 4.26781 12.1553C4.12104 13.2453 4 14.3624 4 15.5C4 16.6376 4.12104 17.7547 4.26781 18.8447Z"></path>
			<path d="M7.5 9V6.5C7.5 4.01472 9.51472 2 12 2C14.4853 2 16.5 4.01472 16.5 6.5V9" stroke-linecap="round" stroke-linejoin="round"></path>
			<path d="M12.125 15.5H12M12.25 15.5C12.25 15.6381 12.1381 15.75 12 15.75C11.8619 15.75 11.75 15.6381 11.75 15.5C11.75 15.3619 11.8619 15.25 12 15.25C12.1381 15.25 12.25 15.3619 12.25 15.5Z" stroke-linecap="round"></path>
		</svg>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5 text-foreground" data-templ-create-lock-icon="unlocked">
			<path d="M4.26781 18.8447C4.49269 20.515 5.87613 21.8235 7.55966 21.9009C8.97627 21.966 10.4153 22 12 22C13.5847 22 15.0237 21.966 16.4403 21.9009C18.1239 21.8235 19.5073 20.515 19.7322 18.8447C19.879 17.7547 20 16.6376 20 15.5C20 14.3624 19.879 13.2453 19.7322 12.1553C19.5073 10.485 18.1239 9.17649 16.4403 9.09909C15.0237 9.03397 13.5847 9 12 9C10.4153 9 8.97627 9.03397 7.55965 9.09909C5.87613 9.17649 4.49269 10.485 4.26781 12.1553C4.12104 13.2453 4 14.3624 4 15.5C4 16.6376 4.12104 17.7547 4.26781 18.8447Z"></path>
			<path d="M7.5 9V6.5C7.5 4.01472 9.51472 2 12 2C13.9593 2 15.5 3.5 16 5" stroke-linecap="round" stroke-linejoin="round"></path>
			<path d="M12.125 15.5H12M12.25 15.5C12.25 15.6381 12.1381 15.75 12 15.75C11.8619 15.75 11.75 15.6381 11.75 15.5C11.75 15.3619 11.8619 15.25 12 15.25C12.1381 15.25 12.25 15.3619 12.25 15.5Z" stroke-linecap="round"></path>
		</svg>
	</button>
}

// createMainMenuTrigger is the MainMenu trigger (main-menu.tsx) with the
// Hugeicons Menu09Icon inline.
templ createMainMenuTrigger() {
	<button
		type="button"
		data-templ-create-trigger="mainmenu"
		data-slot="dropdown-menu-trigger"
		aria-haspopup="menu"
		aria-expanded="false"
		class={ utils.CN(createTriggerClass, "flex items-center justify-between gap-2 rounded-lg px-1.75 ring-1 ring-foreground/10 focus-visible:ring-1") }
	>
		<span class="font-medium">Menu</span>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
			<path d="M4 8.5L20 8.5"></path>
			<path d="M4 15.5L20 15.5"></path>
		</svg>
	</button>
}

// createMainMenuContent is the MainMenu popup (main-menu.tsx): the items in
// exact order, shortcuts filled per platform by create.js.
templ createMainMenuContent() {
	<div
		data-templ-create-content="mainmenu"
		data-slot="dropdown-menu-content"
		role="menu"
		hidden
		class={ createContentClass }
	>
		@createGroup() {
			@createMenuActionItem("navigate", "Navigate...") {
				<span data-slot="dropdown-menu-shortcut" data-templ-create-shortcut="navigate" class={ createShortcutClass }>⌘P</span>
			}
			@createMenuActionItem("open-preset", "Open Preset...") {
				<span data-slot="dropdown-menu-shortcut" class={ createShortcutClass }>O</span>
			}
			@createMenuActionItem("shuffle", "Shuffle") {
				<span data-slot="dropdown-menu-shortcut" class={ createShortcutClass }>R</span>
			}
			@createMenuActionItem("toggle-theme", "Light/Dark") {
				<span data-slot="dropdown-menu-shortcut" class={ createShortcutClass }>D</span>
			}
		}
		@createPopupSeparator()
		@createGroup() {
			@createMenuActionItem("undo", "Undo") {
				<span data-slot="dropdown-menu-shortcut" data-templ-create-shortcut="undo" class={ createShortcutClass }>⌘Z</span>
			}
			@createMenuActionItem("redo", "Redo") {
				<span data-slot="dropdown-menu-shortcut" data-templ-create-shortcut="redo" class={ createShortcutClass }>⇧⌘Z</span>
			}
			@createPopupSeparator()
			@createMenuActionItem("reset", "Reset") {
				<span data-slot="dropdown-menu-shortcut" class={ createShortcutClass }>⇧R</span>
			}
		}
	</div>
}

templ createMenuActionItem(action, label string) {
	<div
		role="menuitem"
		tabindex="-1"
		data-slot="dropdown-menu-item"
		data-templ-create-action={ action }
		class={ createMenuItemClass }
	>
		{ label }
		{ children... }
	</div>
}

// createPickerContent is a PickerContent popup for one picker, portaled to
// shell level and positioned by create.js.
templ createPickerContent(param, extraClass string) {
	<div
		data-templ-create-content={ param }
		data-slot="dropdown-menu-content"
		role="menu"
		hidden
		class={ utils.CN(createContentClass, extraClass) }
	>
		{ children... }
	</div>
}

templ createRadioGroup(name string) {
	<div data-slot="dropdown-menu-radio-group" role="group" data-templ-create-radiogroup={ name }>
		{ children... }
	</div>
}

templ createGroup() {
	<div data-slot="dropdown-menu-group" role="group">
		{ children... }
	</div>
}

templ createPopupLabel(text string) {
	<div data-slot="dropdown-menu-label" class={ createLabelClass }>{ text }</div>
}

templ createPopupSeparator() {
	<div data-slot="dropdown-menu-separator" role="separator" class={ createSeparatorClass }></div>
}

// createRadioItem is a PickerRadioItem. create.js drives data-checked, the
// indicator visibility and data-disabled; item markup rebuilt at runtime (the
// theme and chart color lists) mirrors this exactly.
templ createRadioItem(value, label string, checked, disabled bool) {
	<div
		role="menuitemradio"
		tabindex="-1"
		data-slot="dropdown-menu-radio-item"
		data-templ-create-item
		data-value={ value }
		aria-checked={ utils.IfElse(checked, "true", "false") }
		data-checked={ utils.IfElse(checked, "true", "false") }
		if disabled {
			data-disabled=""
			aria-disabled="true"
		}
		class={ createRadioItemClass }
	>
		<span class="pointer-events-none absolute right-2 flex items-center justify-center" data-slot="dropdown-menu-radio-item-indicator" hidden?={ !checked }>
			@icon.Check(icon.Props{Class: "size-4 pointer-coarse:size-5"})
		</span>
		{ label }
	</div>
}

// createThemeItems renders the theme/chart color list for a base color:
// base-colored themes first, then the colored themes (theme-picker.tsx).
templ createThemeItems(baseColor string) {
	@createGroup() {
		for _, opt := range createBaseColors {
			if opt.Value == baseColor {
				@createRadioItem(opt.Value, opt.Label, true, false)
			}
		}
	}
	@createPopupSeparator()
	@createGroup() {
		for _, opt := range createColorThemes {
			@createRadioItem(opt.Value, opt.Label, false, false)
		}
	}
}

// createFontGroups renders the FONTS grouped by type (font-picker.tsx
// groupedFonts): Sans, Mono, Serif.
templ createFontGroups() {
	@createGroup() {
		@createPopupLabel("Sans")
		for _, opt := range createFontsSans {
			@createRadioItem(opt.Value, opt.Label, false, false)
		}
	}
	@createGroup() {
		@createPopupLabel("Mono")
		for _, opt := range createFontsMono {
			@createRadioItem(opt.Value, opt.Label, false, false)
		}
	}
	@createGroup() {
		@createPopupLabel("Serif")
		for _, opt := range createFontsSerif {
			@createRadioItem(opt.Value, opt.Label, false, false)
		}
	}
}

// createOpenPresetDialog is the desktop Open Preset dialog (open-preset.tsx).
templ createOpenPresetDialog() {
	@dialog.Dialog(dialog.Props{ID: "create-open-preset-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "dark"}) {
			<form data-templ-create-preset-form>
				@dialog.Header() {
					@dialog.Title() {
						Open Preset
					}
					@dialog.Description() {
						Paste a preset code to load a saved configuration.
					}
				}
				<div class="py-4">
					@createPresetField("create-preset-code")
				</div>
				@dialog.Footer() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Type:       button.TypeButton,
						Attributes: dialog.CloseFor("create-open-preset-dialog"),
					}) {
						Cancel
					}
					@button.Button(button.Props{
						Type:       button.TypeSubmit,
						Disabled:   true,
						Attributes: templ.Attributes{"data-templ-create-preset-submit": true},
					}) {
						Open
					}
				}
			</form>
		}
	}
}

// createOpenPresetDrawer is the mobile Open Preset drawer (open-preset.tsx).
templ createOpenPresetDrawer() {
	@drawer.Drawer(drawer.Props{ID: "create-open-preset-drawer"}) {
		@drawer.Content(drawer.ContentProps{Class: "dark rounded-t-2xl!"}) {
			@drawer.Header() {
				@drawer.Title(drawer.TitleProps{Class: "text-xl"}) {
					Open Preset
				}
				@drawer.Description() {
					Paste a preset code to load a saved configuration.
				}
			}
			<form data-templ-create-preset-form>
				<div class="px-4 py-2">
					@createPresetField("create-preset-code-mobile")
				</div>
				@drawer.Footer() {
					@button.Button(button.Props{
						Type:       button.TypeSubmit,
						Class:      "h-10",
						Disabled:   true,
						Attributes: templ.Attributes{"data-templ-create-preset-submit": true},
					}) {
						Open
					}
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Type:       button.TypeButton,
						Class:      "h-10",
						Attributes: drawer.CloseFor("create-open-preset-drawer"),
					}) {
						Cancel
					}
				}
			</form>
		}
	}
}

templ createPresetField(id string) {
	@field.Field(field.Props{Attributes: templ.Attributes{"data-templ-create-preset-field": true}}) {
		@field.Label(field.LabelProps{For: id, Class: "sr-only"}) {
			Preset code
		}
		@field.Content() {
			@input.Input(input.Props{
				ID:          id,
				Placeholder: "b2D0wqNxT or --preset b2D0wqNxT",
				Class:       "h-10 md:h-8",
				Attributes: templ.Attributes{
					"data-templ-create-preset-input": true,
					"autocapitalize":               "none",
					"autocorrect":                  "off",
					"spellcheck":                   "false",
				},
			})
		}
	}
}

// createResetDialog is the reset confirmation (reset-button.tsx ResetDialog).
templ createResetDialog() {
	@alertdialog.AlertDialog(alertdialog.Props{ID: "create-reset-dialog"}) {
		@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
			@alertdialog.Header() {
				@alertdialog.Title() {
					Reset to defaults?
				}
				@alertdialog.Description() {
					This will reset all customization options to their default values.
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel
				}
				@alertdialog.Action(alertdialog.ActionProps{Attributes: templ.Attributes{"data-templ-create-reset-confirm": true}}) {
					Reset
				}
			}
		}
	}
}

// APPLY_MODES verbatim from project-form.tsx: the radio driving the
// `shadcn-templ apply --preset <code> [--only theme|font]` command.
var createApplyModes = []struct{ Value, Title, Description string }{
	{"full", "Full preset", "Everything from the preset, including components, theme, and fonts."},
	{"theme", "Theme only", "Theme tokens only, like colors, radii, and shadows. Components stay as they are."},
	{"font", "Fonts only", "Only preset fonts for body and headings. Components stay as they are."},
}

// createCodeDialog is the Get Code dialog, the pendant of project-form.tsx:
// the "New Project" | "Existing Project" | "Theme" ToggleGroup header and one
// panel per tab, driven by create.js (activeTab, applyMode, copiedTarget).
//
// Deliberate omissions against the tsx, all npm-only: the framework template
// grid, the Base component-library grid and the pointer/monorepo/RTL switches
// (shadcn-templ init scaffolds no frameworks and takes no such flags), and the
// package manager Tabs (Go has exactly one toolchain), so each command
// renders in a single box with a static "shadcn-templ" label where the pm TabsList
// sits. The commands are the real CLI: `shadcn-templ init --preset <code>` and
// `shadcn-templ apply --preset <code> [--only theme|font]`.
templ createCodeDialog() {
	@dialog.Dialog(dialog.Props{ID: "create-code-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "dark top-[64px] no-scrollbar flex max-h-[calc(100svh-2rem)] translate-y-0 flex-col rounded-2xl p-0 shadow-xl **:data-[slot=dialog-close]:top-4.5 **:data-[slot=dialog-close]:right-4 **:data-[slot=field-separator]:h-2 sm:max-w-md"}) {
			<div class="flex min-w-0 flex-1 flex-col gap-0 overflow-hidden rounded-2xl">
				@dialog.Header(dialog.HeaderProps{Class: "border-b px-6 py-5"}) {
					// The tab switcher is controlled like project-form.tsx: create.js
					// owns activeTab and applies the next group value from the change event.
					@togglegroup.ToggleGroup(togglegroup.Props{
						Class: "**:data-[slot=toggle-group-item]:data-pressed:bg-neutral-700/70",
						Value: []string{"new-project"},
						Attributes: templ.Attributes{
							"aria-label":           "Project type",
							"data-templ-create-tabs": true,
						},
					}) {
						@togglegroup.Item(togglegroup.ItemProps{Value: "new-project"}) {
							New Project
						}
						@togglegroup.Item(togglegroup.ItemProps{Value: "existing-project"}) {
							Existing Project
						}
						@togglegroup.Item(togglegroup.ItemProps{Value: "theme"}) {
							Theme
						}
					}
				}
				<div class="no-scrollbar overflow-y-auto" data-templ-create-tab="new-project">
					@field.Group(field.GroupProps{Class: "px-6 py-4"}) {
						@field.Set(field.SetProps{Class: "gap-3"}) {
							@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
								New Project
							}
							// The one-line CLI install hint from installation.md
							// (there are no framework templates to pick).
							@field.Description() {
								Scaffolds a new templ project with this preset. Get the CLI with <code class="font-mono">go install github.com/axadrn/shadcn-templ/v2/cmd/shadcn-templ@latest</code>.
							}
						}
					}
					@dialog.Footer(dialog.FooterProps{Class: "m-0 min-w-0 p-6"}) {
						<div class="flex w-full min-w-0 flex-col gap-3">
							@createCommandBox("command", "init", "shadcn-templ init -t templ --preset b0")
							@createCopyButton("command", "Copy Command")
						</div>
					}
				</div>
				<div class="no-scrollbar overflow-y-auto" data-templ-create-tab="existing-project" hidden>
					@field.Group(field.GroupProps{Class: "px-6 py-4"}) {
						@field.Set(field.SetProps{Class: "gap-3"}) {
							@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
								Apply Preset
							}
							@field.Description() {
								Pick which parts of the preset to apply.
							}
							@createApplyModeGrid()
						}
					}
					@dialog.Footer(dialog.FooterProps{Class: "m-0 min-w-0 p-6"}) {
						<div class="flex w-full min-w-0 flex-col gap-3">
							@createCommandBox("apply", "apply", "shadcn-templ apply --preset b0")
							@createCopyButton("apply", "Copy Command")
						</div>
					}
				</div>
				<div class="no-scrollbar overflow-y-auto" data-templ-create-tab="theme" hidden>
					@field.Group(field.GroupProps{Class: "min-w-0 px-6 py-4"}) {
						@field.Set(field.SetProps{Class: "min-w-0 gap-3"}) {
							@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
								Theme Tokens
							}
							@field.Description() {
								Copy the CSS variables for this preset.
							}
							<div class="w-full min-w-0 overflow-hidden rounded-xl border-0 ring-1 ring-border">
								<div class="flex items-center gap-2 py-1 pr-1.5 pl-3">
									<div class="min-w-0 truncate font-mono text-sm text-muted-foreground">globals.css</div>
									@createCopyIconButton("theme", "Copy theme")
								</div>
								<div class="relative no-scrollbar max-h-[45svh] overflow-auto border-t bg-popover p-3">
									<pre class="min-w-max font-mono leading-normal whitespace-pre"><code data-templ-create-css></code></pre>
								</div>
							</div>
						}
					}
					@dialog.Footer(dialog.FooterProps{Class: "m-0 min-w-0 p-6"}) {
						@createCopyButton("theme", "Copy Theme")
					}
				</div>
			</div>
		}
	}
}

// createApplyModeGrid is the ApplyModeGrid pendant: the APPLY_MODES radio.
// The native change event of the hidden radio inputs drives applyMode in
// create.js.
templ createApplyModeGrid() {
	@radiogroup.RadioGroup(radiogroup.Props{
		Name:         "create-apply-mode",
		DefaultValue: "full",
		Attributes:   templ.Attributes{"aria-label": "Apply"},
	}) {
		for _, mode := range createApplyModes {
			@field.Label(field.LabelProps{For: "create-apply-" + mode.Value}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@radiogroup.Item(radiogroup.ItemProps{ID: "create-apply-" + mode.Value, Value: mode.Value})
					@field.Content() {
						@field.Title() {
							{ mode.Title }
						}
						@field.Description() {
							{ mode.Description }
						}
					}
				}
			}
		}
	}
}

// createCommandBox is the command Tabs pendant reduced to the single Go
// runner: the reference header row keeps its layout (pm TabsList left, icon
// copy button right) with a static "shadcn-templ" label in the TabsList slot, the
// command sits in the bg-popover content row. create.js keeps the command
// text live with the current preset code (data-templ-create-command).
templ createCommandBox(target, command, initial string) {
	<div class="w-full min-w-0 overflow-hidden rounded-xl border-0 ring-1 ring-border">
		<div class="flex items-center gap-2 py-1 pr-1.5 pl-3">
			<div class="min-w-0 truncate font-mono text-sm text-muted-foreground">shadcn-templ</div>
			@createCopyIconButton(target, "Copy command")
		</div>
		<div class="relative overflow-hidden border-t bg-popover p-3">
			<div class="no-scrollbar overflow-x-auto">
				<code class="font-mono text-sm whitespace-nowrap" data-templ-create-command={ command }>{ initial }</code>
			</div>
		</div>
	</div>
}

// createCopyIconButton is the icon copy button of a command/theme box; the
// Copy icon flashes to Check while copiedTarget matches (project-form.tsx
// Copy01Icon/Tick02Icon swap).
templ createCopyIconButton(target, srLabel string) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeIconSm,
		Class:      "ml-auto",
		Attributes: templ.Attributes{"data-templ-create-copy-target": target},
	}) {
		<span data-templ-create-copy-icon="copy">
			@icon.Copy()
		</span>
		<span data-templ-create-copy-icon="check" hidden>
			@icon.Check()
		</span>
		<span class="sr-only">{ srLabel }</span>
	}
}

// createCopyButton is the full-width footer copy button; its label flashes to
// "Copied" while copiedTarget matches.
templ createCopyButton(target, label string) {
	@button.Button(button.Props{
		Class: "h-9 w-full",
		Attributes: templ.Attributes{
			"data-templ-create-copy-target": target,
			"data-templ-create-copy-label":  label,
		},
	}) {
		{ label }
	}
}

// createRegistryNavItems is the curated registry:example list from
// getAllItems: one kitchen-sink page per component, names and titles
// verbatim from registry/bases/base/examples/_registry.ts, alphabetical by
// title (sortRegistryGroups). Docs demos are a separate namespace and never
// appear here, exactly like shadcn's ExamplesIndex vs registry items.
func createRegistryNavItems() []createOption {
	return []createOption{
		{Value: "accordion-example", Label: "Accordion"},
		{Value: "alert-example", Label: "Alert"},
