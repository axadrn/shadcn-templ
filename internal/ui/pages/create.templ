// Search keywords appended to the command value, from SEARCH_KEYWORDS in
// use-action-menu.ts: registry:block has an explicit entry, registry:example
// falls back to type.replace(":", " ").
const (
	createBlockKeywords   = "block blocks component components"
	createExampleKeywords = "registry example"
)

// createActionMenu is the ⌘P navigator (action-menu.tsx): a CommandDialog
// listing every registry item. Like shadcn, all groups render flat inside a
// single CommandGroup: blocks first (sortRegistryGroups), then the
// "Components" group with the example demos. create.js keeps data-checked on
// the active item and sets ?item= on select (command-select listener).
templ createActionMenu() {
	@command.Dialog(command.DialogProps{ID: "create-action-menu", Class: "animate-none!"}) {
		@command.Command() {
			@command.Input(command.InputProps{Placeholder: "Search"})
			@command.List() {
				@command.Empty() {
					No items found.
				}
				@command.Group() {
					// getAllItems filters names ending in digits, so preview-02
					// (the default item) is not listed, exactly like shadcn.
					@createActionMenuItem("preview", "Preview", createBlockKeywords, false)
					for _, item := range createRegistryNavItems() {
						@createActionMenuItem(item.Value, item.Label, createExampleKeywords, false)
					}
				}
			}
		}
	}
}

templ createActionMenuItem(name, title, keywords string, checked bool) {
	@command.Item(command.ItemProps{
		Value: title + " " + keywords,
		Class: "px-2",
		Attributes: templ.Attributes{
			"data-templ-create-registry-item": name,
			"data-checked":                  utils.IfElse(checked, "true", "false"),
		},
	}) {
		{ title }
	}
}

// createWelcomeDialog is the first-visit dialog (welcome-dialog.tsx), shown by
// create.js when the localStorage flag is missing.
templ createWelcomeDialog() {
	@dialog.Dialog(dialog.Props{ID: "create-welcome-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			HideCloseButton: true,
			Class:           "dialog-ring max-w-92 min-w-0 gap-0 overflow-hidden rounded-xl p-0 sm:max-w-sm dark:bg-neutral-900",
		}) {
			<div class="flex aspect-[2/1.2] w-full items-center justify-center rounded-t-xl bg-neutral-950 text-center text-neutral-100 sm:aspect-2/1">
				<div class="font-mono text-2xl font-bold">
					@icon.ToggleLeft(icon.Props{Class: "size-12"})
				</div>
			</div>
			@dialog.Header(dialog.HeaderProps{Class: "gap-1 p-4"}) {
				@dialog.Title(dialog.TitleProps{Class: "text-left text-base"}) {
					Build your own shadcn-templ
				}
				@dialog.Description(dialog.DescriptionProps{Class: "text-left leading-relaxed text-foreground"}) {
					Customize everything from the ground up. Pick your style, font, color scheme, and more.
				}
				@dialog.Description(dialog.DescriptionProps{Class: "mt-2 text-left leading-relaxed font-medium text-foreground"}) {
					Built for Go with templ.
				}
			}
			@dialog.Footer(dialog.FooterProps{Class: "m-0"}) {
				@button.Button(button.Props{
					Class:      "w-full",
					Attributes: dialog.CloseFor("create-welcome-dialog"),
				}) {
					Get Started
				}
			}
		}
	}
}
