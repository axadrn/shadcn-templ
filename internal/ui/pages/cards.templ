var cardsSkeletonPowerBars = []int{30, 70, 80, 60, 90, 75, 100, 85}

templ SkeletonPowerUsage() {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "gap-2"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-32 rounded-md"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24 rounded-md"})
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4"}) {
			<div class="flex h-[140px] w-full items-end gap-2">
				for _, height := range cardsSkeletonPowerBars {
					<div class="flex h-full flex-1 flex-col justify-end gap-1.5">
						@skeleton.Skeleton(skeleton.Props{
							Class:      "w-full rounded-t rounded-b-none",
							Attributes: templ.Attributes{"style": "height: " + strconv.Itoa(height) + "%"},
						})
						@skeleton.Skeleton(skeleton.Props{Class: "mx-auto h-3 w-5 rounded-md"})
					</div>
				}
			</div>
			@skeleton.Skeleton(skeleton.Props{Class: "h-px w-full rounded-none"})
			<div class="grid grid-cols-2 gap-4">
				<div class="flex flex-col gap-1.5">
					@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-28 rounded-md"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-20 rounded-md"})
				</div>
				<div class="flex flex-col gap-1.5">
					@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-20 rounded-md"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-24 rounded-md"})
				</div>
			</div>
		}
		@card.Footer(card.FooterProps{Class: "flex-col items-start gap-2"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-24 rounded-md"})
			<div class="flex w-full items-center gap-2">
				@skeleton.Skeleton(skeleton.Props{Class: "h-2 flex-1 rounded-full"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-10 rounded-md"})
			</div>
		}
	}
}
