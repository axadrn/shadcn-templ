// Ports of the homepage card wall, app/(app)/(root)/cards/*.tsx. These are
// the static homepage variants of the cards, not the interactive block
// variants in create_preview_cards.templ (shadcn keeps two copies too): the
// homepage ones drop recharts, react-qr-code and the "use client" state and
// draw their charts as plain divs. Where a homepage card is literally the
// block card, the block templ is reused instead of duplicated
// (cardNewMilestone, cardEmptyDistributeTrack, cardTransferFunds).

// pct is the Go pendant of the `${(value / max) * 100}%` inline heights the
// source computes in JSX.
func cardsBarHeight(value, max float64) string {
	return "height: " + strconv.FormatFloat(value/max*100, 'f', -1, 64) + "%"
}

// ---------------------------------------------------------------------------
// index.tsx
// ---------------------------------------------------------------------------

// CardsDemo is the wall itself. theme-neutral is verbatim from the reference
// (it supplies the greyscale --chart-* values). The reference's style comes
// from its imports — every card pulls @/styles/base-rhea/ui/*, the generated
// rhea build — so its markup carries flat rhea utilities and no style class;
// ours gets there through the inliner at the call site (see IndexPage).
templ CardsDemo() {
	<div
		data-slot="demo"
		class="theme-neutral relative flex w-full max-w-none flex-col gap-(--gap) overflow-hidden bg-muted p-12 pb-0! [--gap:--spacing(8)] 3xl:[--gap:--spacing(8)] min-[1900px]:p-12 min-[1900px]:[--gap:--spacing(10)]! lg:p-6 lg:[--gap:--spacing(6)] dark:bg-background"
	>
		@cardsSkeletonRails()
		<div class="relative z-10 mx-auto grid gap-(--gap) **:data-[slot=card]:w-full min-[1400px]:grid-cols-4! min-[1900px]:grid-cols-5! md:max-w-3xl md:grid-cols-2 lg:max-w-none lg:grid-cols-3 xl:max-w-[1600px] 2xl:max-w-[1900px]">
			<div class="flex flex-col items-start gap-(--gap)">
				@UIElements()
				@SidebarNav()
				@SavingsTargets()
			</div>
			<div class="hidden flex-col gap-(--gap) lg:flex">
				@ContributionHistory()
				@ClaimableBalance()
				@DividendIncome()
			</div>
			<div class="hidden flex-col gap-(--gap) min-[1400px]:flex">
				// Literally the block card, so the existing port is reused.
				@cardNewMilestone()
				@PayoutThreshold()
				@AccountAccess()
			</div>
			<div class="hidden flex-col gap-(--gap) md:flex">
				@QrConnect()
				// The reference renders MessageScrollerDemo here and keeps
				// <TransferFunds /> commented out right above it. shadcn-templ has
				// no message-scroller component, so this slot keeps the card
				// the reference falls back to and that its own skeleton wall
				// still shows here: TransferFunds.
				@cardTransferFunds()
				@Payments()
			</div>
			<div class="hidden flex-col gap-(--gap) min-[1900px]:flex">
				// Literally the block card, so the existing port is reused.
				@cardEmptyDistributeTrack()
				@AnalyticsCard()
				@NotificationSettings()
				@PowerUsage()
			</div>
		</div>
		<div class="absolute inset-x-0 top-0 z-1 h-120 bg-linear-to-b from-background via-muted to-transparent dark:hidden"></div>
		<div class="absolute inset-x-0 bottom-0 z-20 h-48 bg-linear-to-t from-background via-muted/80 to-transparent lg:h-80 xl:h-64 dark:via-background/80"></div>
	</div>
}

// cardsSkeletonRails is CardsSkeletonRails: the decorative skeleton walls
// left and right of the grid, only visible from 2200px up.
templ cardsSkeletonRails() {
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-x-0 top-12 z-10 hidden min-[2200px]:block [&_[data-slot=skeleton]:nth-child(even)]:hidden"
	>
		<div class="absolute top-0 left-[calc(50%-950px-var(--rail-width)-var(--gap))] grid w-(--rail-width) grid-cols-[repeat(2,var(--rail-column))] gap-(--gap) opacity-50 [--rail-column:20rem] [--rail-width:calc(var(--rail-column)*2+var(--gap))]">
			<div class="flex flex-col gap-(--gap)">
				@SkeletonContributionHistory()
				@SkeletonClaimableBalance()
				@SkeletonDividendIncome()
				@SkeletonPayoutThreshold()
			</div>
			<div class="flex flex-col gap-(--gap)">
				@SkeletonUIElements()
				@SkeletonSavingsTargets()
				@SkeletonNewMilestone()
				@SkeletonPayoutThreshold()
				@SkeletonAccountAccess()
			</div>
		</div>
		<div class="absolute top-0 right-[calc(50%-950px-var(--rail-width)-var(--gap))] grid w-(--rail-width) grid-cols-[repeat(2,var(--rail-column))] gap-(--gap) opacity-50 [--rail-column:20rem] [--rail-width:calc(var(--rail-column)*2+var(--gap))]">
			<div class="flex flex-col gap-(--gap)">
				@SkeletonNewMilestone()
				@SkeletonPayoutThreshold()
				@SkeletonAccountAccess()
				@SkeletonQrConnect()
				@SkeletonTransferFunds()
				@SkeletonPayments()
				@SkeletonEmptyDistributeTrack()
			</div>
			<div class="flex flex-col gap-(--gap)">
				@SkeletonQrConnect()
				@SkeletonTransferFunds()
				@SkeletonPayments()
				@SkeletonEmptyDistributeTrack()
				@SkeletonAnalyticsCard()
				@SkeletonNotificationSettings()
				@SkeletonPowerUsage()
			</div>
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// ui-elements.tsx
// ---------------------------------------------------------------------------
templ UIElements() {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
			<div class="flex gap-2">
				@button.Button() {
					Button{ " " }
					@icon.ArrowRight(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
				}
				@button.Button(button.Props{Variant: button.VariantSecondary}) {
					Secondary
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Outline
				}
			</div>
			@field.Group() {
				@field.Field() {
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{Placeholder: "Name"})
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@inputgroup.Text() {
								@icon.Search()
							}
						}
					}
				}
				@field.Field(field.Props{Class: "flex-1"}) {
					@textarea.Textarea(textarea.Props{Placeholder: "Message", Class: "resize-none"})
				}
			}
			<div class="flex items-center gap-2">
				<div class="flex gap-2">
					@badge.Badge() {
						Badge
					}
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						Secondary
					}
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "hidden 4xl:flex"}) {
						Outline
					}
				</div>
				@radiogroup.RadioGroup(radiogroup.Props{
					Name:         "cards-ui-elements-fruit",
					DefaultValue: "apple",
					Class:        "ml-auto flex w-fit gap-3",
					Attributes:   templ.Attributes{"aria-label": "Fruit preference"},
				}) {
					@radiogroup.Item(radiogroup.ItemProps{Value: "apple", Attributes: templ.Attributes{"aria-label": "Apple"}})
					@radiogroup.Item(radiogroup.ItemProps{Value: "banana", Attributes: templ.Attributes{"aria-label": "Banana"}})
				}
				<div class="flex gap-3">
					@checkbox.Checkbox(checkbox.Props{DefaultChecked: true, Attributes: templ.Attributes{"aria-label": "Enable email alerts"}})
					@checkbox.Checkbox(checkbox.Props{Class: "hidden 4xl:flex", Attributes: templ.Attributes{"aria-label": "Enable push alerts"}})
				</div>
				@switchcomp.Switch(switchcomp.Props{DefaultChecked: true, Class: "flex 4xl:hidden", Attributes: templ.Attributes{"aria-label": "Enable compact notifications"}})
			</div>
			<div class="flex items-center gap-4">
				@alertdialog.AlertDialog() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: alertdialog.Trigger(ctx)}) {
						<span class="hidden md:flex style-sera:md:hidden">Alert Dialog</span>
						<span class="flex md:hidden style-sera:md:flex">Dialog</span>
					}
					@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm, Class: "theme-neutral"}) {
						@alertdialog.Header() {
							@alertdialog.Title() {
								Allow accessory to connect?
							}
							@alertdialog.Description() {
								Do you want to allow the USB accessory to connect to this device and your data?
							}
						}
						@alertdialog.Footer() {
							@alertdialog.Cancel() {
								Don't allow
							}
							@alertdialog.Action() {
								Allow
							}
						}
					}
				}
				@buttongroup.ButtonGroup(buttongroup.Props{Class: "ml-auto"}) {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						<span class="style-sera:hidden">Button Group</span>
						<span class="hidden style-sera:block">Group</span>
					}
					@dropdownmenu.DropdownMenu() {
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeIcon,
							Attributes: utils.MergeAttributes(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": "Open quick actions"}),
						}) {
							@icon.ChevronUp()
						}
						@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideTop, Class: "w-40"}) {
							@dropdownmenu.Group() {
								@dropdownmenu.Label() {
									Quick Actions
								}
								@dropdownmenu.Item() {
									Mute Conversation
								}
								@dropdownmenu.Item() {
									Mark as Read
								}
								@dropdownmenu.Item() {
									Block User
								}
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Group() {
								@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
									Delete Conversation
								}
							}
						}
					}
				}
				@switchcomp.Switch(switchcomp.Props{DefaultChecked: true, Class: "hidden 4xl:flex", Attributes: templ.Attributes{"aria-label": "Enable advanced setting"}})
			</div>
		}
	}
}

// ---------------------------------------------------------------------------
// sidebar-nav.tsx
// ---------------------------------------------------------------------------

// The hugeicons of the source mapped onto their lucide pendants, like the
// rest of our ports.
var cardsSidebarNavSections = []struct {
	label   string
	class   string
	entries []sidebarNavEntry
}{
	{
		label: "Overview",
		class: "xl:col-start-1 xl:row-start-2",
		entries: []sidebarNavEntry{
			{icon: icon.ChartColumn, label: "Analytics", active: true},
			{icon: icon.ArrowLeftRight, label: "Transactions"},
			{icon: icon.TrendingUp, label: "Investments"},
			{icon: icon.Building2, label: "Accounts"},
			{icon: icon.ChartPie, label: "Spending"},
		},
	},
	{
		label: "Planning",
		class: "xl:col-start-1 xl:row-start-1",
		entries: []sidebarNavEntry{
			{icon: icon.FileText, label: "Documents"},
			{icon: icon.Wallet, label: "Budget"},
			{icon: icon.FileChartColumn, label: "Reports"},
			{icon: icon.Target, label: "Goals"},
			{icon: icon.Calendar, label: "Calendar"},
		},
	},
	{
		label: "Support",
		class: "flex xl:col-start-2 xl:row-start-1",
		entries: []sidebarNavEntry{
			{icon: icon.CircleQuestionMark, label: "Help Center"},
			{icon: icon.BookOpen, label: "Docs"},
			{icon: icon.MessageSquare, label: "Contact Us"},
			{icon: icon.Activity, label: "Status"},
			{icon: icon.Globe, label: "Community"},
		},
	},
	{
		label: "Account",
		class: "flex xl:col-start-2 xl:row-start-2",
		entries: []sidebarNavEntry{
			{icon: icon.User, label: "Profile"},
			{icon: icon.CreditCard, label: "Billing", active: true},
			{icon: icon.Bell, label: "Notifications"},
			{icon: icon.Shield, label: "Security"},
			{icon: icon.Paintbrush, label: "Appearance"},
		},
	},
}

templ SidebarNav() {
	<div class="grid w-full grid-cols-2 gap-4 xl:gap-6">
		for _, section := range cardsSidebarNavSections {
			@sidebarSection(section.label, section.class, section.entries)
		}
	</div>
}

templ sidebarSection(label, class string, entries []sidebarNavEntry) {
	@card.Card(card.Props{Class: "w-full overflow-hidden rounded-3xl py-0 " + class}) {
		@sidebar.Provider(sidebar.ProviderProps{Class: "min-h-0"}) {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleNone, Class: "w-full bg-transparent"}) {
				@sidebar.Content(sidebar.ContentProps{Class: "gap-0 overflow-hidden"}) {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							{ label }
						}
						@sidebar.GroupContent() {
							@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
								for _, entry := range entries {
									@sidebar.MenuItem() {
										@sidebar.MenuButton(sidebar.MenuButtonProps{IsActive: entry.active}) {
											@entry.icon()
											{ entry.label }
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// ---------------------------------------------------------------------------
// savings-targets.tsx
// ---------------------------------------------------------------------------

type cardsSavingsTarget struct {
	label    string
	amount   string
	progress int
	achieved string
	saved    string
	ariaText string
}

var cardsSavingsTargets = []cardsSavingsTarget{
	{label: "Retirement", amount: "$420,000", progress: 65, achieved: "65% achieved", saved: "$273,000", ariaText: "Retirement savings progress"},
	{label: "Real Estate", amount: "$85,000", progress: 32, achieved: "32% achieved", saved: "$27,200", ariaText: "Real estate savings progress"},
}

templ SavingsTargets() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Savings Targets
			}
			@card.Description() {
				Active milestones for 2024 across your portfolio. Monitor how close you are to each savings goal.
			}
		}
		@card.Content() {
			@item.Group(item.GroupProps{Class: "gap-3"}) {
				for _, target := range cardsSavingsTargets {
					@item.Item(item.Props{
						Variant:    item.VariantMuted,
						Class:      "flex-col items-stretch",
						Attributes: templ.Attributes{"role": "listitem"},
					}) {
						@item.Content(item.ContentProps{Class: "gap-3"}) {
							@item.Description(item.DescriptionProps{Class: "cn-font-heading text-xs font-medium tracking-wider text-muted-foreground uppercase"}) {
								{ target.label }
							}
							<span class="text-3xl font-semibold tabular-nums">{ target.amount }</span>
							@progress.Progress(progress.Props{Value: target.progress, Attributes: templ.Attributes{"aria-label": target.ariaText}})
						}
						@item.Footer() {
							<span class="text-sm text-muted-foreground">{ target.achieved }</span>
							<span class="text-sm font-medium tabular-nums">{ target.saved }</span>
						}
					}
				}
			}
		}
		@card.Footer() {
			@card.Description(card.DescriptionProps{Class: "text-center"}) {
				You have not met your targets for this year.
			}
		}
	}
}

// ---------------------------------------------------------------------------
// contribution-history.tsx
// ---------------------------------------------------------------------------

type cardsContributionBar struct {
	month  string
	amount float64
}

var cardsContributionData = []cardsContributionBar{
	{month: "Dec", amount: 800},
	{month: "Jan", amount: 1100},
	{month: "Feb", amount: 900},
	{month: "Mar", amount: 1300},
	{month: "Apr", amount: 750},
}

const cardsContributionMax = 1300

templ ContributionHistory() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Contribution History
			}
			@card.Description() {
				Last 6 months of activity
			}
		}
		@card.Content() {
			<div class="flex h-[200px] w-full items-end gap-3" role="img" aria-label="Last 6 months of contribution activity">
				for index, bar := range cardsContributionData {
					<div class="flex h-full flex-1 flex-col justify-end gap-2">
						<div
							data-index={ strconv.Itoa(index) }
							class="data-[index=5]:bg-chart-6 min-h-2 rounded-lg data-[index=0]:bg-chart-1 data-[index=1]:bg-chart-2 data-[index=2]:bg-chart-3 data-[index=3]:bg-chart-4 data-[index=4]:bg-chart-5"
							style={ templ.SafeCSS(cardsBarHeight(bar.amount, cardsContributionMax)) }
						></div>
						<span class="text-center text-xs text-muted-foreground">{ bar.month }</span>
					</div>
				}
			</div>
		}
		@card.Content() {
			<div class="grid w-full grid-cols-1 gap-3 xl:grid-cols-2">
				@item.Item(item.Props{Variant: item.VariantMuted, Class: "flex-col items-stretch"}) {
					@item.Content(item.ContentProps{Class: "gap-1"}) {
						@item.Description(item.DescriptionProps{Class: "text-xs font-medium tracking-wider text-muted-foreground uppercase"}) {
							Upcoming
						}
						<span class="cn-font-heading text-base font-semibold">May 2024</span>
						<span class="text-sm text-muted-foreground">Scheduled</span>
					}
				}
				@item.Item(item.Props{Variant: item.VariantMuted, Class: "hidden flex-col items-stretch xl:flex"}) {
					@item.Content(item.ContentProps{Class: "gap-1"}) {
						@item.Description(item.DescriptionProps{Class: "text-xs font-medium tracking-wider text-muted-foreground uppercase"}) {
							Savings Plan
						}
						<span class="cn-font-heading text-base font-semibold">Accelerated</span>
						<span class="text-sm text-muted-foreground">Recurring</span>
					}
				}
			</div>
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				View Full Report
			}
		}
	}
}

// ---------------------------------------------------------------------------
// claimable-balance.tsx
// ---------------------------------------------------------------------------
// netRoyalties 1248.75 - processingFee 37.46 = 1211.29, formatted with
// toLocaleString("en-US") like the source.
templ ClaimableBalance() {
	@card.Card() {
		@card.Header() {
			@card.Description() {
				Claimable Balance
			}
			@card.Title(card.TitleProps{Class: "text-4xl tabular-nums"}) {
				$1,211.29
			}
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				<span class="size-2 rounded-full bg-yellow-500"></span>
				Pending Setup
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-1 flex-col justify-end"}) {
			@item.Item(item.Props{Variant: item.VariantMuted, Class: "flex-col items-stretch"}) {
				@item.Content(item.ContentProps{Class: "gap-3"}) {
					<div class="flex items-center justify-between">
						<span class="text-sm text-muted-foreground">Net Royalties</span>
						<span class="text-sm font-medium tabular-nums">$1,248.75</span>
					</div>
					<div class="flex items-center justify-between">
						<span class="text-sm text-muted-foreground">Processing Fee</span>
						<span class="text-sm font-medium tabular-nums">-$37.46</span>
					</div>
					@separator.Separator()
					<div class="flex items-center justify-between">
						<span class="text-sm text-muted-foreground">Total Ready to Claim</span>
						<span class="text-sm font-semibold tabular-nums">$1,211.29 USD</span>
					</div>
				}
			}
		}
		@card.Footer() {
			@card.Description() {
				Once your bank is connected, balances over $10.00 are automatically eligible for monthly distribution on the 15th of each month.
			}
		}
	}
}

// ---------------------------------------------------------------------------
// dividend-income.tsx
// ---------------------------------------------------------------------------

type cardsHolding struct {
	name   string
	shares string
	values []float64
	max    float64
}

var cardsHoldings = []cardsHolding{
	{name: "Vanguard", shares: "450 Shares", values: []float64{380, 420, 390, 652}, max: 652},
	{name: "S&P 500 VOO", shares: "112 Shares", values: []float64{180, 210, 320, 218}, max: 320},
	{name: "Apple AAPL", shares: "85 Shares", values: []float64{60, 70, 120, 90}, max: 120},
	{name: "Realty Income", shares: "320 Shares", values: []float64{240, 260, 280, 360}, max: 360},
}

templ DividendIncome() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Q2 Dividend Income
			}
			@card.Description() {
				Quarterly dividend payouts across your portfolio holdings.
			}
			@card.Action() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "bg-muted",
					Attributes: templ.Attributes{"aria-label": "Dismiss dividend income"},
				}) {
					@icon.X()
				}
			}
		}
		@card.Content() {
			@item.Group() {
				for _, holding := range cardsHoldings {
					@item.Item(item.Props{Variant: item.VariantMuted, Attributes: templ.Attributes{"role": "listitem"}}) {
						@item.Content() {
							@item.Title() {
								{ holding.name }
							}
							@item.Description() {
								{ holding.shares }
							}
						}
						<div class="hidden h-8 w-24 items-end gap-1 md:flex" role="img" aria-label={ holding.name + " quarterly dividends" }>
							for _, value := range holding.values {
								<div class="min-h-1 flex-1 rounded-t-sm bg-chart-2" style={ templ.SafeCSS(cardsBarHeight(value, holding.max)) }></div>
							}
						</div>
					}
				}
			}
		}
	}
}

// ---------------------------------------------------------------------------
// payout-threshold.tsx
// ---------------------------------------------------------------------------

var cardsCurrencies = []createOption{
	{Value: "usd", Label: "USD — United States Dollar"},
	{Value: "eur", Label: "EUR — Euro"},
	{Value: "gbp", Label: "GBP — British Pound"},
	{Value: "jpy", Label: "JPY — Japanese Yen"},
}

templ PayoutThreshold() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Payout Threshold
			}
			@card.Description() {
				Set the minimum balance required before a payout is triggered.
			}
			@card.Action() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIconSm,
					Class:      "bg-muted",
					Attributes: templ.Attributes{"aria-label": "Dismiss payout threshold"},
				}) {
					@icon.X()
				}
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "preferred-currency"}) {
						Preferred Currency
					}
					@selectcomp.Select(selectcomp.Props{
						Items: utils.Map(cardsCurrencies, func(c createOption) selectcomp.ItemData {
							return selectcomp.ItemData{Value: c.Value, Label: c.Label}
						}),
						DefaultValue: "usd",
					}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "preferred-currency", Class: "w-full"}) {
							@selectcomp.Value()
						}
						@selectcomp.Content() {
							@selectcomp.Group() {
								for _, currency := range cardsCurrencies {
									@selectcomp.Item(selectcomp.ItemProps{Value: currency.Value}) {
										{ currency.Label }
									}
								}
							}
						}
					}
				}
				@field.Field() {
					<div class="flex items-baseline justify-between">
						@field.Label(field.LabelProps{ID: "min-payout-label"}) {
							Minimum Payout Amount
						}
						<span class="text-2xl font-semibold tabular-nums">$2500.00</span>
					</div>
					@progress.Progress(progress.Props{
						Value: 25,
						Attributes: templ.Attributes{
							"aria-labelledby": "min-payout-label",
							"aria-valuetext":  "$2,500 of $10,000",
						},
					})
					<div class="flex items-center justify-between">
						@field.Description() {
							$50 (MIN)
						}
						@field.Description() {
							$10,000 (MAX)
						}
					</div>
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "payout-notes"}) {
						Notes
					}
					@textarea.Textarea(textarea.Props{ID: "payout-notes", Placeholder: "Add any notes for this payout configuration...", Class: "min-h-[100px]"})
				}
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				Save Threshold
			}
		}
	}
}

// ---------------------------------------------------------------------------
// account-access.tsx
// ---------------------------------------------------------------------------
templ AccountAccess() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Account Access
			}
			@card.Description() {
				Update your credentials or re-authenticate.
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "email-address"}) {
						Email Address
					}
					@input.Input(input.Props{ID: "email-address", Type: "email", Placeholder: "artist@studio.inc"})
				}
				@field.Field() {
					<div class="flex items-center justify-between">
						@field.Label(field.LabelProps{For: "current-password"}) {
							Current Password
						}
						<a href="#" class="text-xs font-medium tracking-wider text-muted-foreground uppercase hover:text-foreground">
							Forgot?
						</a>
					</div>
					@input.Input(input.Props{ID: "current-password", Type: "password", Placeholder: "••••••••••••••••••••••••"})
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col gap-4"}) {
			@button.Button(button.Props{Class: "w-full"}) {
				@icon.LockKeyhole()
				Update Security
			}
			@item.Item(item.Props{Variant: item.VariantMuted, Href: "#"}) {
				@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
					@icon.CircleAlert(icon.Props{Class: "text-destructive"})
				}
				@item.Content() {
					@item.Title() {
						Danger Zone
					}
					@item.Description(item.DescriptionProps{Class: "line-clamp-1"}) {
						Archive account and remove catalog
					}
				}
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		}
	}
}

// ---------------------------------------------------------------------------
// qr-connect.tsx
// ---------------------------------------------------------------------------
// The cell matrix verbatim from the source; the homepage card draws the QR as
// a static 21x21 grid instead of react-qr-code.

var cardsQrCells = []string{
	"111111100101101111111",
	"100000101001001000001",
	"101110101111101011101",
	"101110100100001011101",
	"101110101010101011101",
	"100000100111001000001",
	"111111101010101111111",
	"000000001101000000000",
	"101011111001111010110",
	"010100001110010101001",
	"111010111011101111010",
	"001101000101000010101",
	"110111101111010111011",
	"000000001001010001010",
	"111111101101111101001",
	"100000100010001001111",
	"101110101011101110100",
	"101110100110100010011",
	"101110101000111101110",
	"100000101101000011001",
	"111111101011101101111",
}

templ QrConnect() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex justify-center pt-6"}) {
			<div class="rounded-xl border bg-white p-4">
				<svg viewBox="0 0 21 21" class="size-40 text-black" role="img" aria-label="Connect device QR code" shape-rendering="crispEdges">
					<rect width="21" height="21" fill="white"></rect>
					for y, row := range cardsQrCells {
						for x, cell := range row {
							if cell == '1' {
								<rect x={ strconv.Itoa(x) } y={ strconv.Itoa(y) } width="1" height="1"></rect>
							}
						}
					}
				</svg>
			</div>
		}
		@card.Header(card.HeaderProps{Class: "text-center"}) {
			@card.Title() {
				Scan to connect your mobile device
			}
			@card.Description(card.DescriptionProps{Class: "text-balance"}) {
				Open the Ledger mobile app and scan this code to link your device.
			}
		}
	}
}

// ---------------------------------------------------------------------------
// payments.tsx
// ---------------------------------------------------------------------------
templ Payments() {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "flex flex-col gap-3"}) {
			@breadcrumb.Breadcrumb() {
				@breadcrumb.List() {
					@breadcrumb.Item() {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "#"}) {
							Home
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item() {
						@dropdownmenu.DropdownMenu() {
							@button.Button(button.Props{
								Size:       button.SizeIconSm,
								Variant:    button.VariantGhost,
								Attributes: utils.MergeAttributes(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": "Account options"}),
							}) {
								@icon.Ellipsis()
								<span class="sr-only">Account options</span>
							}
							@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignStart}) {
								@dropdownmenu.Group() {
									@dropdownmenu.Item() {
										Profile
									}
									@dropdownmenu.Item() {
										Statements
									}
									@dropdownmenu.Item() {
										Documents
									}
								}
							}
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item() {
						@breadcrumb.Page() {
							Payments
						}
					}
				}
			}
		}
		@card.Content() {
			@item.Group() {
				@paymentsItem(icon.Settings, "Change transfer limit", "Adjust how much you can send from your balance.")
				@paymentsItem(icon.Calendar, "Scheduled transfers", "Set up a transfer to send at a later date.")
				@paymentsItem(icon.RefreshCw, "Recurring card payments", "Manage your repeated card transactions.")
			}
		}
	}
}

templ paymentsItem(iconFn func(...icon.Props) templ.Component, title, description string) {
	<div role="listitem" class="w-full">
		@item.Item(item.Props{Variant: item.VariantMuted, Href: "#"}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@iconFn()
			}
			@item.Content() {
				@item.Title() {
					{ title }
				}
				@item.Description() {
					{ description }
				}
			}
			@icon.ChevronRight(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
		}
	</div>
}

// ---------------------------------------------------------------------------
// analytics-card.tsx
// ---------------------------------------------------------------------------

const cardsAnalyticsAreaPath = "M0 52L18 40L36 46L54 70L72 50L100 49V86H0Z"
const cardsAnalyticsStrokePath = "M0 52L18 40L36 46L54 70L72 50L100 49"

templ AnalyticsCard() {
	@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-full max-w-sm data-[size=sm]:pb-0"}) {
		@card.Header() {
			@card.Title() {
				Analytics
			}
			@card.Description() {
				418.2K Visitors{ " " }
				@badge.Badge() {
					+10%
				}
			}
			@card.Action() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					View Analytics
				}
			}
		}
		<svg viewBox="0 0 100 86" preserveAspectRatio="none" class="aspect-[1/0.35] w-full text-chart-1" role="img" aria-label="Visitor trend">
			<path d={ cardsAnalyticsAreaPath } fill="currentColor" opacity="0.28"></path>
			<path d={ cardsAnalyticsStrokePath } fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
		</svg>
	}
}

// ---------------------------------------------------------------------------
// notification-settings.tsx
// ---------------------------------------------------------------------------

type cardsNotification struct {
	id          string
	label       string
	description string
	checked     bool
}

var cardsNotifications = []cardsNotification{
	{id: "transactions", label: "Transaction alerts", description: "Deposits, withdrawals, and transfers.", checked: true},
	{id: "security", label: "Security alerts", description: "Login attempts and account changes.", checked: true},
	{id: "goals", label: "Goal milestones", description: "Updates at 25%, 50%, 75%, and 100%.", checked: false},
	{id: "market", label: "Market updates", description: "Daily portfolio summary and price alerts.", checked: false},
}

templ NotificationSettings() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Notifications
			}
			@card.Description() {
				Choose which email and push alerts you want to receive.
			}
		}
		@card.Content() {
			@field.Group() {
				for _, notification := range cardsNotifications {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@checkbox.Checkbox(checkbox.Props{ID: "notify-" + notification.id, DefaultChecked: notification.checked})
						@field.Content() {
							@field.Label(field.LabelProps{For: "notify-" + notification.id}) {
								{ notification.label }
							}
							@field.Description() {
								{ notification.description }
							}
						}
					}
				}
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				Save Preferences
			}
		}
	}
}

// ---------------------------------------------------------------------------
// power-usage.tsx
// ---------------------------------------------------------------------------

type cardsPowerBar struct {
	hour  string
	usage float64
}

var cardsPowerData = []cardsPowerBar{
	{hour: "6a", usage: 1.2},
	{hour: "8a", usage: 2.8},
	{hour: "10a", usage: 3.1},
	{hour: "12p", usage: 2.4},
	{hour: "2p", usage: 3.4},
	{hour: "4p", usage: 2.9},
	{hour: "6p", usage: 3.8},
	{hour: "8p", usage: 3.2},
}

const cardsPowerMax = 3.8

templ PowerUsage() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Power Usage
			}
			@card.Description() {
				Whole Home
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4"}) {
			<div class="flex h-[140px] w-full items-end gap-2" role="img" aria-label="Power usage by hour">
				for _, bar := range cardsPowerData {
					<div class="flex h-full flex-1 flex-col justify-end gap-1.5">
						<div class="min-h-2 rounded-t bg-chart-2" style={ templ.SafeCSS(cardsBarHeight(bar.usage, cardsPowerMax)) }></div>
						<span class="text-center text-xs text-muted-foreground">{ bar.hour }</span>
					</div>
				}
			</div>
			@separator.Separator()
			<div class="grid grid-cols-2 gap-4">
				<div class="flex flex-col gap-0.5">
					<span class="text-sm text-muted-foreground">Currently Using</span>
					<span class="text-lg font-semibold tabular-nums">3.4 kW</span>
				</div>
				<div class="flex flex-col gap-0.5">
					<span class="text-sm text-muted-foreground">Solar Gen</span>
					<span class="text-lg font-semibold tabular-nums">+1.2 kW</span>
				</div>
			</div>
		}
	}
}

