templ SkeletonUIElements() {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full rounded-2xl"})
			<div class="flex flex-wrap gap-2">
				@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-20 rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-24 rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-20 rounded-lg"})
			</div>
			<div class="flex flex-col gap-3">
				@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-full rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-20 w-full rounded-lg"})
			</div>
			<div class="flex items-center gap-2">
				<div class="flex gap-2">
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-12 rounded-full"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-16 rounded-full"})
					@skeleton.Skeleton(skeleton.Props{Class: "hidden h-5 w-14 rounded-full 4xl:block"})
				</div>
				<div class="ml-auto flex gap-3">
					@skeleton.Skeleton(skeleton.Props{Class: "size-4 rounded-full"})
					@skeleton.Skeleton(skeleton.Props{Class: "size-4 rounded-full"})
				</div>
				<div class="flex gap-3">
					@skeleton.Skeleton(skeleton.Props{Class: "size-4 rounded-sm"})
					@skeleton.Skeleton(skeleton.Props{Class: "hidden size-4 rounded-sm 4xl:block"})
				</div>
				@skeleton.Skeleton(skeleton.Props{Class: "ml-auto h-5 w-9 rounded-full 4xl:hidden"})
			</div>
			<div class="flex items-center gap-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-24 rounded-lg"})
				<div class="flex">
					@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-28 rounded-l-lg rounded-r-none"})
					@skeleton.Skeleton(skeleton.Props{Class: "ml-px h-9 w-9 rounded-l-none rounded-r-lg"})
				</div>
				@skeleton.Skeleton(skeleton.Props{Class: "ml-auto hidden h-5 w-9 rounded-full 4xl:block"})
			</div>
		}
	}
}

templ SkeletonSidebarNav() {
	<div class="grid w-full items-start gap-4 xl:grid-cols-2 xl:gap-6">
		@card.Card(card.Props{Class: "w-full overflow-hidden rounded-3xl py-0"}) {
			@navSkeleton()
		}
		@card.Card(card.Props{Class: "hidden w-full overflow-hidden rounded-3xl py-0 xl:flex"}) {
			@navSkeleton()
		}
	</div>
}

templ navSkeleton() {
	<div class="flex flex-col gap-1 p-2">
		for gi := 0; gi < 2; gi++ {
			<div class="flex flex-col gap-1 px-2 py-1.5">
				@skeleton.Skeleton(skeleton.Props{Class: "mb-1 h-3 w-20 rounded-md"})
				for i := 0; i < 5; i++ {
					<div class="flex items-center gap-2 px-2 py-2">
						@skeleton.Skeleton(skeleton.Props{Class: "size-4 rounded-md"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-24 rounded-md"})
					</div>
				}
				if gi < 1 {
					@skeleton.Skeleton(skeleton.Props{Class: "my-1 h-px w-full rounded-none"})
				}
			</div>
		}
	</div>
}

templ SkeletonSavingsTargets() {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "gap-2"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-36 rounded-md"})
			<div class="flex flex-col gap-1.5">
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full max-w-64 rounded-md"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-48 rounded-md"})
			</div>
		}
		@card.Content() {
			<div class="flex flex-col gap-3">
				for i := 0; i < 2; i++ {
					<div class="flex flex-col gap-3 rounded-xl bg-muted p-4">
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-24 rounded-md bg-muted-foreground/15"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-36 rounded-md bg-muted-foreground/15"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-2 w-full rounded-full bg-muted-foreground/15"})
						<div class="flex items-center justify-between">
							@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-24 rounded-md bg-muted-foreground/15"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-20 rounded-md bg-muted-foreground/15"})
						</div>
					</div>
				}
			</div>
		}
		@card.Footer(card.FooterProps{Class: "justify-center"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-56 rounded-md"})
		}
	}
}

