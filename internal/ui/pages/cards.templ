var cardsSkeletonMiniBars = []int{40, 60, 80, 50}

templ SkeletonDividendIncome() {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "gap-2"}) {
			@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-48 rounded-md"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-64 rounded-md"})
			@card.Action() {
				@skeleton.Skeleton(skeleton.Props{Class: "size-8 rounded-md"})
			}
		}
		@card.Content() {
			<div class="flex flex-col gap-2">
				for i := 0; i < 4; i++ {
					<div class="flex items-center gap-3 rounded-xl bg-muted p-3">
						<div class="flex flex-1 flex-col gap-2">
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-28 rounded-md bg-muted-foreground/15"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-20 rounded-md bg-muted-foreground/15"})
						</div>
						<div class="hidden h-8 w-24 items-end gap-1 md:flex">
							for _, height := range cardsSkeletonMiniBars {
								@skeleton.Skeleton(skeleton.Props{
									Class:      "flex-1 rounded-t-sm rounded-b-none bg-muted-foreground/15",
									Attributes: templ.Attributes{"style": "height: " + strconv.Itoa(height) + "%"},
								})
							}
						</div>
						@skeleton.Skeleton(skeleton.Props{Class: "hidden h-4 w-16 rounded-md bg-muted-foreground/15 md:block"})
					</div>
				}
			</div>
		}
	}
}

