package pages

import (
	"github.com/axadrn/shadcn-templ/v2/internal/service"
	"github.com/axadrn/shadcn-templ/v2/internal/shared"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/layouts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
)

// ComponentsOverview is the pendant of the reference's
// content/docs/components/index.mdx rendered through the docs shell: the
// markdown page header and pager, a New Components section listing only
// PAGES_NEW members (no dots), then All Components where the new ones carry
// the blue dot (components-list.tsx showNewIndicator).
templ ComponentsOverview(prev, next PagerLink) {
	@layouts.DocsLayout(
		service.ComponentsIndexTitle,
		service.ComponentsIndexDescription,
		componentsTOC(),
	) {
		<div class="flex w-full flex-1 flex-col gap-6">
			@modules.DocsPageHeader(service.ComponentsIndexTitle, service.ComponentsIndexDescription, prev.Href, next.Href)
			<div class="typeset w-full flex-1 pb-16 sm:pb-0">
				if shared.HasNewComponents() {
					<h2 id="new-components">New Components</h2>
					@componentsGrid(true, false)
				}
				<h2 id="all-components">All Components</h2>
				@componentsGrid(false, true)
			</div>
			@modules.DocsPager(prev.Title, prev.Href, next.Title, next.Href)
		</div>
	}
}

// componentsTOC lists the sections the page renders.
func componentsTOC() []modules.TableOfContentsItem {
	var items []modules.TableOfContentsItem
	if shared.HasNewComponents() {
		items = append(items, modules.TableOfContentsItem{ID: "new-components", Text: "New Components"})
	}
	return append(items, modules.TableOfContentsItem{ID: "all-components", Text: "All Components"})
}

templ componentsGrid(onlyNew bool, showNewIndicator bool) {
	<div data-not-typeset class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-x-8 lg:gap-x-16 lg:gap-y-6 xl:gap-x-20">
		for _, section := range shared.Sections {
			if section.Title == "Components" {
				for _, link := range section.Links {
					if !onlyNew || shared.PageIsNew(link.Href) {
						<a
							href={ templ.SafeURL(link.Href) }
							class="inline-flex items-center gap-2 text-lg font-medium underline-offset-4 hover:underline md:text-base"
						>
							{ link.Text }
							if showNewIndicator && shared.PageIsNew(link.Href) {
								<span class="sr-only">New</span>
								<span aria-hidden="true" class="flex size-2 rounded-full bg-blue-500"></span>
							}
						</a>
					}
				}
			}
		}
	</div>
}
