package pages

import (
	"github.com/axadrn/shadcn-templ/v2/internal/ui/examples"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// CreatePreview renders inside the /create iframe. The parent syncs the
// design system params via postMessage; create-preview.js turns them into
// CSS variables.
templ CreatePreview(item string) {
	@modules.SimplePreviewLayout(createPreviewContent(item))
}

templ createPreviewContent(item string) {
	<link rel="stylesheet" href={ utils.ScriptURL("/assets/css/create-fonts.css") }/>
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/preset.js") }></script>
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create-config.js") }></script>
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create-themes.js") }></script>
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/create-preview.js") }></script>
	// The shared preview layout loads the full component bundle
	// (components.Scripts()); loading any component .min.js here again would
	// double-bind its document-level listeners (a doubled toggle click
	// handler cancels itself out).
	// Item resolution like shadcn's preview/[base]/[name] route: the two
	// static walls by name, every other name from the registry index. shadcn
	// 404s on unknown names; inside our iframe the default wall is friendlier.
	switch {
		case item == "" || item == "preview-02":
			@createPreview02Grid()
		case item == "preview":
			@createPreviewGrid()
		// The palette's registry items and the docs demos are separate
		// namespaces like shadcn's registry vs ExamplesIndex; chart-example
		// exists in both, the registry item wins here.
		case item == "chart-example":
			@createRegistryItemPreview(examples.Registry["chart-example-page"].Component)
		default:
			if entry, ok := examples.Registry[item]; ok {
				@createRegistryItemPreview(entry.Component)
			} else {
				@createPreview02Grid()
			}
	}
}

// createRegistryItemPreview renders a registry demo in the preview shell.
// shadcn's preview route renders the item bare in <div class="relative
// bg-background"> because their example items bring their own full-page
// ExampleWrapper; our docs demos do not, so they get a centered flex
// container like the docs showcase rendering.
templ createRegistryItemPreview(demo templ.Component) {
	<div class="relative bg-background">
		<div class="flex min-h-svh w-full items-center justify-center p-6">
			@demo
		</div>
	</div>
}

// createPreviewGrid mirrors shadcn's preview block (the "02" switcher
// item): a wide, horizontally scrollable card wall on bg-muted.
templ createPreviewGrid() {
	<div class="min-h-svh overflow-x-auto overflow-y-hidden bg-muted contain-[paint] [--gap:--spacing(4)] 3xl:[--gap:--spacing(12)] md:[--gap:--spacing(10)] dark:bg-background style-lyra:md:[--gap:--spacing(6)] style-mira:md:[--gap:--spacing(6)]">
		<div class="flex w-full min-w-max justify-center">
			<div
				class="grid w-[2400px] grid-cols-7 items-start gap-(--gap) bg-muted p-(--gap) md:w-[3000px] dark:bg-background style-lyra:md:w-[2600px] style-mira:md:w-[2600px] *:[div]:gap-(--gap)"
				data-slot="capture-target"
			>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardStyleOverview()
					@cardTypographySpecimen()
					<div class="md:hidden">
						@cardUIElements("mobile")
					</div>
					@cardCodespaces()
					@cardInvoice()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardIconPreviewGrid()
					<div class="hidden w-full md:flex">
						@cardUIElements("desktop")
					</div>
					@cardObservability()
					@cardShippingAddress()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardEnvironmentVariables()
					@cardBarChart()
					@cardInviteTeam()
					@cardActivateAgentDialog()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardSkeletonLoading()
					@cardPieChart()
					@cardNoTeamMembers()
					@cardReportBug()
					@cardContributors()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardFeedbackForm()
					@cardBookAppointment()
					@cardSleepReport()
					@cardGithubProfile()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardWeeklyFitnessSummary()
					@cardFileUpload()
					@cardAnalytics()
					@cardUsage()
					@cardShortcuts()
				</div>
				<div class="flex flex-col p-px [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardAnomalyAlert()
					@cardLiveWaveform()
					@cardVisitors()
					@cardContributionsActivity()
					@cardNotFound()
				</div>
			</div>
		</div>
	</div>
}

// createPreview02Grid mirrors shadcn's preview-02 block (the default "01"
// switcher item): a wide, horizontally scrollable card wall on bg-muted.
templ createPreview02Grid() {
	<div class="min-h-svh overflow-x-auto overflow-y-hidden bg-muted contain-[paint] [--gap:--spacing(4)] 3xl:[--gap:--spacing(12)] md:[--gap:--spacing(10)] dark:bg-background style-lyra:md:[--gap:--spacing(6)] style-mira:md:[--gap:--spacing(6)]">
		<div class="flex w-full min-w-max justify-center">
			<div
				class="grid w-[2400px] grid-cols-7 items-start gap-(--gap) bg-muted p-(--gap) md:w-[3000px] dark:bg-background style-lyra:md:w-[2600px] style-mira:md:w-[2600px] *:[div]:gap-(--gap)"
				data-slot="capture-target"
			>
				<div class="flex flex-col p-1 [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardContributionHistory()
					@cardEmptyDistributeTrack()
					@cardQrConnect()
					@cardDividendIncome()
					@cardIndexInvesting()
					@cardSyncingState()
				</div>
				<div class="flex flex-col p-1 [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardPayoutThreshold()
					@cardClaimableBalance()
					@cardPreferences()
					@cardSavingsProgress()
					@cardKitchenIsland()
				</div>
				<div class="col-span-2 flex flex-col p-1 [contain-intrinsic-size:760px_1200px] [content-visibility:auto]">
					@cardSavingsTargets()
					@cardRecentTransactions()
					<div class="grid grid-cols-2 items-start gap-(--gap)">
						<div class="flex flex-col gap-(--gap)">
							@cardSidebarNav()
							@cardFaq()
						</div>
						<div class="flex flex-col gap-(--gap)">
							@cardPayments()
							@cardFrontDoor()
						</div>
					</div>
					@cardReleaseCatalog()
				</div>
				<div class="flex flex-col p-1 [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardAccountAccess()
					@cardOverview()
					@cardTransferFunds()
					@cardCoverArt()
					@cardLoading()
				</div>
				<div class="flex flex-col p-1 [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardReceivingMethod()
					@cardPowerUsage()
					@cardEmptyConnectBank()
					@cardUpcomingPayments()
					@cardRollerShades()
				</div>
				<div class="flex flex-col p-1 [contain-intrinsic-size:380px_1200px] [content-visibility:auto]">
					@cardStockPerformance()
					@cardEmptyExploreCatalog()
					@cardNewMilestone()
					@cardSocialLinks()
					@cardNotificationSettings()
				</div>
			</div>
		</div>
	</div>
}
