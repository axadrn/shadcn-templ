package pages

import (
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/charts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/layouts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The charts gallery, the pendant of shadcn's /charts pages: page header
// with announcement, the category nav and a card grid per chart type.

type chartsNavLink struct {
	Name string
	Type string
}

var chartsNavLinks = []chartsNavLink{
	{"Area Charts", "area"},
	{"Bar Charts", "bar"},
	{"Line Charts", "line"},
	{"Pie Charts", "pie"},
	{"Radar Charts", "radar"},
	{"Radial Charts", "radial"},
	{"Tooltips", "tooltip"},
}

// ChartTypes are the valid gallery categories.
var ChartTypes = map[string]bool{
	"area": true, "bar": true, "line": true, "pie": true,
	"radar": true, "radial": true, "tooltip": true,
}

// chartsFor lists the ported charts per category, in charts.tsx order.
func chartsFor(chartType string) []modules.ChartEntry {
	entry := func(id string, fullWidth bool) modules.ChartEntry {
		return modules.ChartEntry{ID: id, FullWidth: fullWidth, Code: charts.Source(id)}
	}
	switch chartType {
	case "area":
		return []modules.ChartEntry{
			entry("chart-area-interactive", true),
			entry("chart-area-default", false),
			entry("chart-area-linear", false),
			entry("chart-area-step", false),
			entry("chart-area-legend", false),
			entry("chart-area-stacked", false),
			entry("chart-area-stacked-expand", false),
			entry("chart-area-icons", false),
			entry("chart-area-gradient", false),
			entry("chart-area-axes", false),
		}
	case "bar":
		return []modules.ChartEntry{
			entry("chart-bar-interactive", true),
			entry("chart-bar-default", false),
			entry("chart-bar-horizontal", false),
			entry("chart-bar-multiple", false),
			entry("chart-bar-stacked", false),
			entry("chart-bar-label", false),
			entry("chart-bar-label-custom", false),
			entry("chart-bar-mixed", false),
			entry("chart-bar-active", false),
			entry("chart-bar-negative", false),
		}
	case "line":
		return []modules.ChartEntry{
			entry("chart-line-interactive", true),
			entry("chart-line-default", false),
			entry("chart-line-linear", false),
			entry("chart-line-step", false),
			entry("chart-line-multiple", false),
			entry("chart-line-dots", false),
			entry("chart-line-dots-custom", false),
			entry("chart-line-dots-colors", false),
			entry("chart-line-label", false),
			entry("chart-line-label-custom", false),
		}
	case "radar":
		return []modules.ChartEntry{
			entry("chart-radar-default", false),
			entry("chart-radar-dots", false),
			entry("chart-radar-lines-only", false),
			entry("chart-radar-label-custom", false),
			entry("chart-radar-grid-custom", false),
			entry("chart-radar-grid-none", false),
			entry("chart-radar-grid-circle", false),
			entry("chart-radar-grid-circle-no-lines", false),
			entry("chart-radar-grid-circle-fill", false),
			entry("chart-radar-grid-fill", false),
			entry("chart-radar-multiple", false),
			entry("chart-radar-legend", false),
		}
	case "pie":
		return []modules.ChartEntry{
			entry("chart-pie-simple", false),
			entry("chart-pie-separator-none", false),
			entry("chart-pie-label", false),
			entry("chart-pie-label-custom", false),
			entry("chart-pie-label-list", false),
			entry("chart-pie-legend", false),
			entry("chart-pie-donut", false),
			entry("chart-pie-donut-active", false),
			entry("chart-pie-donut-text", false),
			entry("chart-pie-stacked", false),
			entry("chart-pie-interactive", false),
		}
	case "radial":
		return []modules.ChartEntry{
			entry("chart-radial-simple", false),
			entry("chart-radial-label", false),
			entry("chart-radial-grid", false),
			entry("chart-radial-text", false),
			entry("chart-radial-shape", false),
			entry("chart-radial-stacked", false),
		}
	case "tooltip":
		return []modules.ChartEntry{
			entry("chart-tooltip-default", false),
			entry("chart-tooltip-indicator-line", false),
			entry("chart-tooltip-indicator-none", false),
			entry("chart-tooltip-label-custom", false),
			entry("chart-tooltip-label-formatter", false),
			entry("chart-tooltip-label-none", false),
			entry("chart-tooltip-formatter", false),
			entry("chart-tooltip-icons", false),
			entry("chart-tooltip-advanced", false),
		}
	}
	return nil
}

templ Charts(chartType string) {
	@layouts.BaseLayout(
		"Beautiful Charts & Graphs",
		"A collection of ready-to-use chart components built with shadcn-templ. From basic charts to rich data displays, copy and paste into your apps.",
	) {
		@modules.AnnouncementBar()
		@modules.Navbar()
		<section class="border-grid">
			<div class="container-wrapper">
				<div class="container mx-auto flex flex-col items-center gap-2 px-6 py-8 text-center md:py-16 lg:py-20 xl:gap-4">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "bg-muted", Href: "/docs/components/chart"}) {
						@icon.ChartArea(icon.Props{Class: "size-3", Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Charts are now available
						@icon.ArrowRight()
					}
					<h1 class="leading-tighter max-w-3xl text-3xl font-semibold tracking-tight text-balance text-primary lg:leading-[1.1] lg:font-semibold xl:text-5xl xl:tracking-tighter">
						Beautiful Charts & Graphs
					</h1>
					<p class="max-w-4xl text-base text-balance text-foreground sm:text-lg">
						A collection of ready-to-use chart components built with shadcn-templ. From basic charts to rich data displays, copy and paste into your apps.
					</p>
					<div class="flex w-full items-center justify-center gap-2 pt-2 **:data-[slot=button]:shadow-none">
						@button.Button(button.Props{Class: "px-3", Href: "#charts"}) {
							Browse Charts
						}
						@button.Button(button.Props{Variant: button.VariantGhost, Class: "px-3", Href: "/docs/components/chart"}) {
							Documentation
						}
					</div>
				</div>
			</div>
		</section>
		<div id="charts-page">
			<div id="charts" class="container-wrapper scroll-mt-24">
				<div class="container mx-auto flex items-center justify-between gap-4 px-4 py-4">
					<div class="relative overflow-hidden">
						<div class="max-w-[600px] overflow-x-auto no-scrollbar lg:max-w-none">
							<div class="flex items-center">
								for _, link := range chartsNavLinks {
									<a
										href={ templ.SafeURL("/charts/" + link.Type + "#charts") }
										hx-get={ "/charts/" + link.Type }
										hx-select="#charts-page"
										hx-target="#charts-page"
										hx-swap="outerHTML"
										hx-push-url={ "/charts/" + link.Type }
										data-active={ utils.IfElse(link.Type == chartType, "true", "false") }
										class="flex h-7 shrink-0 items-center justify-center px-4 text-center text-base font-medium text-muted-foreground transition-colors hover:text-primary data-[active=true]:text-primary"
									>
										{ link.Name }
									</a>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		<div class="container-wrapper flex-1">
			<div class="container mx-auto px-4 pb-6">
				<section class="theme-container">
					<div class="grid flex-1 gap-12 lg:gap-24">
						<h2 class="sr-only">{ chartType } Charts</h2>
						<div class="grid flex-1 scroll-mt-20 items-stretch gap-10 md:grid-cols-2 md:gap-6 lg:grid-cols-3 xl:gap-10">
							for _, entry := range chartsFor(chartType) {
								@modules.ChartDisplay(entry)
							}
							for range 12 - len(chartsFor(chartType)) {
								<div class="hidden aspect-square w-full rounded-lg border border-dashed xl:block"></div>
							}
						</div>
					</div>
				</section>
			</div>
		</div>
		</div>
		@modules.Footer()
		@chartsPageScript()
	}
}

// chartsPageScript wires the gallery interactions that live outside the
// chart component: the copy buttons and the interactive demo toggles.
templ chartsPageScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// ChartIframe: fade the chart iframes in once loaded, the pendant
			// of shadcn's onLoad state. On a fast host the iframes can finish
			// before this script runs, so frames that are already complete
			// reveal immediately (the img.complete pattern for iframes).
			const revealIframe = (f) => {
				f.classList.remove("opacity-0");
				f.classList.add("opacity-100");
			};
			document.addEventListener("load", (e) => {
				if (e.target instanceof Element && e.target.matches("[data-templ-chart-iframe]")) {
					revealIframe(e.target);
				}
			}, true);
			document.querySelectorAll("[data-templ-chart-iframe]").forEach((f) => {
				const d = f.contentDocument;
				if (d && d.readyState === "complete" && d.URL !== "about:blank") {
					revealIframe(f);
				}
			});

			// Copy buttons: write the chart source, swap to the check icon
			// for two seconds.
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				const btn = e.target.closest("[data-templ-chart-copy]");
				if (!btn) return;
				const name = btn.getAttribute("data-templ-chart-copy");
				const code = document.querySelector(`[data-templ-chart-code="${name}"]`);
				if (!code) return;
				navigator.clipboard.writeText(code.value);
				btn.querySelector("[data-templ-chart-copy-idle]").classList.add("hidden");
				btn.querySelector("[data-templ-chart-copy-done]").classList.remove("hidden");
				setTimeout(() => {
					btn.querySelector("[data-templ-chart-copy-idle]").classList.remove("hidden");
					btn.querySelector("[data-templ-chart-copy-done]").classList.add("hidden");
				}, 2000);
			});

		})();
	</script>
}
