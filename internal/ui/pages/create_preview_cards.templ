						Data:        savingsProgressData,
						DataKey:     "value",
						NameKey:     "name",
						InnerRadius: 70,
						OuterRadius: 95,
						Stroke:      "0",
					}) {
						@chart.Label(chart.LabelProps{
							DominantBaseline: "middle",
							Spans: []chart.LabelSpan{
								{Text: "$24,000", Class: "fill-foreground text-2xl font-bold", OffsetY: -12},
								{Text: "80% of $30,000", Class: "fill-muted-foreground text-xs", OffsetY: 12},
							},
						})
					}
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col gap-0"}) {
			<div class="flex w-full items-center justify-between py-3">
				<span class="text-sm text-muted-foreground">Projected Finish</span>
				<span class="text-sm font-semibold">October 2024</span>
			</div>
