			<div class="flex w-full items-center justify-between py-3">
				<span class="text-sm text-muted-foreground">Monthly Average</span>
				<span class="text-sm font-semibold tabular-nums">$1,250</span>
			</div>
			@separator.Separator()
			<div class="flex w-full items-center justify-between py-3">
				<span class="text-sm text-muted-foreground">Top Contributor</span>
				<span class="text-sm font-semibold">Auto-Transfer</span>
			</div>
		}
	}
}

templ cardKitchenIsland() {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-kitchen-island": ""}}) {
		@card.Header() {
			@card.Title() {
				Kitchen Island
			}
			@card.Description() {
				Hue Color Ambient
			}
			@card.Action() {
				@switchcomp.Switch(switchcomp.Props{DefaultChecked: true})
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4"}) {
			<div class="flex flex-col gap-2">
				<span class="sr-only">Scenes</span>
				@togglegroup.ToggleGroup(togglegroup.Props{
					Variant: togglegroup.VariantOutline,
					Spacing: utils.Ptr(1),
					Class:   "flex-wrap",
					Value:   []string{"cooking"},
				}) {
					@togglegroup.Item(togglegroup.ItemProps{Value: "cooking"}) {
						Cooking
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "dining"}) {
						Dining
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "nightlight"}) {
						Nightlight
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "focus"}) {
						Focus
					}
				}
			</div>
			@item.Group() {
				@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
					@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
						@icon.Sun()
					}
					@item.Content(item.ContentProps{Class: "flex-row items-center gap-3"}) {
						@item.Title(item.TitleProps{Class: "shrink-0"}) {
							Brightness
						}
					}
					@item.Actions(item.ActionsProps{Class: "flex-1"}) {
						@slider.Slider(slider.Props{DefaultValue: []float64{90}, Max: 100, Class: "w-full"})
					}
				}
				@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
					@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
						@icon.Thermometer()
					}
					@item.Content(item.ContentProps{Class: "flex-row items-center gap-3"}) {
						@item.Title(item.TitleProps{Class: "shrink-0"}) {
							Color Temp
						}
					}
					@item.Actions(item.ActionsProps{Class: "flex-1"}) {
						@slider.Slider(slider.Props{DefaultValue: []float64{70}, Max: 100})
					}
				}
				@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
					@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
						@icon.Volume2()
					}
					@item.Content(item.ContentProps{Class: "flex-row items-center gap-3"}) {
						@item.Title(item.TitleProps{Class: "shrink-0"}) {
							Volume
						}
					}
					@item.Actions(item.ActionsProps{Class: "flex-1"}) {
						@slider.Slider(slider.Props{DefaultValue: []float64{30}, Max: 100})
					}
				}
				@item.Item(item.Props{Size: item.SizeSm, Variant: item.VariantOutline}) {
					@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
						@icon.Timer()
					}
					@item.Content(item.ContentProps{Class: "flex-row items-center gap-3"}) {
						@item.Title(item.TitleProps{Class: "shrink-0"}) {
							Fade
						}
					}
					@item.Actions(item.ActionsProps{Class: "flex-1"}) {
						@slider.Slider(slider.Props{DefaultValue: []float64{0}, Max: 100})
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of kitchen-island.tsx's state: the scene toggle
		// group applies its SCENES preset to the four sliders (brightness,
		// color temp, volume, fade in DOM order), the header switch
		// enables/disables scenes and sliders. Dragging a slider changes only
		// that slider, exactly like the source.
		(() => {
			if (window.__templDemoKitchenIsland) return;
			window.__templDemoKitchenIsland = true;
			// kitchen-island.tsx SCENES, as [brightness, colorTemp, volume, fade].
			const SCENES = {
				cooking: [90, 70, 30, 0],
				dining: [50, 40, 20, 60],
				nightlight: [15, 20, 0, 80],
				focus: [100, 85, 0, 0],
			};
			// slider.js render() for the single horizontal thumb, same repeat
			// as the roller shades demo.
			const setSlider = (root, v) => {
				const min = parseFloat(root.getAttribute("data-templ-min") || "0");
				const max = parseFloat(root.getAttribute("data-templ-max") || "100");
				const f = max === min ? 0 : Math.min(1, Math.max(0, (v - min) / (max - min)));
				const thumb = root.querySelector("[data-slot=slider-thumb]");
				thumb.setAttribute("aria-valuenow", String(v));
				thumb.style.left = "calc(" + (f * 100).toFixed(4) + "% - " + (f * 12).toFixed(2) + "px)";
				const range = root.querySelector("[data-slot=slider-range]");
				range.style.left = "0";
				range.style.width = "calc(" + (f * 100).toFixed(4) + "% + " + (6 - f * 12).toFixed(2) + "px)";
			};
			document.addEventListener("toggle-group-value-change", (e) => {
				const card = e.target.closest("[data-kitchen-island]");
				if (!card) return;
				// handleSceneChange(value[0] ?? "cooking"): unpressing falls
				// back to the cooking scene.
				const scene = e.detail.value[0] || "cooking";
				const preset = SCENES[scene];
				if (!preset) return;
				card.querySelectorAll("[data-slot=slider]").forEach((root, i) => {
					if (preset[i] != null) setSlider(root, preset[i]);
				});
				const group = card.querySelector("[data-slot=toggle-group]");
				group.querySelectorAll("[data-slot=toggle-group-item]").forEach((t) => {
					const on = t.getAttribute("data-templ-value") === scene;
					t.toggleAttribute("data-pressed", on);
					t.setAttribute("aria-pressed", on ? "true" : "false");
				});
			});
			document.addEventListener("change", (e) => {
				if (!e.target.matches || !e.target.matches("[data-slot=switch] + input")) return;
				const card = e.target.closest("[data-kitchen-island]");
				if (!card) return;
				const disabled = !e.target.checked;
				card.querySelectorAll("[data-slot=toggle-group-item]").forEach((t) => {
					t.disabled = disabled;
					t.toggleAttribute("data-disabled", disabled);
				});
				// The slider's Disabled prop pendant: root + control carry
				// data-disabled (behavior + 50% opacity), the thumb loses its
				// tab stop.
				card.querySelectorAll("[data-slot=slider]").forEach((root) => {
					root.toggleAttribute("data-disabled", disabled);
					root.querySelector("[data-slot=slider-track]").parentElement.toggleAttribute("data-disabled", disabled);
					const thumb = root.querySelector("[data-slot=slider-thumb]");
					thumb.toggleAttribute("data-disabled", disabled);
					if (disabled) {
						thumb.setAttribute("aria-disabled", "true");
					} else {
						thumb.removeAttribute("aria-disabled");
					}
					thumb.setAttribute("tabindex", disabled ? "-1" : "0");
				});
			});
		})();
	</script>
}

templ cardSavingsTargets() {
	<div class="grid grid-cols-2 gap-(--gap)">
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Savings Targets
				}
				@card.Description() {
					Active milestones for 2024
				}
				@card.Action() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
						New Goal
					}
				}
			}
			@card.Content() {
				@item.Group(item.GroupProps{Class: "gap-3"}) {
					@item.Item(item.Props{Variant: item.VariantMuted, Class: "flex-col items-stretch"}) {
						@item.Content(item.ContentProps{Class: "gap-3"}) {
							@item.Description(item.DescriptionProps{Class: "cn-font-heading text-xs font-medium tracking-wider text-muted-foreground uppercase"}) {
								Retirement
							}
							<span class="text-3xl font-semibold tabular-nums">$420,000</span>
							@progress.Progress(progress.Props{Value: 65})
						}
						@item.Footer() {
							<span class="text-sm text-muted-foreground">65% achieved</span>
							<span class="text-sm font-medium tabular-nums">$273,000</span>
						}
					}
					@item.Item(item.Props{Variant: item.VariantMuted, Class: "flex-col items-stretch"}) {
						@item.Content(item.ContentProps{Class: "gap-3"}) {
							@item.Description(item.DescriptionProps{Class: "cn-font-heading text-xs font-medium tracking-wider text-muted-foreground uppercase"}) {
								Real Estate
							}
							<span class="text-3xl font-semibold tabular-nums">$85,000</span>
							@progress.Progress(progress.Props{Value: 32})
						}
						@item.Footer() {
							<span class="text-sm text-muted-foreground">32% achieved</span>
							<span class="text-sm font-medium tabular-nums">$27,200</span>
						}
					}
				}
			}
			@card.Footer() {
				@card.Description(card.DescriptionProps{Class: "text-center"}) {
					You have not met your targets for this year.
				}
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Buy Investment
				}
			}
			@card.Content(card.ContentProps{Class: "flex flex-1 flex-col gap-3"}) {
				@field.Group(field.GroupProps{Class: "flex-1"}) {
					@field.Field() {
						@field.Label(field.LabelProps{For: "invest-amount"}) {
							Amount to Invest
						}
						@inputgroup.InputGroup() {
							@inputgroup.Addon() {
								@inputgroup.Text() {
									$
								}
							}
							@inputgroup.Input(inputgroup.InputProps{ID: "invest-amount", Value: "1,000.00"})
						}
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "invest-type"}) {
							Order Type
						}
						@selectcomp.Select(selectcomp.Props{DefaultValue: "market"}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "invest-type", Class: "w-full"}) {
								@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select"})
							}
							@selectcomp.Content() {
								@selectcomp.Group() {
									@selectcomp.Item(selectcomp.ItemProps{Value: "market"}) {
										Market Order
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "limit"}) {
										Limit Order
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "stop"}) {
										Stop Order
									}
								}
							}
						}
						@field.Description() {
							Market orders execute at the current price.
						}
					}
					<div class="flex flex-col gap-2">
						<div class="flex items-center justify-between">
							<span class="text-sm text-muted-foreground">Estimated Shares</span>
							<span class="text-sm font-semibold tabular-nums">1.95</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-sm text-muted-foreground">Buying Power</span>
							<span class="text-sm font-semibold tabular-nums">$12,450.00</span>
						</div>
					</div>
				}
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-3"}) {
				@button.Button(button.Props{Class: "w-full"}) {
					Review Order
				}
				@card.Description(card.DescriptionProps{Class: "text-center"}) {
					Trades are typically executed within minutes during market hours.
				}
			}
		}
	</div>
}

type recentTransaction struct {
	icon     func(...icon.Props) templ.Component
	name     string
	category string
	date     string
	amount   string
	positive bool
}

var recentTransactions = []recentTransaction{
	{icon: icon.Coffee, name: "Blue Bottle Coffee", category: "Food & Drink", date: "Today, 10:24 AM", amount: "-$6.50"},
	{icon: icon.ShoppingCart, name: "Whole Foods Market", category: "Groceries", date: "Yesterday", amount: "-$142.30"},
	{icon: icon.Wallet, name: "Stripe Payout", category: "Income", date: "Oct 12", amount: "+$4,200.00", positive: true},
	{icon: icon.Car, name: "Uber Technologies", category: "Transport", date: "Oct 11", amount: "-$24.10"},
	{icon: icon.Tv, name: "Netflix Subscription", category: "Entertainment", date: "Oct 10", amount: "-$19.99"},
