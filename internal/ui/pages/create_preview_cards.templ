type usageItem struct {
	name       string
	value      string
	percentage float64
}

var usageItems = []usageItem{
	{name: "Edge Requests", value: "$1.83K", percentage: 67.34},
	{name: "Fast Data Transfer", value: "$952.51", percentage: 52.18},
	{name: "Monitoring data points", value: "$901.20", percentage: 89.42},
	{name: "Web Analytics Events", value: "$603.71", percentage: 45.67},
	{name: "ISR Writes", value: "524.52K / 2M", percentage: 26.23},
	{name: "Function Duration", value: "5.11 GB Hrs / 1K GB Hrs", percentage: 5.11},
}

// usageGauge is the pendant of the CircularGauge SVG of the source.
templ usageGauge(percentage float64) {
	{{
		normalized := percentage
		if normalized < 0 {
			normalized = 0
		}
		if normalized > 100 {
			normalized = 100
		}
		circumference := 2 * 3.141592653589793 * 42.5
		strokePercent := normalized / 100 * circumference
	}}
	<svg
		aria-hidden="true"
		fill="none"
		height="16"
		width="16"
		stroke-width="2"
		viewBox="0 0 100 100"
		class="-rotate-90"
	>
		<circle
			cx="50"
			cy="50"
			r="42.5"
			stroke-width="12"
			stroke-dashoffset="0"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="opacity-20"
			stroke="currentColor"
			style={ templ.SafeCSS(fmt.Sprintf("stroke-dasharray: %f %f", circumference, circumference)) }
		></circle>
		<circle
			cx="50"
			cy="50"
			r="42.5"
			stroke-width="12"
			stroke-dashoffset="0"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke="currentColor"
			class="transition-all duration-300"
			style={ templ.SafeCSS(fmt.Sprintf("stroke-dasharray: %f %f", strokePercent, circumference)) }
		></circle>
	</svg>
}

templ cardUsage() {
	@card.Card(card.Props{Class: "w-full max-w-sm gap-4"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "px-1 text-sm"}) {
				5 days remaining in cycle
			}
		}
		@card.Content() {
			@item.Group(item.GroupProps{Class: "gap-0"}) {
				for _, entry := range usageItems {
					@item.Item(item.Props{Size: item.SizeXs, Class: "px-0 group-hover/item-group:bg-transparent", Href: "#"}) {
						@item.Media(item.MediaProps{Variant: item.MediaVariantIcon, Class: "text-primary"}) {
							@usageGauge(entry.percentage)
						}
						@item.Content(item.ContentProps{Class: "inline-block truncate"}) {
							@item.Title(item.TitleProps{Class: "inline"}) {
								{ entry.name }
							}
						}
						@item.Actions() {
							<span class="font-mono text-xs font-medium text-muted-foreground tabular-nums">{ entry.value }</span>
						}
					}
				}
			}
		}
	}
}

type shortcutEntry struct {
	label string
	keys  []string
}

var shortcutEntries = []shortcutEntry{
	{label: "Search", keys: []string{"⌘", "K"}},
	{label: "Quick Actions", keys: []string{"⌘", "J"}},
	{label: "New File", keys: []string{"⌘", "N"}},
	{label: "Save", keys: []string{"⌘", "S"}},
	{label: "Toggle Sidebar", keys: []string{"⌘", "B"}},
}

templ cardShortcuts() {
	@card.Card() {
		@card.Content() {
			<div class="flex flex-col gap-3">
				<div class="text-sm font-medium">Shortcuts</div>
				@item.Group(item.GroupProps{Class: "gap-2 text-muted-foreground", Attributes: templ.Attributes{"data-size": "xs"}}) {
					for i, shortcut := range shortcutEntries {
						if i > 0 {
							@item.Separator()
						}
						@item.Item(item.Props{Variant: item.VariantDefault, Size: item.SizeXs, Class: "border-0 px-0 py-0"}) {
							@item.Header() {
								@item.Title(item.TitleProps{Class: "font-normal"}) {
									{ shortcut.label }
								}
								@item.Actions() {
									<div class="flex gap-1">
										for _, key := range shortcut.keys {
											@kbd.Kbd() {
												{ key }
											}
										}
									</div>
								}
							}
						}
					}
				}
			</div>
		}
	}
}

templ cardAnomalyAlert() {
	@card.Card() {
		@card.Content() {
			@empty.Empty(empty.Props{Class: "h-48"}) {
				@empty.Header() {
					@empty.Title() {
						Get alerted for anomalies
					}
					@empty.Description() {
						Automatically monitor your projects for anomalies and get notified.
					}
				}
				@empty.Content() {
					@button.Button() {
						Upgrade to Observability Plus
					}
				}
			}
		}
	}
}

// cardLiveWaveform renders the reference card in its idle waveform state:
// the live canvas animation is microphone-driven React code that has no
// server-side pendant.
templ cardLiveWaveform() {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-live-waveform": ""}}) {
		@card.Header() {
			@card.Title() {
				Live Audio Waveform
			}
			@card.Description() {
				Real-time microphone input visualization with audio reactivity
			}
		}
		@card.Content() {
			// Initial state of the source card: processing on, so the idle
			// dotted line starts hidden.
			<div data-waveform class="relative h-full w-full" style="height: 80px" aria-label="Processing audio" role="img">
				<div data-waveform-idle hidden class="absolute top-1/2 right-0 left-0 -translate-y-1/2 border-t-2 border-dotted border-muted-foreground/20"></div>
				<canvas class="block h-full w-full" aria-hidden="true"></canvas>
			</div>
		}
		@card.Footer(card.FooterProps{Class: "gap-2"}) {
			@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-waveform-listen": ""}}) {
				Start Listening
			}
			@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-waveform-process": ""}}) {
				Stop Processing
			}
			@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-waveform-mode": ""}}) {
				Static
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of live-waveform.tsx: the LiveWaveform canvas
		// component with the card's props baked in (height 80, barWidth 3,
		// barGap 2, fadeEdges, barColor "gray", historySize 120) plus the
		// card's active/processing/mode state and its three buttons.
		(() => {
			const card = document.querySelector("[data-live-waveform]");
			if (!card || card.hasAttribute("data-waveform-initialized")) return;
			card.setAttribute("data-waveform-initialized", "");

			const container = card.querySelector("[data-waveform]");
			const idleLine = card.querySelector("[data-waveform-idle]");
			const canvas = container.querySelector("canvas");
			const ctx = canvas.getContext("2d");
			const listenBtn = card.querySelector("[data-waveform-listen]");
			const processBtn = card.querySelector("[data-waveform-process]");
			const modeBtn = card.querySelector("[data-waveform-mode]");

			// The card's LiveWaveform props and the component defaults.
			const BAR_WIDTH = 3;
			const BAR_GAP = 2;
			const BAR_RADIUS = 1.5;
			const BASE_BAR_HEIGHT = 4;
			const SENSITIVITY = 1;
			const SMOOTHING = 0.8;
			const FFT_SIZE = 256;
			const HISTORY_SIZE = 120;
			const UPDATE_RATE = 30;
			const FADE_WIDTH = 24;
			const BAR_COLOR = "gray";

			// Card state (useState) and the component's refs.
			let active = false;
			let processing = true;
			let mode = "static";
			let history = [];
			let staticBars = [];
			let lastActiveData = [];
			let transitionProgress = 0;
			let needsRedraw = true;
			let gradientCache = null;
			let lastWidth = 0;
			let lastUpdate = 0;
			let procRaf = 0;
			let analyser = null;
			let audioContext = null;
			let stream = null;

			// Canvas resizing effect.
			new ResizeObserver(() => {
				const rect = container.getBoundingClientRect();
				const dpr = window.devicePixelRatio || 1;
				canvas.width = rect.width * dpr;
				canvas.height = rect.height * dpr;
				canvas.style.width = rect.width + "px";
				canvas.style.height = rect.height + "px";
				ctx.scale(dpr, dpr);
				gradientCache = null;
				lastWidth = rect.width;
				needsRedraw = true;
			}).observe(container);

			// The processing/idle effect ([processing, active, mode] deps).
			const syncProcessing = () => {
				if (procRaf) {
					cancelAnimationFrame(procRaf);
					procRaf = 0;
				}
				if (processing && !active) {
					let time = 0;
					transitionProgress = 0;
					const animateProcessing = () => {
						time += 0.03;
						transitionProgress = Math.min(1, transitionProgress + 0.02);
						const processingData = [];
						const barCount = Math.floor(
							(container.getBoundingClientRect().width || 200) / (BAR_WIDTH + BAR_GAP)
						);
						if (mode === "static") {
							const halfCount = Math.floor(barCount / 2);
							for (let i = 0; i < barCount; i++) {
								const normalizedPosition = (i - halfCount) / halfCount;
								const centerWeight = 1 - Math.abs(normalizedPosition) * 0.4;
								const wave1 = Math.sin(time * 1.5 + normalizedPosition * 3) * 0.25;
								const wave2 = Math.sin(time * 0.8 - normalizedPosition * 2) * 0.2;
								const wave3 = Math.cos(time * 2 + normalizedPosition) * 0.15;
								const processingValue = (0.2 + wave1 + wave2 + wave3) * centerWeight;
								let finalValue = processingValue;
								if (lastActiveData.length > 0 && transitionProgress < 1) {
									const lastValue = lastActiveData[Math.min(i, lastActiveData.length - 1)] || 0;
									finalValue = lastValue * (1 - transitionProgress) + processingValue * transitionProgress;
								}
								processingData.push(Math.max(0.05, Math.min(1, finalValue)));
							}
						} else {
							for (let i = 0; i < barCount; i++) {
								const normalizedPosition = (i - barCount / 2) / (barCount / 2);
								const centerWeight = 1 - Math.abs(normalizedPosition) * 0.4;
								const wave1 = Math.sin(time * 1.5 + i * 0.15) * 0.25;
								const wave2 = Math.sin(time * 0.8 - i * 0.1) * 0.2;
								const wave3 = Math.cos(time * 2 + i * 0.05) * 0.15;
								const processingValue = (0.2 + wave1 + wave2 + wave3) * centerWeight;
								let finalValue = processingValue;
								if (lastActiveData.length > 0 && transitionProgress < 1) {
									const lastValue = lastActiveData[Math.floor((i / barCount) * lastActiveData.length)] || 0;
									finalValue = lastValue * (1 - transitionProgress) + processingValue * transitionProgress;
								}
								processingData.push(Math.max(0.05, Math.min(1, finalValue)));
							}
						}
						if (mode === "static") {
							staticBars = processingData;
						} else {
							history = processingData;
						}
						needsRedraw = true;
						procRaf = requestAnimationFrame(animateProcessing);
					};
					animateProcessing();
				} else if (!active && !processing) {
					const hasData = mode === "static" ? staticBars.length > 0 : history.length > 0;
					if (hasData) {
						let fadeProgress = 0;
						const fadeToIdle = () => {
							fadeProgress += 0.03;
							if (fadeProgress < 1) {
								if (mode === "static") {
									staticBars = staticBars.map((value) => value * (1 - fadeProgress));
								} else {
									history = history.map((value) => value * (1 - fadeProgress));
								}
								needsRedraw = true;
								requestAnimationFrame(fadeToIdle);
							} else if (mode === "static") {
								staticBars = [];
							} else {
								history = [];
							}
						};
						fadeToIdle();
					}
				}
			};

			// The microphone setup/teardown effect ([active] deps).
			const syncMic = () => {
				if (!active) {
					if (stream) {
						stream.getTracks().forEach((track) => track.stop());
						stream = null;
					}
					if (audioContext && audioContext.state !== "closed") {
						audioContext.close();
					}
					audioContext = null;
					analyser = null;
					return;
				}
				navigator.mediaDevices
					.getUserMedia({
						audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
					})
					.then((s) => {
						stream = s;
						const AC = window.AudioContext || window.webkitAudioContext;
						audioContext = new AC();
						analyser = audioContext.createAnalyser();
						analyser.fftSize = FFT_SIZE;
						analyser.smoothingTimeConstant = SMOOTHING;
						audioContext.createMediaStreamSource(s).connect(analyser);
						history = [];
					})
					.catch(() => {});
			};

			// The persistent draw loop.
			const animate = (currentTime) => {
				const rect = canvas.getBoundingClientRect();
				if (active && currentTime - lastUpdate > UPDATE_RATE) {
					lastUpdate = currentTime;
					if (analyser) {
						const dataArray = new Uint8Array(analyser.frequencyBinCount);
						analyser.getByteFrequencyData(dataArray);
						const startFreq = Math.floor(dataArray.length * 0.05);
						const endFreq = Math.floor(dataArray.length * 0.4);
						const relevantData = dataArray.slice(startFreq, endFreq);
						if (mode === "static") {
							const barCount = Math.floor(rect.width / (BAR_WIDTH + BAR_GAP));
							const halfCount = Math.floor(barCount / 2);
							const newBars = [];
							for (let i = halfCount - 1; i >= 0; i--) {
								const dataIndex = Math.floor((i / halfCount) * relevantData.length);
								newBars.push(Math.max(0.05, Math.min(1, (relevantData[dataIndex] / 255) * SENSITIVITY)));
							}
							for (let i = 0; i < halfCount; i++) {
								const dataIndex = Math.floor((i / halfCount) * relevantData.length);
								newBars.push(Math.max(0.05, Math.min(1, (relevantData[dataIndex] / 255) * SENSITIVITY)));
							}
							staticBars = newBars;
							lastActiveData = newBars;
						} else {
							let sum = 0;
							for (let i = 0; i < relevantData.length; i++) {
								sum += relevantData[i];
							}
							const average = (sum / relevantData.length / 255) * SENSITIVITY;
							history.push(Math.min(1, Math.max(0.05, average)));
							lastActiveData = [...history];
							if (history.length > HISTORY_SIZE) {
								history.shift();
							}
						}
						needsRedraw = true;
					}
				}
				if (!needsRedraw && !active) {
					requestAnimationFrame(animate);
					return;
				}
				needsRedraw = active;
				ctx.clearRect(0, 0, rect.width, rect.height);
				const step = BAR_WIDTH + BAR_GAP;
				const barCount = Math.floor(rect.width / step);
				const centerY = rect.height / 2;
				const bars = mode === "static" ? staticBars : history;
				for (let i = 0; i < barCount && i < bars.length; i++) {
					const value = (mode === "static" ? bars[i] : bars[bars.length - 1 - i]) || 0.1;
					const x = mode === "static" ? i * step : rect.width - (i + 1) * step;
					const bh = Math.max(BASE_BAR_HEIGHT, value * rect.height * 0.8);
					const y = centerY - bh / 2;
					ctx.fillStyle = BAR_COLOR;
					ctx.globalAlpha = 0.4 + value * 0.6;
					if (BAR_RADIUS > 0) {
						ctx.beginPath();
						ctx.roundRect(x, y, BAR_WIDTH, bh, BAR_RADIUS);
						ctx.fill();
					} else {
						ctx.fillRect(x, y, BAR_WIDTH, bh);
					}
				}
				if (FADE_WIDTH > 0 && rect.width > 0) {
					if (!gradientCache || lastWidth !== rect.width) {
						const gradient = ctx.createLinearGradient(0, 0, rect.width, 0);
						const fadePercent = Math.min(0.3, FADE_WIDTH / rect.width);
						gradient.addColorStop(0, "rgba(255,255,255,1)");
						gradient.addColorStop(fadePercent, "rgba(255,255,255,0)");
						gradient.addColorStop(1 - fadePercent, "rgba(255,255,255,0)");
						gradient.addColorStop(1, "rgba(255,255,255,1)");
						gradientCache = gradient;
						lastWidth = rect.width;
					}
					ctx.globalCompositeOperation = "destination-out";
					ctx.fillStyle = gradientCache;
					ctx.fillRect(0, 0, rect.width, rect.height);
					ctx.globalCompositeOperation = "source-over";
				}
				ctx.globalAlpha = 1;
				requestAnimationFrame(animate);
			};
			requestAnimationFrame(animate);

			const setVariant = (btn, on) => {
				btn.classList.toggle("cn-button-variant-default", on);
				btn.classList.toggle("cn-button-variant-outline", !on);
			};
			const syncUI = () => {
				idleLine.hidden = active || processing;
				container.setAttribute(
					"aria-label",
					active ? "Live audio waveform" : processing ? "Processing audio" : "Audio waveform idle"
				);
				setVariant(listenBtn, active);
				listenBtn.textContent = (active ? "Stop" : "Start") + " Listening";
				setVariant(processBtn, processing);
				processBtn.textContent = (processing ? "Stop" : "Start") + " Processing";
				modeBtn.textContent = mode === "static" ? "Static" : "Scrolling";
			};

			listenBtn.addEventListener("click", () => {
				active = !active;
				if (active) processing = false;
				syncMic();
				syncProcessing();
				syncUI();
			});
			processBtn.addEventListener("click", () => {
				processing = !processing;
				if (processing) active = false;
				syncMic();
				syncProcessing();
				syncUI();
			});
			modeBtn.addEventListener("click", () => {
				mode = mode === "static" ? "scrolling" : "static";
				syncProcessing();
				syncUI();
			});

			// Initial state: processing runs from mount.
			syncProcessing();
		})();
	</script>
}

var visitorsChartData = []chart.Datum{
	{"month": "January", "desktop": 186},
	{"month": "February", "desktop": 305},
	{"month": "March", "desktop": 237},
	{"month": "April", "desktop": 73},
	{"month": "May", "desktop": 209},
	{"month": "June", "desktop": 214},
}

var visitorsChartConfig = chart.Config{
	{Key: "desktop", Label: "Desktop", Color: "var(--chart-1)"},
}

// visitorsTrend mirrors the source's trend math: 214 vs 209 is +2%.
func visitorsTrend() string {
	latest := visitorsChartData[len(visitorsChartData)-1]["desktop"].(int)
	previous := visitorsChartData[len(visitorsChartData)-2]["desktop"].(int)
	trend := int(float64(latest-previous)/float64(previous)*100 + 0.5)
	prefix := ""
	if trend > 0 {
		prefix = "+"
	}
	return fmt.Sprintf("%s%d%% vs last month", prefix, trend)
}

templ cardVisitors() {
	@card.Card(card.Props{Class: "pb-0"}) {
		@card.Header() {
			@card.Title() {
				Visitors
			}
			@card.Description() {
				Last 6 months
			}
			@card.Action() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ visitorsTrend() }
				}
			}
		}
		@card.Content(card.ContentProps{Class: "px-0"}) {
			@chart.Container(chart.ContainerProps{ID: "p1-visitors", Config: visitorsChartConfig, Class: "h-48 w-full"}) {
				@chart.AreaChart(chart.AreaChartProps{
					AccessibilityLayer: true,
					Data:               visitorsChartData,
					Margin:             &chart.Margin{Left: 0, Right: 0, Top: 6, Bottom: 0},
				}) {
					@chart.XAxis(chart.XAxisProps{DataKey: "month", Hide: true, TickMargin: 6})
					@chart.Tooltip(chart.TooltipProps{
						Cursor:  chart.Bool(false),
						Content: chart.TooltipContentProps{Indicator: "line"},
					})
					// strokeWidth={2} of the source is not portable: chart.AreaProps
					// has no stroke width prop.
					@chart.Area(chart.AreaProps{
						DataKey:     "desktop",
						Type:        chart.CurveNatural,
						Fill:        "var(--color-desktop)",
						FillOpacity: 0.15,
						Stroke:      "var(--color-desktop)",
					})
				}
			}
		}
	}
}

templ cardContributionsActivity() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Contributions & Activity
			}
			@card.Description() {
				Manage your contributions and activity visibility.
			}
		}
		@card.Content() {
			<form id="contributions-activity">
				@field.Group() {
					@field.Set() {
						@field.Legend(field.LegendProps{Class: "sr-only"}) {
							Contributions & activity
						}
						@field.Group() {
							@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
								@checkbox.Checkbox(checkbox.Props{ID: "activity-private-profile"})
								@field.Content() {
									@field.Label(field.LabelProps{For: "activity-private-profile"}) {
										Make profile private and hide activity
									}
									@field.Description() {
										Enabling this will hide your contributions and activity
										from your GitHub profile and from social features like
										followers, stars, feeds, leaderboards and releases.
									}
								}
							}
						}
					}
				}
			</form>
		}
		@card.Footer() {
			@button.Button(button.Props{Form: "contributions-activity", Class: "style-sera:w-full"}) {
				Save Changes
			}
		}
	}
}

templ cardNotFound() {
	@card.Card() {
		@card.Content() {
			@empty.Empty(empty.Props{Class: "h-72"}) {
				@empty.Header() {
					@empty.Title() {
						404 - Not Found
					}
					@empty.Description() {
						The page you're looking for doesn't exist. Try searching for what you need below.
					}
				}
				@empty.Content() {
					@inputgroup.InputGroup(inputgroup.Props{Class: "w-3/4"}) {
						@inputgroup.Input(inputgroup.InputProps{Placeholder: "Try searching for pages..."})
						@inputgroup.Addon() {
							@icon.Search()
						}
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@kbd.Kbd() {
								/
							}
						}
					}
					@button.Button(button.Props{Variant: button.VariantLink}) {
						Go to homepage
					}
				}
			}
		}
	}
}
