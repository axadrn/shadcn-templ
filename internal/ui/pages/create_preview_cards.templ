				@icon.Copy()
			}
		}
		@inputgroup.Input(inputgroup.InputProps{ID: id, Value: value, Attributes: templ.Attributes{"readonly": true}})
	}
}

type invoiceItem struct {
	item      string
	qty       int
	unitPrice int
}

var invoiceItems = []invoiceItem{
	{item: "Design System License", qty: 1, unitPrice: 499},
	{item: "Priority Support", qty: 12, unitPrice: 99},
	{item: "Custom Components", qty: 3, unitPrice: 250},
}

// invoiceUSD is the pendant of the Intl.NumberFormat en-US currency
// formatter of the source.
func invoiceUSD(value int) string {
	s := fmt.Sprintf("%d", value)
	out := ""
	for i, r := range s {
		if i > 0 && (len(s)-i)%3 == 0 {
			out += ","
		}
		out += string(r)
	}
	return "$" + out + ".00"
}

func invoiceSubtotal() int {
	sum := 0
	for _, row := range invoiceItems {
		sum += row.qty * row.unitPrice
	}
	return sum
}

templ cardInvoice() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Invoice #INV-2847
			}
			@card.Description() {
				Due March 30, 2026
			}
			@card.Action() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					Pending
				}
			}
		}
		@card.Content() {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Item
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Qty
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Rate
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Amount
						}
					}
				}
				@table.Body() {
					for _, row := range invoiceItems {
						@table.Row() {
							@table.Cell() {
								{ row.item }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ fmt.Sprintf("%d", row.qty) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ invoiceUSD(row.unitPrice) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ invoiceUSD(row.qty * row.unitPrice) }
							}
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "text-right", Attributes: templ.Attributes{"colspan": "3"}}) {
							Subtotal
						}
						@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
							{ invoiceUSD(invoiceSubtotal()) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "text-right", Attributes: templ.Attributes{"colspan": "3"}}) {
							Tax
						}
						@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
							$0.00
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "text-right", Attributes: templ.Attributes{"colspan": "3"}}) {
							Total Due
						}
						@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
							{ invoiceUSD(invoiceSubtotal()) }
						}
					}
				}
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				Download PDF
			}
			@button.Button(button.Props{Size: button.SizeSm, Class: "ml-auto"}) {
				Pay Now
			}
		}
	}
}

