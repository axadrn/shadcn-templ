templ cardReportBug() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Report Bug
			}
			@card.Description() {
				Help us fix issues faster.
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "bug-title"}) {
						Title
					}
					@input.Input(input.Props{ID: "bug-title", Placeholder: "Brief description of the issue"})
				}
				<div class="grid grid-cols-2 gap-3">
					@field.Field() {
						@field.Label(field.LabelProps{For: "bug-severity"}) {
							Severity
						}
						@selectcomp.Select(selectcomp.Props{DefaultValue: "medium"}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "bug-severity", Class: "w-full"}) {
								@selectcomp.Value()
							}
							@selectcomp.Content() {
								@selectcomp.Group() {
									@selectcomp.Item(selectcomp.ItemProps{Value: "critical"}) {
										Critical
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "high"}) {
										High
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "medium"}) {
										Medium
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "low"}) {
										Low
									}
								}
							}
						}
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "bug-component"}) {
							Component
						}
						@selectcomp.Select(selectcomp.Props{DefaultValue: "dashboard"}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "bug-component", Class: "w-full"}) {
								@selectcomp.Value()
							}
							@selectcomp.Content() {
								@selectcomp.Group() {
									@selectcomp.Item(selectcomp.ItemProps{Value: "dashboard"}) {
										Dashboard
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "auth"}) {
										Auth
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "api"}) {
										API
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: "billing"}) {
										Billing
									}
								}
							}
						}
					}
				</div>
				@field.Field() {
					@field.Label(field.LabelProps{For: "bug-steps"}) {
						Steps to reproduce
					}
					@textarea.Textarea(textarea.Props{ID: "bug-steps", Placeholder: "1. Go to\n2. Click on\n3. Observe...", Class: "min-h-24 resize-none"})
				}
			}
		}
		@card.Footer() {
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "justify-end style-sera:justify-center"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "style-sera:flex-1"}) {
					Attach File
				}
				@button.Button(button.Props{Class: "style-sera:flex-1"}) {
					Submit Bug
				}
			}
		}
	}
}

