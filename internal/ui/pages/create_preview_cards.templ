var barChartCardData = []chart.Datum{
	{"month": "January", "desktop": 186, "mobile": 80},
	{"month": "February", "desktop": 305, "mobile": 200},
	{"month": "March", "desktop": 237, "mobile": 120},
	{"month": "April", "desktop": 73, "mobile": 190},
	{"month": "May", "desktop": 209, "mobile": 130},
	{"month": "June", "desktop": 214, "mobile": 140},
}

var barChartCardConfig = chart.Config{
	{Key: "desktop", Label: "Desktop", Color: "var(--chart-1)"},
	{Key: "mobile", Label: "Mobile", Color: "var(--chart-2)"},
}

func barChartCardTotal(series string) int {
	sum := 0
	for _, d := range barChartCardData {
		sum += d[series].(int)
	}
	return sum
}

// barChartCardTotals mirrors the source's toLocaleString and delta math.
func barChartCardTotalString(series string) string {
	s := fmt.Sprintf("%d", barChartCardTotal(series))
	out := ""
	for i, r := range s {
		if i > 0 && (len(s)-i)%3 == 0 {
			out += ","
		}
		out += string(r)
	}
	return out
}

func barChartCardDelta() string {
	desktop := barChartCardTotal("desktop")
	mobile := barChartCardTotal("mobile")
	delta := int(float64(desktop-mobile)/float64(mobile)*100 + 0.5)
	prefix := ""
	if delta > 0 {
		prefix = "+"
	}
	return fmt.Sprintf("%s%d%%", prefix, delta)
}

func barChartCardMonthShort(v any) string {
	return v.(string)[:3]
}

templ cardBarChart() {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-lg"}) {
				Traffic channels
			}
			@card.Description(card.DescriptionProps{Class: "line-clamp-2 text-sm leading-snug"}) {
				Monthly desktop and mobile traffic for the last six months—compare
				volume and mix across platforms and devices at a glance.
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4 pt-0"}) {
			@chart.Container(chart.ContainerProps{ID: "p1-bar-chart", Config: barChartCardConfig, Class: "max-h-[180px] w-full"}) {
				@chart.BarChart(chart.BarChartProps{
					AccessibilityLayer: true,
					Data:               barChartCardData,
					Margin:             &chart.Margin{Left: 0, Right: 0, Top: 8, Bottom: 0},
				}) {
					@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
					@chart.XAxis(chart.XAxisProps{DataKey: "month", TickMargin: 8, TickFormatter: barChartCardMonthShort})
					@chart.Tooltip(chart.TooltipProps{
						Cursor:  chart.Bool(false),
						Content: chart.TooltipContentProps{Indicator: "dashed"},
					})
					@chart.Legend()
					@chart.Bar(chart.BarProps{DataKey: "desktop", Fill: "var(--color-desktop)", Radius: []float64{6, 6, 0, 0}})
					@chart.Bar(chart.BarProps{DataKey: "mobile", Fill: "var(--color-mobile)", Radius: []float64{6, 6, 0, 0}})
				}
			}
			<div class="grid w-full grid-cols-3 divide-x divide-border/60">
				<div class="px-2 text-center">
					<div class="text-[0.65rem] text-muted-foreground uppercase">Desktop</div>
					<div class="text-sm font-medium tabular-nums">{ barChartCardTotalString("desktop") }</div>
				</div>
				<div class="px-2 text-center">
					<div class="text-[0.65rem] text-muted-foreground uppercase">Mobile</div>
					<div class="text-sm font-medium tabular-nums">{ barChartCardTotalString("mobile") }</div>
				</div>
				<div class="px-2 text-center">
					<div class="text-[0.65rem] text-muted-foreground uppercase">Mix Delta</div>
					<div class="text-sm font-medium tabular-nums">{ barChartCardDelta() }</div>
				</div>
			</div>
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				View report
			}
		}
	}
}

