templ cardQrConnect() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex justify-center pt-6"}) {
			<div class="rounded-xl border bg-white p-4">
				<svg width="160" height="160" viewBox="0 0 29 29" shape-rendering="crispEdges" role="img" aria-label="QR code for https://ledger.app/connect/jd-4829">
					<path fill="#000000" d={ qrConnectPath }></path>
				</svg>
			</div>
		}
		@card.Header(card.HeaderProps{Class: "text-center"}) {
			@card.Title() {
				Scan to connect your mobile device
			}
			@card.Description() {
				Open the Ledger mobile app and scan this code to link your device.
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Variant: button.VariantSecondary, Class: "w-full"}) {
				Got it
			}
		}
	}
}

