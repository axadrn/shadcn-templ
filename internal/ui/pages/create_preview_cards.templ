templ cardReleaseCatalog() {
	@card.Card() {
		@card.Header() {
			<div class="flex items-center justify-between gap-3">
				@inputgroup.InputGroup(inputgroup.Props{Class: "max-w-sm"}) {
					@inputgroup.Addon() {
						@icon.Search()
					}
					@inputgroup.Input(inputgroup.InputProps{Placeholder: "Search holdings or tickers..."})
				}
				@togglegroup.ToggleGroup(togglegroup.Props{
					Variant:      togglegroup.VariantOutline,
					Spacing:      utils.Ptr(1),
					DefaultValue: []string{"etfs"},
				}) {
					@togglegroup.Item(togglegroup.ItemProps{Value: "stocks"}) {
						Stocks
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "etfs"}) {
						ETFs
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "reits"}) {
						REITs
					}
				}
			</div>
		}
		@card.Content() {
			@item.Group() {
				for _, holding := range catalogHoldings {
					@item.Item(item.Props{Variant: item.VariantMuted}) {
						@item.Media() {
							<div class="flex size-12 items-center justify-center rounded-lg border text-sm font-semibold">
								{ holding.ticker }
							</div>
						}
						@item.Content() {
							@item.Title() {
								{ holding.name }
							}
							@item.Description(item.DescriptionProps{Class: "text-xs tracking-wider uppercase"}) {
								{ holding.shares } Shares · { holding.added }
							}
						}
						<div class="flex shrink-0 items-center gap-6">
							@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
								{ holding.typ }
							}
							<div class="flex flex-col items-end gap-0.5">
								<span class="text-xs tracking-wider text-muted-foreground uppercase">Value</span>
								<span class="font-medium tabular-nums">{ holding.value }</span>
							</div>
						</div>
					}
				}
			}
		}
	}
}

templ cardAccountAccess() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Account Access
			}
			@card.Description() {
				Update your credentials or re-authenticate.
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "email-address"}) {
						Email Address
					}
					@input.Input(input.Props{ID: "email-address", Type: "email", Value: "artist@studio.inc"})
				}
				@field.Field() {
					<div class="flex items-center justify-between">
						@field.Label(field.LabelProps{For: "current-password"}) {
							Current Password
						}
						<a href="#" class="text-xs font-medium tracking-wider text-muted-foreground uppercase hover:text-foreground">
							Forgot?
						</a>
					</div>
					@input.Input(input.Props{ID: "current-password", Type: "password", Value: "password123"})
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col gap-4"}) {
			@button.Button(button.Props{Class: "w-full"}) {
				@icon.LockKeyhole()
				Update Security
			}
			@item.Item(item.Props{Variant: item.VariantMuted, Href: "#"}) {
				@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
					@icon.CircleAlert(icon.Props{Class: "text-destructive"})
				}
				@item.Content() {
					@item.Title() {
						Danger Zone
					}
					@item.Description(item.DescriptionProps{Class: "line-clamp-1"}) {
						Archive account and remove catalog
					}
				}
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		}
	}
}

var cardOverviewActivityData = []chart.Datum{
	{"month": "Jan", "amount": 40},
	{"month": "Feb", "amount": 55},
	{"month": "Mar", "amount": 35},
	{"month": "Apr", "amount": 60},
	{"month": "May", "amount": 45},
	{"month": "Jun", "amount": 50},
	{"month": "Jul", "amount": 65},
	{"month": "Aug", "amount": 40},
	{"month": "Sep", "amount": 55},
	{"month": "Oct", "amount": 70},
	{"month": "Nov", "amount": 45},
	{"month": "Dec", "amount": 80},
}

var cardOverviewChartConfig = chart.Config{
	{Key: "amount", Label: "Activity", Color: "var(--chart-2)"},
}

func cardOverviewMonthInitial(v any) string {
	return v.(string)[:1]
}

templ cardOverview() {
	<div class="grid grid-cols-2 gap-3">
		@card.Card() {
			@card.Content() {
				@card.Description() {
					Card Balance
				}
				@card.Title(card.TitleProps{Class: "text-2xl tabular-nums"}) {
					US$12.94
				}
				@card.Description(card.DescriptionProps{Class: "tabular-nums"}) {
					US$11,337.06 Available
				}
			}
		}
		@card.Card(card.Props{Class: "flex flex-col justify-between"}) {
			@card.Content(card.ContentProps{Class: "flex flex-1 flex-col justify-between"}) {
				<div class="flex flex-col gap-1">
					@card.Description() {
						Payment Due
					}
					@card.Title(card.TitleProps{Class: "text-2xl"}) {
						1 Apr
					}
				</div>
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "mt-3 w-full"}) {
					Pay Early
				}
			}
		}
		@card.Card(card.Props{Class: "col-span-2"}) {
			@card.Content(card.ContentProps{Class: "flex flex-col gap-2"}) {
				<div class="flex items-center justify-between">
					@card.Description() {
						Yearly Activity
					}
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						+US$0.25 Daily Cash
					}
				</div>
				@chart.Container(chart.ContainerProps{ID: "p02-card-overview", Config: cardOverviewChartConfig, Class: "h-20 w-full"}) {
					@chart.BarChart(chart.BarChartProps{
						Data:   cardOverviewActivityData,
						Margin: &chart.Margin{Top: 4, Right: 0, Bottom: 0, Left: 0},
					}) {
						@chart.XAxis(chart.XAxisProps{DataKey: "month", TickMargin: 4, TickFormatter: cardOverviewMonthInitial})
						@chart.Tooltip(chart.TooltipProps{
							Cursor:  chart.Bool(false),
							Content: chart.TooltipContentProps{HideLabel: true},
						})
						@chart.Bar(chart.BarProps{DataKey: "amount", Fill: "var(--color-amount)", Radius: []float64{3, 3, 0, 0}})
					}
				}
			}
		}
	</div>
}

type transferAccount struct {
	label string
	value string
}

var transferFromAccounts = []transferAccount{
	{label: "Main Checking (··8402) — $12,450.00", value: "checking"},
	{label: "Business (··7731) — $8,920.00", value: "business"},
}

var transferToAccounts = []transferAccount{
	{label: "High Yield Savings (··1192) — $42,100.00", value: "savings"},
	{label: "Investment (··3349) — $18,200.00", value: "investment"},
}

templ cardTransferFunds() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Transfer Funds
			}
			@card.Description() {
				Move money between your connected accounts.
			}
			@card.Action() {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "bg-muted"}) {
					@icon.X()
				}
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "transfer-amount"}) {
						Amount to Transfer
					}
					@inputgroup.InputGroup() {
						@inputgroup.Addon() {
							@inputgroup.Text() {
								$
							}
						}
						@inputgroup.Input(inputgroup.InputProps{ID: "transfer-amount", Value: "1,200.00"})
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "from-account"}) {
						From Account
					}
					@transferAccountSelect("from-account", transferFromAccounts, "checking")
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "to-account"}) {
						To Account
					}
					@transferAccountSelect("to-account", transferToAccounts, "savings")
				}
				@item.Item(item.Props{Variant: item.VariantMuted, Class: "flex-col items-stretch"}) {
					@item.Content(item.ContentProps{Class: "gap-3"}) {
						<div class="flex items-center justify-between">
							<span class="text-sm text-muted-foreground">Estimated arrival</span>
							<span class="text-sm font-medium">Today, Apr 14</span>
						</div>
						@separator.Separator()
						<div class="flex items-center justify-between">
							<span class="text-sm text-muted-foreground">Transaction fee</span>
							<span class="text-sm font-medium tabular-nums">$0.00</span>
						</div>
						@separator.Separator()
						<div class="flex items-center justify-between">
							<span class="text-sm font-medium">Total amount</span>
							<span class="text-sm font-semibold tabular-nums">$1,200.00</span>
						</div>
					}
				}
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				Confirm Transfer
			}
		}
	}
}

templ transferAccountSelect(id string, accounts []transferAccount, selected string) {
	@selectcomp.Select(selectcomp.Props{DefaultValue: selected}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{ID: id, Class: "w-full"}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				for _, account := range accounts {
					@selectcomp.Item(selectcomp.ItemProps{Value: account.value}) {
						{ account.label }
					}
				}
			}
		}
	}
}

templ cardCoverArt() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-3"}) {
			@label.Label(label.Props{For: "cover-art", Class: "text-center text-xs font-normal tracking-wider text-muted-foreground uppercase"}) {
				Cover Art
			}
