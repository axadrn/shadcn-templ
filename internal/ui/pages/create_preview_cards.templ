templ cardSidebarNav() {
	<div class="grid grid-cols-2 items-start gap-6">
		@sidebarNavCard(sidebarNavLeft)
		@sidebarNavCard(sidebarNavRight)
	</div>
}

templ sidebarNavCard(groups []sidebarNavGroup) {
	@card.Card(card.Props{Class: "overflow-hidden py-0"}) {
		@sidebar.Provider(sidebar.ProviderProps{Class: "min-h-0"}) {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleNone, Class: "w-full bg-transparent"}) {
				@sidebar.Content(sidebar.ContentProps{Class: "gap-0"}) {
					for i, group := range groups {
						if i > 0 {
							@sidebar.Separator(sidebar.SeparatorProps{Class: "w-auto!"})
						}
						@sidebar.Group(sidebar.GroupProps{Class: utils.IfElse(i == 0, "pb-1", "pt-1")}) {
							@sidebar.GroupLabel() {
								{ group.label }
							}
							@sidebar.GroupContent() {
								@sidebar.Menu() {
									for _, entry := range group.entries {
										@sidebar.MenuItem() {
											@sidebar.MenuButton(sidebar.MenuButtonProps{IsActive: entry.active}) {
												@entry.icon()
												{ entry.label }
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ cardPayments() {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "flex flex-col gap-3"}) {
			@breadcrumb.Breadcrumb() {
				@breadcrumb.List() {
					@breadcrumb.Item() {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "#"}) {
							Home
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item() {
						@dropdownmenu.DropdownMenu() {
							@button.Button(button.Props{Size: button.SizeIconSm, Variant: button.VariantGhost, Attributes: dropdownmenu.Trigger(ctx)}) {
								@icon.Ellipsis()
								<span class="sr-only">Account options</span>
							}
							@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignStart}) {
								@dropdownmenu.Group() {
									@dropdownmenu.Item() {
										Profile
									}
									@dropdownmenu.Item() {
										Statements
									}
									@dropdownmenu.Item() {
										Documents
									}
								}
							}
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item() {
						@breadcrumb.Page() {
							Payments
						}
					}
				}
			}
		}
		@card.Content() {
			@item.Group() {
				@paymentItem(icon.Gauge, "Change transfer limit", "Adjust how much you can send from your balance.")
				@paymentItem(icon.Calendar, "Scheduled transfers", "Set up a transfer to send at a later date.")
				@paymentItem(icon.Repeat, "Direct Debits", "Set up and manage regular payments.")
				@paymentItem(icon.RefreshCw, "Recurring card payments", "Manage your repeated card transactions.")
			}
		}
	}
}

templ paymentItem(iconFn func(...icon.Props) templ.Component, title, description string) {
	@item.Item(item.Props{Variant: item.VariantMuted, Href: "#"}) {
		@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
			@iconFn()
		}
		@item.Content() {
			@item.Title() {
				{ title }
			}
			@item.Description() {
				{ description }
			}
		}
		@icon.ChevronRight(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
	}
}

templ cardFrontDoor() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Front Door
			}
			@card.Description() {
				Smart Lock Pro
			}
