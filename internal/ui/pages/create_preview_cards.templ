type notificationSetting struct {
	id          string
	label       string
	description string
	checked     bool
}

var notificationSettings = []notificationSetting{
	{id: "transactions", label: "Transaction alerts", description: "Deposits, withdrawals, and transfers.", checked: true},
	{id: "security", label: "Security alerts", description: "Login attempts and account changes.", checked: true},
	{id: "goals", label: "Goal milestones", description: "Updates at 25%, 50%, 75%, and 100%.", checked: false},
	{id: "market", label: "Market updates", description: "Daily portfolio summary and price alerts.", checked: false},
}

templ cardNotificationSettings() {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-notification-settings": ""}}) {
		@card.Header() {
			@card.Title() {
				Notifications
			}
			@card.Description() {
				Choose what you want to be notified about.
			}
		}
		@card.Content() {
			@field.Group() {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@checkbox.Checkbox(checkbox.Props{ID: "notify-all"})
					@field.Content() {
						@field.Label(field.LabelProps{For: "notify-all"}) {
							Select all
						}
					}
				}
				for _, setting := range notificationSettings {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@checkbox.Checkbox(checkbox.Props{ID: "notify-" + setting.id, DefaultChecked: setting.checked})
						@field.Content() {
							@field.Label(field.LabelProps{For: "notify-" + setting.id}) {
								{ setting.label }
							}
							@field.Description() {
								{ setting.description }
							}
						}
					}
				}
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Class: "w-full"}) {
				Save Preferences
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of notification-settings.tsx's checked record:
		// the select-all checkbox drives the items, the items drive the
		// select-all state including Base UI's indeterminate attributes
		// (aria-checked="mixed" + data-indeterminate), which the checkbox
		// component itself does not model.
		(() => {
			if (window.__templDemoNotificationSettings) return;
			window.__templDemoNotificationSettings = true;
			const partsOf = (card) => {
				const all = card.querySelector("#notify-all");
				const items = [...card.querySelectorAll("[data-slot=checkbox] + input")].filter((i) => i !== all);
				return { all, items };
			};
			const setChecked = (input, checked) => {
				if (input.checked === checked) return;
				input.checked = checked;
				input.dispatchEvent(new Event("change", { bubbles: true }));
			};
			const syncAll = (card) => {
				const { all, items } = partsOf(card);
				const allChecked = items.every((i) => i.checked);
				const someChecked = items.some((i) => i.checked) && !allChecked;
				setChecked(all, allChecked);
				all.indeterminate = someChecked;
				const root = all.previousElementSibling;
				root.setAttribute("aria-checked", someChecked ? "mixed" : String(allChecked));
				root.toggleAttribute("data-indeterminate", someChecked);
				const indicator = root.querySelector('[data-slot="checkbox-indicator"]');
				indicator.toggleAttribute("data-indeterminate", someChecked);
				// Base UI renders the indicator when checked or indeterminate.
				indicator.hidden = !(allChecked || someChecked);
			};
			let updating = false;
			document.addEventListener("change", (e) => {
				if (updating || !e.target.matches || !e.target.matches("[data-slot=checkbox] + input")) return;
				const card = e.target.closest("[data-notification-settings]");
				if (!card) return;
				const { all } = partsOf(card);
				const target = e.target;
				updating = true;
				// checkbox.js's own change listener runs after this one and
				// resets the root attributes from input.checked; the microtask
				// re-applies the derived select-all state afterwards.
				queueMicrotask(() => {
					if (target === all) {
						partsOf(card).items.forEach((i) => setChecked(i, all.checked));
					}
					syncAll(card);
					updating = false;
				});
			});
			// Initial render: two of four are checked, so the select-all
			// starts indeterminate, like the source's initial state. Runs
			// after checkbox.js's DOMContentLoaded setup pass.
			const initial = () => {
				setTimeout(() => {
					updating = true;
					document.querySelectorAll("[data-notification-settings]").forEach(syncAll);
					updating = false;
				}, 0);
			};
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initial);
			} else {
				initial();
			}
		})();
	</script>
}

// The preview (item "02") wall cards, ports of
// registry/bases/base/blocks/preview/cards. The style and font names in the
// style overview and typography specimen are the defaults (Nova, Geist);
// shadcn derives them from the live search params in React.

var styleOverviewVariables = []string{
	"--background",
	"--foreground",
	"--primary",
	"--secondary",
	"--muted",
	"--accent",
	"--border",
	"--chart-1",
	"--chart-2",
	"--chart-3",
	"--chart-4",
	"--chart-5",
}

templ cardStyleOverview() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-6 style-lyra:gap-4 style-mira:gap-4"}) {
			<div class="flex flex-col gap-1">
				<div data-style-overview-title class="cn-font-heading text-2xl font-medium style-lyra:text-lg style-mira:text-lg style-sera:text-lg style-sera:font-semibold style-sera:tracking-wide style-sera:uppercase">
					Nova - Geist
				</div>
				<div class="line-clamp-2 text-base text-muted-foreground style-lyra:text-sm style-mira:text-sm style-sera:text-sm style-sera:leading-relaxed">
					Designers love packing quirky glyphs into test phrases. This is a
					preview of the typography styles.
				</div>
			</div>
			<div class="grid grid-cols-6 gap-3">
				for _, variable := range styleOverviewVariables {
					<div class="flex flex-col flex-wrap items-center gap-2">
						<div
							class="relative aspect-square w-full rounded-lg bg-(--color) after:absolute after:inset-0 after:rounded-lg after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten style-sera:rounded-none style-sera:after:rounded-none"
							style={ templ.SafeCSS("--color: var(" + variable + ")") }
						></div>
						<div class="hidden max-w-14 truncate font-mono text-[0.60rem] md:block style-lyra:max-w-10 style-mira:max-w-10">
							{ variable }
						</div>
					</div>
				}
			</div>
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of style-overview.tsx's useDesignSystemSearchParams
		// wiring: the title derives from the live style/font params. Initial
		// paint from the iframe URL (same preset decoding as create-preview.js),
		// updates from the parent's design-system-params postMessage.
		(() => {
			if (window.__templDemoStyleOverviewTitle) return;
			window.__templDemoStyleOverviewTitle = true;
			const apply = (p) => {
				const cfg = window.templCreateConfig;
				const el = document.querySelector("[data-style-overview-title]");
				if (!cfg || !el || !p) return;
				const style = cfg.STYLES.find((s) => s.name === p.style);
				const font = cfg.FONTS.find((f) => f.value === p.font);
				const heading = cfg.FONTS.find((f) => f.value === p.fontHeading);
				const fontName = font ? font.name : "";
				const headingName = heading ? heading.name : "";
				el.textContent =
					(style ? style.title : "") +
					" - " +
					(headingName && headingName !== fontName ? headingName : fontName);
			};
			const initialParams = () => {
				const cfg = window.templCreateConfig;
				const preset = window.templPreset;
				if (!cfg) return null;
				const p = Object.assign({}, cfg.DEFAULT_CONFIG);
				const code = new URLSearchParams(window.location.search).get("preset");
				if (code && preset && preset.isPresetCode(code)) {
					const decoded = preset.decodePreset(code);
					if (decoded) Object.assign(p, decoded);
				}
				return p;
			};
			window.addEventListener("message", (event) => {
				if (event.origin !== window.location.origin) return;
				const data = event.data;
				if (data && typeof data === "object" && data.type === "design-system-params" && data.data) {
					apply(data.data);
				}
			});
			const init = () => apply(initialParams());
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", init);
			} else {
				init();
			}
		})();
	</script>
}

templ cardTypographySpecimen() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-2"}) {
			<div data-typography-specimen-title class="text-xs font-medium text-muted-foreground uppercase">
				Inherit - Geist
			</div>
			<p class="cn-font-heading text-2xl font-medium style-sera:text-lg style-sera:font-semibold style-sera:tracking-wider style-sera:uppercase">
				Designing with rhythm and hierarchy.
			</p>
			<p class="text-sm leading-relaxed text-muted-foreground">
				A strong body style keeps long-form content readable and balances the
				visual weight of headings.
			</p>
			<p class="text-sm leading-relaxed text-muted-foreground">
				Thoughtful spacing and cadence help paragraphs scan quickly without
				feeling dense.
			</p>
		}
		@card.Footer() {
			@dialog.Dialog() {
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full", Attributes: dialog.Trigger(ctx)}) {
					Share Feedback
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Share Feedback
						}
						@dialog.Description() {
							Let us know how we can improve your experience.
						}
					}
					@field.Group() {
						<div class="grid grid-cols-2 gap-3">
							@field.Field() {
								@field.Label(field.LabelProps{For: "feedback-name"}) {
									Name
								}
								@input.Input(input.Props{ID: "feedback-name", Placeholder: "Your name"})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "feedback-email"}) {
									Email
								}
								@input.Input(input.Props{ID: "feedback-email", Type: "email", Placeholder: "you@example.com"})
							}
						</div>
						@field.Field() {
							@field.Label(field.LabelProps{For: "feedback-category"}) {
								Category
							}
							@selectcomp.Select(selectcomp.Props{DefaultValue: "general"}) {
								@selectcomp.Trigger(selectcomp.TriggerProps{ID: "feedback-category", Class: "w-full"}) {
									@selectcomp.Value()
								}
								@selectcomp.Content() {
									@selectcomp.Group() {
										@selectcomp.Item(selectcomp.ItemProps{Value: "general"}) {
											General
										}
										@selectcomp.Item(selectcomp.ItemProps{Value: "bug"}) {
											Bug Report
										}
										@selectcomp.Item(selectcomp.ItemProps{Value: "feature"}) {
											Feature Request
										}
										@selectcomp.Item(selectcomp.ItemProps{Value: "improvement"}) {
											Improvement
										}
									}
								}
							}
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "feedback-message"}) {
								Message
							}
							@textarea.Textarea(textarea.Props{ID: "feedback-message", Placeholder: "Tell us what's on your mind...", Class: "min-h-24 resize-none"})
						}
					}
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
							Cancel
						}
						@button.Button() {
							Submit
						}
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of typography-specimen.tsx's
		// useDesignSystemSearchParams wiring: headingLabel falls back to
		// "Inherit", bodyLabel to "Default". Same params plumbing as the
		// style overview card above.
		(() => {
			if (window.__templDemoTypographySpecimenTitle) return;
			window.__templDemoTypographySpecimenTitle = true;
			const apply = (p) => {
				const cfg = window.templCreateConfig;
				const el = document.querySelector("[data-typography-specimen-title]");
				if (!cfg || !el || !p) return;
				const font = cfg.FONTS.find((f) => f.value === p.font);
				const heading = cfg.FONTS.find((f) => f.value === p.fontHeading);
				const fontName = font ? font.name : "";
				const headingName = heading ? heading.name : "";
				const headingLabel = headingName && headingName !== fontName ? headingName : "Inherit";
				const bodyLabel = fontName || "Default";
				el.textContent = headingLabel + " - " + bodyLabel;
			};
			const initialParams = () => {
				const cfg = window.templCreateConfig;
				const preset = window.templPreset;
				if (!cfg) return null;
				const p = Object.assign({}, cfg.DEFAULT_CONFIG);
				const code = new URLSearchParams(window.location.search).get("preset");
				if (code && preset && preset.isPresetCode(code)) {
					const decoded = preset.decodePreset(code);
					if (decoded) Object.assign(p, decoded);
				}
				return p;
			};
			window.addEventListener("message", (event) => {
				if (event.origin !== window.location.origin) return;
				const data = event.data;
				if (data && typeof data === "object" && data.type === "design-system-params" && data.data) {
					apply(data.data);
				}
			});
			const init = () => apply(initialParams());
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", init);
			} else {
				init();
			}
		})();
	</script>
}

templ cardUIElements(suffix string) {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
			<div class="flex flex-col gap-4">
				<div class="flex flex-wrap gap-2">
					@button.Button() {
						Button
					}
					@button.Button(button.Props{Variant: button.VariantSecondary}) {
						Secondary
					}
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Outline
					}
					@button.Button(button.Props{Variant: button.VariantGhost}) {
						Ghost
					}
				</div>
				@item.Item(item.Props{Variant: item.VariantOutline}) {
					@item.Content() {
						@item.Title() {
							Two-factor authentication
						}
						@item.Description(item.DescriptionProps{Class: "text-pretty xl:hidden 2xl:block"}) {
							Verify via email or phone number.
						}
					}
					@item.Actions(item.ActionsProps{Class: "hidden md:flex"}) {
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantSecondary}) {
							Enable
						}
					}
				}
			</div>
			@slider.Slider(slider.Props{DefaultValue: []float64{500}, Max: 1000, Min: 0, Step: 10, Class: "flex-1", Attributes: templ.Attributes{"aria-label": "Slider"}})
			@field.Group() {
				@field.Field() {
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{Placeholder: "Name"})
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@inputgroup.Text() {
								@icon.Search()
							}
						}
					}
				}
				@field.Field(field.Props{Class: "flex-1"}) {
					@textarea.Textarea(textarea.Props{Placeholder: "Message", Class: "resize-none"})
				}
			}
			<div class="flex items-center gap-2">
				<div class="flex gap-2">
					@badge.Badge() {
						Badge
					}
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						Secondary
					}
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						Outline
					}
				</div>
				@radiogroup.RadioGroup(radiogroup.Props{Name: "ui-elements-fruit-" + suffix, DefaultValue: "apple", Class: "ml-auto flex w-fit gap-3"}) {
					@radiogroup.Item(radiogroup.ItemProps{Value: "apple"})
					@radiogroup.Item(radiogroup.ItemProps{Value: "banana"})
				}
				<div class="flex gap-3">
					@checkbox.Checkbox(checkbox.Props{DefaultChecked: true})
					@checkbox.Checkbox()
				</div>
			</div>
			<div class="flex items-center gap-4">
				@alertdialog.AlertDialog() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: alertdialog.Trigger(ctx)}) {
						<span class="hidden md:flex style-sera:md:hidden">Alert Dialog</span>
						<span class="flex md:hidden style-sera:md:flex">Dialog</span>
					}
					@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
						@alertdialog.Header() {
							@alertdialog.Title() {
								Allow accessory to connect?
							}
							@alertdialog.Description() {
								Do you want to allow the USB accessory to connect to this device and your data?
							}
						}
						@alertdialog.Footer() {
							@alertdialog.Cancel() {
								Don't allow
							}
							@alertdialog.Action() {
								Allow
							}
						}
					}
				}
				@buttongroup.ButtonGroup() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						<span class="style-sera:hidden">Button Group</span>
						<span class="hidden style-sera:block">Group</span>
					}
					@dropdownmenu.DropdownMenu() {
						@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Attributes: dropdownmenu.Trigger(ctx)}) {
							@icon.ChevronUp()
						}
						@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideTop, Class: "w-fit"}) {
							@dropdownmenu.Group() {
								@dropdownmenu.Label() {
									Quick Actions
								}
								@dropdownmenu.Item() {
									Mute Conversation
								}
								@dropdownmenu.Item() {
									Mark as Read
								}
								@dropdownmenu.Item() {
									Block User
								}
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Group() {
								@dropdownmenu.Label() {
									Conversation
								}
								@dropdownmenu.Item() {
									Share Conversation
								}
								@dropdownmenu.Item() {
									Copy Conversation
								}
								@dropdownmenu.Item() {
									Report Conversation
								}
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Group() {
								@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
									Delete Conversation
								}
							}
						}
					}
				}
				@switchcomp.Switch(switchcomp.Props{DefaultChecked: true, Class: "ml-auto"})
			</div>
		}
	}
}

templ cardCodespaces() {
	@card.Card() {
		@card.Content() {
			@tabs.Tabs(tabs.Props{DefaultValue: "codespaces"}) {
				@tabs.List(tabs.ListProps{Class: "w-full"}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "codespaces"}) {
						Codespaces
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "local"}) {
						Local
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "codespaces"}) {
					@item.Item(item.Props{Size: item.SizeSm, Class: "px-1 pt-2"}) {
						@item.Content() {
							@item.Title() {
								Codespaces
							}
							@item.Description() {
								Your workspaces in the cloud
							}
						}
						@item.Actions() {
							@tooltip.Tooltip() {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: tooltip.Trigger(ctx)}) {
									@icon.Plus()
								}
								@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom}) {
									Create a codespace on main
								}
							}
							@dropdownmenu.DropdownMenu() {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: dropdownmenu.Trigger(ctx)}) {
									@icon.Ellipsis()
								}
								@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Class: "w-56"}) {
									@dropdownmenu.Group() {
										@dropdownmenu.Item() {
											@icon.Plus()
											New with options...
										}
										@dropdownmenu.Item() {
											@icon.Container()
											Configure container
										}
										@dropdownmenu.Item() {
											@icon.Zap()
											Set up prebuilds
										}
									}
									@dropdownmenu.Separator()
									@dropdownmenu.Group() {
										@dropdownmenu.Item() {
											@icon.Server()
											Manage codespaces
										}
										@dropdownmenu.Item() {
											@icon.Share()
											Share deep link
										}
										@dropdownmenu.Item() {
											@icon.Info()
											What are codespaces?
										}
									}
								}
							}
						}
					}
					@separator.Separator(separator.Props{Class: "-mx-2 my-2 w-auto!"})
					@empty.Empty(empty.Props{Class: "p-4"}) {
						@empty.Header() {
							@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
								@icon.Server()
							}
							@empty.Title() {
								No codespaces
							}
							@empty.Description() {
								You don't have any codespaces with this repository checked out
							}
						}
						@empty.Content() {
							@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-codespaces-create": ""}}) {
								// The source mounts the spinner while isCreatingCodespace;
								// our pendant toggles the hidden class.
								@spinner.Spinner(spinner.Props{Class: "hidden", Attributes: templ.Attributes{"data-icon": "inline-start"}})
								Create Codespace
							}
							<a href="#learn-more" class="text-xs text-muted-foreground underline underline-offset-4">
								Learn more about codespaces
							</a>
						}
					}
					@separator.Separator(separator.Props{Class: "-mx-2 my-2 w-auto!"})
					<div class="p-1.5 text-xs text-muted-foreground">
						Codespace usage for this repository is paid for by <span class="font-medium">shadcn-templ</span>.
					</div>
				}
				@tabs.Content(tabs.ContentProps{Value: "local"}) {
					@item.Item(item.Props{Size: item.SizeSm, Class: "hidden p-0"}) {
						@item.Content() {
							@item.Title(item.TitleProps{Class: "gap-2"}) {
								@icon.Terminal(icon.Props{Class: "size-4"})
								Clone
							}
						}
						@item.Actions() {
							@tooltip.Tooltip() {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: tooltip.Trigger(ctx)}) {
									@icon.Info()
								}
								@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideLeft}) {
									Which remote URL should I use?
								}
							}
						}
					}
					@tabs.Tabs(tabs.Props{DefaultValue: "https"}) {
						@tabs.List(tabs.ListProps{Variant: tabs.VariantLine, Class: "w-full justify-start border-b *:[button]:flex-0"}) {
							@tabs.Trigger(tabs.TriggerProps{Value: "https"}) {
								HTTPS
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "ssh"}) {
								SSH
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "cli"}) {
								GitHub CLI
							}
						}
						<div class="rounded-md border bg-muted/30 p-2">
							@tabs.Content(tabs.ContentProps{Value: "https"}) {
								@field.Field(field.Props{Class: "gap-2"}) {
									@field.Label(field.LabelProps{For: "https-url", Class: "sr-only"}) {
										HTTPS URL
									}
									@cloneURLInputGroup("https-url", "https://github.com/axadrn/shadcn-templ.git")
									@field.Description() {
										Clone using the web URL.
									}
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "ssh"}) {
								@field.Field(field.Props{Class: "gap-2"}) {
									@field.Label(field.LabelProps{For: "ssh-url", Class: "sr-only"}) {
										SSH URL
									}
									@cloneURLInputGroup("ssh-url", "git@github.com:axadrn/shadcn-templ.git")
									@field.Description() {
										Use a password-protected SSH key.
									}
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "cli"}) {
								@field.Field(field.Props{Class: "gap-2"}) {
									@field.Label(field.LabelProps{For: "cli-command", Class: "sr-only"}) {
										CLI Command
									}
									@cloneURLInputGroup("cli-command", "gh repo clone axadrn/shadcn-templ")
									@field.Description() {
										Work fast with our official CLI. <a href="#learn-more">Learn more</a>
									}
								}
							}
						</div>
					}
					@separator.Separator(separator.Props{Class: "-mx-2 my-2 w-auto!"})
					<div class="flex flex-col">
						@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "justify-start gap-1.5"}) {
							@icon.Monitor(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
							Open with GitHub Desktop
						}
						@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "justify-start gap-1.5"}) {
							@icon.Download(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
							Download ZIP
						}
					</div>
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of codespaces-card.tsx's isCreatingCodespace
		// state: the button disables and shows the spinner for 2 seconds.
		(() => {
			if (window.__templDemoCodespaces) return;
			window.__templDemoCodespaces = true;
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				const btn = e.target.closest("[data-codespaces-create]");
				if (!btn || btn.disabled) return;
				const spin = btn.querySelector('[data-slot="spinner"]');
				btn.disabled = true;
				if (spin) spin.classList.remove("hidden");
				setTimeout(() => {
					btn.disabled = false;
					if (spin) spin.classList.add("hidden");
				}, 2000);
			});
		})();
	</script>
}

