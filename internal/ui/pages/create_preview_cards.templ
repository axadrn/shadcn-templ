templ cardRollerShades() {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-roller-shades": ""}}) {
		@card.Header() {
			@card.Title() {
				Living Room
			}
			@card.Description() {
				Roller Shades
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4"}) {
			<div class="flex h-32 flex-col overflow-hidden rounded-lg border bg-muted">
				<div data-roller-shade class="bg-muted-foreground transition-all duration-300" style="height: 50%"></div>
			</div>
			<div class="flex items-center gap-3">
				<span class="text-xs font-medium tracking-wider text-muted-foreground uppercase">Open</span>
				@slider.Slider(slider.Props{DefaultValue: []float64{50}, Max: 100, Class: "flex-1"})
				<span class="text-xs font-medium tracking-wider text-muted-foreground uppercase">Close</span>
			</div>
		}
		@card.Footer() {
			@togglegroup.ToggleGroup(togglegroup.Props{
				Variant: togglegroup.VariantOutline,
				Spacing: utils.Ptr(1),
				Class:   "w-full",
				Value:   []string{"half"},
			}) {
				@togglegroup.Item(togglegroup.ItemProps{Value: "open", Class: "flex-1"}) {
					Open
				}
				@togglegroup.Item(togglegroup.ItemProps{Value: "half", Class: "flex-1"}) {
					Half
				}
				@togglegroup.Item(togglegroup.ItemProps{Value: "closed", Class: "flex-1"}) {
					Closed
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of roller-shades.tsx's position state: the
		// slider drives the shade height, the derived preset (<=10 open,
		// >=90 closed, else half) drives the toggle group, and the toggle
		// group is controlled, so unpressing keeps the current preset.
		(() => {
			if (window.__templDemoRollerShades) return;
			window.__templDemoRollerShades = true;
			const POSITIONS = { open: 0, half: 50, closed: 100 };
			const presetOf = (v) => (v <= 10 ? "open" : v >= 90 ? "closed" : "half");
			// slider.js render() for the single horizontal thumb: the demo sets
			// the value from outside, so it repeats the edge-aligned math.
			const setSlider = (root, v) => {
				const min = parseFloat(root.getAttribute("data-templ-min") || "0");
				const max = parseFloat(root.getAttribute("data-templ-max") || "100");
				const f = max === min ? 0 : Math.min(1, Math.max(0, (v - min) / (max - min)));
				const thumb = root.querySelector("[data-slot=slider-thumb]");
				thumb.setAttribute("aria-valuenow", String(v));
				thumb.style.left = "calc(" + (f * 100).toFixed(4) + "% - " + (f * 12).toFixed(2) + "px)";
				const range = root.querySelector("[data-slot=slider-range]");
				range.style.left = "0";
				range.style.width = "calc(" + (f * 100).toFixed(4) + "% + " + (6 - f * 12).toFixed(2) + "px)";
			};
			const render = (card, v) => {
				card.querySelector("[data-roller-shade]").style.height = v + "%";
				const preset = presetOf(v);
				const group = card.querySelector("[data-slot=toggle-group]");
				group.querySelectorAll("[data-slot=toggle-group-item]").forEach((t) => {
					const on = t.getAttribute("data-templ-value") === preset;
					t.toggleAttribute("data-pressed", on);
					t.setAttribute("aria-pressed", on ? "true" : "false");
				});
			};
			document.addEventListener("slider-change", (e) => {
				const card = e.target.closest("[data-roller-shades]");
				if (!card) return;
				render(card, e.detail.values[0]);
			});
			document.addEventListener("toggle-group-value-change", (e) => {
				const card = e.target.closest("[data-roller-shades]");
				if (!card) return;
				const sliderRoot = card.querySelector("[data-slot=slider]");
				let v;
				const nextPreset = e.detail.value[0];
				if (nextPreset in POSITIONS) {
					v = POSITIONS[nextPreset];
					setSlider(sliderRoot, v);
				} else {
					// Unpressing keeps the position; render re-asserts the
					// controlled preset.
					v = parseFloat(sliderRoot.querySelector("[data-slot=slider-thumb]").getAttribute("aria-valuenow"));
				}
				render(card, v);
			});
		})();
	</script>
}

var stockTickers = []string{"VOO", "VIG", "AAPL", "MSFT", "GOOGL", "AMZN", "TSLA"}

// stockPerformancePanels are the source's CHART_DATA entries plus its
// DEFAULT_DATA fallback for every other ticker; the combobox toggles the
// SSR rendered variants like the interactive chart demos.
var stockPerformancePanels = []struct {
	Key  string
	Data []chart.Datum
}{
	{"VOO", []chart.Datum{
		{"month": "Jan", "price": 412},
		{"month": "Feb", "price": 438},
		{"month": "Mar", "price": 395},
		{"month": "Apr", "price": 450},
		{"month": "May", "price": 420},
		{"month": "Jun", "price": 462},
	}},
	{"AAPL", []chart.Datum{
		{"month": "Jan", "price": 185},
		{"month": "Feb", "price": 210},
		{"month": "Mar", "price": 172},
		{"month": "Apr", "price": 198},
		{"month": "May", "price": 178},
		{"month": "Jun", "price": 215},
	}},
	{"default", []chart.Datum{
		{"month": "Jan", "price": 100},
		{"month": "Feb", "price": 118},
		{"month": "Mar", "price": 95},
		{"month": "Apr", "price": 125},
		{"month": "May", "price": 108},
		{"month": "Jun", "price": 130},
	}},
}

var stockPerformanceConfig = chart.Config{
	{Key: "price", Label: "Price", Color: "var(--chart-1)"},
}

templ cardStockPerformance() {
	@card.Card(card.Props{Attributes: templ.Attributes{"data-stock-performance": ""}}) {
		@card.Header() {
			@card.Title() {
				Stock Performance
			}
			@card.Description() {
				6-month price history.
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-col gap-4"}) {
			@field.Group() {
				@field.Field() {
					@field.Label(field.LabelProps{For: "ticker-select"}) {
						Ticker
					}
					@combobox.Combobox(combobox.Props{DefaultValue: "VOO"}) {
						@combobox.Input(combobox.InputProps{ID: "ticker-select", Placeholder: "Search ticker..."})
						@combobox.Content() {
							@combobox.Empty() {
								No tickers found.
							}
							@combobox.List() {
								for _, ticker := range stockTickers {
									@combobox.Item(combobox.ItemProps{Value: ticker}) {
										{ ticker }
									}
								}
							}
						}
					}
				}
			}
			@separator.Separator(separator.Props{Class: "style-sera:hidden"})
			@chart.Container(chart.ContainerProps{ID: "p02-stock-performance", Config: stockPerformanceConfig, Class: "h-[200px] w-full"}) {
				for _, panel := range stockPerformancePanels {
					<div data-stock-chart={ panel.Key } hidden?={ panel.Key != "VOO" } style="width:100%;height:100%">
						@chart.AreaChart(chart.AreaChartProps{
							AccessibilityLayer: true,
							Data:               panel.Data,
							Margin:             &chart.Margin{Left: 0, Right: 0, Top: 8, Bottom: 0},
						}) {
							@chart.Defs() {
								@chart.LinearGradient(chart.LinearGradientProps{ID: "fillPrice", X1: "0", Y1: "0", X2: "0", Y2: "1"}) {
									<stop offset="0%" stop-color="var(--color-price)" stop-opacity="0.3"></stop>
									<stop offset="100%" stop-color="var(--color-price)" stop-opacity="0.05"></stop>
								}
							}
							@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
							@chart.Tooltip(chart.TooltipProps{
								Cursor:  chart.Bool(false),
								Content: chart.TooltipContentProps{HideLabel: true},
							})
							// strokeWidth={2} of the source is not portable: chart.AreaProps
							// has no stroke width prop.
							@chart.Area(chart.AreaProps{
								DataKey: "price",
								Type:    "monotone",
								Stroke:  "var(--color-price)",
								Fill:    "url(#fillPrice)",
							})
						}
					</div>
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of stock-performance.tsx's ticker state:
		// CHART_DATA[ticker] ?? DEFAULT_DATA, as SSR rendered chart variants
		// toggled by the combobox. Clearing the combobox (null) keeps the
		// last ticker, like the source's onValueChange guard.
		(() => {
			if (window.__templDemoStockPerformance) return;
			window.__templDemoStockPerformance = true;
			document.addEventListener("combobox-change", (e) => {
				const card = e.target.closest("[data-stock-performance]");
				if (!card) return;
				const ticker = e.detail.values[0];
				if (!ticker) return;
				const panels = [...card.querySelectorAll("[data-stock-chart]")];
				const key = panels.some((p) => p.getAttribute("data-stock-chart") === ticker) ? ticker : "default";
				panels.forEach((p) => {
					p.hidden = p.getAttribute("data-stock-chart") !== key;
				});
			});
		})();
	</script>
}

