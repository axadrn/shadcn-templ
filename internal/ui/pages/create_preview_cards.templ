var dividendMiniChartConfig = chart.Config{
	{Key: "value", Label: "Dividend", Color: "var(--chart-2)"},
}

templ cardDividendIncome() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Q2 Dividend Income
			}
			@card.Description() {
				Quarterly dividend payouts across your portfolio holdings.
			}
			@card.Action() {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "bg-muted"}) {
					@icon.X()
				}
			}
		}
		@card.Content() {
			@item.Group() {
				for i, holding := range dividendHoldings {
					@item.Item(item.Props{Variant: item.VariantMuted}) {
						@item.Content() {
							@item.Title() {
								{ holding.name }
							}
							@item.Description() {
								{ holding.shares }
							}
						}
						@chart.Container(chart.ContainerProps{ID: fmt.Sprintf("p02-dividend-%d", i), Config: dividendMiniChartConfig, Class: "hidden h-8 w-24 md:block"}) {
							@chart.BarChart(chart.BarChartProps{
								Data:   holding.data,
								Margin: &chart.Margin{Top: 0, Right: 0, Bottom: 0, Left: 0},
							}) {
								@chart.Tooltip(chart.TooltipProps{
									Cursor:  chart.Bool(false),
									Content: chart.TooltipContentProps{HideLabel: true},
								})
								@chart.Bar(chart.BarProps{DataKey: "value", Fill: "var(--color-value)", Radius: []float64{3, 3, 0, 0}})
							}
						}
						<span class="hidden text-sm font-semibold tabular-nums md:block">{ holding.amount }</span>
					}
				}
			}
		}
	}
}

templ cardIndexInvesting() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Dollar-Cost Averaging
			}
			@card.Description() {
				A strategy for building wealth over time.
			}
		}
		@card.Content() {
			@card.Description(card.DescriptionProps{Class: "mt-3 text-sm leading-relaxed style-sera:mt-0"}) {
				<a href="#" class="underline underline-offset-4 hover:text-primary">Over time</a>
				, this smooths out the average cost of your investments. When prices
				drop, your fixed amount buys more shares. When prices rise, you buy
				fewer. The result is a lower average cost per share compared to
				lump-sum investing during volatile periods.
			}
		}
	}
}

templ cardSyncingState() {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "p-0"}) {
			@empty.Empty(empty.Props{Class: "p-4"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@spinner.Spinner()
					}
					@empty.Title() {
						Syncing your accounts
					}
					@empty.Description() {
						We're pulling in your latest transactions. This usually takes a few seconds.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Cancel
					}
				}
			}
		}
	}
}

