templ cardRecentTransactions() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Recent Transactions
			}
			@card.Description() {
				Your latest account activity.
			}
			@card.Action() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					View All
				}
			}
		}
		@card.Content() {
			@table.Table() {
				@table.Body() {
					for _, tx := range recentTransactions {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "w-10"}) {
								<div class="flex size-10 items-center justify-center rounded-lg bg-muted">
									@tx.icon(icon.Props{Class: "size-4 shrink-0"})
								</div>
							}
							@table.Cell() {
								<div class="flex flex-col">
									<span class="font-medium">{ tx.name }</span>
									<span class="text-sm text-muted-foreground">{ tx.category }</span>
								</div>
							}
							@table.Cell(table.CellProps{Class: "text-sm text-muted-foreground"}) {
								{ tx.date }
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								if tx.positive {
									<span class="text-sm font-semibold text-emerald-500 tabular-nums">{ tx.amount }</span>
								} else {
									<span class="text-sm font-semibold tabular-nums">{ tx.amount }</span>
								}
							}
							@table.Cell(table.CellProps{Class: "w-8"}) {
								@dropdownmenu.DropdownMenu() {
									@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: dropdownmenu.Trigger(ctx)}) {
										@icon.Ellipsis()
									}
									@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd}) {
										@dropdownmenu.Item() {
											View details
										}
										@dropdownmenu.Item() {
											Add note
										}
										@dropdownmenu.Item() {
											Categorize
										}
										@dropdownmenu.Separator()
										@dropdownmenu.Item() {
											Dispute
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

