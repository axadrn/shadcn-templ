var pieChartCardData = []chart.Datum{
	{"browser": "chrome", "visitors": 275, "fill": "var(--color-chrome)"},
	{"browser": "safari", "visitors": 200, "fill": "var(--color-safari)"},
	{"browser": "firefox", "visitors": 287, "fill": "var(--color-firefox)"},
	{"browser": "edge", "visitors": 173, "fill": "var(--color-edge)"},
}

var pieChartCardConfig = chart.Config{
	{Key: "visitors", Label: "Visitors"},
	{Key: "chrome", Label: "Chrome", Color: "var(--chart-1)"},
	{Key: "safari", Label: "Safari", Color: "var(--chart-2)"},
	{Key: "firefox", Label: "Firefox", Color: "var(--chart-3)"},
	{Key: "edge", Label: "Edge", Color: "var(--chart-4)"},
}

// The source derives these from the data: firefox is the top browser with
// 287 of 935 visitors.
func pieChartCardTotal() int {
	sum := 0
	for _, d := range pieChartCardData {
		sum += d["visitors"].(int)
	}
	return sum
}

func pieChartCardTop() (string, int) {
	top := pieChartCardData[0]
	for _, d := range pieChartCardData {
		if d["visitors"].(int) > top["visitors"].(int) {
			top = d
		}
	}
	share := int(float64(top["visitors"].(int))/float64(pieChartCardTotal())*100 + 0.5)
	return pieChartCardConfig.Label(top["browser"].(string)), share
}

templ cardPieChart() {
	{{ topBrowser, topShare := pieChartCardTop() }}
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "pb-0"}) {
			@card.Title() {
				Browser Share
			}
			@card.Description() {
				January - June 2026
			}
			@card.Action() {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					{ topBrowser }
				}
			}
		}
		@card.Content(card.ContentProps{Class: "pt-0"}) {
			@chart.Container(chart.ContainerProps{ID: "p1-pie-chart", Config: pieChartCardConfig, Class: "mx-auto aspect-square max-h-[190px]"}) {
				@chart.PieChart() {
					@chart.Tooltip(chart.TooltipProps{
						Cursor:  chart.Bool(false),
						Content: chart.TooltipContentProps{HideLabel: true},
					})
					@chart.Pie(chart.PieProps{
						Data:        pieChartCardData,
						DataKey:     "visitors",
						NameKey:     "browser",
						InnerRadius: 50,
						StrokeWidth: 5,
					}) {
						@chart.Label(chart.LabelProps{
							DominantBaseline: "middle",
							Spans: []chart.LabelSpan{
								{Text: fmt.Sprintf("%d", pieChartCardTotal()), Class: "fill-foreground text-2xl font-bold", OffsetY: -16},
								{Text: "Visitors", Class: "fill-muted-foreground text-xs", OffsetY: 4},
							},
						})
					}
					@chart.Legend(chart.LegendProps{NameKey: "browser", Class: "translate-y-2"})
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col items-stretch gap-2"}) {
			<div class="flex items-center text-xs">
				<span class="font-medium">{ topBrowser }</span>
				<span class="ml-auto text-muted-foreground tabular-nums">{ fmt.Sprintf("%d%%", topShare) }</span>
			</div>
			@progress.Progress(progress.Props{Value: topShare, Class: "**:data-[slot=progress-indicator]:bg-chart-3"})
		}
	}
}

