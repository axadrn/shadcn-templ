package popover

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
)

templ popoverExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ PopoverExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@popoverExampleBasic()
			@popoverExampleSides()
			@popoverExampleWithForm()
			@popoverExampleAlignments()
			@popoverExampleInDialog()
		</div>
	</div>
}

templ popoverExampleBasic() {
	@popoverExampleSection("Basic") {
		@popover.Popover() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: popover.Trigger(ctx),
			}) {
				Open Popover
			}
			@popover.Content(popover.ContentProps{Align: popover.AlignStart}) {
				@popover.Header() {
					@popover.Title() {
						Dimensions
					}
					@popover.Description() {
						Set the dimensions for the layer.
					}
				}
			}
		}
	}
}

// Our popover has no inline-start/inline-end placements; they resolve to
// left/right in LTR, so those two sides reuse SideLeft/SideRight.
type popoverExampleSide struct {
	Label string
	Side  popover.Side
}

func popoverExampleSidesRow1() []popoverExampleSide {
	return []popoverExampleSide{
		{"inline start", popover.SideLeft},
		{"left", popover.SideLeft},
		{"top", popover.SideTop},
	}
}

func popoverExampleSidesRow2() []popoverExampleSide {
	return []popoverExampleSide{
		{"bottom", popover.SideBottom},
		{"right", popover.SideRight},
		{"inline end", popover.SideRight},
	}
}

templ popoverExampleSides() {
	@popoverExampleSection("Sides") {
		<div class="flex flex-col gap-2">
			<div class="flex flex-wrap gap-2">
				for _, side := range popoverExampleSidesRow1() {
					@popover.Popover() {
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Class:      "w-fit capitalize",
							Attributes: popover.Trigger(ctx),
						}) {
							{ side.Label }
						}
						@popover.Content(popover.ContentProps{Side: side.Side, Class: "w-40"}) {
							<p>Popover on { side.Label }</p>
						}
					}
				}
			</div>
			<div class="flex flex-wrap gap-2">
				for _, side := range popoverExampleSidesRow2() {
					@popover.Popover() {
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Class:      "w-fit capitalize",
							Attributes: popover.Trigger(ctx),
						}) {
							{ side.Label }
						}
						@popover.Content(popover.ContentProps{Side: side.Side, Class: "w-40"}) {
							<p>Popover on { side.Label }</p>
						}
					}
				}
			</div>
		</div>
	}
}

templ popoverExampleWithForm() {
	@popoverExampleSection("With Form") {
		@popover.Popover() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: popover.Trigger(ctx),
			}) {
				Open Popover
			}
			@popover.Content(popover.ContentProps{Align: popover.AlignStart, Class: "w-64"}) {
				@popover.Header() {
					@popover.Title() {
						Dimensions
					}
					@popover.Description() {
						Set the dimensions for the layer.
					}
				}
				@field.Group(field.GroupProps{Class: "gap-4"}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@field.Label(field.LabelProps{For: "width", Class: "w-1/2"}) {
							Width
						}
						@input.Input(input.Props{ID: "width", Value: "100%"})
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@field.Label(field.LabelProps{For: "height", Class: "w-1/2"}) {
							Height
						}
						@input.Input(input.Props{ID: "height", Value: "25px"})
					}
				}
			}
		}
	}
}

templ popoverExampleAlignments() {
	@popoverExampleSection("Alignments") {
		<div class="flex gap-6">
			@popover.Popover() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: popover.Trigger(ctx),
				}) {
					Start
				}
				@popover.Content(popover.ContentProps{Align: popover.AlignStart, Class: "w-40"}) {
					Aligned to start
				}
			}
			@popover.Popover() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: popover.Trigger(ctx),
				}) {
					Center
				}
				@popover.Content(popover.ContentProps{Align: popover.AlignCenter, Class: "w-40"}) {
					Aligned to center
				}
			}
			@popover.Popover() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: popover.Trigger(ctx),
				}) {
					End
				}
				@popover.Content(popover.ContentProps{Align: popover.AlignEnd, Class: "w-40"}) {
					Aligned to end
				}
			}
		</div>
	}
}

templ popoverExampleInDialog() {
	@popoverExampleSection("In Dialog") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Popover Example
					}
					@dialog.Description() {
						Click the button below to see the popover.
					}
				}
				@popover.Popover() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      "w-fit",
						Attributes: popover.Trigger(ctx),
					}) {
						Open Popover
					}
					@popover.Content(popover.ContentProps{Align: popover.AlignStart}) {
						@popover.Header() {
							@popover.Title() {
								Popover in Dialog
							}
							@popover.Description() {
								This popover appears inside a dialog. Click the button to open it.
							}
						}
					}
				}
			}
		}
	}
}
