package popover

import (
	extooltip "github.com/axadrn/shadcn-templ/v2/internal/ui/examples/tooltip"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
)

// The upstream example's Arabic translation, its default language. The
// sides and their labels are shared with tooltip_rtl.templ.
templ PopoverRtl() {
	<div class="grid gap-4">
		<div class="flex flex-wrap justify-center gap-2">
			for _, s := range extooltip.SideRtlPhysical {
				@popoverRtlItem(s)
			}
		</div>
		<div class="flex flex-wrap justify-center gap-2">
			for _, s := range extooltip.SideRtlLogical {
				@popoverRtlItem(s)
			}
		</div>
	</div>
}

templ popoverRtlItem(s extooltip.SideRtlLabel) {
	@popover.Popover() {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: popover.Trigger(ctx),
		}) {
			{ s.Label }
		}
		@popover.Content(popover.ContentProps{Side: popover.Side(s.Side), Attributes: templ.Attributes{"dir": "rtl"}}) {
			@popover.Header() {
				@popover.Title() {
					الأبعاد
				}
				@popover.Description() {
					تعيين الأبعاد للطبقة.
				}
			}
		}
	}
}
