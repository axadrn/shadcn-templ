package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/messagescroller"
	"github.com/axadrn/shadcn-templ/v2/components/togglegroup"
)

var msAnchoringMessages = []msMessage{
	{ID: "anchor-1-user", Role: "user", Text: "Can you show me how anchoring behaves when a new prompt starts the turn?"},
	{ID: "anchor-1-assistant", Role: "assistant", Text: "Append the user prompt first, then append the assistant response. With User selected, the prompt settles near the top and the assistant response fills in below it."},
	{ID: "anchor-2-user", Role: "user", Text: "What changes when assistant messages are the anchor?"},
	{ID: "anchor-2-assistant", Role: "assistant", Text: "Now each assistant response is the item `MessageScroller` keeps in view. This is useful when the reply is the moment you want readers to land on after each turn."},
	{ID: "anchor-3-user", Role: "user", Text: "Can I switch roles and keep adding turns?"},
	{ID: "anchor-3-assistant", Role: "assistant", Text: "Yes. The next appended message with the selected role becomes the anchor, so you can compare user and assistant anchoring without resetting the demo."},
}

templ MessageScrollerAnchoring() {
	<div class="relative flex flex-col gap-4">
		@card.Card(card.Props{Class: "mx-auto h-140 w-full max-w-sm gap-0"}) {
			@card.Header(card.HeaderProps{Class: "border-b"}) {
				@card.Title() {
					Anchoring Turns
				}
				@card.Description() {
					Choose which role settles near the top edge.
				}
				@card.Action() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeIcon,
						Disabled:   true,
						Attributes: templ.Attributes{"aria-label": "Reset anchored turns"},
					}) {
						@icon.RotateCw()
					}
				}
			}
			@card.Content(card.ContentProps{Class: "min-h-0 flex-1 overflow-hidden p-0"}) {
				@msEmptyState("No anchored messages yet", "Send the first message to see the selected role anchor.")
			}
			@card.Footer() {
				@togglegroup.ToggleGroup(togglegroup.Props{
					DefaultValue: []string{"user"},
					Attributes:   templ.Attributes{"aria-label": "Select scroll anchor role"},
				}) {
					@togglegroup.Item(togglegroup.ItemProps{Value: "user", Attributes: templ.Attributes{"aria-label": "Anchor user messages"}}) {
						User
					}
					@togglegroup.Item(togglegroup.ItemProps{Value: "assistant", Attributes: templ.Attributes{"aria-label": "Anchor assistant messages"}}) {
						Assistant
					}
				}
				@button.Button(button.Props{
					Size:  button.SizeIcon,
					Class: "ml-auto",
				}) {
					@icon.ArrowUp()
					<span class="sr-only">Send Message</span>
				}
			}
		}
		<div class="mx-auto max-w-xs px-0.5 text-center text-xs text-muted-foreground">
			Toggle the anchor role, then send messages to compare where turns
			settle.
		</div>
		<template>
			@messagescroller.Provider() {
				@msScroller(nil, false)
			}
		</template>
		<template>
			@msEmptyState("No anchored messages yet", "Send the first message to see the selected role anchor.")
		</template>
		@msTurnTemplates(msAnchoringMessages, false, bubble.VariantMuted, bubble.VariantGhost)
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const demo = document.currentScript.previousElementSibling;
			const roles = {{ msRoles(msAnchoringMessages) }};
			const [scroller, emptyState, ...turns] = demo.querySelectorAll(":scope > template");
			let role = "user";
			let index = 0;
			const send = demo.querySelector('[data-slot="card-footer"] > [data-slot="button"]');
			const reset = demo.querySelector('[aria-label="Reset anchored turns"]');
			const sync = () => {
				send.disabled = index >= turns.length;
				reset.disabled = index === 0;
			};
			const clear = () => {
				index = 0;
				const root = demo.querySelector('[data-slot="message-scroller"]');
				if (root) root.replaceWith(emptyState.content.cloneNode(true));
				sync();
			};
			send.addEventListener("click", () => {
				if (index >= turns.length) return;
				const empty = demo.querySelector('[data-slot="empty"]');
				if (empty) empty.replaceWith(scroller.content.cloneNode(true));
				const row = turns[index].content.firstElementChild.cloneNode(true);
				row.setAttribute("data-scroll-anchor", String(roles[index] === role));
				demo.querySelector('[data-slot="message-scroller-content"]').append(row);
				index++;
				sync();
			});
			reset.addEventListener("click", clear);
			demo.addEventListener("toggle-group-value-change", (e) => {
				const next = e.detail.value[0];
				if (next !== "user" && next !== "assistant") return;
				role = next;
				clear();
			});
		})();
	</script>
}

func msRoles(messages []msMessage) []string {
	out := make([]string, len(messages))
	for i, m := range messages {
		out[i] = m.Role
	}
	return out
}
