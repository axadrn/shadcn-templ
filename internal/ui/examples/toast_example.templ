package examples

import "github.com/axadrn/shadcn-templ/v2/components/button"

// Full toast showcase using the window.templ.toast API.
templ toastExampleSection(title, class string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class={ "flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full", class }>
			{ children... }
		</div>
	</div>
}

templ ToastExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@toastExampleBasic()
			@toastExampleWithAction()
			@toastExamplePromise()
		</div>
	</div>
}

templ toastExampleBasic() {
	@toastExampleSection("Basic", "items-center justify-center") {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-fit",
			Attributes: templ.Attributes{"id": "toast-example-basic-trigger"},
		}) {
			Show Toast
		}
		<script nonce={ templ.GetNonce(ctx) }>
			document.getElementById("toast-example-basic-trigger").addEventListener("click", () => {
				window.templ.toast.add({
					title: "Event created",
					description: "Sunday, December 3 at 9:00 AM",
				});
			});
		</script>
	}
}

templ toastExampleWithAction() {
	@toastExampleSection("With Action", "items-center justify-center") {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-fit",
			Attributes: templ.Attributes{"id": "toast-example-action-trigger"},
		}) {
			Show Toast
		}
		<script nonce={ templ.GetNonce(ctx) }>
			document.getElementById("toast-example-action-trigger").addEventListener("click", () => {
				const id = window.templ.toast.add({
					title: "Event created",
					description: "You can undo this action.",
					actionProps: {
						children: "Undo",
						onClick() {
							window.templ.toast.close(id);
							window.templ.toast.add({
								description: "Event creation undone.",
							});
						},
					},
				});
			});
		</script>
	}
}

templ toastExamplePromise() {
	@toastExampleSection("Promise", "items-center justify-center") {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-fit",
			Attributes: templ.Attributes{"id": "toast-example-promise-trigger"},
		}) {
			Create Event
		}
		<script nonce={ templ.GetNonce(ctx) }>
			document.getElementById("toast-example-promise-trigger").addEventListener("click", () => {
				window.templ.toast.promise(
					new Promise((resolve) => {
						window.setTimeout(() => resolve({ name: "Event" }), 2000);
					}),
					{
						loading: "Creating event…",
						success: (data) => `${data.name} created.`,
						error: "Could not create event.",
					},
				);
			});
		</script>
	}
}
