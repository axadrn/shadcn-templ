package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/message"
)

templ MessageGroup() {
	<div class="flex w-full max-w-sm flex-col gap-6 py-12">
		@message.Group() {
			@message.Message() {
				@message.Avatar()
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							I checked the registry addresses.
						}
					}
				}
			}
			@message.Message() {
				@message.Avatar() {
					@messageAvatar("/assets/img/avatars/02.png", "@avatar", "CN")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							The component and example JSON now live under the UI registry.
						}
					}
				}
			}
		}
	</div>
}
