templ toggleGroupExampleWithIcons() {
	@toggleGroupExampleSection("With Icons") {
		@togglegroup.ToggleGroup(togglegroup.Props{
			Multiple: true,
			Variant:  togglegroup.VariantOutline,
			Spacing:  utils.Ptr(2),
			Size:     togglegroup.SizeSm,
		}) {
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "star",
				Class:      "aria-pressed:bg-transparent aria-pressed:*:[svg]:fill-foreground aria-pressed:*:[svg]:stroke-foreground",
				Attributes: templ.Attributes{"aria-label": "Toggle star"},
			}) {
				@icon.Star()
				Star
			}
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "heart",
				Class:      "aria-pressed:bg-transparent aria-pressed:*:[svg]:fill-foreground aria-pressed:*:[svg]:stroke-foreground",
				Attributes: templ.Attributes{"aria-label": "Toggle heart"},
			}) {
				@icon.Heart()
				Heart
			}
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "bookmark",
				Class:      "aria-pressed:bg-transparent aria-pressed:*:[svg]:fill-foreground aria-pressed:*:[svg]:stroke-foreground",
				Attributes: templ.Attributes{"aria-label": "Toggle bookmark"},
			}) {
				@icon.Bookmark()
				Bookmark
			}
		}
	}
}

