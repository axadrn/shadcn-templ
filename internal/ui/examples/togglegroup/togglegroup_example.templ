type toggleGroupExampleFilterItem struct {
	Label string
	Value string
}

var toggleGroupExampleFilterItems = []toggleGroupExampleFilterItem{
	{"All", "all"},
	{"Active", "active"},
	{"Archived", "archived"},
}

templ toggleGroupExampleWithInputAndSelect() {
	@toggleGroupExampleSection("With Input and Select") {
		<div class="flex items-center gap-2">
			@input.Input(input.Props{Type: "search", Placeholder: "Search...", Class: "flex-1"})
			@selectcomp.Select(selectcomp.Props{
				Items: utils.Map(toggleGroupExampleFilterItems, func(i toggleGroupExampleFilterItem) selectcomp.ItemData {
					return selectcomp.ItemData{Value: i.Value, Label: i.Label}
				}),
				DefaultValue: "all",
			}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-32"}) {
					@selectcomp.Value()
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						for _, item := range toggleGroupExampleFilterItems {
							@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
								{ item.Label }
							}
						}
					}
				}
			}
			@togglegroup.ToggleGroup(togglegroup.Props{
				Variant:      togglegroup.VariantOutline,
				DefaultValue: []string{"grid"},
			}) {
				@togglegroup.Item(togglegroup.ItemProps{
					Value:      "grid",
					Attributes: templ.Attributes{"aria-label": "Grid view"},
				}) {
					Grid
				}
				@togglegroup.Item(togglegroup.ItemProps{
					Value:      "list",
					Attributes: templ.Attributes{"aria-label": "List view"},
				}) {
					List
				}
			}
		</div>
	}
}

