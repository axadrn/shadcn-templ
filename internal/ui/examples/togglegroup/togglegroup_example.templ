templ toggleGroupExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ToggleGroupExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@toggleGroupExampleBasic()
			@toggleGroupExampleOutline()
			@toggleGroupExampleOutlineWithIcons()
			@toggleGroupExampleSizes()
			@toggleGroupExampleSpacing()
			@toggleGroupExampleWithIcons()
			@toggleGroupExampleFilter()
			@toggleGroupExampleDateRange()
			@toggleGroupExampleSort()
			@toggleGroupExampleWithInputAndSelect()
			@toggleGroupExampleVertical()
			@toggleGroupExampleVerticalOutline()
			@toggleGroupExampleVerticalOutlineWithIcons()
			@toggleGroupExampleVerticalWithSpacing()
			@toggleGroupExampleFontWeightSelector()
		</div>
	</div>
}

templ toggleGroupExampleBasic() {
	@toggleGroupExampleSection("Basic") {
		@togglegroup.ToggleGroup(togglegroup.Props{
			Multiple: true,
			Spacing:  utils.Ptr(1),
		}) {
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "bold",
				Attributes: templ.Attributes{"aria-label": "Toggle bold"},
			}) {
				@icon.Bold()
			}
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "italic",
				Attributes: templ.Attributes{"aria-label": "Toggle italic"},
			}) {
				@icon.Italic()
			}
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "underline",
				Attributes: templ.Attributes{"aria-label": "Toggle underline"},
			}) {
				@icon.Underline()
			}
		}
	}
}

templ toggleGroupExampleOutline() {
	@toggleGroupExampleSection("Outline") {
		@togglegroup.ToggleGroup(togglegroup.Props{
			Variant:      togglegroup.VariantOutline,
			DefaultValue: []string{"all"},
		}) {
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "all",
				Attributes: templ.Attributes{"aria-label": "Toggle all"},
			}) {
				All
			}
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      "missed",
				Attributes: templ.Attributes{"aria-label": "Toggle missed"},
			}) {
				Missed
			}
		}
	}
}

