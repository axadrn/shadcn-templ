templ avatarExampleInEmpty() {
	@avatarExampleSection("In Empty") {
		@empty.Empty(empty.Props{Class: "w-full flex-none border"}) {
			@empty.Header() {
				@empty.Media() {
					@avatar.Group() {
						@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
							@avatar.Image(avatar.ImageProps{Src: "https://github.com/axadrn.png", Alt: "@axadrn", Class: "grayscale"})
							@avatar.Fallback() {
								AA
							}
						}
						@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
							@avatar.Image(avatar.ImageProps{Src: "https://github.com/joerdav.png", Alt: "@joerdav", Class: "grayscale"})
							@avatar.Fallback() {
								JD
							}
						}
						@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
							@avatar.Image(avatar.ImageProps{Src: "https://github.com/a-h.png", Alt: "@a-h", Class: "grayscale"})
							@avatar.Fallback() {
								AH
							}
						}
						@avatar.GroupCount() {
							@icon.Plus()
						}
					}
				}
				@empty.Title() {
					No Team Members
				}
				@empty.Description() {
					Invite your team to collaborate on this project.
				}
			}
			@empty.Content() {
				@button.Button() {
					@icon.Plus(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					Invite Members
				}
			}
		}
	}
}
