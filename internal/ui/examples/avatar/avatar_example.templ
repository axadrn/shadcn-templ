package avatar

import (
	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

templ avatarExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ AvatarExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@avatarExampleSizes()
			@avatarExampleWithBadge()
			@avatarExampleWithBadgeIcon()
			@avatarExampleGroup()
			@avatarExampleGroupWithCount()
			@avatarExampleGroupWithIconCount()
			@avatarExampleInEmpty()
		</div>
	</div>
}

templ avatarExampleSizes() {
	@avatarExampleSection("Sizes") {
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/axadrn.png", Alt: "@axadrn"})
				@avatar.Fallback() {
					AA
				}
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/axadrn.png", Alt: "@axadrn"})
				@avatar.Fallback() {
					AA
				}
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/axadrn.png", Alt: "@axadrn"})
				@avatar.Fallback() {
					AA
				}
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Fallback() {
					AA
				}
			}
			@avatar.Avatar() {
				@avatar.Fallback() {
					AA
				}
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Fallback() {
					AA
				}
			}
		</div>
	}
}

templ avatarExampleWithBadge() {
	@avatarExampleSection("Badge") {
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/joerdav.png", Alt: "@joerdav"})
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/joerdav.png", Alt: "@joerdav"})
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/joerdav.png", Alt: "@joerdav"})
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
			@avatar.Avatar() {
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Fallback() {
					JD
				}
				@avatar.Badge()
			}
		</div>
	}
}

templ avatarExampleWithBadgeIcon() {
	@avatarExampleSection("Badge with Icon") {
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/mvdan.png", Alt: "@mvdan"})
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Plus()
				}
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/mvdan.png", Alt: "@mvdan"})
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Plus()
				}
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Image(avatar.ImageProps{Src: "https://github.com/mvdan.png", Alt: "@mvdan"})
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Plus()
				}
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Check()
				}
			}
			@avatar.Avatar() {
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Check()
				}
			}
			@avatar.Avatar(avatar.Props{Size: avatar.SizeLg}) {
				@avatar.Fallback() {
					DM
				}
				@avatar.Badge() {
					@icon.Check()
				}
			}
		</div>
	}
}

