package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
)

templ DatePickerDob() {
	@field.Field(field.Props{Class: "mx-auto w-44"}) {
		@field.Label(field.LabelProps{For: "date"}) {
			Date of birth
		}
		@popover.Popover(popover.Props{ID: "date-picker-dob"}) {
			{{
				triggerAttrs := popover.Trigger(ctx)
				triggerAttrs["id"] = "date"
			}}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "justify-start font-normal",
				Attributes: triggerAttrs,
			}) {
				Select date
			}
			@popover.Content(popover.ContentProps{
				Class: "w-auto overflow-hidden p-0",
				Align: popover.AlignStart,
			}) {
				@calendar.Calendar(calendar.Props{
					Mode:          calendar.ModeSingle,
					CaptionLayout: calendar.CaptionLayoutDropdown,
				})
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The date and open state: onSelect sets the date and closes.
		document.addEventListener("calendar-select", (e) => {
			if (!(e.target instanceof Element) || !e.target.closest("#date-picker-dob")) return;
			const trigger = document.querySelector('[data-templ-controls="date-picker-dob"]');
			const date = e.detail.selected;
				window.templ.calendar.setSelected(e.target, e.detail.selected);
			trigger.textContent = date ? date.toLocaleDateString() : "Select date";
			window.templ.popover.close(e.target.closest("#date-picker-dob"));
		});
	</script>
}
