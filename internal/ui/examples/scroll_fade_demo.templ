package examples

import "strconv"

templ ScrollFadeDemo() {
	<div class="mx-auto w-full max-w-xs overflow-hidden rounded-2xl border">
		<div class="h-72 scroll-fade scrollbar-none overflow-y-auto">
			@scrollFadeNumberedItems(12)
		</div>
	</div>
}

// scrollFadeNumberedItems is the "Item n" list the scroll fade examples scroll.
templ scrollFadeNumberedItems(count int) {
	<div class="flex flex-col gap-1.5 p-1.5">
		for i := range count {
			<div class="rounded-lg bg-muted px-3 py-2.5 text-sm">
				Item { strconv.Itoa(i + 1) }
			</div>
		}
	</div>
}
