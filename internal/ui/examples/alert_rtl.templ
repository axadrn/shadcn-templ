package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/alert"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

// The upstream example's Arabic translation, its default language.
templ AlertRtl() {
	<div class="grid w-full max-w-md items-start gap-4" dir="rtl">
		@alert.Alert() {
			@icon.CircleCheck()
			@alert.Title() {
				تم الدفع بنجاح
			}
			@alert.Description() {
				تمت معالجة دفعتك البالغة 29.99 دولارًا. تم إرسال إيصال إلى عنوان بريدك الإلكتروني.
			}
		}
		@alert.Alert() {
			@icon.Info()
			@alert.Title() {
				ميزة جديدة متاحة
			}
			@alert.Description() {
				لقد أضفنا دعم الوضع الداكن. يمكنك تفعيله في إعدادات حسابك.
			}
		}
	</div>
}
