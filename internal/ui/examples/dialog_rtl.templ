package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/label"
)

// The upstream example's Arabic translation, its default language.
templ DialogRtl() {
	@dialog.Dialog() {
		<form>
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				فتح الحوار
			}
			@dialog.Content(dialog.ContentProps{
				Class:      "sm:max-w-sm",
				Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"},
			}) {
				@dialog.Header() {
					@dialog.Title() {
						تعديل الملف الشخصي
					}
					@dialog.Description() {
						قم بإجراء تغييرات على ملفك الشخصي هنا. انقر فوق حفظ عند الانتهاء.
					}
				}
				@field.Group() {
					@field.Field() {
						@label.Label(label.Props{For: "name-1"}) {
							الاسم
						}
						@input.Input(input.Props{ID: "name-1", Name: "name", Value: "Pedro Duarte"})
					}
					@field.Field() {
						@label.Label(label.Props{For: "username-1"}) {
							اسم المستخدم
						}
						@input.Input(input.Props{ID: "username-1", Name: "username", Value: "@peduarte"})
					}
				}
				@dialog.Footer() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Attributes: dialog.Close(ctx),
					}) {
						إلغاء
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						حفظ التغييرات
					}
				}
			}
		</form>
	}
}
