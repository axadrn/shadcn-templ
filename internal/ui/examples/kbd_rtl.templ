package examples

import "github.com/axadrn/shadcn-templ/v2/components/kbd"

// The upstream example's Arabic translation, its default language.
templ KbdRtl() {
	<div class="flex flex-col items-center gap-4" dir="rtl">
		@kbd.Group() {
			@kbd.Kbd() {
				⌘
			}
			@kbd.Kbd() {
				⇧
			}
			@kbd.Kbd() {
				⌥
			}
			@kbd.Kbd() {
				⌃
			}
		}
		@kbd.Group() {
			@kbd.Kbd() {
				Ctrl
			}
			<span>+</span>
			@kbd.Kbd() {
				B
			}
		}
	</div>
}
