package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/inputotp"
	"github.com/axadrn/shadcn-templ/v2/components/radiogroup"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/components/slider"
	"github.com/axadrn/shadcn-templ/v2/components/switch"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
)

// The native select markup is inlined in this showcase.
templ fieldExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ FieldExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@fieldExampleInputFields()
			@fieldExampleTextareaFields()
			@fieldExampleSelectFields()
			@fieldExampleCheckboxFields()
			@fieldExampleRadioFields()
			@fieldExampleSwitchFields()
			@fieldExampleSliderFields()
			@fieldExampleNativeSelectFields()
			@fieldExampleInputOTPFields()
			@fieldExampleHorizontalFields()
		</div>
	</div>
}

templ fieldExampleInputFields() {
	@fieldExampleSection("Input Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-basic"}) {
					Basic Input
				}
				@input.Input(input.Props{ID: "input-basic", Placeholder: "Enter text"})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-with-desc"}) {
					Input with Description
				}
				@input.Input(input.Props{ID: "input-with-desc", Placeholder: "Enter your username"})
				@field.Description() {
					Choose a unique username for your account.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-desc-first"}) {
					Email Address
				}
				@field.Description() {
					We'll never share your email with anyone.
				}
				@input.Input(input.Props{
					ID:          "input-desc-first",
					Type:        "email",
					Placeholder: "email@example.com",
				})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-required"}) {
					Required Field <span class="text-destructive">*</span>
				}
				@input.Input(input.Props{
					ID:          "input-required",
					Placeholder: "This field is required",
					Required:    true,
				})
				@field.Description() {
					This field must be filled out.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-disabled"}) {
					Disabled Input
				}
				@input.Input(input.Props{ID: "input-disabled", Placeholder: "Cannot edit", Disabled: true})
				@field.Description() {
					This field is currently disabled.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-badge"}) {
					Input with Badge
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						Recommended
					}
				}
				@input.Input(input.Props{ID: "input-badge", Placeholder: "Enter value"})
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "input-invalid"}) {
					Invalid Input
				}
				@input.Input(input.Props{
					ID:          "input-invalid",
					Placeholder: "This field has an error",
					Attributes:  templ.Attributes{"aria-invalid": "true"},
				})
				@field.Description() {
					This field contains validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "input-disabled-field"}) {
					Disabled Field
				}
				@input.Input(input.Props{ID: "input-disabled-field", Placeholder: "Cannot edit", Disabled: true})
				@field.Description() {
					This field is currently disabled.
				}
			}
		}
	}
}

templ fieldExampleTextareaFields() {
	@fieldExampleSection("Textarea Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-basic"}) {
					Basic Textarea
				}
				@textarea.Textarea(textarea.Props{ID: "textarea-basic", Placeholder: "Enter your message"})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-comments"}) {
					Comments
				}
				@textarea.Textarea(textarea.Props{
					ID:          "textarea-comments",
					Placeholder: "Share your thoughts...",
					Class:       "min-h-[100px]",
				})
				@field.Description() {
					Maximum 500 characters allowed.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-bio"}) {
					Bio
				}
				@field.Description() {
					Tell us about yourself in a few sentences.
				}
				@textarea.Textarea(textarea.Props{
					ID:          "textarea-bio",
					Placeholder: "I am a...",
					Class:       "min-h-[120px]",
				})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-desc-after"}) {
					Message
				}
				@textarea.Textarea(textarea.Props{ID: "textarea-desc-after", Placeholder: "Enter your message"})
				@field.Description() {
					Enter your message so it is long enough to test the layout.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "textarea-invalid"}) {
					Invalid Textarea
				}
				@textarea.Textarea(textarea.Props{
					ID:          "textarea-invalid",
					Placeholder: "This field has an error",
					Attributes:  templ.Attributes{"aria-invalid": "true"},
				})
				@field.Description() {
					This field contains validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "textarea-disabled-field"}) {
					Disabled Field
				}
				@textarea.Textarea(textarea.Props{
					ID:          "textarea-disabled-field",
					Placeholder: "Cannot edit",
					Disabled:    true,
				})
				@field.Description() {
					This field is currently disabled.
				}
			}
		}
	}
}

// fieldExampleSelect is one Select field: the tsx passes item lists whose
// first entry has a null value, our pendant is the placeholder plus items.
templ fieldExampleSelect(id, placeholder string, invalid, disabled bool, options []dialogExampleOption) {
	@selectcomp.Select(selectcomp.Props{Disabled: disabled}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{
			ID: id,
			Attributes: templ.Attributes{
				"aria-invalid": invalid,
			},
		}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: placeholder})
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
					{ placeholder }
				}
				for _, option := range options {
					@selectcomp.Item(selectcomp.ItemProps{Value: option.Value}) {
						{ option.Label }
					}
				}
			}
		}
	}
}

func fieldExampleOptions123() []dialogExampleOption {
	return []dialogExampleOption{
		{"Option 1", "option1"}, {"Option 2", "option2"}, {"Option 3", "option3"},
	}
}

func fieldExampleCountryOptions() []dialogExampleOption {
	return []dialogExampleOption{
		{"United States", "us"}, {"United Kingdom", "uk"}, {"Canada", "ca"},
	}
}

templ fieldExampleSelectFields() {
	@fieldExampleSection("Select Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "select-basic"}) {
					Basic Select
				}
				@fieldExampleSelect("select-basic", "Choose an option", false, false, fieldExampleOptions123())
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "select-country"}) {
					Country
				}
				@fieldExampleSelect("select-country", "Select your country", false, false, fieldExampleCountryOptions())
				@field.Description() {
					Select the country where you currently reside.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "select-timezone"}) {
					Timezone
				}
				@field.Description() {
					Choose your local timezone for accurate scheduling.
				}
				@fieldExampleSelect("select-timezone", "Select timezone", false, false, []dialogExampleOption{
					{"UTC", "utc"}, {"Eastern Time", "est"}, {"Pacific Time", "pst"},
				})
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "select-invalid"}) {
					Invalid Select
				}
				@fieldExampleSelect("select-invalid", "This field has an error", true, false, fieldExampleOptions123())
				@field.Description() {
					This field contains validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "select-disabled-field"}) {
					Disabled Field
				}
				@fieldExampleSelect("select-disabled-field", "Cannot select", false, true, fieldExampleOptions123())
				@field.Description() {
					This field is currently disabled.
				}
			}
		}
	}
}

// Native select markup used directly by this showcase.
templ fieldExampleNativeSelect(id string, invalid, disabled bool) {
	<div class="cn-native-select-wrapper group/native-select relative w-fit has-[select:disabled]:opacity-50" data-slot="native-select-wrapper" data-size="default">
		<select
			id={ id }
			data-slot="native-select"
			data-size="default"
			class="cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed"
			if invalid {
				aria-invalid="true"
			}
			disabled?={ disabled }
		>
			{ children... }
		</select>
		@icon.ChevronDown(icon.Props{
			Class: "cn-native-select-icon pointer-events-none absolute select-none",
			Attributes: templ.Attributes{
				"aria-hidden": "true",
				"data-slot":   "native-select-icon",
			},
		})
	</div>
}

templ fieldExampleNativeSelectFields() {
	@fieldExampleSection("Native Select Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "native-select-basic"}) {
					Basic Native Select
				}
				@fieldExampleNativeSelect("native-select-basic", false, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Choose an option</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option1">Option 1</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option2">Option 2</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option3">Option 3</option>
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "native-select-country"}) {
					Country
				}
				@fieldExampleNativeSelect("native-select-country", false, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Select your country</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="us">United States</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="uk">United Kingdom</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="ca">Canada</option>
				}
				@field.Description() {
					Select the country where you currently reside.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "native-select-timezone"}) {
					Timezone
				}
				@field.Description() {
					Choose your local timezone for accurate scheduling.
				}
				@fieldExampleNativeSelect("native-select-timezone", false, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Select timezone</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="utc">UTC</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="est">Eastern Time</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="pst">Pacific Time</option>
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "native-select-grouped"}) {
					Grouped Options
				}
				@fieldExampleNativeSelect("native-select-grouped", false, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Select a region</option>
					<optgroup data-slot="native-select-optgroup" class="bg-[Canvas] text-[CanvasText]" label="North America">
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="us">United States</option>
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="ca">Canada</option>
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="mx">Mexico</option>
					</optgroup>
					<optgroup data-slot="native-select-optgroup" class="bg-[Canvas] text-[CanvasText]" label="Europe">
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="uk">United Kingdom</option>
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="fr">France</option>
						<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="de">Germany</option>
					</optgroup>
				}
				@field.Description() {
					Native select with grouped options using optgroup.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "native-select-invalid"}) {
					Invalid Native Select
				}
				@fieldExampleNativeSelect("native-select-invalid", true, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">This field has an error</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option1">Option 1</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option2">Option 2</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option3">Option 3</option>
				}
				@field.Description() {
					This field contains validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "native-select-disabled-field"}) {
					Disabled Field
				}
				@fieldExampleNativeSelect("native-select-disabled-field", false, true) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Cannot select</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option1">Option 1</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option2">Option 2</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="option3">Option 3</option>
				}
				@field.Description() {
					This field is currently disabled.
				}
			}
		}
	}
}

templ fieldExampleCheckboxFields() {
	@fieldExampleSection("Checkbox Fields") {
		@field.Group() {
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-basic", DefaultChecked: true})
				@field.Label(field.LabelProps{For: "checkbox-basic"}) {
					I agree to the terms and conditions
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Label(field.LabelProps{For: "checkbox-right"}) {
					Accept terms and conditions
				}
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-right"})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-with-desc"})
				@field.Content() {
					@field.Label(field.LabelProps{For: "checkbox-with-desc"}) {
						Subscribe to newsletter
					}
					@field.Description() {
						Receive weekly updates about new features and promotions.
					}
				}
			}
			@field.Label(field.LabelProps{For: "checkbox-with-title"}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@checkbox.Checkbox(checkbox.Props{ID: "checkbox-with-title"})
					@field.Content() {
						@field.Title() {
							Enable Touch ID
						}
						@field.Description() {
							Enable Touch ID to quickly unlock your device.
						}
					}
				}
			}
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Preferences
				}
				@field.Description() {
					Select all that apply to customize your experience.
				}
				@field.Group(field.GroupProps{Class: "gap-3"}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@checkbox.Checkbox(checkbox.Props{ID: "pref-dark"})
						@field.Label(field.LabelProps{For: "pref-dark"}) {
							Dark mode
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@checkbox.Checkbox(checkbox.Props{ID: "pref-compact"})
						@field.Label(field.LabelProps{For: "pref-compact"}) {
							Compact view
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@checkbox.Checkbox(checkbox.Props{ID: "pref-notifications"})
						@field.Label(field.LabelProps{For: "pref-notifications"}) {
							Enable notifications
						}
					}
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@checkbox.Checkbox(checkbox.Props{
					ID:         "checkbox-invalid",
					Attributes: templ.Attributes{"aria-invalid": "true"},
				})
				@field.Label(field.LabelProps{For: "checkbox-invalid"}) {
					Invalid checkbox
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-disabled-field", Disabled: true})
				@field.Label(field.LabelProps{For: "checkbox-disabled-field"}) {
					Disabled checkbox
				}
			}
		}
	}
}

templ fieldExampleRadioFields() {
	@fieldExampleSection("Radio Fields") {
		@field.Group() {
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Subscription Plan
				}
				@radiogroup.RadioGroup(radiogroup.Props{DefaultValue: "free"}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "free", ID: "radio-free"})
						@field.Label(field.LabelProps{For: "radio-free"}) {
							Free Plan
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "pro", ID: "radio-pro"})
						@field.Label(field.LabelProps{For: "radio-pro"}) {
							Pro Plan
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "enterprise", ID: "radio-enterprise"})
						@field.Label(field.LabelProps{For: "radio-enterprise"}) {
							Enterprise
						}
					}
				}
			}
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Battery Level
				}
				@field.Description() {
					Choose your preferred battery level.
				}
				@radiogroup.RadioGroup() {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "high", ID: "battery-high"})
						@field.Label(field.LabelProps{For: "battery-high"}) {
							High
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "medium", ID: "battery-medium"})
						@field.Label(field.LabelProps{For: "battery-medium"}) {
							Medium
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "low", ID: "battery-low"})
						@field.Label(field.LabelProps{For: "battery-low"}) {
							Low
						}
					}
				}
			}
			@radiogroup.RadioGroup(radiogroup.Props{Class: "gap-6"}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@radiogroup.Item(radiogroup.ItemProps{Value: "option1", ID: "radio-content-1"})
					@field.Content() {
						@field.Label(field.LabelProps{For: "radio-content-1"}) {
							Enable Touch ID
						}
						@field.Description() {
							Enable Touch ID to quickly unlock your device.
						}
					}
				}
			}
			@radiogroup.RadioGroup(radiogroup.Props{Class: "gap-3"}) {
				@field.Label(field.LabelProps{For: "radio-title-1"}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "title1", ID: "radio-title-1"})
						@field.Content() {
							@field.Title() {
								Enable Touch ID
							}
							@field.Description() {
								Enable Touch ID to quickly unlock your device.
							}
						}
					}
				}
			}
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Invalid Radio Group
				}
				@radiogroup.RadioGroup() {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-invalid": "true"}}) {
						@radiogroup.Item(radiogroup.ItemProps{
							Value:      "invalid1",
							ID:         "radio-invalid-1",
							Attributes: templ.Attributes{"aria-invalid": "true"},
						})
						@field.Label(field.LabelProps{For: "radio-invalid-1"}) {
							Invalid Option 1
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-invalid": "true"}}) {
						@radiogroup.Item(radiogroup.ItemProps{
							Value:      "invalid2",
							ID:         "radio-invalid-2",
							Attributes: templ.Attributes{"aria-invalid": "true"},
						})
						@field.Label(field.LabelProps{For: "radio-invalid-2"}) {
							Invalid Option 2
						}
					}
				}
			}
			@field.Set() {
				@field.Legend(field.LegendProps{Variant: field.LegendVariantLabel}) {
					Disabled Radio Group
				}
				@radiogroup.RadioGroup(radiogroup.Props{Disabled: true}) {
					@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-disabled": "true"}}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "disabled1", ID: "radio-disabled-1", Disabled: true})
						@field.Label(field.LabelProps{For: "radio-disabled-1"}) {
							Disabled Option 1
						}
					}
					@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-disabled": "true"}}) {
						@radiogroup.Item(radiogroup.ItemProps{Value: "disabled2", ID: "radio-disabled-2", Disabled: true})
						@field.Label(field.LabelProps{For: "radio-disabled-2"}) {
							Disabled Option 2
						}
					}
				}
			}
		}
	}
}

templ fieldExampleSwitchFields() {
	@fieldExampleSection("Switch Fields") {
		@field.Group() {
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "switch-airplane"}) {
						Airplane Mode
					}
					@field.Description() {
						Turn on airplane mode to disable all connections.
					}
				}
				@switchcomp.Switch(switchcomp.Props{ID: "switch-airplane"})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Label(field.LabelProps{For: "switch-dark"}) {
					Dark Mode
				}
				@switchcomp.Switch(switchcomp.Props{ID: "switch-dark"})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@switchcomp.Switch(switchcomp.Props{ID: "switch-marketing"})
				@field.Content() {
					@field.Label(field.LabelProps{For: "switch-marketing"}) {
						Marketing Emails
					}
					@field.Description() {
						Receive emails about new products, features, and more.
					}
				}
			}
			@field.Field() {
				@field.Label() {
					Privacy Settings
				}
				@field.Description() {
					Manage your privacy preferences.
				}
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@switchcomp.Switch(switchcomp.Props{ID: "switch-profile", DefaultChecked: true})
					@field.Label(field.LabelProps{For: "switch-profile"}) {
						Make profile visible to others
					}
				}
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@switchcomp.Switch(switchcomp.Props{ID: "switch-email"})
					@field.Label(field.LabelProps{For: "switch-email"}) {
						Show email on profile
					}
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "switch-invalid"}) {
						Invalid Switch
					}
					@field.Description() {
						This switch has validation errors.
					}
				}
				@switchcomp.Switch(switchcomp.Props{
					ID:         "switch-invalid",
					Attributes: templ.Attributes{"aria-invalid": "true"},
				})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "switch-disabled-field"}) {
						Disabled Switch
					}
					@field.Description() {
						This switch is currently disabled.
					}
				}
				@switchcomp.Switch(switchcomp.Props{ID: "switch-disabled-field", Disabled: true})
			}
		}
	}
}

templ fieldExampleSliderFields() {
	@fieldExampleSection("Slider Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-volume"}) {
					Volume
				}
				@slider.Slider(slider.Props{
					ID:           "slider-volume",
					DefaultValue: []float64{50},
					Max:          100,
					Step:         1,
				})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-brightness"}) {
					Screen Brightness
				}
				@slider.Slider(slider.Props{
					ID:           "slider-brightness",
					DefaultValue: []float64{75},
					Max:          100,
					Step:         5,
				})
				@field.Description() {
					Current brightness: <span data-templ-field-example-brightness>75</span>%
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-quality"}) {
					Video Quality
				}
				@field.Description() {
					Higher quality uses more bandwidth.
				}
				@slider.Slider(slider.Props{
					ID:           "slider-quality",
					DefaultValue: []float64{720},
					Min:          360,
					Max:          1080,
					Step:         360,
				})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-temperature"}) {
					Temperature Range
				}
				@slider.Slider(slider.Props{
					ID:           "slider-temperature",
					DefaultValue: []float64{0.3, 0.7},
					Min:          0,
					Max:          1,
					Step:         0.1,
				})
				@field.Description() {
					Range: <span data-templ-field-example-temperature>0.3 - 0.7</span>
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-price-range"}) {
					Price Range
				}
				@slider.Slider(slider.Props{
					ID:           "slider-price-range",
					DefaultValue: []float64{25, 75},
					Max:          100,
					Step:         5,
				})
				@field.Description() {
					<span data-templ-field-example-price>$25 - $75</span>
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slider-color-balance"}) {
					Color Balance
				}
				@slider.Slider(slider.Props{
					ID:           "slider-color-balance",
					DefaultValue: []float64{10, 20, 70},
					Max:          100,
					Step:         10,
				})
				@field.Description() {
					<span data-templ-field-example-color>Red: 10%, Green: 20%, Blue: 70%</span>
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "slider-invalid"}) {
					Invalid Slider
				}
				@slider.Slider(slider.Props{
					ID:           "slider-invalid",
					DefaultValue: []float64{30},
					Max:          100,
					Attributes:   templ.Attributes{"aria-invalid": "true"},
				})
				@field.Description() {
					This slider has validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "slider-disabled-field"}) {
					Disabled Slider
				}
				@slider.Slider(slider.Props{
					ID:           "slider-disabled-field",
					DefaultValue: []float64{50},
					Max:          100,
					Disabled:     true,
				})
				@field.Description() {
					This slider is currently disabled.
				}
			}
		}
		// Keep the live slider descriptions in sync.
		<script nonce={ templ.GetNonce(ctx) }>
			(() => {
				const bind = (id, target, format) => {
					const root = document.getElementById(id);
					if (!root) return;
					root.addEventListener('slider-change', (e) => {
						const el = document.querySelector(target);
						if (el) el.textContent = format(e.detail.values);
					});
				};
				bind('slider-brightness', '[data-templ-field-example-brightness]', (v) => v[0]);
				bind('slider-temperature', '[data-templ-field-example-temperature]', (v) => v[0].toFixed(1) + ' - ' + v[1].toFixed(1));
				bind('slider-price-range', '[data-templ-field-example-price]', (v) => '$' + v[0] + ' - $' + v[1]);
				bind('slider-color-balance', '[data-templ-field-example-color]', (v) => 'Red: ' + v[0] + '%, Green: ' + v[1] + '%, Blue: ' + v[2] + '%');
			})();
		</script>
	}
}

templ fieldExampleInputOTPFields() {
	@fieldExampleSection("OTP Input Fields") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "otp-basic"}) {
					Verification Code
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-basic"}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
						@inputotp.Slot(inputotp.SlotProps{Index: 4})
						@inputotp.Slot(inputotp.SlotProps{Index: 5})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "otp-with-desc"}) {
					Enter OTP
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-with-desc"}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
						@inputotp.Slot(inputotp.SlotProps{Index: 4})
						@inputotp.Slot(inputotp.SlotProps{Index: 5})
					}
				}
				@field.Description() {
					Enter the 6-digit code sent to your email.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "otp-separator"}) {
					Two-Factor Authentication
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-separator"}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
					}
					@inputotp.Separator()
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
						@inputotp.Slot(inputotp.SlotProps{Index: 4})
						@inputotp.Slot(inputotp.SlotProps{Index: 5})
					}
				}
				@field.Description() {
					Enter the code from your authenticator app.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "otp-pin"}) {
					PIN Code
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-pin", Pattern: inputotp.RegexpOnlyDigits}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
					}
				}
				@field.Description() {
					Enter your 4-digit PIN (numbers only).
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "otp-invalid"}) {
					Invalid OTP
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-invalid"}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0, Attributes: templ.Attributes{"aria-invalid": "true"}})
						@inputotp.Slot(inputotp.SlotProps{Index: 1, Attributes: templ.Attributes{"aria-invalid": "true"}})
						@inputotp.Slot(inputotp.SlotProps{Index: 2, Attributes: templ.Attributes{"aria-invalid": "true"}})
						@inputotp.Slot(inputotp.SlotProps{Index: 3, Attributes: templ.Attributes{"aria-invalid": "true"}})
						@inputotp.Slot(inputotp.SlotProps{Index: 4, Attributes: templ.Attributes{"aria-invalid": "true"}})
						@inputotp.Slot(inputotp.SlotProps{Index: 5, Attributes: templ.Attributes{"aria-invalid": "true"}})
					}
				}
				@field.Description() {
					This OTP field contains validation errors.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "otp-disabled-field"}) {
					Disabled OTP
				}
				@inputotp.InputOTP(inputotp.Props{ID: "otp-disabled-field", Disabled: true}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
						@inputotp.Slot(inputotp.SlotProps{Index: 4})
						@inputotp.Slot(inputotp.SlotProps{Index: 5})
					}
				}
				@field.Description() {
					This OTP field is currently disabled.
				}
			}
		}
	}
}

templ fieldExampleHorizontalFields() {
	@fieldExampleSection("Horizontal Fields") {
		@field.Group(field.GroupProps{Class: "**:data-[slot=field-content]:min-w-48"}) {
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-input"}) {
						Username
					}
					@field.Description() {
						Enter your preferred username.
					}
				}
				@input.Input(input.Props{ID: "horizontal-input", Placeholder: "axadrn"})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-textarea"}) {
						Bio
					}
					@field.Description() {
						Write a short description about yourself.
					}
				}
				@textarea.Textarea(textarea.Props{
					ID:          "horizontal-textarea",
					Placeholder: "Tell us about yourself...",
				})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-switch"}) {
						Email Notifications
					}
					@field.Description() {
						Receive email updates about your account.
					}
				}
				@switchcomp.Switch(switchcomp.Props{ID: "horizontal-switch"})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-select"}) {
						Favorite Fruit
					}
					@field.Description() {
						Choose your favorite fruit.
					}
				}
				@fieldExampleSelect("horizontal-select", "Select a fruit", false, false, []dialogExampleOption{
					{"Apple", "apple"}, {"Banana", "banana"}, {"Orange", "orange"},
				})
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-native-select"}) {
						Country
					}
					@field.Description() {
						Select your country.
					}
				}
				@fieldExampleNativeSelect("horizontal-native-select", false, false) {
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Select a country</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="us">United States</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="uk">United Kingdom</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="ca">Canada</option>
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@field.Content() {
					@field.Label(field.LabelProps{For: "horizontal-slider"}) {
						Volume
					}
					@field.Description() {
						Adjust the volume level.
					}
				}
				@slider.Slider(slider.Props{
					ID:           "horizontal-slider",
					DefaultValue: []float64{50},
					Max:          100,
				})
			}
		}
	}
}
