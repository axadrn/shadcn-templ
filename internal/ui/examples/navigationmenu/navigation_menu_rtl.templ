package navigationmenu

import (
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/navigationmenu"
)

// The upstream example's Arabic translation, its default language.
var navigationMenuRtlComponents = []navigationMenuDemoComponent{
	{
		Title:       "حوار التنبيه",
		Href:        "/docs/primitives/alert-dialog",
		Description: "حوار نافذة يقطع المستخدم بمحتوى مهم ويتوقع استجابة.",
	},
	{
		Title:       "بطاقة التحويم",
		Href:        "/docs/primitives/hover-card",
		Description: "للمستخدمين المبصرين لمعاينة المحتوى المتاح خلف الرابط.",
	},
	{
		Title:       "التقدم",
		Href:        "/docs/primitives/progress",
		Description: "يعرض مؤشرًا يوضح تقدم إتمام المهمة، عادةً يتم عرضه كشريط تقدم.",
	},
	{
		Title:       "منطقة التمرير",
		Href:        "/docs/primitives/scroll-area",
		Description: "يفصل المحتوى بصريًا أو دلاليًا.",
	},
	{
		Title:       "التبويبات",
		Href:        "/docs/primitives/tabs",
		Description: "مجموعة من أقسام المحتوى المتعددة الطبقات—المعروفة بألواح التبويب—التي يتم عرضها واحدة في كل مرة.",
	},
	{
		Title:       "تلميح",
		Href:        "/docs/primitives/tooltip",
		Description: "نافذة منبثقة تعرض معلومات متعلقة بعنصر عندما يتلقى العنصر التركيز على لوحة المفاتيح أو عند تحويم الماوس فوقه.",
	},
}

var navigationMenuRtlContent = navigationmenu.ContentProps{Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}

templ NavigationMenuRtl() {
	@navigationmenu.NavigationMenu(navigationmenu.Props{Align: navigationmenu.AlignEnd, Attributes: templ.Attributes{"dir": "rtl"}}) {
		@navigationmenu.List() {
			@navigationmenu.Item() {
				@navigationmenu.Trigger() {
					البدء
				}
				@navigationmenu.Content(navigationMenuRtlContent) {
					<ul class="w-96">
						@navigationMenuDemoListItem("/docs", "مقدمة") {
							مكونات قابلة لإعادة الاستخدام مبنية باستخدام Tailwind CSS.
						}
						@navigationMenuDemoListItem("/docs/installation", "التثبيت") {
							كيفية تثبيت التبعيات وتنظيم تطبيقك.
						}
						@navigationMenuDemoListItem("/docs/primitives/typography", "الطباعة") {
							أنماط للعناوين والفقرات والقوائم...إلخ
						}
					</ul>
				}
			}
			@navigationmenu.Item(navigationmenu.ItemProps{Class: "hidden md:flex"}) {
				@navigationmenu.Trigger() {
					المكونات
				}
				@navigationmenu.Content(navigationMenuRtlContent) {
					<ul class="grid w-[400px] gap-2 md:w-[500px] md:grid-cols-2 lg:w-[600px]">
						for _, component := range navigationMenuRtlComponents {
							@navigationMenuDemoListItem(component.Href, component.Title) {
								{ component.Description }
							}
						}
					</ul>
				}
			}
			@navigationmenu.Item() {
				@navigationmenu.Trigger() {
					مع أيقونة
				}
				@navigationmenu.Content(navigationMenuRtlContent) {
					<ul class="grid w-[200px]">
						<li>
							@navigationmenu.Link(navigationmenu.LinkProps{Href: "#", Class: "flex-row items-center gap-2"}) {
								@icon.CircleAlert()
								قائمة الانتظار
							}
							@navigationmenu.Link(navigationmenu.LinkProps{Href: "#", Class: "flex-row items-center gap-2"}) {
								@icon.CircleDashed()
								المهام
							}
							@navigationmenu.Link(navigationmenu.LinkProps{Href: "#", Class: "flex-row items-center gap-2"}) {
								@icon.CircleCheck()
								منجز
							}
						</li>
					</ul>
				}
			}
			@navigationmenu.Item() {
				@navigationmenu.Link(navigationmenu.LinkProps{Href: "/docs", Class: navigationmenu.TriggerStyle(), Attributes: templ.Attributes{"data-lang": "ar"}}) {
					الوثائق
				}
			}
		}
	}
}
