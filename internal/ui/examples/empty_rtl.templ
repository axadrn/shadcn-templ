package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

// The upstream example's Arabic translation, its default language.
templ EmptyRtl() {
	@empty.Empty(empty.Props{Attributes: templ.Attributes{"dir": "rtl"}}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@icon.FolderCode()
			}
			@empty.Title() {
				لا توجد مشاريع بعد
			}
			@empty.Description() {
				لم تقم بإنشاء أي مشاريع بعد. ابدأ بإنشاء مشروعك الأول.
			}
		}
		@empty.Content(empty.ContentProps{Class: "flex-row justify-center gap-2"}) {
			@button.Button() {
				إنشاء مشروع
			}
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				استيراد مشروع
			}
		}
		@button.Button(button.Props{
			Variant: button.VariantLink,
			Size:    button.SizeSm,
			Href:    "#",
			Class:   "text-muted-foreground",
		}) {
			تعرف على المزيد
			@icon.ArrowUpRight(icon.Props{Class: "rtl:rotate-270", Attributes: templ.Attributes{"data-icon": "inline-end"}})
		}
	}
}
