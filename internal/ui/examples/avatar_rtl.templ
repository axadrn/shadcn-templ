package examples

import "github.com/axadrn/shadcn-templ/v2/components/avatar"

// The upstream example's Arabic translation, its default language.
templ AvatarRtl() {
	<div class="flex flex-row flex-wrap items-center gap-6 md:gap-12" dir="rtl">
		@avatar.Avatar() {
			@avatar.Image(avatar.ImageProps{
				Src:   "https://github.com/shadcn.png",
				Alt:   "@shadcn",
				Class: "grayscale",
			})
			@avatar.Fallback() {
				CN
			}
		}
		@avatar.Avatar() {
			@avatar.Image(avatar.ImageProps{
				Src: "https://github.com/evilrabbit.png",
				Alt: "@evilrabbit",
			})
			@avatar.Fallback() {
				ER
			}
			@avatar.Badge(avatar.BadgeProps{Class: "bg-green-600 dark:bg-green-800"})
		}
		@avatar.Group(avatar.GroupProps{Class: "grayscale"}) {
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{
					Src: "https://github.com/shadcn.png",
					Alt: "@shadcn",
				})
				@avatar.Fallback() {
					CN
				}
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{
					Src: "https://github.com/maxleiter.png",
					Alt: "@maxleiter",
				})
				@avatar.Fallback() {
					LR
				}
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{
					Src: "https://github.com/evilrabbit.png",
					Alt: "@evilrabbit",
				})
				@avatar.Fallback() {
					ER
				}
			}
			@avatar.GroupCount() {
				+٣
			}
		}
	</div>
}
