package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/radiogroup"
)

// The upstream example's Arabic translation, its default language.
templ RadioGroupRtl() {
	@radiogroup.RadioGroup(radiogroup.Props{DefaultValue: "comfortable", Class: "w-fit", Attributes: templ.Attributes{"dir": "rtl"}}) {
		@radioGroupRtlItem("default", "r1-rtl", "افتراضي", "تباعد قياسي لمعظم حالات الاستخدام.")
		@radioGroupRtlItem("comfortable", "r2-rtl", "مريح", "مساحة أكبر بين العناصر.")
		@radioGroupRtlItem("compact", "r3-rtl", "مضغوط", "تباعد أدنى للتخطيطات الكثيفة.")
	}
}

templ radioGroupRtlItem(value, id, label, description string) {
	@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
		@radiogroup.Item(radiogroup.ItemProps{ID: id, Value: value, Attributes: templ.Attributes{"dir": "rtl"}})
		@field.Content() {
			@field.Label(field.LabelProps{For: id, Attributes: templ.Attributes{"dir": "rtl"}}) {
				{ label }
			}
			@field.Description(field.DescriptionProps{Attributes: templ.Attributes{"dir": "rtl"}}) {
				{ description }
			}
		}
	}
}
