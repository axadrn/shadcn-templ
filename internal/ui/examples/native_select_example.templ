package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/example"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/nativeselect"
)

templ NativeSelectExample() {
	@example.Wrapper() {
		@example.Example(example.Props{Title: "Basic"}) {
			@nativeselect.NativeSelect() {
				@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
					Select a fruit
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
					Apple
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
					Banana
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
					Blueberry
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "grapes", Disabled: true}) {
					Grapes
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "pineapple"}) {
					Pineapple
				}
			}
		}
		@example.Example(example.Props{Title: "With Groups"}) {
			@nativeselect.NativeSelect() {
				@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
					Select a food
				}
				@nativeselect.OptGroup(nativeselect.OptGroupProps{Label: "Fruits"}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
						Apple
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
						Banana
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
						Blueberry
					}
				}
				@nativeselect.OptGroup(nativeselect.OptGroupProps{Label: "Vegetables"}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: "carrot"}) {
						Carrot
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "broccoli"}) {
						Broccoli
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "spinach"}) {
						Spinach
					}
				}
			}
		}
		@example.Example(example.Props{Title: "Sizes"}) {
			<div class="flex flex-col gap-4">
				@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeSm}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
						Select a fruit
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
						Apple
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
						Banana
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
						Blueberry
					}
				}
				@nativeselect.NativeSelect(nativeselect.Props{Size: nativeselect.SizeDefault}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
						Select a fruit
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
						Apple
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
						Banana
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
						Blueberry
					}
				}
			</div>
		}
		@example.Example(example.Props{Title: "With Field"}) {
			@field.Field() {
				@field.Label(field.LabelProps{For: "native-select-country"}) {
					Country
				}
				@nativeselect.NativeSelect(nativeselect.Props{ID: "native-select-country"}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
						Select a country
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "us"}) {
						United States
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "uk"}) {
						United Kingdom
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "ca"}) {
						Canada
					}
					@nativeselect.Option(nativeselect.OptionProps{Value: "au"}) {
						Australia
					}
				}
				@field.Description() {
					Select your country of residence.
				}
			}
		}
		@example.Example(example.Props{Title: "Disabled"}) {
			@nativeselect.NativeSelect(nativeselect.Props{Disabled: true}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
					Disabled
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
					Apple
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
					Banana
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
					Blueberry
				}
			}
		}
		@example.Example(example.Props{Title: "Invalid"}) {
			@nativeselect.NativeSelect(nativeselect.Props{Attributes: templ.Attributes{"aria-invalid": "true"}}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: ""}) {
					Error state
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "apple"}) {
					Apple
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "banana"}) {
					Banana
				}
				@nativeselect.Option(nativeselect.OptionProps{Value: "blueberry"}) {
					Blueberry
				}
			}
		}
	}
}
