package bubble

import "github.com/axadrn/shadcn-templ/v2/components/bubble"

templ BubbleDemo() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
			@bubble.Content() {
				Hey there! what's up?
			}
		}
		@bubble.Group() {
			@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
				@bubble.Content() {
					Hey! Want to see chat bubbles?
				}
			}
			@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
				@bubble.Content() {
					I can group messages, switch sides, and keep the whole thread easy
					to scan.
				}
				@bubble.Reactions(bubble.ReactionsProps{Attributes: templ.Attributes{"role": "img", "aria-label": "Reaction: thumbs up"}}) {
					<span>👍</span>
				}
			}
		}
		@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
			@bubble.Content() {
				Sure. Hit me with your best demo.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				Yes. You are reading a demo that is demoing itself. Very meta. Very
				on-brand.
			}
			@bubble.Reactions(bubble.ReactionsProps{Attributes: templ.Attributes{"role": "img", "aria-label": "Reactions: thumbs up, fire, eyes, and 2 more"}}) {
				<span>👍</span>
				<span>🔥</span>
				<span>👀</span>
				<span>+2</span>
			}
		}
	</div>
}
