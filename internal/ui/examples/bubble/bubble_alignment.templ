package bubble

import "github.com/axadrn/shadcn-templ/v2/components/bubble"

templ BubbleAlignmentDemo() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				This bubble is aligned to the start. This is the default alignment.
			}
		}
		@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
			@bubble.Content() {
				This bubble is aligned to the end. Use this for user messages.
			}
		}
	</div>
}
