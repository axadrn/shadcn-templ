package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
)

// The upstream example's Arabic translation, its default language, with
// date-fns' and react-day-picker's arSA locale.
templ DatePickerRtl() {
	@popover.Popover(popover.Props{ID: "date-picker-rtl"}) {
		{{
			triggerAttrs := popover.Trigger(ctx)
			triggerAttrs["data-empty"] = "true"
			triggerAttrs["dir"] = "rtl"
		}}
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-[212px] justify-between text-left font-normal data-[empty=true]:text-muted-foreground",
			Attributes: triggerAttrs,
		}) {
			<span>اختر تاريخًا</span>
			@icon.ChevronDown(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
		}
		@popover.Content(popover.ContentProps{
			Class:      "w-auto p-0",
			Align:      popover.AlignStart,
			Attributes: templ.Attributes{"dir": "rtl"},
		}) {
			@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle, Dir: "rtl", Locale: "ar-SA"})
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The date state: onSelect sets it, the trigger renders it.
		(() => {
			// date-fns format(date, "PPP", { locale: arSA }), "MMMM do, y".
			const months = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
			const ppp = (d) => months[d.getMonth()] + " " + d.getDate() + ", " + d.getFullYear();
			document.addEventListener("calendar-select", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("#date-picker-rtl")) return;
				const trigger = document.querySelector('[data-templ-controls="date-picker-rtl"]');
				const date = e.detail.selected;
				window.templ.calendar.setSelected(e.target, date);
				trigger.firstChild.replaceWith(date ? document.createTextNode(ppp(date)) : Object.assign(document.createElement("span"), { textContent: "اختر تاريخًا" }));
				trigger.setAttribute("data-empty", String(!date));
			});
		})();
	</script>
}
