package contextmenu

import (
	"github.com/axadrn/shadcn-templ/v2/components/contextmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The upstream example's Arabic translation, its default language. The
// people state with onValueChange={setPeople} behaves like the uncontrolled
// radio group. The ui-rtl ContextMenuContent defaults side to inline-end.
templ ContextMenuRtl() {
	@contextmenu.ContextMenu() {
		@contextmenu.Trigger(contextmenu.TriggerProps{Class: "flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed text-sm"}) {
			<span class="hidden pointer-fine:inline-block">انقر بزر الماوس الأيمن هنا</span>
			<span class="hidden pointer-coarse:inline-block">اضغط مطولاً هنا</span>
		}
		@contextmenu.Content(contextmenu.ContentProps{Class: "w-48", Side: contextmenu.Side("inline-end"), Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
			@contextmenu.Group() {
				@contextmenu.Sub() {
					@contextmenu.SubTrigger() {
						التنقل
					}
					@contextmenu.SubContent(contextmenu.SubContentProps{Class: "w-44", Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
						@contextmenu.Group() {
							@contextmenu.Item() {
								@icon.ArrowLeft()
								رجوع
								@contextmenu.Shortcut() {
									⌘[
								}
							}
							@contextmenu.Item(contextmenu.ItemProps{Disabled: true}) {
								@icon.ArrowRight()
								تقدم
								@contextmenu.Shortcut() {
									⌘]
								}
							}
							@contextmenu.Item() {
								@icon.RotateCw()
								إعادة تحميل
								@contextmenu.Shortcut() {
									⌘R
								}
							}
						}
					}
				}
				@contextmenu.Sub() {
					@contextmenu.SubTrigger() {
						المزيد من الأدوات
					}
					@contextmenu.SubContent(contextmenu.SubContentProps{Class: "w-44", Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
						@contextmenu.Group() {
							@contextmenu.Item() {
								حفظ الصفحة...
							}
							@contextmenu.Item() {
								إنشاء اختصار...
							}
							@contextmenu.Item() {
								تسمية النافذة...
							}
						}
						@contextmenu.Separator()
						@contextmenu.Group() {
							@contextmenu.Item() {
								أدوات المطور
							}
						}
						@contextmenu.Separator()
						@contextmenu.Group() {
							@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
								حذف
							}
						}
					}
				}
			}
			@contextmenu.Separator()
			@contextmenu.Group() {
				@contextmenu.CheckboxItem(contextmenu.CheckboxItemProps{Checked: utils.Ptr(true)}) {
					إظهار الإشارات المرجعية
				}
				@contextmenu.CheckboxItem() {
					إظهار عناوين URL الكاملة
				}
			}
			@contextmenu.Separator()
			@contextmenu.Group() {
				@contextmenu.RadioGroup(contextmenu.RadioGroupProps{DefaultValue: "pedro"}) {
					@contextmenu.Label() {
						الأشخاص
					}
					@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "pedro"}) {
						Pedro Duarte
					}
					@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "colm"}) {
						Colm Tuite
					}
				}
			}
		}
	}
}
