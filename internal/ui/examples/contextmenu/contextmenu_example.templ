package contextmenu

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/contextmenu"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

templ contextMenuExampleSection(title, containerClass string) {
	<div data-slot="example" class={ "mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ContextMenuExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@contextMenuExampleBasic()
			@contextMenuExampleWithIcons()
			@contextMenuExampleWithSides()
			@contextMenuExampleWithShortcuts()
			@contextMenuExampleWithSubmenu()
			@contextMenuExampleWithGroups()
			@contextMenuExampleWithCheckboxes()
			@contextMenuExampleWithRadio()
			@contextMenuExampleWithDestructive()
			@contextMenuExampleInDialog()
			@contextMenuExampleWithInset()
		</div>
	</div>
}

templ contextMenuExampleTrigger() {
	@contextmenu.Trigger(contextmenu.TriggerProps{Class: "flex aspect-[2/0.5] w-full items-center justify-center rounded-lg border text-sm"}) {
		Right click here
	}
}

templ contextMenuExampleBasic() {
	@contextMenuExampleSection("Basic", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Item() {
						Back
					}
					@contextmenu.Item(contextmenu.ItemProps{Disabled: true}) {
						Forward
					}
					@contextmenu.Item() {
						Reload
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithIcons() {
	@contextMenuExampleSection("With Icons", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Item() {
						@icon.Copy()
						Copy
					}
					@contextmenu.Item() {
						@icon.Scissors()
						Cut
					}
					@contextmenu.Item() {
						@icon.ClipboardPaste()
						Paste
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
						@icon.Trash()
						Delete
					}
				}
			}
		}
	}
}

type contextMenuExampleSide struct {
	Label string
	Side  contextmenu.Side
}

// Our context menu has no inline-start/inline-end placements; they resolve
// to left/right in LTR, so those two sides reuse SideLeft/SideRight.
func contextMenuExampleSides() []contextMenuExampleSide {
	return []contextMenuExampleSide{
		{"inline start", contextmenu.SideLeft},
		{"left", contextmenu.SideLeft},
		{"top", contextmenu.SideTop},
		{"bottom", contextmenu.SideBottom},
		{"right", contextmenu.SideRight},
		{"inline end", contextmenu.SideRight},
	}
}

templ contextMenuExampleWithSides() {
	@contextMenuExampleSection("With Sides", "col-span-2") {
		<div class="flex flex-wrap justify-center gap-2">
			for _, side := range contextMenuExampleSides() {
				@contextmenu.ContextMenu() {
					@contextmenu.Trigger(contextmenu.TriggerProps{Class: "flex aspect-[2/0.5] items-center justify-center rounded-lg border p-4 text-sm capitalize"}) {
						{ side.Label }
					}
					@contextmenu.Content(contextmenu.ContentProps{Side: side.Side}) {
						@contextmenu.Group() {
							@contextmenu.Item() {
								Back
							}
							@contextmenu.Item() {
								Forward
							}
							@contextmenu.Item() {
								Reload
							}
						}
					}
				}
			}
		</div>
	}
}

templ contextMenuExampleWithShortcuts() {
	@contextMenuExampleSection("With Shortcuts", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Item() {
						Back
						@contextmenu.Shortcut() {
							⌘[
						}
					}
					@contextmenu.Item(contextmenu.ItemProps{Disabled: true}) {
						Forward
						@contextmenu.Shortcut() {
							⌘]
						}
					}
					@contextmenu.Item() {
						Reload
						@contextmenu.Shortcut() {
							⌘R
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Item() {
						Save
						@contextmenu.Shortcut() {
							⌘S
						}
					}
					@contextmenu.Item() {
						Save As...
						@contextmenu.Shortcut() {
							⇧⌘S
						}
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithSubmenu() {
	@contextMenuExampleSection("With Submenu", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Item() {
						Copy
						@contextmenu.Shortcut() {
							⌘C
						}
					}
					@contextmenu.Item() {
						Cut
						@contextmenu.Shortcut() {
							⌘X
						}
					}
				}
				@contextmenu.Sub() {
					@contextmenu.SubTrigger() {
						More Tools
					}
					@contextmenu.SubContent() {
						@contextmenu.Group() {
							@contextmenu.Item() {
								Save Page...
							}
							@contextmenu.Item() {
								Create Shortcut...
							}
							@contextmenu.Item() {
								Name Window...
							}
						}
						@contextmenu.Separator()
						@contextmenu.Group() {
							@contextmenu.Item() {
								Developer Tools
							}
						}
						@contextmenu.Separator()
						@contextmenu.Group() {
							@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
								Delete
							}
						}
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithGroups() {
	@contextMenuExampleSection("With Groups, Labels & Separators", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Label() {
						File
					}
					@contextmenu.Item() {
						New File
						@contextmenu.Shortcut() {
							⌘N
						}
					}
					@contextmenu.Item() {
						Open File
						@contextmenu.Shortcut() {
							⌘O
						}
					}
					@contextmenu.Item() {
						Save
						@contextmenu.Shortcut() {
							⌘S
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Label() {
						Edit
					}
					@contextmenu.Item() {
						Undo
						@contextmenu.Shortcut() {
							⌘Z
						}
					}
					@contextmenu.Item() {
						Redo
						@contextmenu.Shortcut() {
							⇧⌘Z
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Item() {
						Cut
						@contextmenu.Shortcut() {
							⌘X
						}
					}
					@contextmenu.Item() {
						Copy
						@contextmenu.Shortcut() {
							⌘C
						}
					}
					@contextmenu.Item() {
						Paste
						@contextmenu.Shortcut() {
							⌘V
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
						Delete
						@contextmenu.Shortcut() {
							⌫
						}
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithCheckboxes() {
	@contextMenuExampleSection("With Checkboxes", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.CheckboxItem(contextmenu.CheckboxItemProps{DefaultChecked: true}) {
						Show Bookmarks Bar
					}
					@contextmenu.CheckboxItem() {
						Show Full URLs
					}
					@contextmenu.CheckboxItem(contextmenu.CheckboxItemProps{DefaultChecked: true}) {
						Show Developer Tools
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithRadio() {
	@contextMenuExampleSection("With Radio Group", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Label() {
						People
					}
					@contextmenu.RadioGroup(contextmenu.RadioGroupProps{DefaultValue: "pedro"}) {
						@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "pedro"}) {
							Pedro Duarte
						}
						@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "colm"}) {
							Colm Tuite
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Label() {
						Theme
					}
					@contextmenu.RadioGroup(contextmenu.RadioGroupProps{DefaultValue: "light"}) {
						@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "light"}) {
							Light
						}
						@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "dark"}) {
							Dark
						}
						@contextmenu.RadioItem(contextmenu.RadioItemProps{Value: "system"}) {
							System
						}
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithDestructive() {
	@contextMenuExampleSection("With Destructive Items", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content() {
				@contextmenu.Group() {
					@contextmenu.Item() {
						@icon.Pencil()
						Edit
					}
					@contextmenu.Item() {
						@icon.Share()
						Share
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Item() {
						@icon.Archive()
						Archive
					}
					@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
						@icon.Trash()
						Delete
					}
				}
			}
		}
	}
}

templ contextMenuExampleInDialog() {
	@contextMenuExampleSection("In Dialog", "") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Context Menu Example
					}
					@dialog.Description() {
						Right click on the area below to see the context menu.
					}
				}
				@contextmenu.ContextMenu() {
					@contextMenuExampleTrigger()
					@contextmenu.Content() {
						@contextmenu.Group() {
							@contextmenu.Item() {
								@icon.Copy()
								Copy
							}
							@contextmenu.Item() {
								@icon.Scissors()
								Cut
							}
							@contextmenu.Item() {
								@icon.ClipboardPaste()
								Paste
							}
						}
						@contextmenu.Separator()
						@contextmenu.Sub() {
							@contextmenu.SubTrigger() {
								More Options
							}
							@contextmenu.SubContent() {
								@contextmenu.Group() {
									@contextmenu.Item() {
										Save Page...
									}
									@contextmenu.Item() {
										Create Shortcut...
									}
									@contextmenu.Item() {
										Name Window...
									}
								}
								@contextmenu.Separator()
								@contextmenu.Group() {
									@contextmenu.Item() {
										Developer Tools
									}
								}
							}
						}
						@contextmenu.Separator()
						@contextmenu.Group() {
							@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
								@icon.Trash()
								Delete
							}
						}
					}
				}
			}
		}
	}
}

templ contextMenuExampleWithInset() {
	@contextMenuExampleSection("With Inset", "") {
		@contextmenu.ContextMenu() {
			@contextMenuExampleTrigger()
			@contextmenu.Content(contextmenu.ContentProps{Class: "w-44"}) {
				@contextmenu.Group() {
					@contextmenu.Label() {
						Actions
					}
					@contextmenu.Item() {
						@icon.Copy()
						Copy
					}
					@contextmenu.Item() {
						@icon.Scissors()
						Cut
					}
					@contextmenu.Item(contextmenu.ItemProps{Inset: true}) {
						Paste
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Label(contextmenu.LabelProps{Inset: true}) {
						Appearance
					}
					@contextmenu.CheckboxItem(contextmenu.CheckboxItemProps{
						DefaultChecked: true,
						Attributes:     templ.Attributes{"data-inset": "true"},
					}) {
						Bookmarks
					}
					@contextmenu.CheckboxItem(contextmenu.CheckboxItemProps{
						Attributes: templ.Attributes{"data-inset": "true"},
					}) {
						Full URLs
					}
				}
				@contextmenu.Separator()
				@contextmenu.Group() {
					@contextmenu.Label(contextmenu.LabelProps{Inset: true}) {
						Theme
					}
					@contextmenu.RadioGroup(contextmenu.RadioGroupProps{DefaultValue: "system"}) {
						@contextmenu.RadioItem(contextmenu.RadioItemProps{
							Value:      "light",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							Light
						}
						@contextmenu.RadioItem(contextmenu.RadioItemProps{
							Value:      "dark",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							Dark
						}
						@contextmenu.RadioItem(contextmenu.RadioItemProps{
							Value:      "system",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							System
						}
					}
				}
				@contextmenu.Separator()
				@contextmenu.Sub() {
					@contextmenu.SubTrigger(contextmenu.SubTriggerProps{Inset: true}) {
						More Options
					}
					@contextmenu.SubContent() {
						@contextmenu.Group() {
							@contextmenu.Item() {
								Save Page...
							}
							@contextmenu.Item() {
								Create Shortcut...
							}
						}
					}
				}
			}
		}
	}
}
