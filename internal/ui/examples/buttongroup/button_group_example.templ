package buttongroup

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/buttongroup"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
)

templ buttonGroupExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ButtonGroupExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@buttonGroupExampleBasic()
			@buttonGroupExampleWithInput()
			@buttonGroupExampleWithText()
			@buttonGroupExampleWithDropdown()
			@buttonGroupExampleWithSelect()
			@buttonGroupExampleWithIcons()
			@buttonGroupExampleWithInputGroup()
			@buttonGroupExampleWithFields()
			@buttonGroupExampleWithLike()
			@buttonGroupExampleWithSelectAndInput()
			@buttonGroupExampleNested()
			@buttonGroupExamplePagination()
			@buttonGroupExamplePaginationSplit()
			@buttonGroupExampleNavigation()
			@buttonGroupExampleTextAlignment()
			@buttonGroupExampleVertical()
			@buttonGroupExampleVerticalNested()
		</div>
	</div>
}

templ buttonGroupExampleBasic() {
	@buttonGroupExampleSection("Basic") {
		<div class="flex flex-col gap-4">
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Button
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Another Button
				}
			}
		</div>
	}
}

templ buttonGroupExampleWithInput() {
	@buttonGroupExampleSection("With Input") {
		<div class="flex flex-col gap-4">
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Button
				}
				@input.Input(input.Props{Placeholder: "Type something here..."})
			}
			@buttongroup.ButtonGroup() {
				@input.Input(input.Props{Placeholder: "Type something here..."})
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Button
				}
			}
		</div>
	}
}

templ buttonGroupExampleWithText() {
	@buttonGroupExampleSection("With Text") {
		<div class="flex flex-col gap-4">
			@buttongroup.ButtonGroup() {
				@buttongroup.Text() {
					Text
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Another Button
				}
			}
			@buttongroup.ButtonGroup() {
				@buttongroup.Text() {
					GPU Size
				}
				@input.Input(input.Props{
					ID:          "button-group-example-input-text",
					Placeholder: "Type something here...",
					Class:       "style-luma:border-border",
				})
			}
		</div>
	}
}

templ buttonGroupExampleWithDropdown() {
	@buttonGroupExampleSection("With Dropdown") {
		<div class="flex flex-col gap-4">
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Update
				}
				@dropdownmenu.DropdownMenu() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeIcon,
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						@icon.ChevronDown()
					}
					@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd}) {
						@dropdownmenu.Group() {
							@dropdownmenu.Item() {
								Disable
							}
							@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
								Uninstall
							}
						}
					}
				}
			}
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Follow
				}
				@dropdownmenu.DropdownMenu() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeIcon,
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						@icon.ChevronDown()
					}
					@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Class: "w-50"}) {
						@dropdownmenu.Group() {
							@dropdownmenu.Item() {
								@icon.VolumeX()
								Mute Conversation
							}
							@dropdownmenu.Item() {
								@icon.Check()
								Mark as Read
							}
							@dropdownmenu.Item() {
								@icon.TriangleAlert()
								Report Conversation
							}
							@dropdownmenu.Item() {
								@icon.UserRoundX()
								Block User
							}
							@dropdownmenu.Item() {
								@icon.Share()
								Share Conversation
							}
							@dropdownmenu.Item() {
								@icon.Copy()
								Copy Conversation
							}
						}
						@dropdownmenu.Separator()
						@dropdownmenu.Group() {
							@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
								@icon.Trash()
								Delete Conversation
							}
						}
					}
				}
			}
		</div>
	}
}

templ buttonGroupExampleWithSelect() {
	@buttonGroupExampleSection("With Select") {
		@field.Field() {
			@label.Label(label.Props{For: "button-group-example-amount"}) {
				Amount
			}
			@buttongroup.ButtonGroup() {
				@selectcomp.Select(selectcomp.Props{
					Items: []selectcomp.ItemData{
						{Value: "$", Label: "$"},
						{Value: "€", Label: "€"},
						{Value: "£", Label: "£"},
					},
					DefaultValue: "$",
				}) {
					@selectcomp.Trigger() {
						@selectcomp.Value()
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							@selectcomp.Item(selectcomp.ItemProps{Value: "$", Label: "$"}) {
								$
							}
							@selectcomp.Item(selectcomp.ItemProps{Value: "€", Label: "€"}) {
								€
							}
							@selectcomp.Item(selectcomp.ItemProps{Value: "£", Label: "£"}) {
								£
							}
						}
					}
				}
				@input.Input(input.Props{ID: "button-group-example-amount", Placeholder: "Enter amount to send"})
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.ArrowRight()
				}
			}
		}
	}
}

templ buttonGroupExampleWithIcons() {
	@buttonGroupExampleSection("With Icons") {
		<div class="flex flex-col gap-4">
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.FlipHorizontal2()
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.FlipVertical2()
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.RotateCw()
				}
			}
		</div>
	}
}

templ buttonGroupExampleWithInputGroup() {
	@buttonGroupExampleSection("With Input Group") {
		<div class="flex flex-col gap-4">
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{Placeholder: "Type to search..."})
				@inputgroup.Addon(inputgroup.AddonProps{
					Align: inputgroup.AlignInlineStart,
					Class: "text-muted-foreground",
				}) {
					@icon.Search()
				}
			}
		</div>
	}
}

templ buttonGroupExampleWithFields() {
	@buttonGroupExampleSection("With Fields") {
		@field.Group(field.GroupProps{Class: "grid grid-cols-3 gap-4"}) {
			@field.Field(field.Props{Class: "col-span-2"}) {
				@label.Label(label.Props{For: "button-group-example-width"}) {
					Width
				}
				@buttongroup.ButtonGroup() {
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{ID: "button-group-example-width"})
						@inputgroup.Addon(inputgroup.AddonProps{Class: "text-muted-foreground"}) {
							W
						}
						@inputgroup.Addon(inputgroup.AddonProps{
							Align: inputgroup.AlignInlineEnd,
							Class: "text-muted-foreground",
						}) {
							px
						}
					}
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
						@icon.Minus()
					}
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
						@icon.Plus()
					}
				}
			}
		}
	}
}

templ buttonGroupExampleWithLike() {
	@buttonGroupExampleSection("With Like") {
		@buttongroup.ButtonGroup() {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				@icon.Heart(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
				Like
			}
			@buttongroup.Text(buttongroup.TextProps{Class: "w-12 justify-center"}) {
				1.2K
			}
		}
	}
}

templ buttonGroupExampleWithSelectAndInput() {
	@buttonGroupExampleSection("With Select and Input") {
		@buttongroup.ButtonGroup() {
			@selectcomp.Select(selectcomp.Props{
				Items: []selectcomp.ItemData{
					{Value: "hours", Label: "Hours"},
					{Value: "days", Label: "Days"},
					{Value: "weeks", Label: "Weeks"},
				},
				DefaultValue: "hours",
			}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{ID: "button-group-example-duration"}) {
					@selectcomp.Value()
				}
				@selectcomp.Content(selectcomp.ContentProps{Align: selectcomp.AlignStart}) {
					@selectcomp.Group() {
						@selectcomp.Item(selectcomp.ItemProps{Value: "hours", Label: "Hours"}) {
							Hours
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: "days", Label: "Days"}) {
							Days
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: "weeks", Label: "Weeks"}) {
							Weeks
						}
					}
				}
			}
			@input.Input()
		}
	}
}

templ buttonGroupExampleNested() {
	@buttonGroupExampleSection("Nested") {
		@buttongroup.ButtonGroup() {
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Plus()
				}
			}
			@buttongroup.ButtonGroup() {
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{Placeholder: "Send a message..."})
					@tooltip.Tooltip() {
						@inputgroup.Addon(inputgroup.AddonProps{
							Align:      inputgroup.AlignInlineEnd,
							Attributes: tooltip.Trigger(ctx),
						}) {
							@icon.AudioLines()
						}
						@tooltip.Content() {
							Voice Mode
						}
					}
				}
			}
		}
	}
}

templ buttonGroupExamplePagination() {
	@buttonGroupExampleSection("Pagination") {
		@buttongroup.ButtonGroup() {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				@icon.ArrowLeft(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
				Previous
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				1
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				2
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				3
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				4
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				5
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
				Next
				@icon.ArrowRight(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
			}
		}
	}
}

templ buttonGroupExamplePaginationSplit() {
	@buttonGroupExampleSection("Pagination Split") {
		@buttongroup.ButtonGroup() {
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					1
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					2
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					3
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					4
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					5
				}
			}
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIconXs}) {
					@icon.ArrowLeft()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIconXs}) {
					@icon.ArrowRight()
				}
			}
		}
	}
}

templ buttonGroupExampleNavigation() {
	@buttonGroupExampleSection("Navigation") {
		@buttongroup.ButtonGroup() {
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.ArrowLeft()
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					@icon.ArrowRight()
				}
			}
			@buttongroup.ButtonGroup(buttongroup.Props{Attributes: templ.Attributes{"aria-label": "Single navigation button"}}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.ArrowLeft()
				}
			}
		}
	}
}

templ buttonGroupExampleTextAlignment() {
	@buttonGroupExampleSection("Text Alignment") {
		@field.Field() {
			@label.Label(label.Props{ID: "button-group-example-alignment-label"}) {
				Text Alignment
			}
			@buttongroup.ButtonGroup(buttongroup.Props{Attributes: templ.Attributes{"aria-labelledby": "button-group-example-alignment-label"}}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Left
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Center
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Right
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Justify
				}
			}
		}
	}
}

templ buttonGroupExampleVertical() {
	@buttonGroupExampleSection("Vertical") {
		<div class="flex gap-6">
			@buttongroup.ButtonGroup(buttongroup.Props{
				Orientation: buttongroup.OrientationVertical,
				Class:       "h-fit",
				Attributes:  templ.Attributes{"aria-label": "Media controls"},
			}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Plus()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Minus()
				}
			}
		</div>
	}
}

templ buttonGroupExampleVerticalNested() {
	@buttonGroupExampleSection("Vertical Nested") {
		@buttongroup.ButtonGroup(buttongroup.Props{
			Orientation: buttongroup.OrientationVertical,
			Attributes:  templ.Attributes{"aria-label": "Design tools palette"},
		}) {
			@buttongroup.ButtonGroup(buttongroup.Props{Orientation: buttongroup.OrientationVertical}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Search()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Copy()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Share()
				}
			}
			@buttongroup.ButtonGroup(buttongroup.Props{Orientation: buttongroup.OrientationVertical}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.FlipHorizontal2()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.FlipVertical2()
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.RotateCw()
				}
			}
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon}) {
					@icon.Trash()
				}
			}
		}
	}
}
