package checkbox

import (
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

type checkboxTableRow struct {
	ID    string
	Name  string
	Email string
	Role  string
}

var checkboxTableData = []checkboxTableRow{
	{ID: "1", Name: "Sarah Chen", Email: "sarah.chen@example.com", Role: "Admin"},
	{ID: "2", Name: "Marcus Rodriguez", Email: "marcus.rodriguez@example.com", Role: "User"},
	{ID: "3", Name: "Priya Patel", Email: "priya.patel@example.com", Role: "User"},
	{ID: "4", Name: "David Kim", Email: "david.kim@example.com", Role: "Editor"},
}

templ CheckboxTable() {
	@table.Table() {
		@table.Header() {
			@table.Row() {
				@table.Head(table.HeadProps{Class: "w-8"}) {
					@checkbox.Checkbox(checkbox.Props{
						ID:      "select-all-checkbox",
						Name:    "select-all-checkbox",
						Checked: utils.Ptr(false),
					})
				}
				@table.Head() {
					Name
				}
				@table.Head() {
					Email
				}
				@table.Head() {
					Role
				}
			}
		}
		@table.Body() {
			for _, row := range checkboxTableData {
				@table.Row(table.RowProps{
					Attributes: templ.Attributes{"data-state": templ.KV("selected", row.ID == "1")},
				}) {
					@table.Cell() {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "row-" + row.ID + "-checkbox",
							Name:    "row-" + row.ID + "-checkbox",
							Checked: utils.Ptr(row.ID == "1"),
						})
					}
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						{ row.Name }
					}
					@table.Cell() {
						{ row.Email }
					}
					@table.Cell() {
						{ row.Role }
					}
				}
			}
		}
	}
	@checkboxTableState(utils.Map(checkboxTableData, func(r checkboxTableRow) string { return r.ID }))
}

// checkboxTableState is the examples' selectedRows state: onCheckedChange
// sets it, the checkboxes and the rows' data-state render it. It follows the
// table.
templ checkboxTableState(ids []string) {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const table = document.currentScript.previousElementSibling;
			const all = table.querySelector('thead [data-slot="checkbox"]');
			const rows = [...table.querySelectorAll('tbody [data-slot="checkbox"]')];
			const ids = {{ ids }};
			const selected = new Set(["1"]);
			const render = () => {
				window.templ.checkbox.setChecked(all, selected.size === rows.length);
				rows.forEach((row, i) => {
					window.templ.checkbox.setChecked(row, selected.has(ids[i]));
					const tr = row.closest("tr");
					if (selected.has(ids[i])) tr.setAttribute("data-state", "selected");
					else tr.removeAttribute("data-state");
				});
			};
			table.addEventListener("checkbox-change", (e) => {
				if (e.target === all) {
					selected.clear();
					if (e.detail.checked) ids.forEach((id) => selected.add(id));
				} else {
					const id = ids[rows.indexOf(e.target)];
					if (e.detail.checked) selected.add(id);
					else selected.delete(id);
				}
				render();
			});
		})();
	</script>
}
