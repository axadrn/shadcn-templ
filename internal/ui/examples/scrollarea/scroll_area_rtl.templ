package scrollarea

import (
	"github.com/axadrn/shadcn-templ/v2/components/scrollarea"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
)

// The upstream example's Arabic translation, its default language.
templ ScrollAreaRtl() {
	@scrollarea.ScrollArea(scrollarea.Props{Class: "h-72 w-48 rounded-md border", Attributes: templ.Attributes{"dir": "rtl"}}) {
		<div class="p-4">
			<h4 class="mb-4 text-sm leading-none font-medium">العلامات</h4>
			for _, tag := range scrollAreaTags {
				<div class="text-sm">{ tag }</div>
				@separator.Separator(separator.Props{Class: "my-2"})
			}
		</div>
	}
}
