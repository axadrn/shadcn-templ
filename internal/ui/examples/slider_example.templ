package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/slider"
)

templ sliderExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ SliderExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@sliderExampleBasic()
			@sliderExampleRange()
			@sliderExampleMultiple()
			@sliderExampleVertical()
			@sliderExampleControlled()
			@sliderExampleDisabled()
		</div>
	</div>
}

templ sliderExampleBasic() {
	@sliderExampleSection("Basic") {
		@slider.Slider(slider.Props{DefaultValue: []float64{50}, Max: 100, Step: 1})
	}
}

templ sliderExampleRange() {
	@sliderExampleSection("Range") {
		@slider.Slider(slider.Props{DefaultValue: []float64{25, 50}, Max: 100, Step: 5})
	}
}

templ sliderExampleMultiple() {
	@sliderExampleSection("Multiple Thumbs") {
		@slider.Slider(slider.Props{DefaultValue: []float64{10, 20, 70}, Max: 100, Step: 10})
	}
}

templ sliderExampleVertical() {
	@sliderExampleSection("Vertical") {
		<div class="flex items-center gap-6">
			@slider.Slider(slider.Props{
				DefaultValue: []float64{50},
				Max:          100,
				Step:         1,
				Orientation:  slider.OrientationVertical,
				Class:        "h-40",
			})
			@slider.Slider(slider.Props{
				DefaultValue: []float64{25},
				Max:          100,
				Step:         1,
				Orientation:  slider.OrientationVertical,
				Class:        "h-40",
			})
		</div>
	}
}

// Keep the displayed value in sync with the slider.
templ sliderExampleControlled() {
	@sliderExampleSection("Controlled") {
		<div class="grid w-full gap-3">
			<div class="flex items-center justify-between gap-2">
				@label.Label(label.Props{For: "slider-demo-temperature"}) {
					Temperature
				}
				<span class="text-sm text-muted-foreground">0.3, 0.7</span>
			</div>
			@slider.Slider(slider.Props{
				ID:    "slider-demo-temperature",
				Value: []float64{0.3, 0.7},
				Min:   0,
				Max:   1,
				Step:  0.1,
			})
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			// The value state: onValueChange sets it, the slider and the text
			// render it.
			(() => {
				const demo = document.currentScript.previousElementSibling;
				const slider = demo.querySelector('[data-slot="slider"]');
				slider.addEventListener("slider-change", (e) => {
					window.templ.slider.setValues(slider, e.detail.values);
					demo.querySelector("span").textContent = e.detail.values.join(", ");
				});
			})();
		</script>
	}
}

templ sliderExampleDisabled() {
	@sliderExampleSection("Disabled") {
		@slider.Slider(slider.Props{DefaultValue: []float64{50}, Max: 100, Step: 1, Disabled: true})
	}
}
