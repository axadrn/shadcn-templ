package card

import (
	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/togglegroup"
)

templ cardExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

var cardExampleSpacingOptions = []spacingOption{
	{"[--card-spacing:--spacing(4)]", "16px", "4"},
	{"[--card-spacing:--spacing(5)]", "20px", "5"},
	{"[--card-spacing:--spacing(6)]", "24px", "6"},
	{"[--card-spacing:--spacing(8)]", "32px", "8"},
}

templ CardExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@cardExampleDefault()
			@cardExampleSmall()
			@cardExampleContentEdgeToEdge()
			@cardExampleCustomSpacing()
			@cardExampleHeaderWithBorder()
			@cardExampleFooterWithBorder()
			@cardExampleHeaderWithBorderSmall()
			@cardExampleFooterWithBorderSmall()
			@cardExampleWithImage()
			@cardExampleWithImageSmall()
			@cardExampleLogin()
			@cardExampleMeetingNotes()
		</div>
	</div>
}

templ cardExampleContentEdgeToEdge() {
	@cardExampleSection("Content Edge to Edge") {
		@card.Card(card.Props{Class: "mx-auto w-full max-w-sm"}) {
			@card.Header() {
				@card.Title() {
					Terms of Service
				}
				@card.Description() {
					Review the terms before accepting the agreement.
				}
			}
			@card.Content(card.ContentProps{Class: "-mb-(--card-spacing) px-0"}) {
				<div class="max-h-48 space-y-4 overflow-y-scroll border-t bg-muted/50 px-(--card-spacing) py-4 text-sm leading-relaxed">
					<p>
						These terms govern your use of the workspace, including access to shared documents, project files, and collaboration tools.
					</p>
					<p>
						You are responsible for the content you upload and for ensuring that your team has the appropriate permissions to view or edit it.
					</p>
					<p>
						We may update features or limits as the service evolves. When those changes materially affect your workflow, we will notify your workspace administrators.
					</p>
					<p>
						By continuing, you agree to keep your account credentials secure and to follow your organization's acceptable use policies.
					</p>
				</div>
			}
			@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Decline
				}
				@button.Button() {
					Accept
				}
			}
		}
	}
}

templ cardExampleCustomSpacing() {
	@cardExampleSection("Custom Spacing") {
		<div class="mx-auto grid w-full max-w-sm gap-4">
			@togglegroup.ToggleGroup(togglegroup.Props{
				Variant: togglegroup.VariantOutline,
				Size:    togglegroup.SizeSm,
				Class:   "justify-center",
				Value:   []string{cardExampleSpacingOptions[0].Value},
			}) {
				for _, option := range cardExampleSpacingOptions {
					@togglegroup.Item(togglegroup.ItemProps{Value: option.Value}) {
						{ option.Label }
					}
				}
			}
			@card.Card(card.Props{Class: cardExampleSpacingOptions[0].Class}) {
				@card.Header() {
					@card.Title() {
						Release Health
					}
					@card.Description() {
						Track readiness across launch signals.
					}
				}
				@card.Content() {
					<div class="grid gap-2 rounded-lg bg-muted/50 p-3 text-sm style-lyra:rounded-none style-sera:rounded-none">
						<div class="flex items-center justify-between gap-2">
							<span class="text-muted-foreground">Checks passed</span>
							<span class="font-medium">24 / 26</span>
						</div>
						<div class="flex items-center justify-between gap-2">
							<span class="text-muted-foreground">Open blockers</span>
							<span class="font-medium">2</span>
						</div>
					</div>
				}
			}
		</div>
		@cardSpacingState(cardExampleSpacingOptions)
	}
}

templ cardExampleLogin() {
	@cardExampleSection("Login") {
		@card.Card(card.Props{Class: "mx-auto w-full max-w-sm"}) {
			@card.Header() {
				@card.Title() {
					Login to your account
				}
				@card.Description() {
					Enter your email below to login to your account
				}
			}
			@card.Content() {
				<form>
					@field.Group() {
						@field.Field() {
							@field.Label(field.LabelProps{For: "card-example-email"}) {
								Email
							}
							@input.Input(input.Props{
								ID:          "card-example-email",
								Type:        "email",
								Placeholder: "m@example.com",
								Attributes:  templ.Attributes{"required": true},
							})
						}
						@field.Field() {
							<div class="flex items-center">
								@field.Label(field.LabelProps{For: "card-example-password"}) {
									Password
								}
								<a href="#" class="ml-auto inline-block underline-offset-4 hover:underline">
									Forgot your password?
								</a>
							</div>
							@input.Input(input.Props{
								ID:         "card-example-password",
								Type:       "password",
								Attributes: templ.Attributes{"required": true},
							})
						}
					}
				</form>
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-2"}) {
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
					Login
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full"}) {
					Login with Google
				}
				<div class="mt-4 text-center">
					Don't have an account?
					<a href="#" class="underline underline-offset-4">
						Sign up
					</a>
				</div>
			}
		}
	}
}

templ cardExampleMeetingNotes() {
	@cardExampleSection("Meeting Notes") {
		@card.Card(card.Props{Class: "mx-auto w-full max-w-sm"}) {
			@card.Header() {
				@card.Title() {
					Meeting Notes
				}
				@card.Description() {
					Transcript from the meeting with the client.
				}
				@card.Action() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
						@icon.Captions(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Transcribe
					}
				}
			}
			@card.Content() {
				<p>
					Client requested dashboard redesign with focus on mobile responsiveness.
				</p>
				<ol class="mt-4 flex list-decimal flex-col gap-2 pl-6">
					<li>New analytics widgets for daily/weekly metrics</li>
					<li>Simplified navigation menu</li>
					<li>Dark mode support</li>
					<li>Timeline: 6 weeks</li>
					<li>Follow-up meeting scheduled for next Tuesday</li>
				</ol>
			}
			@card.Footer() {
				@avatar.Group() {
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{Src: "https://github.com/axadrn.png", Alt: "@axadrn"})
						@avatar.Fallback() {
							AA
						}
					}
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{Src: "https://github.com/joerdav.png", Alt: "@joerdav"})
						@avatar.Fallback() {
							JD
						}
					}
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{Src: "https://github.com/a-h.png", Alt: "@a-h"})
						@avatar.Fallback() {
							AH
						}
					}
					@avatar.GroupCount() {
						+8
					}
				}
			}
		}
	}
}

templ cardExampleWithImage() {
	@cardExampleSection("With Image") {
		@card.Card(card.Props{Size: card.SizeDefault, Class: "relative mx-auto w-full max-w-sm pt-0"}) {
			<div class="absolute inset-0 z-30 aspect-video bg-primary opacity-50 mix-blend-color"></div>
			<img
				src="/assets/img/card_placeholder.jpeg"
				alt="Photo"
				title="Photo"
				class="relative z-20 aspect-video w-full object-cover brightness-60 grayscale"
			/>
			@card.Header() {
				@card.Title() {
					Beautiful Landscape
				}
				@card.Description() {
					A stunning view that captures the essence of natural beauty.
				}
			}
			@card.Footer() {
				@button.Button(button.Props{Class: "w-full"}) {
					@icon.Plus(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					Button
				}
			}
		}
	}
}

templ cardExampleWithImageSmall() {
	@cardExampleSection("With Image (Small)") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "relative mx-auto w-full max-w-sm pt-0"}) {
			<div class="absolute inset-0 z-30 aspect-video bg-primary opacity-50 mix-blend-color"></div>
			<img
				src="/assets/img/card_placeholder.jpeg"
				alt="Photo"
				title="Photo"
				class="relative z-20 aspect-video w-full object-cover brightness-60 grayscale"
			/>
			@card.Header() {
				@card.Title() {
					Beautiful Landscape
				}
				@card.Description() {
					A stunning view that captures the essence of natural beauty.
				}
			}
			@card.Footer() {
				@button.Button(button.Props{Size: button.SizeSm, Class: "w-full"}) {
					@icon.Plus(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					Button
				}
			}
		}
	}
}

templ cardExampleHeaderWithBorder() {
	@cardExampleSection("Header with Border") {
		@card.Card(card.Props{Class: "mx-auto w-full max-w-sm"}) {
			@card.Header(card.HeaderProps{Class: "border-b"}) {
				@card.Title() {
					Header with Border
				}
				@card.Description() {
					This is a card with a header that has a bottom border.
				}
			}
			@card.Content() {
				<p>
					The header has a border-b class applied, creating a visual separation between the header and content sections.
				</p>
			}
		}
	}
}

templ cardExampleFooterWithBorder() {
	@cardExampleSection("Footer with Border") {
		@card.Card(card.Props{Class: "mx-auto w-full max-w-sm"}) {
			@card.Content() {
				<p>
					The footer has a border-t class applied, creating a visual separation between the content and footer sections.
				</p>
			}
			@card.Footer(card.FooterProps{Class: "border-t"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full"}) {
					Footer with Border
				}
			}
		}
	}
}

templ cardExampleDefault() {
	@cardExampleSection("Default Size") {
		@card.Card(card.Props{Size: card.SizeDefault, Class: "mx-auto w-full max-w-sm"}) {
			@card.Header() {
				@card.Title() {
					Default Card
				}
				@card.Description() {
					This card uses the default size variant.
				}
			}
			@card.Content() {
				<p>
					The card component supports a size prop that defaults to "default" for standard spacing and sizing.
				</p>
			}
			@card.Footer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full"}) {
					Action
				}
			}
		}
	}
}

templ cardExampleSmall() {
	@cardExampleSection("Small Size") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-full max-w-sm"}) {
			@card.Header() {
				@card.Title() {
					Small Card
				}
				@card.Description() {
					This card uses the small size variant.
				}
			}
			@card.Content() {
				<p>
					The card component supports a size prop that can be set to "sm" for a more compact appearance.
				</p>
			}
			@card.Footer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
					Action
				}
			}
		}
	}
}

templ cardExampleHeaderWithBorderSmall() {
	@cardExampleSection("Header with Border (Small)") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-full max-w-sm"}) {
			@card.Header(card.HeaderProps{Class: "border-b"}) {
				@card.Title() {
					Header with Border
				}
				@card.Description() {
					This is a small card with a header that has a bottom border.
				}
			}
			@card.Content() {
				<p>
					The header has a border-b class applied, creating a visual separation between the header and content sections.
				</p>
			}
		}
	}
}

templ cardExampleFooterWithBorderSmall() {
	@cardExampleSection("Footer with Border (Small)") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-full max-w-sm"}) {
			@card.Content() {
				<p>
					The footer has a border-t class applied, creating a visual separation between the content and footer sections.
				</p>
			}
			@card.Footer(card.FooterProps{Class: "border-t"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
					Footer with Border
				}
			}
		}
	}
}
