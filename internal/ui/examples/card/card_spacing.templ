package card

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/togglegroup"
)

type spacingOption struct {
	Class string
	Label string
	Value string
}

var spacingOptions = []spacingOption{
	{"[--card-spacing:--spacing(4)]", "16px", "4"},
	{"[--card-spacing:--spacing(5)]", "20px", "5"},
	{"[--card-spacing:--spacing(6)]", "24px", "6"},
	{"[--card-spacing:--spacing(8)]", "32px", "8"},
}

templ CardSpacing() {
	<div class="mx-auto grid w-full max-w-sm gap-4">
		@togglegroup.ToggleGroup(togglegroup.Props{
			Variant: togglegroup.VariantOutline,
			Size:    togglegroup.SizeSm,
			Class:   "justify-center",
			Value:   []string{spacingOptions[0].Value},
		}) {
			for _, option := range spacingOptions {
				@togglegroup.Item(togglegroup.ItemProps{Value: option.Value}) {
					{ option.Label }
				}
			}
		}
		@card.Card(card.Props{Class: spacingOptions[0].Class}) {
			@card.Header() {
				@card.Title() {
					Login to your account
				}
				@card.Description() {
					Enter your email below to login to your account
				}
				@card.Action() {
					@button.Button(button.Props{Variant: button.VariantLink}) {
						Sign Up
					}
				}
			}
			@card.Content() {
				<form>
					<div class="flex flex-col gap-6">
						<div class="grid gap-2">
							@label.Label(label.Props{For: "email-spacing"}) {
								Email
							}
							@input.Input(input.Props{
								ID:          "email-spacing",
								Type:        "email",
								Placeholder: "m@example.com",
								Attributes:  templ.Attributes{"required": true},
							})
						</div>
						<div class="grid gap-2">
							<div class="flex items-center">
								@label.Label(label.Props{For: "password-spacing"}) {
									Password
								}
								<a href="#" class="ml-auto inline-block text-sm underline-offset-4 hover:underline">
									Forgot your password?
								</a>
							</div>
							@input.Input(input.Props{
								ID:         "password-spacing",
								Type:       "password",
								Attributes: templ.Attributes{"required": true},
							})
						</div>
					</div>
				</form>
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-2"}) {
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
					Login
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full"}) {
					Login with Google
				}
			}
		}
	</div>
	@cardSpacingState(spacingOptions)
}

// cardSpacingState is the examples' spacing state: the toggle group's
// onValueChange sets it unless empty, the group and the card's className
// render it. It follows the element holding both.
templ cardSpacingState(options []spacingOption) {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const demo = document.currentScript.previousElementSibling;
			const group = demo.querySelector('[data-slot="toggle-group"]');
			const card = demo.querySelector('[data-slot="card"]');
			const options = {{ options }};
			group.addEventListener("toggle-group-value-change", (e) => {
				const value = e.detail.value[0];
				if (!value) return;
				window.templ.toggleGroup.setValue(group, [value]);
				options.forEach((o) => card.classList.remove(o.Class));
				card.classList.add(options.find((o) => o.Value === value).Class);
			});
		})();
	</script>
}
