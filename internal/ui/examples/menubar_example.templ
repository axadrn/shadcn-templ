templ menubarExampleFormat() {
	@example.Example(example.Props{Title: "Format"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					Format
				}
				@menubar.Content() {
					@menubar.Item() {
						@icon.Bold()
						Bold
						@menubar.Shortcut() {
							⌘B
						}
					}
					@menubar.Item() {
						@icon.Italic()
						Italic
						@menubar.Shortcut() {
							⌘I
						}
					}
					@menubar.Item() {
						@icon.Underline()
						Underline
						@menubar.Shortcut() {
							⌘U
						}
					}
					@menubar.Separator()
					@menubar.CheckboxItem(menubar.CheckboxItemProps{Checked: menubarBool(true)}) {
						Strikethrough
					}
					@menubar.CheckboxItem() {
						Code
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					View
				}
				@menubar.Content() {
					@menubar.CheckboxItem() {
						Show Ruler
					}
					@menubar.CheckboxItem(menubar.CheckboxItemProps{Checked: menubarBool(true)}) {
						Show Grid
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Inset: true}) {
						Zoom In
					}
					@menubar.Item(menubar.ItemProps{Inset: true}) {
						Zoom Out
					}
				}
			}
		}
	}
}

templ menubarExampleInsert() {
	@example.Example(example.Props{Title: "Insert"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					Insert
				}
				@menubar.Content() {
					@menubar.Sub() {
						@menubar.SubTrigger() {
							@icon.Image()
							Media
						}
						@menubar.SubContent() {
							@menubar.Item() {
								Image
							}
							@menubar.Item() {
								Video
							}
							@menubar.Item() {
								Audio
							}
						}
					}
					@menubar.Separator()
					@menubar.Item() {
						@icon.Link()
						Link
						@menubar.Shortcut() {
							⌘K
						}
					}
					@menubar.Item() {
						@icon.Table()
						Table
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Tools
				}
				@menubar.Content(menubar.ContentProps{Class: "w-44"}) {
					@menubar.Item() {
						@icon.Search()
						Find &amp; Replace
						@menubar.Shortcut() {
							⌘F
						}
					}
					@menubar.Item() {
						@icon.Check()
						Spell Check
					}
				}
			}
		}
	}
}

templ menubarExampleDestructive() {
	@example.Example(example.Props{Title: "Destructive"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					File
				}
				@menubar.Content(menubar.ContentProps{Class: "w-40"}) {
					@menubar.Item() {
						@icon.File()
						New File
						@menubar.Shortcut() {
							⌘N
						}
					}
					@menubar.Item() {
						@icon.Folder()
						Open Folder
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Variant: menubar.ItemVariantDestructive}) {
						@icon.Trash()
						Delete File
						@menubar.Shortcut() {
							⌘⌫
						}
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Account
				}
				@menubar.Content() {
					@menubar.Item() {
						@icon.User()
						Profile
					}
					@menubar.Item() {
						@icon.Settings()
						Settings
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Variant: menubar.ItemVariantDestructive}) {
						@icon.LogOut()
						Sign out
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Variant: menubar.ItemVariantDestructive}) {
						@icon.Trash()
						Delete
					}
				}
			}
		}
	}
}

templ menubarExampleInDialog() {
	@example.Example(example.Props{Title: "In Dialog"}) {
		@dialog.Dialog() {
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Trigger(ctx)}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Menubar Example
					}
					@dialog.Description() {
						Use the menubar below to see the menu options.
					}
				}
				@menubar.Menubar() {
					@menubar.Menu() {
						@menubar.Trigger() {
							File
						}
						@menubar.Content() {
							@menubar.Item() {
								@icon.Copy()
								Copy
							}
							@menubar.Item() {
								@icon.Scissors()
								Cut
							}
							@menubar.Item() {
								@icon.ClipboardPaste()
								Paste
							}
							@menubar.Separator()
							@menubar.Sub() {
								@menubar.SubTrigger() {
									More Options
								}
								@menubar.SubContent() {
									@menubar.Item() {
										Save Page...
									}
									@menubar.Item() {
										Create Shortcut...
									}
									@menubar.Item() {
										Name Window...
									}
									@menubar.Separator()
									@menubar.Item() {
										Developer Tools
									}
								}
							}
							@menubar.Separator()
							@menubar.Item(menubar.ItemProps{Variant: menubar.ItemVariantDestructive}) {
								@icon.Trash()
								Delete
							}
						}
					}
					@menubar.Menu() {
						@menubar.Trigger() {
							Edit
						}
						@menubar.Content() {
							@menubar.Item() {
								Undo
								@menubar.Shortcut() {
									⌘Z
								}
							}
							@menubar.Item() {
								Redo
								@menubar.Shortcut() {
									⇧⌘Z
								}
							}
						}
					}
				}
			}
		}
	}
}

templ menubarExampleWithInset() {
	@example.Example(example.Props{Title: "With Inset"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					View
				}
				@menubar.Content(menubar.ContentProps{Class: "w-44"}) {
					@menubar.Group() {
						@menubar.Label() {
							Actions
						}
						@menubar.Item() {
							@icon.Copy()
							Copy
						}
						@menubar.Item() {
							@icon.Scissors()
							Cut
						}
						@menubar.Item(menubar.ItemProps{Inset: true}) {
							Paste
						}
					}
					@menubar.Separator()
					@menubar.Group() {
						@menubar.Label(menubar.LabelProps{Inset: true}) {
							Appearance
						}
						@menubar.CheckboxItem(menubar.CheckboxItemProps{DefaultChecked: true, Inset: true}) {
							Bookmarks
						}
						@menubar.CheckboxItem(menubar.CheckboxItemProps{Inset: true}) {
							Full URLs
						}
					}
					@menubar.Separator()
					@menubar.Group() {
						@menubar.Label(menubar.LabelProps{Inset: true}) {
							Theme
						}
						@menubar.RadioGroup(menubar.RadioGroupProps{DefaultValue: "system"}) {
							@menubar.RadioItem(menubar.RadioItemProps{Value: "light", Inset: true}) {
								Light
							}
							@menubar.RadioItem(menubar.RadioItemProps{Value: "dark", Inset: true}) {
								Dark
							}
							@menubar.RadioItem(menubar.RadioItemProps{Value: "system", Inset: true}) {
								System
							}
						}
					}
					@menubar.Separator()
					@menubar.Sub() {
						@menubar.SubTrigger(menubar.SubTriggerProps{Inset: true}) {
							More Options
						}
						@menubar.SubContent() {
							@menubar.Group() {
								@menubar.Item() {
									Save Page...
								}
								@menubar.Item() {
									Create Shortcut...
								}
							}
						}
					}
				}
			}
		}
	}
}
