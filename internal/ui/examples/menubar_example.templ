package examples

import (
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/example"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/menubar"
)

// MenubarExample is menubar-example.tsx. IconPlaceholder renders its lucide
// icon. The useState values bound with onValueChange/onCheckedChange are
// the groups' default values, like menubar_radio.templ.
templ MenubarExample() {
	@example.Wrapper() {
		@menubarExampleBasic()
		@menubarExampleWithSubmenu()
		@menubarExampleSides()
		@menubarExampleWithCheckboxes()
		@menubarExampleWithRadio()
		@menubarExampleWithIcons()
		@menubarExampleWithShortcuts()
		@menubarExampleFormat()
		@menubarExampleInsert()
		@menubarExampleDestructive()
		@menubarExampleInDialog()
		@menubarExampleWithInset()
	}
}

templ menubarExampleBasic() {
	@example.Example(example.Props{Title: "Basic"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					File
				}
				@menubar.Content() {
					@menubar.Item() {
						New Tab
						@menubar.Shortcut() {
							⌘T
						}
					}
					@menubar.Item() {
						New Window
						@menubar.Shortcut() {
							⌘N
						}
					}
					@menubar.Item(menubar.ItemProps{Disabled: true}) {
						New Incognito Window
					}
					@menubar.Separator()
					@menubar.Item() {
						Print...
						@menubar.Shortcut() {
							⌘P
						}
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Edit
				}
				@menubar.Content() {
					@menubar.Item() {
						Undo
						@menubar.Shortcut() {
							⌘Z
						}
					}
					@menubar.Item() {
						Redo
						@menubar.Shortcut() {
							⇧⌘Z
						}
					}
					@menubar.Separator()
					@menubar.Item() {
						Cut
					}
					@menubar.Item() {
						Copy
					}
					@menubar.Item() {
						Paste
					}
				}
			}
		}
	}
}

templ menubarExampleSides() {
	@example.Example(example.Props{Title: "Sides", ContainerClass: "col-span-2"}) {
		<div class="flex flex-wrap justify-center gap-2">
			for _, side := range []string{"inline-start", "left", "top", "bottom", "right", "inline-end"} {
				@menubar.Menubar() {
					@menubar.Menu() {
						@menubar.Trigger(menubar.TriggerProps{Class: "capitalize"}) {
							{ strings.Replace(side, "-", " ", 1) }
						}
						@menubar.Content(menubar.ContentProps{Side: menubar.Side(side)}) {
							@menubar.Group() {
								@menubar.Item() {
									New Tab
								}
								@menubar.Item() {
									New Window
								}
								@menubar.Item() {
									New Incognito Window
								}
							}
						}
					}
				}
			}
		</div>
	}
}

templ menubarExampleWithSubmenu() {
	@example.Example(example.Props{Title: "With Submenu"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					File
				}
				@menubar.Content() {
					@menubar.Sub() {
						@menubar.SubTrigger() {
							Share
						}
						@menubar.SubContent() {
							@menubar.Item() {
								Email link
							}
							@menubar.Item() {
								Messages
							}
							@menubar.Item() {
								Notes
							}
						}
					}
					@menubar.Separator()
					@menubar.Item() {
						Print...
						@menubar.Shortcut() {
							⌘P
						}
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Edit
				}
				@menubar.Content() {
					@menubar.Item() {
						Undo
						@menubar.Shortcut() {
							⌘Z
						}
					}
					@menubar.Item() {
						Redo
						@menubar.Shortcut() {
							⇧⌘Z
						}
					}
					@menubar.Separator()
					@menubar.Sub() {
						@menubar.SubTrigger() {
							Find
						}
						@menubar.SubContent() {
							@menubar.Item() {
								Find...
							}
							@menubar.Item() {
								Find Next
							}
							@menubar.Item() {
								Find Previous
							}
						}
					}
					@menubar.Separator()
					@menubar.Item() {
						Cut
					}
					@menubar.Item() {
						Copy
					}
					@menubar.Item() {
						Paste
					}
				}
			}
		}
	}
}

templ menubarExampleWithCheckboxes() {
	@example.Example(example.Props{Title: "With Checkboxes"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					View
				}
				@menubar.Content(menubar.ContentProps{Class: "w-64"}) {
					@menubar.CheckboxItem() {
						Always Show Bookmarks Bar
					}
					@menubar.CheckboxItem(menubar.CheckboxItemProps{Checked: menubarBool(true)}) {
						Always Show Full URLs
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Inset: true}) {
						Reload
						@menubar.Shortcut() {
							⌘R
						}
					}
					@menubar.Item(menubar.ItemProps{Disabled: true, Inset: true}) {
						Force Reload
						@menubar.Shortcut() {
							⇧⌘R
						}
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Format
				}
				@menubar.Content() {
					@menubar.CheckboxItem(menubar.CheckboxItemProps{Checked: menubarBool(true)}) {
						Strikethrough
					}
					@menubar.CheckboxItem() {
						Code
					}
					@menubar.CheckboxItem() {
						Superscript
					}
				}
			}
		}
	}
}

templ menubarExampleWithRadio() {
	@example.Example(example.Props{Title: "With Radio"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					Profiles
				}
				@menubar.Content() {
					@menubar.RadioGroup(menubar.RadioGroupProps{DefaultValue: "benoit"}) {
						@menubar.RadioItem(menubar.RadioItemProps{Value: "andy"}) {
							Andy
						}
						@menubar.RadioItem(menubar.RadioItemProps{Value: "benoit"}) {
							Benoit
						}
						@menubar.RadioItem(menubar.RadioItemProps{Value: "luis"}) {
							Luis
						}
					}
					@menubar.Separator()
					@menubar.Item(menubar.ItemProps{Inset: true}) {
						Edit...
					}
					@menubar.Item(menubar.ItemProps{Inset: true}) {
						Add Profile...
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					Theme
				}
				@menubar.Content() {
					@menubar.RadioGroup(menubar.RadioGroupProps{DefaultValue: "system"}) {
						@menubar.RadioItem(menubar.RadioItemProps{Value: "light"}) {
							Light
						}
						@menubar.RadioItem(menubar.RadioItemProps{Value: "dark"}) {
							Dark
						}
						@menubar.RadioItem(menubar.RadioItemProps{Value: "system"}) {
							System
						}
					}
				}
			}
		}
	}
}

templ menubarExampleWithIcons() {
	@example.Example(example.Props{Title: "With Icons"}) {
		@menubar.Menubar() {
			@menubar.Menu() {
				@menubar.Trigger() {
					File
				}
				@menubar.Content() {
					@menubar.Item() {
						@icon.File()
						New File
						@menubar.Shortcut() {
							⌘N
						}
					}
					@menubar.Item() {
						@icon.Folder()
						Open Folder
					}
					@menubar.Separator()
					@menubar.Item() {
						@icon.Save()
						Save
						@menubar.Shortcut() {
							⌘S
						}
					}
				}
			}
			@menubar.Menu() {
				@menubar.Trigger() {
					More
				}
				@menubar.Content() {
					@menubar.Group() {
						@menubar.Item() {
							@icon.CircleDashed()
							Settings
						}
						@menubar.Item() {
							@icon.CircleDashed()
							Help
						}
						@menubar.Separator()
						@menubar.Item(menubar.ItemProps{Variant: menubar.ItemVariantDestructive}) {
							@icon.CircleDashed()
							Delete
						}
					}
				}
			}
		}
	}
}

