package questionnaire

import "github.com/axadrn/shadcn-templ/v2/components/questionnaire"

type questionnaireDemoChoice struct {
	Value       string
	Label       string
	Description string
}

type questionnaireDemoQuestion struct {
	Name             string
	Title            string
	Description      string
	Required         bool
	Multiple         bool
	Choices          []questionnaireDemoChoice
	InputLabel       string
	InputPlaceholder string
}

var questionnaireDemoQuestions = []questionnaireDemoQuestion{
	{
		Name:        "direction",
		Title:       "What should the agent build next?",
		Description: "Choose a direction or describe another task.",
		Required:    true,
		Choices: []questionnaireDemoChoice{
			{Value: "tool-calls", Label: "Tool call timeline", Description: "Show what the agent ran and what came back."},
			{Value: "approvals", Label: "Approval checkpoints", Description: "Ask before sensitive or destructive actions."},
			{Value: "handoffs", Label: "Sub-agent handoffs", Description: "Make delegated work and results easier to follow."},
		},
		InputLabel:       "Another agent feature",
		InputPlaceholder: "Describe another feature…",
	},
	{
		Name:        "signals",
		Title:       "What should every progress update include?",
		Description: "Select all that apply, or skip this question.",
		Multiple:    true,
		Choices: []questionnaireDemoChoice{
			{Value: "progress", Label: "Progress"},
			{Value: "decisions", Label: "Decisions"},
			{Value: "risks", Label: "Risks"},
			{Value: "next-step", Label: "Next step"},
		},
	},
	{
		Name:        "timing",
		Title:       "When should work begin?",
		Description: "Choose when the agent should begin the work.",
		Required:    true,
		Choices: []questionnaireDemoChoice{
			{Value: "now", Label: "Start now"},
			{Value: "next-cycle", Label: "Next development cycle"},
			{Value: "backlog", Label: "Add it to the backlog"},
		},
	},
}

func questionnaireDemoItems() []questionnaire.ItemDefinition {
	items := make([]questionnaire.ItemDefinition, 0, len(questionnaireDemoQuestions))
	for _, q := range questionnaireDemoQuestions {
		item := questionnaire.ItemDefinition{Name: q.Name, Required: q.Required}
		for _, c := range q.Choices {
			item.Choices = append(item.Choices, questionnaire.ChoiceDefinition{Value: c.Value})
		}
		items = append(items, item)
	}
	return items
}

templ QuestionnaireDemo() {
	@questionnaire.Questionnaire(questionnaire.Props{
		Class:       "mx-auto max-w-md",
		DefaultItem: "direction",
		Items:       questionnaireDemoItems(),
		Shortcuts:   questionnaire.ShortcutsLetters,
	}) {
		@questionnaire.Progress()
		for _, question := range questionnaireDemoQuestions {
			@questionnaire.Item(questionnaire.ItemProps{
				Name:     question.Name,
				Required: question.Required,
				Multiple: question.Multiple,
			}) {
				@questionnaire.Title() {
					{ question.Title }
				}
				@questionnaire.Description() {
					{ question.Description }
				}
				@questionnaire.Choices() {
					for _, choice := range question.Choices {
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: choice.Value}) {
							<span class="font-medium">{ choice.Label }</span>
							if choice.Description != "" {
								<span class="text-muted-foreground">{ choice.Description }</span>
							}
						}
					}
					if question.InputLabel != "" {
						@questionnaire.Input(questionnaire.InputProps{
							Attributes: templ.Attributes{
								"aria-label":  question.InputLabel,
								"placeholder": question.InputPlaceholder,
							},
						})
					}
				}
				@questionnaire.Error()
			}
		}
		@questionnaire.Actions() {
			@questionnaire.Previous()
			@questionnaire.Skip()
			@questionnaire.Next() {
				Next
			}
			@questionnaire.Submit() {
				Save plan
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the demo's onSubmit toast.
		(() => {
			const root = document.currentScript.previousElementSibling;
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const formData = new FormData(e.target);
				const answers = {
					direction: formData.get("direction"),
					signals: formData.getAll("signals"),
					timing: formData.get("timing"),
				};
				window.templ.toast.add({
					title: "Agent plan saved",
					description: `Direction: ${answers.direction ?? "None"} · Progress signals: ${answers.signals.join(", ") || "None"} · Timing: ${answers.timing ?? "None"}`,
				});
			});
		})();
	</script>
}
