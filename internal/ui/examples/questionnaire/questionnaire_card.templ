package questionnaire

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/questionnaire"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The question title and description render as the card's title and
// description (render={<CardTitle />}, render={<CardDescription />}).
var (
	questionnaireCardTitle       = &questionnaire.Render{Tag: "div", Class: "cn-card-title cn-font-heading"}
	questionnaireCardDescription = &questionnaire.Render{Tag: "div", Class: "cn-card-description"}
)

templ QuestionnaireCard() {
	// React.useId for the two titles.
	{{ taskTitleID, outputTitleID := utils.RandomID(), utils.RandomID() }}
	@questionnaire.Questionnaire(questionnaire.Props{
		Class:       "mx-auto max-w-md",
		DefaultItem: "task",
		Shortcuts:   questionnaire.ShortcutsNumbers,
		Items: []questionnaire.ItemDefinition{
			{Name: "task", Required: true, Choices: []questionnaire.ChoiceDefinition{{Value: "fix"}, {Value: "refactor"}, {Value: "docs"}}},
			{Name: "output", Required: true, Choices: []questionnaire.ChoiceDefinition{{Value: "summary"}, {Value: "files"}, {Value: "review"}}},
		},
	}) {
		@card.Card() {
			@questionnaire.Item(questionnaire.ItemProps{
				Name:       "task",
				Required:   true,
				Attributes: templ.Attributes{"aria-labelledby": taskTitleID},
			}) {
				@card.Header() {
					@questionnaire.Title(questionnaire.TitleProps{ID: taskTitleID, Render: questionnaireCardTitle}) {
						What should the agent work on?
					}
					@questionnaire.Description(questionnaire.DescriptionProps{Render: questionnaireCardDescription}) {
						Choose the task that should be handled next.
					}
					@card.Action() {
						@questionnaire.Progress()
					}
				}
				@card.Content() {
					@questionnaire.Choices() {
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "fix"}) {
							Fix the failing tests
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "refactor"}) {
							Refactor the data layer
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "docs"}) {
							Update the integration guide
						}
					}
					@questionnaire.Error()
				}
			}
			@questionnaire.Item(questionnaire.ItemProps{
				Name:       "output",
				Required:   true,
				Attributes: templ.Attributes{"aria-labelledby": outputTitleID},
			}) {
				@card.Header() {
					@questionnaire.Title(questionnaire.TitleProps{ID: outputTitleID, Render: questionnaireCardTitle}) {
						What should the final handoff include?
					}
					@questionnaire.Description(questionnaire.DescriptionProps{Render: questionnaireCardDescription}) {
						Pick the level of detail needed for review.
					}
					@card.Action() {
						@questionnaire.Progress()
					}
				}
				@card.Content() {
					@questionnaire.Choices() {
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "summary"}) {
							Summary only
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "files"}) {
							Summary and changed files
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "review"}) {
							Full review handoff
						}
					}
					@questionnaire.Error()
				}
			}
			@card.Footer() {
				@questionnaire.Actions(questionnaire.ActionsProps{Class: "w-full"}) {
					@questionnaire.Previous()
					@questionnaire.Next() {
						Next
					}
					@questionnaire.Submit() {
						Create task
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the example's onSubmit toast.
		(() => {
			const root = document.currentScript.previousElementSibling;
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const formData = new FormData(e.target);
				window.templ.toast.add({
					title: "Agent task created",
					description: `Task: ${formData.get("task") ?? "None"} · Handoff: ${formData.get("output") ?? "None"}`,
				});
			});
		})();
	</script>
}
