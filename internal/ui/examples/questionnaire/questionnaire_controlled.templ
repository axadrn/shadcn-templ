package questionnaire

import (
	"github.com/axadrn/shadcn-templ/v2/components/questionnaire"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ QuestionnaireControlled() {
	<div class="relative mx-auto flex h-full w-full max-w-md flex-col">
		<p class="absolute end-0 top-0 text-sm text-muted-foreground" role="status">
			Current checkpoint: Change scope
		</p>
		@questionnaire.Questionnaire(questionnaire.Props{
			Class: "mt-auto",
			Item:  utils.Ptr("scope"),
			Items: []questionnaire.ItemDefinition{
				{Name: "scope", Required: true},
				{Name: "checks", Required: true},
				{Name: "output", Required: true},
			},
		}) {
			@questionnaire.Progress()
			@questionnaire.Item(questionnaire.ItemProps{Name: "scope", Required: true}) {
				@questionnaire.Title() {
					What may the agent change?
				}
				@questionnaire.Description() {
					The host stores the active checkpoint while Questionnaire navigates.
				}
				@questionnaire.Choices() {
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "component"}) {
						Only the target component
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "tests"}) {
						Component and related tests
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "feature"}) {
						The complete feature area
					}
				}
				@questionnaire.Error()
			}
			@questionnaire.Item(questionnaire.ItemProps{Name: "checks", Required: true}) {
				@questionnaire.Title() {
					Which verification level should it use?
				}
				@questionnaire.Choices() {
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "targeted"}) {
						Targeted tests
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "package"}) {
						Package tests and typecheck
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "full"}) {
						Full workspace verification
					}
				}
				@questionnaire.Error()
			}
			@questionnaire.Item(questionnaire.ItemProps{Name: "output", Required: true}) {
				@questionnaire.Title() {
					What should the agent return when finished?
				}
				@questionnaire.Choices() {
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "summary"}) {
						Concise summary
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "diff"}) {
						Summary with changed files
					}
					@questionnaire.Choice(questionnaire.ChoiceProps{Value: "handoff"}) {
						Detailed implementation handoff
					}
				}
				@questionnaire.Error()
			}
			@questionnaire.Actions() {
				@questionnaire.Previous()
				@questionnaire.Next() {
					Next
				}
				@questionnaire.Submit() {
					Save workflow
				}
			}
		}
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const example = document.currentScript.previousElementSibling;
			const root = example.querySelector('[data-slot="questionnaire"]');
			const status = example.querySelector('[role="status"]');
			const labels = { scope: "Change scope", checks: "Verification", output: "Final output" };
			// The host owns the active item (item + onItemChange).
			document.addEventListener("questionnaire-item-change", (e) => {
				if (e.target !== root) return;
				window.templ.questionnaire.setItem(root, e.detail.item);
				status.textContent = "Current checkpoint: " + labels[e.detail.item];
			});
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const formData = new FormData(e.target);
				window.templ.toast.add({
					title: "Agent workflow configured",
					description: `Scope: ${formData.get("scope") ?? "None"} · Verification: ${formData.get("checks") ?? "None"} · Output: ${formData.get("output") ?? "None"}`,
				});
			});
		})();
	</script>
}
