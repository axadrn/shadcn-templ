package questionnaire

import "github.com/axadrn/shadcn-templ/v2/components/questionnaire"

const questionnaireAnimatedItemClass = "data-active:animate-in data-active:fade-in-0 data-active:slide-in-from-bottom-2 data-active:duration-300 motion-reduce:animate-none"

templ QuestionnaireAnimated() {
	@questionnaire.Questionnaire(questionnaire.Props{
		Class:       "mx-auto max-w-md",
		DefaultItem: "task",
		Items: []questionnaire.ItemDefinition{
			{Name: "task", Required: true},
			{Name: "review", Required: true},
			{Name: "delivery", Required: true},
		},
	}) {
		@questionnaire.Progress()
		@questionnaire.Item(questionnaire.ItemProps{Class: questionnaireAnimatedItemClass, Name: "task", Required: true}) {
			@questionnaire.Title() {
				What should the agent do?
			}
			@questionnaire.Description() {
				Choose the task for this run.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "implement"}) {
					Implement the requested change
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "debug"}) {
					Debug the current behavior
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "review"}) {
					Review the implementation
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Item(questionnaire.ItemProps{Class: questionnaireAnimatedItemClass, Name: "review", Required: true}) {
			@questionnaire.Title() {
				How should the work be reviewed?
			}
			@questionnaire.Description() {
				Select the verification depth.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "targeted"}) {
					Targeted checks
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "complete"}) {
					Complete test suite
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "manual"}) {
					Tests and manual QA
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Item(questionnaire.ItemProps{Class: questionnaireAnimatedItemClass, Name: "delivery", Required: true}) {
			@questionnaire.Title() {
				How should the result be delivered?
			}
			@questionnaire.Description() {
				Choose the final handoff format.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "summary"}) {
					Concise summary
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "diff"}) {
					Summary and changed files
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "handoff"}) {
					Detailed review handoff
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Actions() {
			@questionnaire.Previous()
			@questionnaire.Next() {
				Next
			}
			@questionnaire.Submit() {
				Save workflow
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the example's onSubmit toast.
		(() => {
			const root = document.currentScript.previousElementSibling;
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const formData = new FormData(e.target);
				window.templ.toast.add({
					title: "Agent workflow saved",
					description: `Task: ${formData.get("task") ?? "None"} · Review: ${formData.get("review") ?? "None"} · Delivery: ${formData.get("delivery") ?? "None"}`,
				});
			});
		})();
	</script>
}
