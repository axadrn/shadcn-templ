package questionnaire

import "github.com/axadrn/shadcn-templ/v2/components/questionnaire"

templ QuestionnaireMultiple() {
	@questionnaire.Questionnaire(questionnaire.Props{
		Class:     "mx-auto max-w-md",
		Shortcuts: questionnaire.ShortcutsLetters,
		Items: []questionnaire.ItemDefinition{
			{Name: "context", Required: true, Choices: []questionnaire.ChoiceDefinition{{Value: "source"}, {Value: "tests"}, {Value: "docs"}, {Value: "history"}}},
		},
	}) {
		@questionnaire.Item(questionnaire.ItemProps{Name: "context", Multiple: true, Required: true}) {
			@questionnaire.Title() {
				What context should the agent inspect?
			}
			@questionnaire.Description() {
				Select every source that may affect the implementation.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "source"}) {
					Relevant source files
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "tests"}) {
					Existing tests
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "docs"}) {
					Architecture documentation
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "history"}) {
					Recent commit history
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Actions() {
			@questionnaire.Submit() {
				Share context
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the example's onSubmit toast.
		(() => {
			const root = document.currentScript.previousElementSibling;
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const context = new FormData(e.target).getAll("context");
				window.templ.toast.add({ title: "Context selected", description: `Context: ${context.join(", ") || "None"}` });
			});
		})();
	</script>
}
