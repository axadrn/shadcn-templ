package questionnaire

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/questionnaire"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ QuestionnaireValidation() {
	@questionnaire.Questionnaire(questionnaire.Props{
		Class: "mx-auto max-w-md",
		Item:  utils.Ptr("detail"),
		Items: []questionnaire.ItemDefinition{
			{Name: "detail", Required: true},
			{Name: "audience", Required: true},
		},
	}) {
		@card.Card(card.Props{Class: "w-full"}) {
			@questionnaire.Item(questionnaire.ItemProps{Name: "detail", Required: true}) {
				@card.Header() {
					@questionnaire.Title() {
						How much detail should the answer include?
					}
					@questionnaire.Description() {
						Choose the response depth.
					}
					@card.Action() {
						@questionnaire.Progress(questionnaire.ProgressProps{Class: "min-w-0"}) {
							1 / 2
						}
					}
				}
				@card.Content() {
					@questionnaire.Choices() {
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "summary"}) {
							Concise summary
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "complete"}) {
							Complete answer
						}
					}
					@questionnaire.Error()
				}
			}
			@questionnaire.Item(questionnaire.ItemProps{Name: "audience", Required: true}) {
				@card.Header() {
					@questionnaire.Title() {
						Who will read the answer?
					}
					@questionnaire.Description() {
						Public answers require complete context.
					}
					@card.Action() {
						@questionnaire.Progress(questionnaire.ProgressProps{Class: "min-w-0"}) {
							1 / 2
						}
					}
				}
				@card.Content() {
					@questionnaire.Choices() {
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "team"}) {
							My team
						}
						@questionnaire.Choice(questionnaire.ChoiceProps{Value: "public"}) {
							Public audience
						}
					}
					@questionnaire.Error()
				}
			}
			@card.Footer() {
				@questionnaire.Actions() {
					@questionnaire.Previous()
					@questionnaire.Next() {
						Next
					}
					@questionnaire.Submit() {
						Validate answers
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const root = document.currentScript.previousElementSibling;
			// The host owns the active item and the schema errors: an error marks
			// its item invalid (the invalid prop) and becomes the Error's text.
			const names = ["detail", "audience"];
			const itemOf = (root, name) => root.querySelector(`[data-templ-name="${name}"]`);
			const setError = (root, name, message) => {
				const item = itemOf(root, name);
				const error = item.querySelector('[data-slot="questionnaire-error"]');
				error._default ??= error.textContent;
				error.textContent = message ?? error._default;
				item.toggleAttribute("data-templ-invalid", !!message);
			};
			document.addEventListener("questionnaire-item-change", (e) => {
				if (e.target !== root) return;
				window.templ.questionnaire.setItem(e.target, e.detail.item);
				const current = names.indexOf(e.detail.item) + 1;
				e.target.querySelectorAll('[data-slot="questionnaire-progress"]').forEach((progress) => {
					progress.textContent = `${current} / ${names.length}`;
				});
			});
			document.addEventListener("change", (e) => {
				if (root.contains(e.target) && names.includes(e.target.name)) setError(root, e.target.name, undefined);
			});
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const answers = Object.fromEntries(new FormData(root));
				const errors = {};
				if (!["summary", "complete"].includes(answers.detail)) errors.detail = "Invalid option: expected one of \"summary\"|\"complete\"";
				if (!["team", "public"].includes(answers.audience)) errors.audience = "Invalid option: expected one of \"team\"|\"public\"";
				if (!errors.detail && !errors.audience && answers.audience === "public" && answers.detail === "summary") {
					errors.detail = "Public answers need enough context. Choose a complete answer.";
				}
				names.forEach((name) => setError(root, name, errors[name]));
				const firstInvalid = names.find((name) => errors[name]);
				if (!firstInvalid) {
					window.templ.toast.add({
						title: "Agent response configured",
						description: `Detail: ${answers.detail} · Audience: ${answers.audience}`,
					});
					return;
				}
				window.templ.questionnaire.setItem(root, firstInvalid);
			});
		})();
	</script>
}
