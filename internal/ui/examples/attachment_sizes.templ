package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/attachment"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

templ AttachmentSizes() {
	<div class="mx-auto flex w-full max-w-sm flex-col gap-3 py-12">
		@attachment.Attachment(attachment.Props{Size: attachment.SizeDefault, Class: "w-full"}) {
			@attachment.Media() {
				@icon.FileText()
			}
			@attachment.Content() {
				@attachment.Title() {
					Default attachment
				}
				@attachment.Description() {
					PDF · 2.4 MB
				}
			}
		}
		@attachment.Attachment(attachment.Props{Size: attachment.SizeSm, Class: "w-full"}) {
			@attachment.Media() {
				@icon.FileText()
			}
			@attachment.Content() {
				@attachment.Title() {
					Small attachment
				}
				@attachment.Description() {
					PDF · 2.4 MB
				}
			}
		}
		@attachment.Attachment(attachment.Props{Size: attachment.SizeXs, Class: "w-full"}) {
			@attachment.Media() {
				@icon.FileText()
			}
			@attachment.Content() {
				@attachment.Title() {
					Extra small attachment
				}
			}
		}
	</div>
}
