package calendar

import (
	"time"

	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/card"
)

templ CalendarCustomCellSize() {
	{{
		from := time.Date(time.Now().Year(), 12, 8, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 10)
	}}
	@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
		@card.Content(card.ContentProps{Class: "p-0"}) {
			@calendar.Calendar(calendar.Props{
				Mode:           calendar.ModeRange,
				DefaultMonth:   from,
				Selected:       calendar.DateRange{From: from, To: to},
				NumberOfMonths: 1,
				CaptionLayout:  calendar.CaptionLayoutDropdown,
				Class:          "[--cell-size:--spacing(10)] md:[--cell-size:--spacing(12)]",
			})
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The formatters and components props: long month names in the
		// dropdown, a price under every day of the month.
		(() => {
			const calendar = document.currentScript.previousElementSibling.querySelector('[data-slot="calendar"]');
			const apply = () =>
				window.templ.calendar.update(calendar, {
					formatters: {
						formatMonthDropdown: (date) => date.toLocaleString("default", { month: "long" }),
					},
					components: {
						DayButton(button, { day, modifiers }) {
							const isWeekend = day.date.getDay() === 0 || day.date.getDay() === 6;
							if (!modifiers.outside) {
								const price = document.createElement("span");
								price.textContent = isWeekend ? "$120" : "$100";
								button.append(price);
							}
						},
					},
				});
			// onSelect={setRange}
			calendar.addEventListener("calendar-select", (e) => window.templ.calendar.setSelected(calendar, e.detail.selected));
			if (window.templ?.calendar) apply();
			else document.addEventListener("DOMContentLoaded", apply);
		})();
	</script>
}
