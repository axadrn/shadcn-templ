package calendar

import (
	"time"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ calendarExampleSection(title string, containerClass string, class string) {
	<div data-slot="example" class={ utils.CN("mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass) }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class={ utils.CN("flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full", class) }>
			{ children... }
		</div>
	</div>
}

templ CalendarExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@calendarExampleSingle()
			@calendarExampleMultiple()
			@calendarExampleWeekNumbers()
			@calendarExampleBookedDates()
			@calendarExampleRange()
			@calendarExampleRangeMultipleMonths()
			@calendarExampleWithTime()
			@calendarExampleWithPresets()
			@calendarExampleCustomDays()
			@calendarExampleDatePickerSimple()
			@calendarExampleDatePickerWithDropdowns()
			@calendarExampleDatePickerWithRange()
			@calendarExampleInCard()
			@calendarExampleInPopover()
		</div>
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		// The date pickers' state: onSelect sets the date, the trigger renders it.
		(() => {
			// date-fns format(date, "PPP") and format(date, "LLL dd, y").
			const ppp = (d) => {
				const n = d.getDate();
				const s = n % 100 >= 11 && n % 100 <= 13 ? "th" : { 1: "st", 2: "nd", 3: "rd" }[n % 10] || "th";
				return d.toLocaleDateString("en-US", { month: "long" }) + " " + n + s + ", " + d.getFullYear();
			};
			const lll = (d) => d.toLocaleDateString("en-US", { month: "short" }) + " " + String(d.getDate()).padStart(2, "0") + ", " + d.getFullYear();
			const pick = () => Object.assign(document.createElement("span"), { textContent: "Pick a date" });
			const trigger = (id) => document.querySelector(`[data-templ-controls="${id}"]`);
			// The Done button's onClick: setOpen(false).
			document.addEventListener("click", (e) => {
				const popup = e.target instanceof Element && e.target.closest("#calendar-example-date-picker-with-dropdowns");
				if (popup && e.target.closest('[data-slot="calendar"] ~ div > [data-slot="button"]')) window.templ.popover.close(popup);
			});
			document.addEventListener("calendar-select", (e) => {
				if (!(e.target instanceof Element)) return;
				const popup = e.target.closest("[id^=calendar-example-]");
				const value = e.detail.selected;
				if (popup?.id === "calendar-example-date-picker-simple") {
					const t = trigger(popup.id);
					t.replaceChildren(t.firstElementChild, value ? ppp(value) : pick());
				} else if (popup?.id === "calendar-example-date-picker-with-dropdowns") {
					const t = trigger(popup.id);
					t.replaceChildren(value ? ppp(value) : pick(), t.lastElementChild);
				} else if (popup?.id === "calendar-example-date-picker-with-range") {
					const t = trigger(popup.id);
					const text = value?.from ? (value.to ? lll(value.from) + " - " + lll(value.to) : lll(value.from)) : pick();
					t.replaceChildren(t.firstElementChild, text);
				}
			});
		})();
	</script>
}

templ calendarExampleInCard() {
	@calendarExampleSection("In Card", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle})
			}
		}
	}
}

templ calendarExampleInPopover() {
	@calendarExampleSection("In Popover", "", "") {
		@popover.Popover(popover.Props{ID: "calendar-example-in-popover"}) {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "px-2.5 font-normal",
				Attributes: popover.Trigger(ctx),
			}) {
				@icon.Calendar(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
				Open Calendar
			}
			@popover.Content(popover.ContentProps{Class: "w-auto p-0", Align: popover.AlignStart}) {
				@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle})
			}
		}
	}
}

templ calendarExampleSingle() {
	@calendarExampleSection("Single", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:          calendar.ModeSingle,
					Selected:      time.Date(time.Now().Year(), time.Now().Month(), 12, 0, 0, 0, 0, time.Local),
					CaptionLayout: calendar.CaptionLayoutDropdown,
				})
			}
		}
		@calendarSelectState()
	}
}

templ calendarExampleMultiple() {
	@calendarExampleSection("Multiple", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{Mode: calendar.ModeMultiple})
			}
		}
	}
}

templ calendarExampleRange() {
	{{
		from := time.Date(time.Now().Year(), 1, 12, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 30)
	}}
	@calendarExampleSection("Range", "lg:col-span-full 2xl:col-span-full", "p-12") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:           calendar.ModeRange,
					DefaultMonth:   from,
					Selected:       calendar.DateRange{From: from, To: to},
					NumberOfMonths: 2,
					// disabled={(date) => date > new Date() || date < new Date("1900-01-01")}
					Disabled: []any{
						calendar.DateAfter{After: time.Now()},
						calendar.DateBefore{Before: time.Date(1900, 1, 1, 0, 0, 0, 0, time.Local)},
					},
				})
			}
		}
		@calendarSelectState()
	}
}

templ calendarExampleRangeMultipleMonths() {
	{{
		from := time.Date(time.Now().Year(), 4, 12, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 60)
	}}
	@calendarExampleSection("Range Multiple Months", "lg:col-span-full 2xl:col-span-full", "p-12") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:           calendar.ModeRange,
					DefaultMonth:   from,
					Selected:       calendar.DateRange{From: from, To: to},
					NumberOfMonths: 3,
					Locale:         "es",
					FixedWeeks:     true,
				})
			}
		}
		@calendarSelectState()
	}
}

templ calendarExampleBookedDates() {
	{{
		date := time.Date(time.Now().Year(), 2, 3, 0, 0, 0, 0, time.Local)
		booked := make([]time.Time, 15)
		for i := range booked {
			booked[i] = time.Date(time.Now().Year(), 2, 12+i, 0, 0, 0, 0, time.Local)
		}
	}}
	@calendarExampleSection("Booked Dates", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:                calendar.ModeSingle,
					DefaultMonth:        date,
					Selected:            date,
					Disabled:            booked,
					Modifiers:           map[string]any{"booked": booked},
					ModifiersClassNames: map[string]string{"booked": "[&>button]:line-through opacity-100"},
				})
			}
		}
		@calendarSelectState()
	}
}

templ calendarExampleTimeField(id, label, value string) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) {
			{ label }
		}
		@inputgroup.InputGroup() {
			@inputgroup.Input(inputgroup.InputProps{
				ID:         id,
				Type:       "time",
				Value:      value,
				Class:      "appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none",
				Attributes: templ.Attributes{"step": "1"},
			})
			@inputgroup.Addon() {
				@icon.Clock2(icon.Props{Class: "text-muted-foreground"})
			}
		}
	}
}

templ calendarExampleWithTime() {
	@calendarExampleSection("With Time", "", "") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-fit"}) {
			@card.Content() {
				@calendar.Calendar(calendar.Props{
					Mode:     calendar.ModeSingle,
					Selected: time.Date(time.Now().Year(), time.Now().Month(), 12, 0, 0, 0, 0, time.Local),
					Class:    "p-0",
				})
			}
			@card.Footer(card.FooterProps{Class: "border-t bg-card"}) {
				@field.Group() {
					@calendarExampleTimeField("time-from", "Start Time", "10:30:00")
					@calendarExampleTimeField("time-to", "End Time", "12:30:00")
				}
			}
		}
		@calendarSelectState()
	}
}

templ calendarExampleCustomDays() {
	@calendarExampleSection("Custom Days", "", "") {
		@CalendarCustomCellSize()
	}
}

templ calendarExampleWithPresets() {
	@calendarExampleSection("With Presets", "", "") {
		@CalendarPresets()
	}
}

templ calendarExampleDatePickerSimple() {
	@calendarExampleSection("Date Picker Simple", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@field.Label(field.LabelProps{For: "date-picker-simple"}) {
				Date
			}
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-simple"}) {
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "date-picker-simple"
				}}
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "justify-start px-2.5 font-normal", Attributes: triggerAttrs}) {
					@icon.Calendar(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					<span>Pick a date</span>
				}
				@popover.Content(popover.ContentProps{Class: "w-auto p-0", Align: popover.AlignStart}) {
					@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle})
					@calendarSelectState()
				}
			}
		}
	}
}

templ calendarExampleDatePickerWithRange() {
	{{
		from := time.Date(time.Now().Year(), 1, 20, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 20)
	}}
	@calendarExampleSection("Date Picker Range", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@field.Label(field.LabelProps{For: "date-picker-range"}) {
				Date Picker Range
			}
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-with-range"}) {
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "date-picker-range"
				}}
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "justify-start px-2.5 font-normal", Attributes: triggerAttrs}) {
					@icon.Calendar(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					{ from.Format("Jan 02, 2006") } - { to.Format("Jan 02, 2006") }
				}
				@popover.Content(popover.ContentProps{Class: "w-auto p-0", Align: popover.AlignStart}) {
					@calendar.Calendar(calendar.Props{
						Mode:           calendar.ModeRange,
						DefaultMonth:   from,
						Selected:       calendar.DateRange{From: from, To: to},
						NumberOfMonths: 2,
					})
					@calendarSelectState()
				}
			}
		}
	}
}

templ calendarExampleDatePickerWithDropdowns() {
	@calendarExampleSection("Date Picker with Dropdowns", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-with-dropdowns"}) {
				@field.Label(field.LabelProps{For: "date-picker-with-dropdowns-desktop"}) {
					Date
				}
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "date-picker-with-dropdowns-desktop"
				}}
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "justify-start px-2.5 font-normal", Attributes: triggerAttrs}) {
					<span>Pick a date</span>
					@icon.ChevronDown(icon.Props{Class: "ml-auto", Attributes: templ.Attributes{"data-icon": "inline-start"}})
				}
				@popover.Content(popover.ContentProps{Class: "w-auto p-0", Align: popover.AlignStart}) {
					@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle, CaptionLayout: calendar.CaptionLayoutDropdown})
					@calendarSelectState()
					<div class="flex gap-2 border-t p-2">
						@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
							Done
						}
					</div>
				}
			}
		}
	}
}

templ calendarExampleWeekNumbers() {
	{{ date := time.Date(time.Now().Year(), 2, 3, 0, 0, 0, 0, time.Local) }}
	@calendarExampleSection("Week Numbers", "", "justify-center") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:           calendar.ModeSingle,
					DefaultMonth:   date,
					Selected:       date,
					ShowWeekNumber: true,
				})
			}
		}
		@calendarSelectState()
	}
}
