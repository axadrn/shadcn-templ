package command

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/command"
)

templ CommandBasic() {
	<div class="flex flex-col gap-4">
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Class:   "w-fit",
			ID:      "command-basic-open",
		}) {
			Open Menu
		}
		@command.Dialog(command.DialogProps{ID: "command-basic"}) {
			@command.Command() {
				@command.Input(command.InputProps{Placeholder: "Type a command or search..."})
				@command.List() {
					@command.Empty() {
						No results found.
					}
					@command.Group(command.GroupProps{Heading: "Suggestions"}) {
						@command.Item() {
							Calendar
						}
						@command.Item() {
							Search Emoji
						}
						@command.Item() {
							Calculator
						}
					}
				}
			}
		}
	</div>
	// shadcn's example opens the dialog from the button's onClick
	// (setOpen(true)), the button is no dialog trigger.
	<script nonce={ templ.GetNonce(ctx) }>
		document.addEventListener("click", (e) => {
			if (e.target instanceof Element && e.target.closest("#command-basic-open")) window.templ.dialog.open("command-basic");
		});
	</script>
}
