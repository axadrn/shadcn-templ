var chartExamplePagePieData = []chart.Datum{
	{"browser": "chrome", "visitors": 275, "fill": "var(--color-chrome)"},
	{"browser": "safari", "visitors": 200, "fill": "var(--color-safari)"},
	{"browser": "firefox", "visitors": 287, "fill": "var(--color-firefox)"},
	{"browser": "edge", "visitors": 173, "fill": "var(--color-edge)"},
	{"browser": "other", "visitors": 190, "fill": "var(--color-other)"},
}

var chartExamplePagePieConfig = chart.Config{
	{Key: "visitors", Label: "Visitors"},
	{Key: "chrome", Label: "Chrome", Color: "var(--chart-1)"},
	{Key: "safari", Label: "Safari", Color: "var(--chart-2)"},
	{Key: "firefox", Label: "Firefox", Color: "var(--chart-3)"},
	{Key: "edge", Label: "Edge", Color: "var(--chart-4)"},
	{Key: "other", Label: "Other", Color: "var(--chart-5)"},
}

// chartExamplePagePieTotal sums the visitors for the center label.
func chartExamplePagePieTotal() string {
	sum := 0
	for _, d := range chartExamplePagePieData {
		sum += d["visitors"].(int)
	}
	return chartExamplePageLocaleNumber(sum)
}

templ chartExamplePagePie() {
	@chartExamplePageSection("Pie Chart") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header(card.HeaderProps{Class: "items-center pb-0"}) {
				@card.Title() {
					Pie Chart - Donut with Text
				}
				@card.Description() {
					January - June 2024
				}
			}
			@card.Content(card.ContentProps{Class: "flex-1 pb-0"}) {
				@chart.Container(chart.ContainerProps{ID: "chart-example-page-pie", Config: chartExamplePagePieConfig, Class: "mx-auto aspect-square max-h-[250px]"}) {
					@chart.PieChart() {
						@chart.Tooltip(chart.TooltipProps{
							Cursor:  chart.Bool(false),
							Content: chart.TooltipContentProps{HideLabel: true},
						})
						@chart.Pie(chart.PieProps{
							Data:        chartExamplePagePieData,
							DataKey:     "visitors",
							NameKey:     "browser",
							InnerRadius: 60,
							StrokeWidth: 5,
						}) {
							@chart.Label(chart.LabelProps{
								DominantBaseline: "middle",
								Spans: []chart.LabelSpan{
									{Text: chartExamplePagePieTotal(), Class: "fill-foreground text-3xl font-bold"},
									{Text: "Visitors", Class: "fill-muted-foreground", OffsetY: 24},
								},
							})
						}
					}
				}
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-2"}) {
				<div class="flex items-center gap-2 leading-none font-medium">
					Trending up by 5.2% this month
					@icon.TrendingUp(icon.Props{Class: "size-4"})
				</div>
				<div class="leading-none text-muted-foreground">
					Showing total visitors for the last 6 months
				</div>
			}
		}
	}
}

var chartExamplePageRadarData = []chart.Datum{
	{"month": "January", "desktop": 186, "mobile": 80},
	{"month": "February", "desktop": 305, "mobile": 200},
	{"month": "March", "desktop": 237, "mobile": 120},
	{"month": "April", "desktop": 73, "mobile": 190},
	{"month": "May", "desktop": 209, "mobile": 130},
	{"month": "June", "desktop": 214, "mobile": 140},
}

var chartExamplePageRadarConfig = chart.Config{
	{Key: "desktop", Label: "Desktop", Color: "var(--chart-1)"},
	{Key: "mobile", Label: "Mobile", Color: "var(--chart-2)"},
}

templ chartExamplePageRadar() {
	@chartExamplePageSection("Radar Chart") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header(card.HeaderProps{Class: "items-center pb-4"}) {
				@card.Title() {
					Radar Chart - Multiple
				}
				@card.Description() {
					Showing total visitors for the last 6 months
				}
			}
			@card.Content(card.ContentProps{Class: "pb-0"}) {
				@chart.Container(chart.ContainerProps{ID: "chart-example-page-radar", Config: chartExamplePageRadarConfig, Class: "mx-auto aspect-square max-h-[250px]"}) {
					@chart.RadarChart(chart.RadarChartProps{Data: chartExamplePageRadarData}) {
						@chart.Tooltip(chart.TooltipProps{
							Cursor:  chart.Bool(false),
							Content: chart.TooltipContentProps{Indicator: "line"},
						})
						@chart.PolarAngleAxis(chart.PolarAngleAxisProps{DataKey: "month"})
						@chart.PolarGrid()
						@chart.Radar(chart.RadarProps{
							DataKey:     "desktop",
							Fill:        "var(--color-desktop)",
							FillOpacity: chart.Float(0.6),
						})
						@chart.Radar(chart.RadarProps{DataKey: "mobile", Fill: "var(--color-mobile)"})
					}
				}
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-2"}) {
				<div class="flex items-center gap-2 leading-none font-medium">
					Trending up by 5.2% this month
					@icon.TrendingUp(icon.Props{Class: "size-4"})
				</div>
				<div class="flex items-center gap-2 leading-none text-muted-foreground">
					January - June 2024
				</div>
			}
		}
	}
}

var chartExamplePageRadialData = []chart.Datum{
	{"browser": "safari", "visitors": 1260, "fill": "var(--color-safari)"},
}

var chartExamplePageRadialConfig = chart.Config{
	{Key: "visitors", Label: "Visitors"},
	{Key: "safari", Label: "Safari", Color: "var(--chart-2)"},
}

templ chartExamplePageRadial() {
	@chartExamplePageSection("Radial Chart") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header() {
				@card.Title() {
					Radial Chart - Shape
				}
				@card.Description() {
					January - June 2024
				}
			}
			@card.Content(card.ContentProps{Class: "flex-1 pb-0"}) {
				@chart.Container(chart.ContainerProps{ID: "chart-example-page-radial", Config: chartExamplePageRadialConfig, Class: "mx-auto aspect-square max-h-[210px]"}) {
					@chart.RadialBarChart(chart.RadialBarChartProps{
						Data:        chartExamplePageRadialData,
						EndAngle:    chart.Float(100),
						InnerRadius: 64,
						OuterRadius: 94,
					}) {
						@chart.PolarGrid(chart.PolarGridProps{
							GridType:    "circle",
							RadialLines: chart.Bool(false),
							Stroke:      "none",
							Class:       "first:fill-muted last:fill-background",
							PolarRadius: []float64{86, 74},
						})
						@chart.RadialBar(chart.RadialBarProps{DataKey: "visitors", Background: true})
						@chart.PolarRadiusAxis(chart.PolarRadiusAxisProps{Tick: chart.Bool(false), TickLine: chart.Bool(false), AxisLine: chart.Bool(false)}) {
							@chart.Label(chart.LabelProps{
								DominantBaseline: "middle",
								Spans: []chart.LabelSpan{
									{Text: chartExamplePageLocaleNumber(chartExamplePageRadialData[0]["visitors"].(int)), Class: "fill-foreground text-4xl font-bold"},
									{Text: "Visitors", Class: "fill-muted-foreground", OffsetY: 24},
								},
							})
						}
					}
				}
			}
			@card.Footer(card.FooterProps{Class: "flex-col gap-2"}) {
				<div class="flex items-center gap-2 leading-none font-medium">
					Trending up by 5.2% this month
					@icon.TrendingUp(icon.Props{Class: "size-4"})
				</div>
				<div class="leading-none text-muted-foreground">
					Showing total visitors for the last 6 months
				</div>
			}
		}
	}
}
