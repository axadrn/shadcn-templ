templ chartExamplePageLine() {
	@chartExamplePageSection("Line Chart") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header() {
				@card.Title() {
					Line Chart - Multiple
				}
				@card.Description() {
					January - June 2024
				}
			}
			@card.Content() {
				@chart.Container(chart.ContainerProps{ID: "chart-example-page-line", Config: chartExamplePageLineConfig}) {
					@chart.LineChart(chart.LineChartProps{
						AccessibilityLayer: true,
						Data:               chartExamplePageLineData,
						Margin:             &chart.Margin{Left: 12, Right: 12},
