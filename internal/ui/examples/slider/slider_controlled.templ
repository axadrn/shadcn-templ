package slider

import (
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/slider"
)

templ SliderControlled() {
	<div class="mx-auto grid w-full max-w-xs gap-3">
		<div class="flex items-center justify-between gap-2">
			@label.Label(label.Props{For: "slider-demo-temperature"}) {
				Temperature
			}
			<span class="text-sm text-muted-foreground">0.3, 0.7</span>
		</div>
		@slider.Slider(slider.Props{
			ID:    "slider-demo-temperature",
			Value: []float64{0.3, 0.7},
			Min:   0,
			Max:   1,
			Step:  0.1,
		})
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		// The value state: onValueChange sets it, the slider and the text
		// render it.
		(() => {
			const demo = document.currentScript.previousElementSibling;
			const slider = demo.querySelector('[data-slot="slider"]');
			slider.addEventListener("slider-change", (e) => {
				window.templ.slider.setValues(slider, e.detail.values);
				demo.querySelector("span").textContent = e.detail.values.join(", ");
			});
		})();
	</script>
}
