package examples

import "github.com/axadrn/shadcn-templ/v2/components/bubble"

templ BubbleVariantsDemo() {
	<div class="flex w-full max-w-sm flex-col gap-12 py-12">
		@bubble.Bubble() {
			@bubble.Content() {
				This is the default primary bubble.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantSecondary, Align: bubble.AlignEnd}) {
			@bubble.Content() {
				This is the secondary variant.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				This one is muted. It uses a lower emphasis color for the chat bubble.
			}
			@bubble.Reactions(bubble.ReactionsProps{Attributes: templ.Attributes{"role": "img", "aria-label": "Reaction: thumbs up"}}) {
				<span>👍</span>
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantTinted, Align: bubble.AlignEnd}) {
			@bubble.Content() {
				This one is tinted. The tint is a softer color derived from the
				primary color.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantOutline}) {
			@bubble.Content() {
				We can also use an outlined variant.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantDestructive, Align: bubble.AlignEnd}) {
			@bubble.Content() {
				Or a destructive variant with a reaction.
			}
			@bubble.Reactions(bubble.ReactionsProps{Attributes: templ.Attributes{"role": "img", "aria-label": "Reaction: fire"}}) {
				<span>🔥</span>
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantGhost}) {
			@bubble.Content() {
				@bubbleGhostMarkdown()
			}
		}
	</div>
}
