package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/drawer"
	"github.com/axadrn/shadcn-templ/v2/utils"
)


var drawerExampleParagraphs = []string{
	"Your changes are saved automatically as you type.",
	"Delivery usually takes three to five business days, depending on your location and the shipping method you selected at checkout.",
	"We use your email address for account notifications and order updates. You can change this anytime from your profile settings.",
	"Two-factor authentication adds an extra layer of security to your account. When enabled, you'll need to enter a code from your authenticator app in addition to your password. We recommend enabling it if you store payment methods or sensitive information.",
	"By continuing, you agree to our Terms of Service and Privacy Policy. We collect usage data to improve the product, personalize your experience, and troubleshoot issues. You can export or delete your data at any time from the account settings page. Third-party integrations may have their own policies, and you should review them before connecting external services.",
	"Refunds are processed within five to ten business days after we receive your return. Items must be unused and in their original packaging to qualify. Shipping costs are non-refundable unless the return is due to our error or a defective product. Once approved, the refund is issued to your original payment method; credit card refunds may take an additional billing cycle to appear on your statement. If you paid with store credit, the balance is restored to your account immediately. Contact support if you haven't received your refund after two weeks.",
	"Last updated March 12, 2026.",
	"Upgrade to Pro for unlimited projects, priority support, and advanced analytics. Cancel anytime from billing settings.",
	"You haven't verified your email yet. Check your inbox for a confirmation link—we sent it when you signed up. The link expires after 24 hours, but you can request a new one below.",
	"API requests are rate-limited to 1,000 calls per hour on the free plan. Exceeding the limit returns a 429 response with a Retry-After header. Upgrade to a paid plan for higher limits and dedicated support. Webhook deliveries are retried up to three times with exponential backoff if your endpoint returns a non-2xx status.",
	"No payment method on file.",
	"Our design team rebuilt the checkout flow last quarter after interviews with forty-two customers. The biggest friction point was surprise fees at the final step, so we moved shipping and tax estimates earlier in the process. Early tests show a twelve percent drop in cart abandonment. We're still rolling out the update region by region, and you may see the old flow until your account is migrated.",
}

func drawerExampleSides() []drawer.SwipeDirection {
	return []drawer.SwipeDirection{
		drawer.SwipeDirectionUp,
		drawer.SwipeDirectionRight,
		drawer.SwipeDirectionDown,
		drawer.SwipeDirectionLeft,
	}
}

templ drawerExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ drawerExampleParagraphList(count int) {
	for i := range count {
		<p class="mb-4 leading-normal style-lyra:mb-2 style-lyra:leading-relaxed">
			{ drawerExampleParagraphs[i%len(drawerExampleParagraphs)] }
		</p>
	}
}

templ DrawerExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@drawerExampleDemo()
			@drawerExampleSwipeHandle()
			@drawerExamplePosition()
			@drawerExampleCustomWidthAndHeight()
			@drawerExampleScrollable()
			@drawerExampleSnapPoints()
			@drawerExampleNested()
			@drawerExampleNonModal()
		</div>
	</div>
}

templ drawerExampleDemo() {
	@drawerExampleSection("Demo") {
		<div class="flex flex-wrap gap-2">
			@drawer.Drawer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
					Open Drawer
				}
				@drawer.Content() {
					<div class="p-4">
						<div class="h-80 w-full bg-muted"></div>
					</div>
				}
			}
			@drawer.Drawer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
					Header
				}
				@drawer.Content() {
					@drawer.Header() {
						@drawer.Title() {
							Edit profile
						}
						@drawer.Description() {
							Make changes to your profile here. Click save when you're done.
						}
					}
					<div class="p-4">
						<div class="h-80 w-full bg-muted"></div>
					</div>
				}
			}
			@drawer.Drawer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
					Footer
				}
				@drawer.Content() {
					<div class="p-4">
						<div class="h-80 w-full bg-muted"></div>
					</div>
					@drawer.Footer() {
						@button.Button() {
							Submit
						}
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
							Cancel
						}
					}
				}
			}
			@drawer.Drawer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
					Header and Footer
				}
				@drawer.Content() {
					@drawer.Header() {
						@drawer.Title() {
							Edit profile
						}
						@drawer.Description() {
							Make changes to your profile here. Click save when you're done.
						}
					}
					<div class="p-4">
						<div class="h-80 w-full bg-muted"></div>
					</div>
					@drawer.Footer() {
						@button.Button() {
							Submit
						}
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
							Cancel
						}
					}
				}
			}
			@drawer.Drawer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
					Edge to Edge
				}
				@drawer.Content() {
					<div class="h-80 w-full bg-blue-200"></div>
				}
			}
		</div>
	}
}

templ drawerExampleSwipeHandle() {
	@drawerExampleSection("Swipe Handle") {
		<div class="flex flex-wrap gap-2">
			for _, side := range drawerExampleSides() {
				@drawer.Drawer(drawer.Props{SwipeDirection: side, ShowSwipeHandle: true}) {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "capitalize", Attributes: drawer.Trigger(ctx)}) {
						{ string(side) }
					}
					@drawer.Content() {
						@drawer.Header() {
							@drawer.Title(drawer.TitleProps{Class: "capitalize"}) {
								Drawer
							}
							@drawer.Description() {
								Drawer with a swipe handle.
							}
						}
						<div class="flex-1 p-4">
							<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
						</div>
					}
				}
			}
		</div>
	}
}

templ drawerExamplePosition() {
	@drawerExampleSection("Position") {
		<div class="flex flex-wrap gap-2">
			for _, side := range drawerExampleSides() {
				@drawer.Drawer(drawer.Props{SwipeDirection: side}) {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "capitalize", Attributes: drawer.Trigger(ctx)}) {
						{ string(side) }
					}
					@drawer.Content() {
						@drawer.Header() {
							@drawer.Title() {
								Move Goal
							}
							@drawer.Description() {
								Set your daily activity goal.
							}
						}
						<div class="flex-1 p-4">
							<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
						</div>
						@drawer.Footer() {
							@button.Button() {
								Submit
							}
							@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
								Cancel
							}
						}
					}
				}
			}
		</div>
	}
}

templ drawerExampleCustomDrawer(side drawer.SwipeDirection, label, title, description, contentClass string) {
	@drawer.Drawer(drawer.Props{SwipeDirection: side}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
			{ label }
		}
		@drawer.Content(drawer.ContentProps{Class: contentClass}) {
			@drawer.Header() {
				@drawer.Title() {
					{ title }
				}
				@drawer.Description() {
					{ description }
				}
			}
			if side == drawer.SwipeDirectionDown {
				<div class="flex-1 scroll-fade scrollbar-thin overflow-y-auto p-4">
					@drawerExampleParagraphList(10)
				</div>
			} else {
				<div class="flex-1 scroll-fade overflow-y-auto p-4">
					@drawerExampleParagraphList(10)
				</div>
			}
			@drawer.Footer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
					Close
				}
			}
		}
	}
}

templ drawerExampleCustomWidthAndHeight() {
	@drawerExampleSection("Custom Width and Height") {
		<div class="flex flex-wrap gap-2">
			@drawerExampleCustomDrawer(drawer.SwipeDirectionDown, "Down", "Down drawer", "Drawer with a custom height.", "data-[swipe-direction=down]:h-64")
			@drawerExampleCustomDrawer(drawer.SwipeDirectionUp, "Up", "Up drawer", "Drawer with a custom height.", "data-[swipe-direction=up]:h-[50vh]")
			@drawerExampleCustomDrawer(drawer.SwipeDirectionLeft, "Left", "Left drawer", "Drawer with a custom width.", "data-[swipe-direction=left]:w-xl")
			@drawerExampleCustomDrawer(drawer.SwipeDirectionRight, "Right", "Right drawer", "Drawer with a custom width.", "data-[swipe-direction=right]:w-xs")
		</div>
	}
}

templ drawerExampleScrollable() {
	@drawerExampleSection("Scrollable Content") {
		<div class="flex flex-wrap gap-2">
			for _, side := range drawerExampleSides() {
				@drawer.Drawer(drawer.Props{SwipeDirection: side}) {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "capitalize", Attributes: drawer.Trigger(ctx)}) {
						{ string(side) }
					}
					@drawer.Content() {
						@drawer.Header() {
							@drawer.Title() {
								Move Goal
							}
							@drawer.Description() {
								Set your daily activity goal.
							}
						}
						<div class="flex-1 scroll-fade overflow-y-auto p-4">
							@drawerExampleParagraphList(20)
						</div>
						@drawer.Footer() {
							@button.Button() {
								Submit
							}
							@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
								Cancel
							}
						}
					}
				}
			}
		</div>
	}
}

templ drawerExampleSnapPoints() {
	@drawerExampleSection("Snap Points") {
		@drawer.Drawer(drawer.Props{SnapPoints: []any{"31rem", 1}, ShowSwipeHandle: true}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
				Open Snap Drawer
			}
			@drawer.Content(drawer.ContentProps{Class: "max-h-[calc(100dvh-1rem)]"}) {
				@drawer.Header() {
					@drawer.Title() {
						Snap points
					}
					@drawer.Description() {
						Drag the drawer to snap between a compact peek and a near full-height view.
					}
				}
				<div class="grid flex-1 scroll-fade gap-3 overflow-y-auto p-4">
					for range 16 {
						<div class="h-12 bg-muted"></div>
					}
				</div>
			}
		}
	}
}

templ drawerExampleNested() {
	@drawerExampleSection("Nested") {
		<div class="flex flex-wrap gap-2">
			for _, side := range drawerExampleSides() {
				@drawer.Drawer(drawer.Props{SwipeDirection: side, ShowSwipeHandle: true}) {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "capitalize", Attributes: drawer.Trigger(ctx)}) {
						{ string(side) }
					}
					@drawer.Content() {
						@drawer.Header() {
							@drawer.Title(drawer.TitleProps{Class: "capitalize"}) {
								{ string(side) } drawer
							}
							@drawer.Description() {
								Open another drawer from the same direction.
							}
						}
						<div class="flex-1 p-4">
							<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
						</div>
						@drawer.Footer() {
							@drawer.Drawer(drawer.Props{SwipeDirection: side}) {
								@button.Button(button.Props{Attributes: drawer.Trigger(ctx)}) {
									Open nested drawer
								}
								@drawer.Content() {
									@drawer.Header() {
										@drawer.Title() {
											Nested drawer
										}
										@drawer.Description() {
											The parent drawer stays mounted behind this one.
										}
									}
									<div class="flex-1 p-4">
										<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
									</div>
									@drawer.Footer() {
										@drawer.Drawer(drawer.Props{SwipeDirection: side}) {
											@button.Button(button.Props{Attributes: drawer.Trigger(ctx)}) {
												Open third drawer
											}
											@drawer.Content() {
												@drawer.Header() {
													@drawer.Title() {
														Third drawer
													}
													@drawer.Description() {
														This is the frontmost drawer in the stack.
													}
												}
												<div class="flex-1 p-4">
													<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
												</div>
												@drawer.Footer() {
													@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
														Close
													}
												}
											}
										}
										@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
											Close
										}
									}
								}
							}
							@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
								Close
							}
						}
					}
				}
			}
		</div>
	}
}

templ drawerExampleNonModal() {
	@drawerExampleSection("Non Modal") {
		@drawer.Drawer(drawer.Props{Modal: utils.Ptr(false), DisablePointerDismissal: true, SwipeDirection: drawer.SwipeDirectionRight}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Trigger(ctx)}) {
				Non Modal
			}
			@drawer.Content() {
				@drawer.Header() {
					@drawer.Title() {
						Non Modal Drawer
					}
				}
				<div class="flex-1 p-4">
					<div class="bg-muted group-data-[swipe-axis=x]/drawer-popup:size-full group-data-[swipe-axis=y]/drawer-popup:h-80 group-data-[swipe-axis=y]/drawer-popup:w-full"></div>
				</div>
				@drawer.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: drawer.Close(ctx)}) {
						Close
					}
				}
			}
		}
	}
}
