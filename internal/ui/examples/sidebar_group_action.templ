package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

templ SidebarGroupAction() {
	@sidebar.Provider() {
		@sidebar.Sidebar() {
			@sidebar.Content() {
				@sidebar.Group() {
					@sidebar.GroupLabel() {
						Projects
					}
					@sidebar.GroupAction(sidebar.GroupActionProps{Attributes: templ.Attributes{"title": "Add Project"}}) {
						@icon.Plus()
						{ " " }
						<span class="sr-only">Add Project</span>
					}
					@sidebar.GroupContent() {
						@sidebar.Menu() {
							for _, project := range sidebarMenuProjects[:3] {
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{Href: project.URL}) {
										@project.Icon()
										<span>{ project.Name }</span>
									}
								}
							}
						}
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// onClick: the example calls sonner's toast (its own Toaster at the
			// bottom left), which shadcn-templ does not port; the toast manager
			// shows the same message.
			const demo = document.currentScript.previousElementSibling;
			demo.querySelector('[data-slot="sidebar-group-action"]').addEventListener("click", () =>
				window.templ.toast.add({ description: "You clicked the group action!" }),
			);
		})();
	</script>
}
