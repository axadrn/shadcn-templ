package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/marker"
)

templ MarkerLinkButtonDemo() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@marker.Marker(marker.Props{Href: "#links-and-buttons"}) {
			@marker.Icon() {
				@icon.GitBranch()
			}
			@marker.Content() {
				View the pull request
			}
		}
		// Marker render={<button />}: the button carries the marker's state.
		<button
			type="button"
			class={ marker.Variants(marker.Props{Variant: marker.VariantDefault}) + " transition-colors hover:text-foreground" }
			data-slot="marker"
			data-variant="default"
		>
			@marker.Icon() {
				@icon.RotateCcw()
			}
			@marker.Content() {
				Revert this change
			}
		</button>
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		// onClick: the example calls sonner's toast, which shadcn-templ does
		// not port; the toast manager shows the same message.
		document.currentScript.previousElementSibling.lastElementChild.addEventListener("click", () =>
			window.templ.toast.add({ description: "You clicked the revert button" }),
		);
	</script>
}
