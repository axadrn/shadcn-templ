package typography

// markdownDemoHTML is the site's Markdown (Streamdown) output for the
// example's markdown string, Shiki's highlighting of the code block included.
const markdownDemoHTML = `<div class="max-w-md"><div class="space-y-4 whitespace-normal [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 cn-markdown w-full min-w-0 overflow-hidden"><h2 class="mt-6 mb-2 font-semibold text-2xl" data-streamdown="heading-2">Getting started</h2><p>Markdown lets you write formatted text with a simple syntax.</p><h3 class="mt-6 mb-2 font-semibold text-xl" data-streamdown="heading-3">Features</h3><ul class="list-inside list-disc whitespace-normal [li_&]:pl-6" data-streamdown="unordered-list">
<li class="py-1 [&>p]:inline" data-streamdown="list-item"><span class="font-semibold" data-streamdown="strong">Bold</span> and <em>italic</em> text</li>
<li class="py-1 [&>p]:inline" data-streamdown="list-item"><button class="wrap-anywhere appearance-none text-left font-medium text-primary underline" data-incomplete="false" data-streamdown="link" type="button">Links</button> and <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">inline code</code></li>
<li class="py-1 [&>p]:inline" data-streamdown="list-item">Ordered and unordered lists</li>
<li class="py-1 [&>p]:inline" data-streamdown="list-item">Tables, blockquotes, and code blocks</li>
</ul>




















<div class="my-4 flex flex-col gap-2 rounded-lg border border-border bg-sidebar p-2" data-streamdown="table-wrapper"><div class="border-collapse overflow-x-auto overflow-y-auto rounded-md border border-border bg-background"><table class="w-full divide-y divide-border" data-streamdown="table"><thead class="bg-muted/80" data-streamdown="table-header"><tr class="border-border" data-streamdown="table-row"><th class="whitespace-nowrap px-4 py-2 text-left font-semibold text-sm" data-streamdown="table-header-cell">Syntax</th><th class="whitespace-nowrap px-4 py-2 text-left font-semibold text-sm" data-streamdown="table-header-cell">Result</th></tr></thead><tbody class="divide-y divide-border" data-streamdown="table-body"><tr class="border-border" data-streamdown="table-row"><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">**bold**</code></td><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><span class="font-semibold" data-streamdown="strong">bold</span></td></tr><tr class="border-border" data-streamdown="table-row"><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">*italic*</code></td><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><em>italic</em></td></tr><tr class="border-border" data-streamdown="table-row"><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">code</code></td><td class="px-4 py-2 text-sm" data-streamdown="table-cell"><code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">code</code></td></tr></tbody></table></div></div><p>How about a quote? How does this look?</p><blockquote class="my-4 border-muted-foreground/30 border-l-4 pl-4 text-muted-foreground italic" data-streamdown="blockquote">
<p>The best way to learn markdown is to write it. Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.</p>
</blockquote><p>Now let's try a code block. It should have line numbers, a copy button and syntax highlighting.</p><div class="my-4 flex w-full flex-col gap-2 rounded-xl border border-border bg-sidebar p-2" data-language="tsx" data-streamdown="code-block" style="content-visibility:auto;contain-intrinsic-size:auto 200px"><div class="flex h-8 items-center text-muted-foreground text-xs" data-language="tsx" data-streamdown="code-block-header"><span class="ml-1 font-mono lowercase">tsx</span></div><!--$--><div class="language-tsx overflow-x-auto rounded-md border border-border bg-background p-4 text-sm" data-language="tsx" data-streamdown="code-block-body"><pre class="language-tsx bg-[var(--sdm-bg,inherit] dark:bg-[var(--shiki-dark-bg,var(--sdm-bg,inherit)]" style="--sdm-bg:transparent;--sdm-fg:inherit"><code class="[counter-increment:line_0] [counter-reset:line]"><span class="block before:content-[counter(line)] before:inline-block before:[counter-increment:line] before:w-6 before:mr-4 before:text-[13px] before:text-right before:text-muted-foreground/50 before:font-mono before:select-none"><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #D73A49; --shiki-dark: #F97583;">export</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #D73A49; --shiki-dark: #F97583;">function</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #6F42C1; --shiki-dark: #B392F0;">Greeting</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">({ </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #E36209; --shiki-dark: #FFAB70;">name</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> }</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #D73A49; --shiki-dark: #F97583;">:</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> { </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #E36209; --shiki-dark: #FFAB70;">name</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #D73A49; --shiki-dark: #F97583;">:</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #005CC5; --shiki-dark: #79B8FF;">string</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> }) {</span></span><span class="block before:content-[counter(line)] before:inline-block before:[counter-increment:line] before:w-6 before:mr-4 before:text-[13px] before:text-right before:text-muted-foreground/50 before:font-mono before:select-none"><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">  </span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #D73A49; --shiki-dark: #F97583;">return</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;"> &lt;</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">p</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;Hello, {name}!&lt;/</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #22863A; --shiki-dark: #85E89D;">p</span><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">&gt;</span></span><span class="block before:content-[counter(line)] before:inline-block before:[counter-increment:line] before:w-6 before:mr-4 before:text-[13px] before:text-right before:text-muted-foreground/50 before:font-mono before:select-none"><span class="text-[var(--sdm-c,inherit)] dark:text-[var(--shiki-dark,var(--sdm-c,inherit))]" style="--sdm-c: #24292E; --shiki-dark: #E1E4E8;">}</span></span></code></pre></div><!--/$--></div><p>If you need more plugins, you can pass them to the <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm" data-streamdown="inline-code">Markdown</code> component.</p></div></div>`

templ MarkdownDemo() {
	@templ.Raw(markdownDemoHTML)
}
