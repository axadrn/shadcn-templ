package tooltip

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
)

type SideRtlLabel struct {
	Side  string
	Label string
}

// The upstream example's Arabic translation, its default language.
var SideRtlPhysical = []SideRtlLabel{
	{"left", "يسار"},
	{"top", "أعلى"},
	{"bottom", "أسفل"},
	{"right", "يمين"},
}

var SideRtlLogical = []SideRtlLabel{
	{"inline-start", "بداية السطر"},
	{"inline-end", "نهاية السطر"},
}

templ TooltipRtl() {
	<div class="grid gap-4">
		<div class="flex flex-wrap justify-center gap-2">
			for _, s := range SideRtlPhysical {
				@tooltipRtlItem(s)
			}
		</div>
		<div class="flex flex-wrap justify-center gap-2">
			for _, s := range SideRtlLogical {
				@tooltipRtlItem(s)
			}
		</div>
	</div>
}

templ tooltipRtlItem(s SideRtlLabel) {
	@tooltip.Tooltip() {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: tooltip.Trigger(ctx),
		}) {
			{ s.Label }
		}
		@tooltip.Content(tooltip.ContentProps{Side: tooltip.Side(s.Side), Attributes: templ.Attributes{"dir": "rtl"}}) {
			إضافة إلى المكتبة
		}
	}
}
