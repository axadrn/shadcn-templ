package examples

import "github.com/axadrn/shadcn-templ/v2/components/questionnaire"

templ QuestionnaireSkipExample() {
	@questionnaire.Questionnaire(questionnaire.Props{
		Class:       "mx-auto max-w-md",
		DefaultItem: "task",
		Items: []questionnaire.ItemDefinition{
			{Name: "task", Required: true},
			{Name: "constraints"},
			{Name: "review", Required: true},
		},
	}) {
		@questionnaire.Progress()
		@questionnaire.Item(questionnaire.ItemProps{Name: "task", Required: true}) {
			@questionnaire.Title() {
				What kind of change is this?
			}
			@questionnaire.Description() {
				Choose the category that best describes the work.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "feature"}) {
					New feature
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "fix"}) {
					Bug fix
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "refactor"}) {
					Refactor
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Item(questionnaire.ItemProps{Name: "constraints"}) {
			@questionnaire.Title() {
				Are there any implementation constraints?
			}
			@questionnaire.Description() {
				Answer if needed, or intentionally skip this question.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "no-dependencies"}) {
					Do not add dependencies
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "no-migrations"}) {
					Do not change the database
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "preserve-api"}) {
					Preserve the public API
				}
				@questionnaire.Input(questionnaire.InputProps{
					Attributes: templ.Attributes{
						"aria-label":  "Another implementation constraint",
						"placeholder": "Describe another constraint…",
					},
				})
			}
		}
		@questionnaire.Item(questionnaire.ItemProps{Name: "review", Required: true}) {
			@questionnaire.Title() {
				How should the work be reviewed?
			}
			@questionnaire.Description() {
				Choose the checks the agent should complete before handoff.
			}
			@questionnaire.Choices() {
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "tests"}) {
					Run the test suite
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "diff"}) {
					Review the final diff
				}
				@questionnaire.Choice(questionnaire.ChoiceProps{Value: "both"}) {
					Tests and diff review
				}
			}
			@questionnaire.Error()
		}
		@questionnaire.Actions() {
			@questionnaire.Previous()
			@questionnaire.Skip()
			@questionnaire.Next() {
				Next
			}
			@questionnaire.Submit() {
				Submit brief
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const root = document.currentScript.previousElementSibling;
			// The constraints item's onStatusChange.
			let constraintStatus = "unanswered";
			document.addEventListener("questionnaire-status-change", (e) => {
				if (!root.contains(e.target) || e.target.getAttribute("data-templ-name") !== "constraints") return;
				constraintStatus = e.detail.status;
			});
			document.addEventListener("submit", (e) => {
				if (e.target !== root) return;
				e.preventDefault();
				const formData = new FormData(e.target);
				const constraints = constraintStatus === "skipped" ? "Skipped" : formData.get("constraints") ?? "None";
				window.templ.toast.add({
					title: "Agent brief submitted",
					description: `Task: ${formData.get("task") ?? "None"} · Constraints: ${constraints} · Review: ${formData.get("review") ?? "None"}`,
				});
			});
		})();
	</script>
}
