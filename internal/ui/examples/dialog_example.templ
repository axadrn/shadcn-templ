package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/kbd"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/components/switch"
	"github.com/axadrn/shadcn-templ/v2/components/tabs"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
)

templ dialogExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		// The tsx passes className="items-center justify-center" into the Example
		// content on every dialog section, merged here into the base string.
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full items-center justify-center">
			{ children... }
		</div>
	</div>
}

templ DialogExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@dialogExampleWithForm()
			@dialogExampleScrollableContent()
			@dialogExampleWithStickyFooter()
			@dialogExampleNoCloseButton()
			@dialogExampleChatSettings()
		</div>
	</div>
}

templ dialogExampleWithForm() {
	@dialogExampleSection("With Form") {
		@dialog.Dialog() {
			<form>
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.Trigger(ctx),
				}) {
					Edit Profile
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Edit profile
						}
						@dialog.Description() {
							Make changes to your profile here. Click save when you're done. Your profile will be updated immediately.
						}
					}
					@field.Group() {
						@field.Field() {
							@field.Label(field.LabelProps{For: "name-1"}) {
								Name
							}
							@input.Input(input.Props{ID: "name-1", Name: "name", Value: "Axel Adrian"})
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "username-1"}) {
								Username
							}
							@input.Input(input.Props{ID: "username-1", Name: "username", Value: "@axadrn"})
						}
					}
					@dialog.Footer() {
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Attributes: dialog.Close(ctx),
						}) {
							Cancel
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Save changes
						}
					}
				}
			</form>
		}
	}
}

templ dialogExampleLoremIpsum() {
	<div class="no-scrollbar max-h-[70vh] overflow-y-auto style-vega:-mx-6 style-vega:px-6 style-nova:-mx-4 style-nova:px-4 style-lyra:-mx-4 style-lyra:px-4 style-maia:-mx-6 style-maia:px-6 style-mira:-mx-4 style-mira:px-4 style-luma:-mx-6 style-luma:px-6 style-rhea:-mx-6 style-rhea:px-6">
		for range 10 {
			<p class="mb-4 leading-normal style-lyra:mb-2 style-lyra:leading-relaxed">
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
			</p>
		}
	</div>
}

templ dialogExampleScrollableContent() {
	@dialogExampleSection("Scrollable Content") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Scrollable Content
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Scrollable Content
					}
					@dialog.Description() {
						This is a dialog with scrollable content.
					}
				}
				@dialogExampleLoremIpsum()
			}
		}
	}
}

templ dialogExampleWithStickyFooter() {
	@dialogExampleSection("With Sticky Footer") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Sticky Footer
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Scrollable Content
					}
					@dialog.Description() {
						This is a dialog with scrollable content.
					}
				}
				@dialogExampleLoremIpsum()
				@dialog.Footer() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Attributes: dialog.Close(ctx),
					}) {
						Close
					}
				}
			}
		}
	}
}

templ dialogExampleNoCloseButton() {
	@dialogExampleSection("No Close Button") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				No Close Button
			}
			@dialog.Content(dialog.ContentProps{HideCloseButton: true}) {
				@dialog.Header() {
					@dialog.Title() {
						No Close Button
					}
					@dialog.Description() {
						This dialog doesn't have a close button in the top-right corner.
					}
				}
				@dialog.Footer() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Attributes: dialog.Close(ctx),
					}) {
						Close
					}
				}
			}
		}
	}
}

type dialogExampleOption struct {
	Label string
	Value string
}

func dialogExampleSpokenLanguages() []dialogExampleOption {
	return []dialogExampleOption{
		{"Auto", "auto"}, {"English", "en"}, {"Spanish", "es"}, {"French", "fr"},
		{"German", "de"}, {"Italian", "it"}, {"Portuguese", "pt"}, {"Russian", "ru"},
		{"Chinese", "zh"}, {"Japanese", "ja"}, {"Korean", "ko"}, {"Arabic", "ar"},
		{"Hindi", "hi"}, {"Bengali", "bn"}, {"Telugu", "te"}, {"Marathi", "mr"},
		{"Kannada", "kn"}, {"Malayalam", "ml"},
	}
}

func dialogExampleVoices() []dialogExampleOption {
	return []dialogExampleOption{
		{"Samantha", "samantha"}, {"Alex", "alex"}, {"Fred", "fred"},
		{"Victoria", "victoria"}, {"Tom", "tom"}, {"Karen", "karen"},
		{"Sam", "sam"}, {"Daniel", "daniel"},
	}
}

func dialogExampleThemes() []dialogExampleOption {
	return []dialogExampleOption{
		{"Light", "light"}, {"Dark", "dark"}, {"System", "system"},
	}
}

func dialogExampleAccents() []dialogExampleOption {
	return []dialogExampleOption{
		{"Default", "default"}, {"Red", "red"}, {"Blue", "blue"},
		{"Green", "green"}, {"Purple", "purple"}, {"Pink", "pink"},
	}
}

templ dialogExampleSettingsSelect(id, value string, options []dialogExampleOption) {
	@selectcomp.Select(selectcomp.Props{DefaultValue: value}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{ID: id}) {
			@selectcomp.Value()
		}
		@selectcomp.Content(selectcomp.ContentProps{Align: selectcomp.AlignEnd}) {
			@selectcomp.Group() {
				for _, option := range options {
					@selectcomp.Item(selectcomp.ItemProps{Value: option.Value}) {
						{ option.Label }
					}
				}
			}
		}
	}
}

templ dialogExampleChatSettings() {
	@dialogExampleSection("Chat Settings") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Chat Settings
			}
			@dialog.Content(dialog.ContentProps{Class: "min-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						Chat Settings
					}
					@dialog.Description() {
						Customize your chat settings: theme, accent color, spoken language, voice, personality, and custom instructions.
					}
				}
				<div class="flex flex-col gap-4" data-templ-dialog-example-chat-settings>
					<div class="cn-native-select-wrapper group/native-select relative w-fit has-[select:disabled]:opacity-50 w-full md:hidden" data-slot="native-select-wrapper" data-size="default">
						<select data-slot="native-select" data-size="default" class="cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed">
							<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="general" selected>General</option>
							<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="notifications">Notifications</option>
							<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="personalization">Personalization</option>
							<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="security">Security</option>
						</select>
						@icon.ChevronDown(icon.Props{
							Class: "cn-native-select-icon pointer-events-none absolute select-none",
							Attributes: templ.Attributes{
								"aria-hidden": "true",
								"data-slot":   "native-select-icon",
							},
						})
					</div>
					@tabs.Tabs(tabs.Props{DefaultValue: "general"}) {
						@tabs.List(tabs.ListProps{Class: "hidden w-full md:flex"}) {
							@tabs.Trigger(tabs.TriggerProps{Value: "general"}) {
								General
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "notifications"}) {
								Notifications
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "personalization"}) {
								Personalization
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "security"}) {
								Security
							}
						}
						<div class="border **:data-[slot=select-trigger]:min-w-[125px] style-vega:min-h-[550px] style-vega:rounded-lg style-vega:p-6 style-nova:min-h-[460px] style-nova:rounded-lg style-nova:p-4 style-lyra:min-h-[450px] style-lyra:rounded-none style-lyra:p-4 style-maia:min-h-[550px] style-maia:rounded-xl style-maia:p-6 style-mira:min-h-[450px] style-mira:rounded-md style-mira:p-4 style-luma:min-h-[550px] style-luma:rounded-xl style-luma:p-6 style-rhea:min-h-[480px] style-rhea:rounded-2xl style-rhea:p-6">
							@tabs.Content(tabs.ContentProps{Value: "general"}) {
								@field.Set() {
									@field.Group() {
										@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
											@field.Label(field.LabelProps{For: "theme"}) {
												Theme
											}
											@dialogExampleSettingsSelect("theme", "system", dialogExampleThemes())
										}
										@field.Separator()
										@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
											@field.Label(field.LabelProps{For: "accent-color"}) {
												Accent Color
											}
											@dialogExampleSettingsSelect("accent-color", "default", dialogExampleAccents())
										}
										@field.Separator()
										@field.Field(field.Props{Orientation: field.OrientationResponsive}) {
											@field.Content() {
												@field.Label(field.LabelProps{For: "spoken-language"}) {
													Spoken Language
												}
												@field.Description() {
													For best results, select the language you mainly speak. If it's not listed, it may still be supported via auto-detection.
												}
											}
											@dialogExampleSettingsSelect("spoken-language", "en", dialogExampleSpokenLanguages())
										}
										@field.Separator()
										@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
											@field.Label(field.LabelProps{For: "voice"}) {
												Voice
											}
											@dialogExampleSettingsSelect("voice", "samantha", dialogExampleVoices())
										}
									}
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "notifications"}) {
								@field.Group() {
									@field.Set() {
										@field.Label() {
											Responses
										}
										@field.Description() {
											Get notified when ChatGPT responds to requests that take time, like research or image generation.
										}
										@field.Group(field.GroupProps{Attributes: templ.Attributes{"data-slot": "checkbox-group"}}) {
											@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
												@checkbox.Checkbox(checkbox.Props{ID: "push", DefaultChecked: true, Disabled: true})
												@field.Label(field.LabelProps{For: "push", Class: "font-normal"}) {
													Push notifications
												}
											}
										}
									}
									@field.Separator()
									@field.Set() {
										@field.Label() {
											Tasks
										}
										@field.Description() {
											Get notified when tasks you've created have updates. <a href="#">Manage tasks</a>
										}
										@field.Group(field.GroupProps{Attributes: templ.Attributes{"data-slot": "checkbox-group"}}) {
											@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
												@checkbox.Checkbox(checkbox.Props{ID: "push-tasks"})
												@field.Label(field.LabelProps{For: "push-tasks", Class: "font-normal"}) {
													Push notifications
												}
											}
											@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
												@checkbox.Checkbox(checkbox.Props{ID: "email-tasks"})
												@field.Label(field.LabelProps{For: "email-tasks", Class: "font-normal"}) {
													Email notifications
												}
											}
										}
									}
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "personalization"}) {
								@field.Group() {
									@field.Field(field.Props{Orientation: field.OrientationResponsive}) {
										@field.Label(field.LabelProps{For: "nickname"}) {
											Nickname
										}
										@inputgroup.InputGroup() {
											@inputgroup.Input(inputgroup.InputProps{
												ID:          "nickname",
												Placeholder: "Broski",
												Class:       "@md/field-group:max-w-[200px]",
											})
											@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
												@tooltip.Tooltip() {
													@inputgroup.Button(inputgroup.ButtonProps{
														Size:       inputgroup.ButtonSizeIconXs,
														Attributes: tooltip.Trigger(ctx),
													}) {
														@icon.Info()
													}
													@tooltip.Content(tooltip.ContentProps{Class: "flex items-center gap-2"}) {
														Used to identify you in the chat.
														@kbd.Kbd() {
															N
														}
													}
												}
											}
										}
									}
									@field.Separator()
									@field.Field(field.Props{
										Orientation: field.OrientationResponsive,
										Class:       "@md/field-group:flex-col @2xl/field-group:flex-row",
									}) {
										@field.Content() {
											@field.Label(field.LabelProps{For: "about"}) {
												More about you
											}
											@field.Description() {
												Tell us more about yourself. This will be used to help us personalize your experience.
											}
										}
										@textarea.Textarea(textarea.Props{
											ID:          "about",
											Placeholder: "I'm a software engineer...",
											Class:       "min-h-[120px] @md/field-group:min-w-full @2xl/field-group:min-w-[300px]",
										})
									}
									@field.Separator()
									@field.Label() {
										@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
											@field.Content() {
												@field.Label(field.LabelProps{For: "customization"}) {
													Enable customizations
												}
												@field.Description() {
													Enable customizations to make ChatGPT more personalized.
												}
											}
											@switchcomp.Switch(switchcomp.Props{ID: "customization", DefaultChecked: true})
										}
									}
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "security"}) {
								@field.Group() {
									@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
										@field.Content() {
											@field.Label(field.LabelProps{For: "2fa"}) {
												Multi-factor authentication
											}
											@field.Description() {
												Enable multi-factor authentication to secure your account. If you do not have a two-factor authentication device, you can use a one-time code sent to your email.
											}
										}
										@switchcomp.Switch(switchcomp.Props{ID: "2fa"})
									}
									@field.Separator()
									@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
										@field.Content() {
											@field.Title() {
												Log out
											}
											@field.Description() {
												Log out of your account on this device.
											}
										}
										@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
											Log Out
										}
									}
									@field.Separator()
									@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
										@field.Content() {
											@field.Title() {
												Log out of all devices
											}
											@field.Description() {
												This will log you out of all devices, including the current session. It may take up to 30 minutes for the changes to take effect.
											}
										}
										@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
											Log Out All
										}
									}
								}
							}
						</div>
					}
				</div>
				// The native select is the mobile pendant of the tabs list, the
				// change handler is the vanilla port of the shared tab state.
				<script nonce={ templ.GetNonce(ctx) }>
					document.addEventListener('change', (e) => {
						const root = e.target.closest?.('[data-templ-dialog-example-chat-settings]');
						if (!root || e.target.dataset.slot !== 'native-select') return;
						root.querySelector('[data-slot="tabs-trigger"][data-templ-value="' + e.target.value + '"]')?.click();
					});
				</script>
			}
		}
	}
}
