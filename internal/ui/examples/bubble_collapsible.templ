package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/collapsible"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

const bubbleCollapsibleText = `The accessibility review found two focus states that were visually too subtle in dark mode.

I checked the dialog, menu, and drawer paths because each one renders focusable controls inside a layered surface.

The dialog and drawer are fine. The menu needs the hover and focus tokens split so keyboard focus stays visible when the pointer is not involved.

I also recommend keeping the change in the style file instead of the primitive so the other themes can choose their own focus treatment later.`

var bubbleCollapsiblePreview = bubbleCollapsibleText[:180] + "..."

templ BubbleCollapsible() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				How can I help you today?
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted, Align: bubble.AlignEnd}) {
			@bubble.Content(bubble.ContentProps{Class: "whitespace-pre-line"}) {
				@collapsible.Collapsible(collapsible.Props{Open: utils.Ptr(false)}) {
					<div>{ bubbleCollapsiblePreview }</div>
					@button.Button(button.Props{
						Variant:    button.VariantLink,
						Class:      "gap-1 p-0 text-muted-foreground",
						Attributes: collapsible.Trigger(ctx),
					}) {
						Show more
						@icon.ChevronDown(icon.Props{
							Class:      "group-data-panel-open/button:rotate-180",
							Attributes: templ.Attributes{"data-icon": "inline-end"},
						})
					}
				}
			}
		}
	</div>
	@bubbleCollapsibleState(bubbleCollapsibleText, bubbleCollapsiblePreview)
}

// bubbleCollapsibleState is the example's open state: the collapsible's
// onOpenChange sets it, the text and the trigger's label render it. It
// follows the element holding the collapsible.
templ bubbleCollapsibleState(text, preview string) {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const text = {{ text }};
			const preview = {{ preview }};
			const root = document.currentScript.previousElementSibling.querySelector('[data-slot="collapsible"]');
			const [content, trigger] = root.children;
			root.addEventListener("collapsible-open-change", (e) => {
				const open = e.detail.open;
				window.templ.collapsible.setOpen(root, open);
				content.textContent = open ? text : preview;
				trigger.firstChild.textContent = open ? "Show less" : "Show more";
			});
		})();
	</script>
}
