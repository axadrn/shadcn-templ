package dropdownmenu

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

// The upstream example's Arabic translation, its default language.
templ DropdownMenuRtl() {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: dropdownmenu.Trigger(ctx),
		}) {
			افتح القائمة
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{
			Align:      dropdownmenu.AlignEnd,
			Class:      "w-36",
			Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"},
		}) {
			@dropdownmenu.Group() {
				@dropdownmenu.Sub() {
					@dropdownmenu.SubTrigger() {
						الحساب
					}
					@dropdownmenu.Portal() {
						@dropdownmenu.SubContent(dropdownmenu.SubContentProps{Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
							@dropdownmenu.Group() {
								@dropdownmenu.Item() {
									@icon.User()
									الملف الشخصي
								}
								@dropdownmenu.Item() {
									@icon.CreditCard()
									الفوترة
								}
								@dropdownmenu.Item() {
									@icon.Settings()
									الإعدادات
								}
							}
						}
					}
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Group() {
				@dropdownmenu.Label() {
					الفريق
				}
				@dropdownmenu.Item() {
					الفريق
				}
				@dropdownmenu.Sub() {
					@dropdownmenu.SubTrigger() {
						دعوة المستخدمين
					}
					@dropdownmenu.Portal() {
						@dropdownmenu.SubContent(dropdownmenu.SubContentProps{Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
							@dropdownmenu.Item() {
								البريد الإلكتروني
							}
							@dropdownmenu.Item() {
								رسالة
							}
							@dropdownmenu.Sub() {
								@dropdownmenu.SubTrigger() {
									المزيد
								}
								@dropdownmenu.Portal() {
									@dropdownmenu.SubContent(dropdownmenu.SubContentProps{Attributes: templ.Attributes{"dir": "rtl", "data-lang": "ar"}}) {
										@dropdownmenu.Item() {
											تقويم
										}
										@dropdownmenu.Item() {
											دردشة
										}
										@dropdownmenu.Separator()
										@dropdownmenu.Item() {
											خطاف ويب
										}
									}
								}
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Item() {
								متقدم...
							}
						}
					}
				}
				@dropdownmenu.Item() {
					فريق جديد
					@dropdownmenu.Shortcut() {
						⌘+T
					}
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Group() {
				@dropdownmenu.Label() {
					عرض
				}
				@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{DefaultChecked: true}) {
					شريط الحالة
				}
				@dropdownmenu.CheckboxItem() {
					شريط النشاط
				}
				@dropdownmenu.CheckboxItem() {
					اللوحة
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Group() {
				@dropdownmenu.Label() {
					الموضع
				}
				@dropdownmenu.RadioGroup(dropdownmenu.RadioGroupProps{DefaultValue: "bottom"}) {
					@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "top"}) {
						أعلى
					}
					@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "bottom"}) {
						أسفل
					}
					@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "right"}) {
						يمين
					}
					@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "left"}) {
						يسار
					}
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Group() {
				@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
					تسجيل الخروج
				}
			}
		}
	}
}
