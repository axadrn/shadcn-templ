	}
}

templ dropdownMenuExampleWithCheckboxesIcons() {
	@dropdownMenuExampleSection("Checkboxes with Icons", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
