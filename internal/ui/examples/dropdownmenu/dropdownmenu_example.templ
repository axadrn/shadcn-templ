package dropdownmenu

import (
	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

templ dropdownMenuExampleSection(title, containerClass string) {
	<div data-slot="example" class={ "mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ DropdownMenuExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@dropdownMenuExampleBasic()
			@dropdownMenuExampleComplex()
			@dropdownMenuExampleSidesSection()
			@dropdownMenuExampleWithIcons()
			@dropdownMenuExampleWithShortcuts()
			@dropdownMenuExampleWithSubmenu()
			@dropdownMenuExampleWithCheckboxes()
			@dropdownMenuExampleWithCheckboxesIcons()
			@dropdownMenuExampleWithRadio()
			@dropdownMenuExampleWithRadioIcons()
			@dropdownMenuExampleWithDestructive()
			@dropdownMenuExampleWithAvatar()
			@dropdownMenuExampleInDialog()
			@dropdownMenuExampleWithInset()
		</div>
	</div>
}

templ dropdownMenuExampleBasic() {
	@dropdownMenuExampleSection("Basic", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Open
			}
			@dropdownmenu.Content() {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						My Account
					}
					@dropdownmenu.Item() {
						Profile
					}
					@dropdownmenu.Item() {
						Billing
					}
					@dropdownmenu.Item() {
						Settings
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Item() {
					GitHub
				}
				@dropdownmenu.Item() {
					Support
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{Disabled: true}) {
					API
				}
			}
		}
	}
}

templ dropdownMenuExampleComplex() {
	@dropdownMenuExampleSection("Complex", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Complex Menu
			}
			@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-56"}) {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						My Account
					}
					@dropdownmenu.Item() {
						@icon.User()
						Profile
						@dropdownmenu.Shortcut() {
							⇧⌘P
						}
					}
					@dropdownmenu.Item() {
						@icon.CreditCard()
						Billing
						@dropdownmenu.Shortcut() {
							⌘B
						}
					}
					@dropdownmenu.Item() {
						@icon.Settings()
						Settings
						@dropdownmenu.Shortcut() {
							⌘S
						}
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						View
					}
					@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{DefaultChecked: true}) {
						@icon.PanelLeft()
						Sidebar
					}
					@dropdownmenu.CheckboxItem() {
						@icon.PanelsTopLeft()
						Status Bar
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Group() {
					@dropdownmenu.Sub() {
						@dropdownmenu.SubTrigger() {
							@icon.Users()
							Invite Users
						}
						@dropdownmenu.SubContent() {
							@dropdownmenu.Group() {
								@dropdownmenu.Item() {
									@icon.Mail()
									Email
								}
								@dropdownmenu.Item() {
									@icon.MessageSquare()
									Message
								}
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Group() {
								@dropdownmenu.Item() {
									@icon.CirclePlus()
									More...
								}
							}
						}
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Group() {
					@dropdownmenu.Item() {
						@icon.CircleQuestionMark()
						Support
					}
					@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
						@icon.LogOut()
						Sign Out
						@dropdownmenu.Shortcut() {
							⇧⌘Q
						}
					}
				}
			}
		}
	}
}

type dropdownMenuExampleSide struct {
	Label string
	Side  dropdownmenu.Side
}

// Our dropdown menu has no inline-start/inline-end placements; they resolve
// to left/right in LTR, so those two sides reuse SideLeft/SideRight.
func dropdownMenuExampleSides() []dropdownMenuExampleSide {
	return []dropdownMenuExampleSide{
		{"inline start", dropdownmenu.SideLeft},
		{"left", dropdownmenu.SideLeft},
		{"top", dropdownmenu.SideTop},
		{"bottom", dropdownmenu.SideBottom},
		{"right", dropdownmenu.SideRight},
		{"inline end", dropdownmenu.SideRight},
	}
}

templ dropdownMenuExampleSidesSection() {
	@dropdownMenuExampleSection("Sides", "col-span-2") {
		<div class="flex flex-wrap justify-center gap-2">
			for _, side := range dropdownMenuExampleSides() {
				@dropdownmenu.DropdownMenu() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      "w-fit capitalize",
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						{ side.Label }
					}
					@dropdownmenu.Content(dropdownmenu.ContentProps{Side: side.Side}) {
						@dropdownmenu.Group() {
							@dropdownmenu.Item() {
								Profile
							}
							@dropdownmenu.Item() {
								Billing
							}
							@dropdownmenu.Item() {
								Settings
							}
						}
					}
				}
			}
		</div>
	}
}

