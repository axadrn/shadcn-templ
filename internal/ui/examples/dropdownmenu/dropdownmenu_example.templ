templ dropdownMenuExampleWithRadio() {
	@dropdownMenuExampleSection("With Radio Group", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Radio Group
			}
			@dropdownmenu.Content() {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						Panel Position
					}
					@dropdownmenu.RadioGroup(dropdownmenu.RadioGroupProps{DefaultValue: "bottom"}) {
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "top"}) {
							@icon.ArrowUp()
							Top
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "bottom"}) {
							@icon.ArrowDown()
							Bottom
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "right", Disabled: true}) {
							@icon.ArrowRight()
							Right
						}
					}
				}
			}
		}
	}
}

templ dropdownMenuExampleWithRadioIcons() {
	@dropdownMenuExampleSection("Radio with Icons", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Payment Method
			}
			@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "min-w-56"}) {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						Select Payment Method
					}
					@dropdownmenu.RadioGroup(dropdownmenu.RadioGroupProps{DefaultValue: "card"}) {
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "card"}) {
							@icon.CreditCard()
							Credit Card
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "paypal"}) {
							@icon.Wallet()
							PayPal
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{Value: "bank"}) {
							@icon.Building2()
							Bank Transfer
						}
					}
				}
			}
		}
	}
}

