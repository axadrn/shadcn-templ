templ dropdownMenuExampleWithCheckboxes() {
	@dropdownMenuExampleSection("With Checkboxes", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Checkboxes
			}
			@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "min-w-40"}) {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						Appearance
					}
					@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{DefaultChecked: true}) {
						@icon.PanelsTopLeft()
						Status Bar
					}
					@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{Disabled: true}) {
						@icon.Activity()
						Activity Bar
					}
					@dropdownmenu.CheckboxItem() {
						@icon.PanelLeft()
						Panel
					}
				}
			}
