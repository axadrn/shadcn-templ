templ dropdownMenuExampleAvatarMenuContent() {
	@dropdownmenu.Group() {
		@dropdownmenu.Item() {
			@icon.BadgeCheck()
			Account
		}
		@dropdownmenu.Item() {
			@icon.CreditCard()
			Billing
		}
		@dropdownmenu.Item() {
			@icon.Bell()
			Notifications
		}
	}
	@dropdownmenu.Separator()
	@dropdownmenu.Item() {
		@icon.LogOut()
		Sign Out
	}
}

templ dropdownMenuExampleWithAvatar() {
	@dropdownMenuExampleSection("With Avatar", "") {
		<div class="flex items-center justify-between gap-4">
			@dropdownmenu.DropdownMenu() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "h-12 justify-start px-2 md:max-w-[200px] style-sera:font-normal style-sera:tracking-normal style-sera:normal-case",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{
							Src: "https://github.com/axadrn.png",
							Alt: "Axel Adrian",
						})
						@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
							AA
						}
					}
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-semibold">axadrn</span>
						<span class="truncate text-xs text-muted-foreground">axadrn@example.com</span>
					</div>
					@icon.ChevronsUpDown(icon.Props{Class: "ml-auto text-muted-foreground"})
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-(--anchor-width) min-w-56"}) {
					@dropdownMenuExampleAvatarMenuContent()
				}
			}
			@dropdownmenu.DropdownMenu() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "rounded-full",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{
							Src: "https://github.com/axadrn.png",
							Alt: "axadrn",
						})
						@avatar.Fallback() {
							AA
						}
					}
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideTop}) {
					@dropdownMenuExampleAvatarMenuContent()
				}
			}
		</div>
	}
}

templ dropdownMenuExampleInDialog() {
	@dropdownMenuExampleSection("In Dialog", "") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Dropdown Menu Example
					}
					@dialog.Description() {
						Click the button below to see the dropdown menu.
					}
				}
				@dropdownmenu.DropdownMenu() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      "w-fit",
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						Open Menu
					}
					@dropdownmenu.Content() {
						@dropdownmenu.Item() {
							@icon.Copy()
							Copy
						}
						@dropdownmenu.Item() {
							@icon.Scissors()
							Cut
						}
						@dropdownmenu.Item() {
							@icon.ClipboardPaste()
							Paste
						}
						@dropdownmenu.Separator()
						@dropdownmenu.Sub() {
							@dropdownmenu.SubTrigger() {
								More Options
							}
							@dropdownmenu.SubContent() {
								@dropdownmenu.Item() {
									Save Page...
								}
								@dropdownmenu.Item() {
									Create Shortcut...
								}
								@dropdownmenu.Item() {
									Name Window...
								}
								@dropdownmenu.Separator()
								@dropdownmenu.Item() {
									Developer Tools
								}
							}
						}
						@dropdownmenu.Separator()
						@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
							@icon.Trash()
							Delete
						}
					}
				}
			}
		}
	}
}

templ dropdownMenuExampleWithInset() {
	@dropdownMenuExampleSection("With Inset", "") {
		@dropdownmenu.DropdownMenu() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-fit",
				Attributes: dropdownmenu.Trigger(ctx),
			}) {
				Open
			}
			@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-44"}) {
				@dropdownmenu.Group() {
					@dropdownmenu.Label() {
						Actions
					}
					@dropdownmenu.Item() {
						@icon.Copy()
						Copy
					}
					@dropdownmenu.Item() {
						@icon.Scissors()
						Cut
					}
					@dropdownmenu.Item(dropdownmenu.ItemProps{Inset: true}) {
						Paste
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Group() {
					@dropdownmenu.Label(dropdownmenu.LabelProps{Inset: true}) {
						Appearance
					}
					@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{
						DefaultChecked: true,
						Attributes:     templ.Attributes{"data-inset": "true"},
					}) {
						Bookmarks
					}
					@dropdownmenu.CheckboxItem(dropdownmenu.CheckboxItemProps{
						Attributes: templ.Attributes{"data-inset": "true"},
					}) {
						Full URLs
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Group() {
					@dropdownmenu.Label(dropdownmenu.LabelProps{Inset: true}) {
						Theme
					}
					@dropdownmenu.RadioGroup(dropdownmenu.RadioGroupProps{DefaultValue: "system"}) {
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{
							Value:      "light",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							Light
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{
							Value:      "dark",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							Dark
						}
						@dropdownmenu.RadioItem(dropdownmenu.RadioItemProps{
							Value:      "system",
							Attributes: templ.Attributes{"data-inset": "true"},
						}) {
							System
						}
					}
				}
				@dropdownmenu.Separator()
				@dropdownmenu.Sub() {
					@dropdownmenu.SubTrigger(dropdownmenu.SubTriggerProps{Inset: true}) {
						More Options
					}
					@dropdownmenu.SubContent() {
						@dropdownmenu.Group() {
							@dropdownmenu.Item() {
								Save Page...
							}
							@dropdownmenu.Item() {
								Create Shortcut...
							}
						}
					}
				}
			}
		}
	}
}
