package hovercard

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/hovercard"
)

templ hoverCardExampleSection(title, containerClass string) {
	<div data-slot="example" class={ "mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ HoverCardExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@hoverCardExampleSidesSection()
			@hoverCardExampleInDialog()
		</div>
	</div>
}

// Our hovercard has no inline-start/inline-end placements; they resolve to
// left/right in LTR, so those two sides reuse SideLeft/SideRight.
type hoverCardExampleSide struct {
	Label string
	Side  hovercard.Side
}

func hoverCardExampleSides() []hoverCardExampleSide {
	return []hoverCardExampleSide{
		{"inline start", hovercard.SideLeft},
		{"left", hovercard.SideLeft},
		{"top", hovercard.SideTop},
		{"bottom", hovercard.SideBottom},
		{"right", hovercard.SideRight},
		{"inline end", hovercard.SideRight},
	}
}

templ hoverCardExampleSidesSection() {
	@hoverCardExampleSection("Sides", "col-span-2") {
		<div class="flex flex-wrap items-center justify-center gap-2">
			for _, side := range hoverCardExampleSides() {
				@hovercard.HoverCard(hovercard.Props{Delay: 100, CloseDelay: 100}) {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      "capitalize",
						Attributes: hovercard.Trigger(ctx),
					}) {
						{ side.Label }
					}
					@hovercard.Content(hovercard.ContentProps{Side: side.Side}) {
						<div class="flex flex-col style-vega:gap-2 style-nova:gap-1.5 style-lyra:gap-1 style-maia:gap-2 style-mira:gap-1 style-luma:gap-2">
							<h4 class="font-medium">Hover Card</h4>
							<p>This hover card appears on the { side.Label } side of the trigger.</p>
						</div>
					}
				}
			}
		</div>
	}
}

templ hoverCardExampleInDialog() {
	@hoverCardExampleSection("In Dialog", "") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Hover Card Example
					}
					@dialog.Description() {
						Hover over the button below to see the hover card.
					}
				}
				@hovercard.HoverCard(hovercard.Props{Delay: 100, CloseDelay: 100}) {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      "w-fit",
						Attributes: hovercard.Trigger(ctx),
					}) {
						Hover me
					}
					@hovercard.Content() {
						<div class="flex flex-col style-vega:gap-2 style-nova:gap-1.5 style-lyra:gap-1 style-maia:gap-2 style-mira:gap-1 style-luma:gap-2">
							<h4 class="font-medium">Hover Card</h4>
							<p>This hover card appears inside a dialog. Hover over the button to see it.</p>
						</div>
					}
				}
			}
		}
	}
}
