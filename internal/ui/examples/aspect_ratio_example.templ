package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/aspectratio"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ aspectRatioExampleSection(title string, class string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class={ utils.CN("flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full", class) }>
			{ children... }
		</div>
	</div>
}

templ AspectRatioExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class={ utils.CN("mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl", "max-w-4xl 2xl:max-w-4xl") }>
			@aspectRatioExample16x9()
			@aspectRatioExample21x9()
			@aspectRatioExample1x1()
			@aspectRatioExample9x16()
		</div>
	</div>
}

templ aspectRatioExample16x9() {
	@aspectRatioExampleSection("16:9", "items-center justify-center") {
		@aspectratio.AspectRatio(aspectratio.Props{
			Ratio: "16/9",
			Class: "rounded-lg bg-muted style-luma:rounded-3xl",
		}) {
			// next/image with fill: the img it renders.
			<img
				alt="Photo"
				loading="lazy"
				decoding="async"
				data-nimg="fill"
				class="h-full w-full rounded-lg object-cover grayscale dark:brightness-20 style-luma:rounded-3xl"
				style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"
				sizes="100vw"
				srcset="https://avatar.vercel.sh/shadcn1 1x"
				src="https://avatar.vercel.sh/shadcn1"
			/>
		}
	}
}

