package examples

import (
	"fmt"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/item"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ selectExampleSection(title, containerClass string) {
	<div data-slot="example" class={ "mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ SelectExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@selectExampleBasic()
			@selectExampleSides()
			@selectExampleWithIcons()
			@selectExampleWithGroups()
			@selectExampleLargeList()
			@selectExampleSizes()
			@selectExamplePlan()
			@selectExampleWithButton()
			@selectExampleItemAligned()
			@selectExampleWithField()
			@selectExampleInvalid()
			@selectExampleInline()
			@selectExampleDisabled()
			@selectExampleInDialog()
		</div>
	</div>
}

type selectExampleItem struct {
	Label string
	Value string
}

var selectExampleFruits = []selectExampleItem{
	{"Apple", "apple"},
	{"Banana", "banana"},
	{"Blueberry", "blueberry"},
	{"Grapes", "grapes"},
	{"Pineapple", "pineapple"},
}

templ selectExampleBasic() {
	@selectExampleSection("Basic", "") {
		@selectcomp.Select() {
			@selectcomp.Trigger() {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					for _, fruit := range selectExampleFruits {
						@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
							{ fruit.Label }
						}
					}
				}
			}
		}
	}
}

// Our select computes its side from the available space; there is no side
// preference like Base UI's side prop, so the six triggers only carry the
// side labels as placeholders.
var selectExampleSideLabels = []string{"inline start", "left", "top", "bottom", "right", "inline end"}

templ selectExampleSides() {
	@selectExampleSection("Sides", "col-span-2") {
		<div class="flex flex-wrap justify-center gap-2">
			for _, side := range selectExampleSideLabels {
				@selectcomp.Select() {
					@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-28 capitalize"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: side})
					}
					@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false)}) {
						@selectcomp.Group() {
							for _, fruit := range selectExampleFruits[:3] {
								@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
									{ fruit.Label }
								}
							}
						}
					}
				}
			}
		</div>
	}
}

templ selectExampleChartItems() {
	@selectcomp.Item(selectcomp.ItemProps{Value: "line"}) {
		@icon.ChartLine()
		Line
	}
	@selectcomp.Item(selectcomp.ItemProps{Value: "bar"}) {
		@icon.ChartBar()
		Bar
	}
	@selectcomp.Item(selectcomp.ItemProps{Value: "pie"}) {
		@icon.ChartPie()
		Pie
	}
}

templ selectExampleWithIcons() {
	@selectExampleSection("With Icons", "") {
		<div class="flex flex-col gap-4">
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeSm}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Chart Type"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						@selectExampleChartItems()
					}
				}
			}
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeDefault}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Chart Type"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						@selectExampleChartItems()
					}
				}
			}
		</div>
	}
}

templ selectExampleWithGroups() {
	@selectExampleSection("With Groups & Labels", "") {
		@selectcomp.Select() {
			@selectcomp.Trigger() {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					@selectcomp.Label() {
						Fruits
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "apple"}) {
						Apple
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "banana"}) {
						Banana
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "blueberry"}) {
						Blueberry
					}
				}
				@selectcomp.Separator()
				@selectcomp.Group() {
					@selectcomp.Label() {
						Vegetables
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "carrot"}) {
						Carrot
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "broccoli"}) {
						Broccoli
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "spinach"}) {
						Spinach
					}
				}
			}
		}
	}
}

templ selectExampleLargeList() {
	@selectExampleSection("Large List", "") {
		@selectcomp.Select() {
			@selectcomp.Trigger() {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select an item"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					for i := range 100 {
						@selectcomp.Item(selectcomp.ItemProps{Value: fmt.Sprintf("item-%d", i)}) {
							{ fmt.Sprintf("Item %d", i) }
						}
					}
				}
			}
		}
	}
}

templ selectExampleSizes() {
	@selectExampleSection("Sizes", "") {
		<div class="flex flex-col gap-4">
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeSm}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						for _, fruit := range selectExampleFruits[:3] {
							@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
								{ fruit.Label }
							}
						}
					}
				}
			}
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeDefault}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						for _, fruit := range selectExampleFruits[:3] {
							@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
								{ fruit.Label }
							}
						}
					}
				}
			}
		</div>
	}
}

type selectExamplePlanItem struct {
	Name        string
	Description string
}

var selectExamplePlans = []selectExamplePlanItem{
	{"Starter", "Perfect for individuals getting started."},
	{"Professional", "Ideal for growing teams and businesses."},
	{"Enterprise", "Advanced features for large organizations."},
}

// Our trigger renders the selected item's label as text; the rich plan item
// markup only lives in the list (the SelectValue render prop has no pendant).
templ selectExamplePlan() {
	@selectExampleSection("Subscription Plan", "") {
		@selectcomp.Select(selectcomp.Props{DefaultValue: "Starter"}) {
			@selectcomp.Trigger(selectcomp.TriggerProps{Class: "h-auto! w-72"}) {
				@selectcomp.Value()
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					for _, plan := range selectExamplePlans {
						@selectcomp.Item(selectcomp.ItemProps{Value: plan.Name, Label: plan.Name}) {
							@item.Item(item.Props{Size: item.SizeXs, Class: "w-full p-0"}) {
								@item.Content(item.ContentProps{Class: "gap-0 normal-case"}) {
									@item.Title(item.TitleProps{Class: "font-sans"}) {
										{ plan.Name }
									}
									@item.Description(item.DescriptionProps{Class: "text-xs font-normal tracking-normal"}) {
										{ plan.Description }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ selectExampleWithButton() {
	@selectExampleSection("With Button", "") {
		<div class="flex flex-col gap-4">
			<div class="flex items-center gap-2">
				@selectcomp.Select() {
					@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeSm}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							for _, fruit := range selectExampleFruits[:3] {
								@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
									{ fruit.Label }
								}
							}
						}
					}
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Submit
				}
			</div>
			<div class="flex items-center gap-2">
				@selectcomp.Select() {
					@selectcomp.Trigger() {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							for _, fruit := range selectExampleFruits[:3] {
								@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
									{ fruit.Label }
								}
							}
						}
					}
				}
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Submit
				}
			</div>
		</div>
	}
}

templ selectExampleItemAligned() {
	@selectExampleSection("Item Aligned", "") {
		@selectcomp.Select() {
			@selectcomp.Trigger() {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
			}
			@selectcomp.Content(selectcomp.ContentProps{}) {
				@selectcomp.Group() {
					@selectcomp.Item(selectcomp.ItemProps{Value: "apple"}) {
						Apple
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "banana"}) {
						Banana
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "blueberry"}) {
						Blueberry
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "grapes", Disabled: true}) {
						Grapes
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "pineapple"}) {
						Pineapple
					}
				}
			}
		}
	}
}

templ selectExampleWithField() {
	@selectExampleSection("With Field", "") {
		@field.Field() {
			@field.Label(field.LabelProps{For: "select-fruit"}) {
				Favorite Fruit
			}
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{ID: "select-fruit"}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						for _, fruit := range selectExampleFruits {
							@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
								{ fruit.Label }
							}
						}
					}
				}
			}
			@field.Description() {
				Choose your favorite fruit from the list.
			}
		}
	}
}

templ selectExampleInvalid() {
	@selectExampleSection("Invalid", "") {
		<div class="flex flex-col gap-4">
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Attributes: templ.Attributes{"aria-invalid": "true"}}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						for _, fruit := range selectExampleFruits {
							@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
								{ fruit.Label }
							}
						}
					}
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "select-fruit-invalid"}) {
					Favorite Fruit
				}
				@selectcomp.Select() {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "select-fruit-invalid", Attributes: templ.Attributes{"aria-invalid": "true"}}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							for _, fruit := range selectExampleFruits {
								@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
									{ fruit.Label }
								}
							}
						}
					}
				}
				@field.Error() {
					Please select a valid fruit.
				}
			}
		</div>
	}
}

templ selectExampleInline() {
	@selectExampleSection("Inline with Input & NativeSelect", "") {
		<div class="flex items-center gap-2">
			@input.Input(input.Props{Placeholder: "Search...", Class: "flex-1"})
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-[140px]"}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Filter"})
				}
				@selectcomp.Content() {
					@selectcomp.Group() {
						@selectcomp.Item(selectcomp.ItemProps{Value: "all"}) {
							All
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: "active"}) {
							Active
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: "inactive"}) {
							Inactive
						}
					}
				}
			}
			<div class="cn-native-select-wrapper group/native-select relative w-[140px] has-[select:disabled]:opacity-50" data-slot="native-select-wrapper" data-size="default">
				<select data-slot="native-select" data-size="default" class="cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed">
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="">Sort by</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="name">Name</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="date">Date</option>
					<option data-slot="native-select-option" class="bg-[Canvas] text-[CanvasText]" value="status">Status</option>
				</select>
				@icon.ChevronDown(icon.Props{
					Class: "cn-native-select-icon pointer-events-none absolute select-none",
					Attributes: templ.Attributes{
						"aria-hidden": "true",
						"data-slot":   "native-select-icon",
					},
				})
			</div>
		</div>
	}
}

templ selectExampleDisabled() {
	@selectExampleSection("Disabled", "") {
		@selectcomp.Select(selectcomp.Props{Disabled: true}) {
			@selectcomp.Trigger() {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					@selectcomp.Item(selectcomp.ItemProps{Value: "apple"}) {
						Apple
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "banana"}) {
						Banana
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "blueberry"}) {
						Blueberry
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "grapes", Disabled: true}) {
						Grapes
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "pineapple"}) {
						Pineapple
					}
				}
			}
		}
	}
}

templ selectExampleInDialog() {
	@selectExampleSection("In Dialog", "") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Select Example
					}
					@dialog.Description() {
						Use the select below to choose a fruit.
					}
				}
				@selectcomp.Select() {
					@selectcomp.Trigger() {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a fruit"})
					}
					@selectcomp.Content() {
						@selectcomp.Group() {
							for _, fruit := range selectExampleFruits {
								@selectcomp.Item(selectcomp.ItemProps{Value: fruit.Value}) {
									{ fruit.Label }
								}
							}
						}
					}
				}
			}
		}
	}
}
