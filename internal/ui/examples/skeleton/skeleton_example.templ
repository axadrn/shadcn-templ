package skeleton

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/skeleton"
)

templ skeletonExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ SkeletonExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@skeletonExampleAvatar()
			@skeletonExampleCard()
			@skeletonExampleText()
			@skeletonExampleForm()
			@skeletonExampleTable()
		</div>
	</div>
}

templ skeletonExampleAvatar() {
	@skeletonExampleSection("Avatar") {
		<div class="flex w-full items-center gap-4">
			@skeleton.Skeleton(skeleton.Props{Class: "size-10 shrink-0 rounded-full"})
			<div class="grid gap-2">
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-[150px]"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-[100px]"})
			</div>
		</div>
	}
}

templ skeletonExampleCard() {
	@skeletonExampleSection("Card") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header() {
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/2"})
			}
			@card.Content() {
				@skeleton.Skeleton(skeleton.Props{Class: "aspect-square w-full"})
			}
		}
	}
}

templ skeletonExampleText() {
	@skeletonExampleSection("Text") {
		<div class="flex w-full flex-col gap-2">
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-3/4"})
		</div>
	}
}

templ skeletonExampleForm() {
	@skeletonExampleSection("Form") {
		<div class="flex w-full flex-col gap-7">
			<div class="flex flex-col gap-3">
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-full"})
			</div>
			<div class="flex flex-col gap-3">
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-full"})
			</div>
			@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-24"})
		</div>
	}
}

templ skeletonExampleTable() {
	@skeletonExampleSection("Table") {
		<div class="flex w-full flex-col gap-2">
			for range 3 {
				<div class="flex gap-4">
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 flex-1"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20"})
				</div>
			}
		</div>
	}
}
