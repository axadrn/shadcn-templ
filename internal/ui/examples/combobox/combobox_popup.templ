package combobox

import (
	"slices"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/combobox"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The countries with upstream's first entry, the value "" labelled "Select
// country", which the combobox starts with.
var comboboxPopupCountries = slices.Concat(
	[]combobox.ItemData{{Value: "", Label: "Select country"}},
	utils.Map(comboboxCountries, func(c comboboxCountry) combobox.ItemData {
		return combobox.ItemData{Value: c.Value, Label: c.Label}
	}),
)

templ ComboboxPopup() {
	@combobox.Combobox(combobox.Props{Items: comboboxPopupCountries, DefaultValue: ""}) {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "cn-combobox-trigger w-64 justify-between font-normal",
			Attributes: combobox.Trigger(ctx),
		}) {
			@combobox.Value()
			@icon.ChevronDown(icon.Props{Class: "cn-combobox-trigger-icon pointer-events-none"})
		}
		@combobox.Content() {
			@combobox.Input(combobox.InputProps{
				Placeholder: "Search",
				HideTrigger: true,
			})
			@combobox.Empty() {
				No items found.
			}
			@combobox.List() {
				for _, country := range comboboxPopupCountries {
					@combobox.Item(combobox.ItemProps{Value: country.Value}) {
						{ country.Label.(string) }
					}
				}
			}
		}
	}
}
