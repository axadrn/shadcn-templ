templ attachmentExampleTriggers() {
	@example.Example(example.Props{Title: "Triggers", Class: "gap-3"}) {
		@attachment.Attachment(attachment.Props{Class: "w-full"}) {
			@attachment.Media() {
				@icon.FileText()
			}
			@attachment.Content() {
				@attachment.Title() {
					contract-review.pdf
				}
				@attachment.Description() {
					PDF · 820 KB
				}
			}
			@attachment.Actions() {
				@attachment.Action(attachment.ActionProps{Attributes: templ.Attributes{"aria-label": "Download attachment"}}) {
					@icon.Download()
				}
				@attachment.Action(attachment.ActionProps{Attributes: templ.Attributes{"aria-label": "Remove attachment"}}) {
					@icon.X()
				}
			}
			@attachment.Trigger(attachment.TriggerProps{Href: "#", Attributes: templ.Attributes{"target": "_blank", "rel": "noreferrer", "aria-label": "Open contract-review.pdf"}})
		}
		@dialog.Dialog() {
			@attachment.Attachment(attachment.Props{Class: "w-full"}) {
				@attachment.Media() {
					@icon.FileSearch()
				}
				@attachment.Content() {
					@attachment.Title() {
						research-summary.pdf
					}
					@attachment.Description() {
						Open preview dialog
					}
				}
				@attachment.Actions() {
					@attachment.Action(attachment.ActionProps{Attributes: templ.Attributes{"aria-label": "Copy link"}}) {
						@icon.Copy()
					}
					@attachment.Action(attachment.ActionProps{Attributes: templ.Attributes{"aria-label": "Remove research-summary.pdf"}}) {
						@icon.X()
					}
				}
				// DialogTrigger render={<AttachmentTrigger />}: the dialog
				// trigger's slot wins.
				@attachment.Trigger(attachment.TriggerProps{
					Attributes: utils.MergeAttributes(
						dialog.Trigger(ctx),
						templ.Attributes{"aria-label": "Preview research-summary.pdf"},
					),
				})
			}
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						research-summary.pdf
					}
					@dialog.Description() {
						Attachment triggers can open dialogs while actions remain
						independently reachable.
					}
				}
			}
		}
	}
	// The isVisible state: Remove attachment swaps the first attachment for
	// the Restore button, which swaps it back.
	<template>
		@button.Button(button.Props{Variant: button.VariantOutline}) {
			Restore attachment
		}
	</template>
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const template = document.currentScript.previousElementSibling;
			const content = template.previousElementSibling.querySelector('[data-slot="example-content"]');
			const attachment = content.firstElementChild;
			const restore = template.content.firstElementChild;
			attachment.querySelector('[aria-label="Remove attachment"]').addEventListener("click", () => attachment.replaceWith(restore));
			restore.addEventListener("click", () => restore.replaceWith(attachment));
		})();
	</script>
}
