package inputotp

import (
	"github.com/axadrn/shadcn-templ/v2/components/inputotp"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ InputOTPControlled() {
	<div class="space-y-2">
		@inputotp.InputOTP(inputotp.Props{MaxLength: 6, Value: utils.Ptr("")}) {
			@inputotp.Group() {
				@inputotp.Slot(inputotp.SlotProps{Index: 0})
				@inputotp.Slot(inputotp.SlotProps{Index: 1})
				@inputotp.Slot(inputotp.SlotProps{Index: 2})
				@inputotp.Slot(inputotp.SlotProps{Index: 3})
				@inputotp.Slot(inputotp.SlotProps{Index: 4})
				@inputotp.Slot(inputotp.SlotProps{Index: 5})
			}
		}
		<div class="text-center text-sm">Enter your one-time password.</div>
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		// The value state: onChange sets it, the input and the text render it.
		(() => {
			const demo = document.currentScript.previousElementSibling;
			const input = demo.querySelector("[data-input-otp]");
			const status = demo.lastElementChild;
			input.addEventListener("input-otp-change", (e) => {
				const value = e.detail.value;
				window.templ.inputOTP.setValue(input, value);
				status.textContent = value === "" ? "Enter your one-time password." : "You entered: " + value;
			});
		})();
	</script>
}
