	@itemExampleSection("ItemGroup") {
		@item.Group() {
			@item.Item() {
				@item.Content() {
					@item.Title() {
						Item 1
					}
					@item.Description() {
						First item in the group.
					}
				}
			}
			@item.Item() {
				@item.Content() {
					@item.Title() {
						Item 2
					}
					@item.Description() {
						Second item in the group.
					}
				}
			}
			@item.Item() {
				@item.Content() {
					@item.Title() {
						Item 3
					}
					@item.Description() {
						Third item in the group.
					}
				}
			}
		}
	}
}

