package item

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/item"
)

// The variant, size, and image sections reuse the same item combinations
// through the shared matrix helpers below.
templ itemExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ItemExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@itemExampleVariantSection("Default", item.VariantDefault, item.SizeDefault, "")
			@itemExampleVariantSection("Outline", item.VariantOutline, item.SizeDefault, "")
			@itemExampleVariantSection("Muted", item.VariantMuted, item.SizeDefault, "")
			@itemExampleVariantSection("Small", item.VariantDefault, item.SizeSm, button.SizeSm)
			@itemExampleVariantSection("Outline - Small", item.VariantOutline, item.SizeSm, button.SizeSm)
			@itemExampleVariantSection("Muted - Small", item.VariantMuted, item.SizeSm, button.SizeSm)
			@itemExampleVariantSection("Extra Small", item.VariantDefault, item.SizeXs, button.SizeSm)
			@itemExampleVariantSection("Outline - Extra Small", item.VariantOutline, item.SizeXs, button.SizeSm)
			@itemExampleVariantSection("Muted - Extra Small", item.VariantMuted, item.SizeXs, button.SizeSm)
			@itemExampleLinkSection("asChild", item.VariantDefault)
			@itemExampleLinkSection("Outline - asChild", item.VariantOutline)
			@itemExampleLinkSection("Muted - asChild", item.VariantMuted)
			@itemExampleDefaultGroup()
			@itemExampleOutlineGroup()
			@itemExampleMutedGroup()
			@itemExampleSeparatorSection()
			@itemExampleHeaderSection()
			@itemExampleFooterSection()
			@itemExampleHeaderAndFooterSection()
			@itemExampleImageSection("Default - ItemMedia image", item.VariantDefault, item.SizeDefault, true)
			@itemExampleImageSection("Outline - ItemMedia image", item.VariantOutline, item.SizeDefault, true)
			@itemExampleImageSection("Outline - ItemMedia image - Small", item.VariantOutline, item.SizeSm, true)
			@itemExampleImageSection("Outline - ItemMedia image - Extra Small", item.VariantOutline, item.SizeXs, false)
			@itemExampleImageSection("Muted - ItemMedia image", item.VariantMuted, item.SizeDefault, true)
		</div>
	</div>
}

// itemExampleVariantSection is one of the nine variant/size sections: the
// same item combinations, only variant, size and the outline action button
// size differ (the default sections use the default button size).
templ itemExampleVariantSection(title string, variant item.Variant, size item.Size, outlineButtonSize button.Size) {
	@itemExampleSection(title) {
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Content() {
				@item.Title() {
					Title Only
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Content() {
				@item.Title() {
					Title + Button
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: outlineButtonSize}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Content() {
				@item.Title() {
					Title + Description
				}
				@item.Description() {
					This is a description that provides additional context.
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Content() {
				@item.Title() {
					Title + Description + Button
				}
				@item.Description() {
					This item includes a title, description, and action button.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: outlineButtonSize}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@icon.Inbox()
			}
			@item.Content() {
				@item.Title() {
					Media + Title
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@icon.Inbox()
			}
			@item.Content() {
				@item.Title() {
					Media + Title + Button
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Size: button.SizeSm}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@icon.Inbox()
			}
			@item.Content() {
				@item.Title() {
					Media + Title + Description
				}
				@item.Description() {
					This item includes media, title, and description.
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@icon.Inbox()
			}
			@item.Content() {
				@item.Title() {
					Media + Title + Description + Button
				}
				@item.Description() {
					Complete item with all components: media, title, description, and button.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Size: button.SizeSm}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Content() {
				@item.Title() {
					Multiple Actions
				}
				@item.Description() {
					Item with multiple action buttons in the actions area.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Cancel
				}
				@button.Button(button.Props{Size: button.SizeSm}) {
					Confirm
				}
			}
		}
	}
}

templ itemExampleLinkSection(title string, variant item.Variant) {
	@itemExampleSection(title) {
		@item.Group() {
			@item.Item(item.Props{Variant: variant, Href: "#"}) {
				@item.Content() {
					@item.Title() {
						Title Only (Link)
					}
				}
			}
			@item.Item(item.Props{Variant: variant, Href: "#"}) {
				@item.Content() {
					@item.Title() {
						Title + Description (Link)
					}
					@item.Description() {
						Clickable item with title and description.
					}
				}
			}
			@item.Item(item.Props{Variant: variant, Href: "#"}) {
				@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
					@icon.Inbox()
				}
				@item.Content() {
					@item.Title() {
						Media + Title (Link)
					}
				}
			}
			@item.Item(item.Props{Variant: variant, Href: "#"}) {
				@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
					@icon.Inbox()
				}
				@item.Content() {
					@item.Title() {
						Media + Title + Description (Link)
					}
					@item.Description() {
						Complete link item with media, title, and description.
					}
				}
			}
			@item.Item(item.Props{Variant: variant, Href: "#"}) {
				@item.Content() {
					@item.Title() {
						With Actions (Link)
					}
					@item.Description() {
						Link item that also has action buttons.
					}
				}
				@item.Actions() {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
						Share
					}
				}
			}
		}
	}
}

