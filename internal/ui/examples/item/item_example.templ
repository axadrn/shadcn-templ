templ itemExampleSeparatorItem(title, description string) {
	@item.Item(item.Props{Variant: item.VariantOutline}) {
		@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
			@icon.Inbox()
		}
		@item.Content() {
			@item.Title() {
				{ title }
			}
			@item.Description() {
				{ description }
			}
		}
	}
}

templ itemExampleSeparatorSection() {
	@itemExampleSection("ItemSeparator") {
		@item.Group() {
			@itemExampleSeparatorItem("Inbox", "View all incoming messages.")
			@item.Separator()
			@itemExampleSeparatorItem("Sent", "View all sent messages.")
			@item.Separator()
			@itemExampleSeparatorItem("Drafts", "View all draft messages.")
			@item.Separator()
			@itemExampleSeparatorItem("Archive", "View archived messages.")
		}
	}
}

templ itemExampleHeaderSection() {
	@itemExampleSection("ItemHeader") {
		@item.Item() {
			@item.Header() {
				<span class="text-sm font-medium">Design System</span>
			}
			@item.Content() {
				@item.Title() {
					Component Library
				}
				@item.Description() {
					A comprehensive collection of reusable UI components for building consistent interfaces.
				}
			}
		}
		@item.Item(item.Props{Variant: item.VariantOutline}) {
			@item.Header() {
				<span class="text-sm font-medium">Marketing</span>
			}
			@item.Content() {
				@item.Title() {
					Campaign Analytics
				}
				@item.Description() {
					Track performance metrics and engagement rates across all marketing channels.
				}
			}
		}
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Header() {
				<span class="text-sm font-medium">Engineering</span>
			}
			@item.Content() {
				@item.Title() {
					API Documentation
				}
				@item.Description() {
					Complete reference guide for all available endpoints and authentication methods.
				}
			}
		}
	}
}

templ itemExampleFooterSection() {
	@itemExampleSection("ItemFooter") {
		@item.Item() {
			@item.Content() {
				@item.Title() {
					Quarterly Report Q4 2024
				}
				@item.Description() {
					Financial overview including revenue, expenses, and growth metrics for the fourth quarter.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">Last updated 2 hours ago</span>
			}
		}
		@item.Item(item.Props{Variant: item.VariantOutline}) {
			@item.Content() {
				@item.Title() {
					User Research Findings
				}
				@item.Description() {
					Insights from interviews and surveys conducted with 50+ users across different demographics.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">Created by Sarah Chen</span>
			}
		}
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Content() {
				@item.Title() {
					Product Roadmap
				}
				@item.Description() {
					Planned features and improvements scheduled for the next three months.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">12 comments</span>
			}
		}
	}
}

templ itemExampleHeaderAndFooterSection() {
	@itemExampleSection("ItemHeader + ItemFooter") {
		@item.Item() {
			@item.Header() {
				<span class="text-sm font-medium">Team Project</span>
			}
			@item.Content() {
				@item.Title() {
					Website Redesign
				}
				@item.Description() {
					Complete overhaul of the company website with modern design principles and improved user experience.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">Updated 5 minutes ago</span>
			}
		}
		@item.Item(item.Props{Variant: item.VariantOutline}) {
			@item.Header() {
				<span class="text-sm font-medium">Client Work</span>
			}
			@item.Content() {
				@item.Title() {
					Mobile App Development
				}
				@item.Description() {
					Building a fast server-rendered web application with Go and templ.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">Status: In Progress</span>
			}
		}
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Header() {
				<span class="text-sm font-medium">Documentation</span>
			}
			@item.Content() {
				@item.Title() {
					API Integration Guide
				}
				@item.Description() {
					Step-by-step instructions for integrating third-party APIs with authentication and error handling.
				}
			}
			@item.Footer() {
				<span class="text-sm text-muted-foreground">Category: Technical • 3 attachments</span>
			}
		}
	}
}

templ itemExampleImage(name string) {
	<img
		src={ "https://avatar.vercel.sh/" + name }
		alt={ name }
		width="40"
		height="40"
		class="object-cover grayscale"
	/>
}

// itemExampleImageSection is one of the ItemMedia image sections; the extra
// small one drops the descriptions like the tsx does.
templ itemExampleImageSection(title string, variant item.Variant, size item.Size, withDescriptions bool) {
	@itemExampleSection(title) {
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantImage}) {
				@itemExampleImage("Project")
			}
			@item.Content() {
				@item.Title() {
					Project Dashboard
				}
				if withDescriptions {
					@item.Description() {
						Overview of project settings and configuration.
					}
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantImage}) {
				@itemExampleImage("Document")
			}
			@item.Content() {
				@item.Title() {
					Document
				}
				if withDescriptions {
					@item.Description() {
						A document with metadata displayed.
					}
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					View
				}
			}
		}
		@item.Item(item.Props{Variant: variant, Size: size}) {
			@item.Media(item.MediaProps{Variant: item.MediaVariantImage}) {
				@itemExampleImage("File")
			}
			@item.Content() {
				@item.Title() {
					File Attachment
				}
				if withDescriptions {
					@item.Description() {
						Complete file with image, title, description, and action button.
					}
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Size: button.SizeSm}) {
					Download
				}
			}
		}
	}
}
