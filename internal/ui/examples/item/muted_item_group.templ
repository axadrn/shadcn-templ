package item

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/item"
)

templ MutedItemGroup() {
	@item.Group() {
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Content() {
				@item.Title() {
					Item 1
				}
				@item.Description() {
					First item in muted group.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Content() {
				@item.Title() {
					Item 2
				}
				@item.Description() {
					Second item in muted group.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Action
				}
			}
		}
		@item.Item(item.Props{Variant: item.VariantMuted}) {
			@item.Content() {
				@item.Title() {
					Item 3
				}
				@item.Description() {
					Third item in muted group.
				}
			}
			@item.Actions() {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					Action
				}
			}
		}
	}
}
