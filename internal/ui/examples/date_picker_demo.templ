package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
)

templ DatePickerDemo() {
	@popover.Popover(popover.Props{ID: "date-picker-demo"}) {
		{{
			triggerAttrs := popover.Trigger(ctx)
			triggerAttrs["data-empty"] = "true"
		}}
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Class:      "w-[212px] justify-between text-left font-normal data-[empty=true]:text-muted-foreground",
			Attributes: triggerAttrs,
		}) {
			<span>Pick a date</span>
			@icon.ChevronDown(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
		}
		@popover.Content(popover.ContentProps{
			Class:     "w-auto p-0",
			Align: popover.AlignStart,
		}) {
			@calendar.Calendar(calendar.Props{Mode: calendar.ModeSingle})
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The date state: onSelect sets it, the trigger renders it.
		(() => {
			// date-fns format(date, "PPP").
			const ppp = (d) => {
				const n = d.getDate();
				const s = n % 100 >= 11 && n % 100 <= 13 ? "th" : { 1: "st", 2: "nd", 3: "rd" }[n % 10] || "th";
				return d.toLocaleDateString("en-US", { month: "long" }) + " " + n + s + ", " + d.getFullYear();
			};
			document.addEventListener("calendar-select", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("#date-picker-demo")) return;
				const trigger = document.querySelector('[data-templ-controls="date-picker-demo"]');
				const date = e.detail.selected;
				window.templ.calendar.setSelected(e.target, e.detail.selected);
				trigger.firstChild.replaceWith(date ? document.createTextNode(ppp(date)) : Object.assign(document.createElement("span"), { textContent: "Pick a date" }));
				trigger.setAttribute("data-empty", String(!date));
			});
		})();
	</script>
}
