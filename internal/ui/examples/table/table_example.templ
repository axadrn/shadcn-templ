package table

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ tableExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ TableExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@tableExampleBasic()
			@tableExampleWithFooter()
			@tableExampleSimple()
			@tableExampleWithBadges()
			@tableExampleWithActions()
			@tableExampleWithSelect()
			@tableExampleWithInput()
		</div>
	</div>
}

templ tableExampleBasic() {
	@tableExampleSection("Basic") {
		@table.Table() {
			@table.Caption() {
				A list of your recent invoices.
			}
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "w-[100px]"}) {
						Invoice
					}
					@table.Head() {
						Status
					}
					@table.Head() {
						Method
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Amount
					}
				}
			}
			@table.Body() {
				for _, invoice := range tableInvoices[:3] {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium"}) {
							{ invoice.Invoice }
						}
						@table.Cell() {
							{ invoice.PaymentStatus }
						}
						@table.Cell() {
							{ invoice.PaymentMethod }
						}
						@table.Cell(table.CellProps{Class: "text-right"}) {
							{ invoice.TotalAmount }
						}
					}
				}
			}
		}
	}
}

templ tableExampleWithFooter() {
	@tableExampleSection("With Footer") {
		@table.Table() {
			@table.Caption() {
				A list of your recent invoices.
			}
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "w-[100px]"}) {
						Invoice
					}
					@table.Head() {
						Status
					}
					@table.Head() {
						Method
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Amount
					}
				}
			}
			@table.Body() {
				for _, invoice := range tableInvoices[:3] {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium"}) {
							{ invoice.Invoice }
						}
						@table.Cell() {
							{ invoice.PaymentStatus }
						}
						@table.Cell() {
							{ invoice.PaymentMethod }
						}
						@table.Cell(table.CellProps{Class: "text-right"}) {
							{ invoice.TotalAmount }
						}
					}
				}
			}
			@table.Footer() {
				@table.Row() {
					@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "3"}}) {
