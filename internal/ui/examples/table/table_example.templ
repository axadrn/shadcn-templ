templ tableExampleWithBadges() {
	@tableExampleSection("With Badges") {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Task
					}
					@table.Head() {
						Status
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Priority
					}
				}
			}
			@table.Body() {
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						Design homepage
					}
					@table.Cell() {
						<span class="inline-flex items-center rounded-full bg-green-500/10 px-2 py-1 text-xs font-medium text-green-700 dark:text-green-400">
							Completed
						</span>
					}
					@table.Cell(table.CellProps{Class: "text-right"}) {
						<span class="inline-flex items-center rounded-full bg-blue-500/10 px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-400">
							High
						</span>
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						Implement API
					}
					@table.Cell() {
						<span class="inline-flex items-center rounded-full bg-yellow-500/10 px-2 py-1 text-xs font-medium text-yellow-700 dark:text-yellow-400">
							In Progress
						</span>
					}
					@table.Cell(table.CellProps{Class: "text-right"}) {
						<span class="inline-flex items-center rounded-full bg-gray-500/10 px-2 py-1 text-xs font-medium text-gray-700 dark:text-gray-400">
							Medium
						</span>
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						Write tests
					}
					@table.Cell() {
						<span class="inline-flex items-center rounded-full bg-gray-500/10 px-2 py-1 text-xs font-medium text-gray-700 dark:text-gray-400">
							Pending
						</span>
					}
					@table.Cell(table.CellProps{Class: "text-right"}) {
						<span class="inline-flex items-center rounded-full bg-gray-500/10 px-2 py-1 text-xs font-medium text-gray-700 dark:text-gray-400">
							Low
						</span>
					}
				}
			}
		}
	}
}

type tableExampleProduct struct {
	Name  string
	Price string
}

var tableExampleProducts = []tableExampleProduct{
	{"Wireless Mouse", "$29.99"},
	{"Mechanical Keyboard", "$129.99"},
	{"USB-C Hub", "$49.99"},
}

templ tableExampleWithActions() {
	@tableExampleSection("With Actions") {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Product
					}
					@table.Head() {
						Price
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Actions
					}
				}
			}
			@table.Body() {
				for _, product := range tableExampleProducts {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium"}) {
							{ product.Name }
						}
						@table.Cell() {
							{ product.Price }
						}
						@table.Cell(table.CellProps{Class: "text-right"}) {
							@dropdownmenu.DropdownMenu() {
								@button.Button(button.Props{
									Variant:    button.VariantGhost,
									Size:       button.SizeIcon,
									Class:      "size-8",
									Attributes: dropdownmenu.Trigger(ctx),
								}) {
									@icon.Ellipsis()
									<span class="sr-only">Open menu</span>
								}
								@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd}) {
									@dropdownmenu.Item() {
										Edit
									}
									@dropdownmenu.Item() {
										Duplicate
									}
									@dropdownmenu.Separator()
									@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive}) {
										Delete
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

type tableExamplePerson struct {
	Value string
	Label string
}

var tableExamplePeople = []tableExamplePerson{
	{"sarah", "Sarah Chen"},
	{"marcus", "Marc Rodriguez"},
	{"emily", "Emily Watson"},
	{"david", "David Kim"},
}

type tableExampleTask struct {
	Task     string
	Assignee string
	Status   string
}

var tableExampleTasks = []tableExampleTask{
	{"Design homepage", "sarah", "In Progress"},
	{"Implement API", "marcus", "Pending"},
	{"Write tests", "emily", "Not Started"},
}

templ tableExampleWithSelect() {
	@tableExampleSection("With Select") {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Task
					}
					@table.Head() {
						Assignee
					}
					@table.Head() {
						Status
					}
				}
			}
			@table.Body() {
				for _, task := range tableExampleTasks {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium"}) {
							{ task.Task }
						}
						@table.Cell() {
							@selectcomp.Select(selectcomp.Props{
								Items: utils.Map(tableExamplePeople, func(p tableExamplePerson) selectcomp.ItemData {
									return selectcomp.ItemData{Value: p.Value, Label: p.Label}
								}),
								DefaultValue: task.Assignee,
							}) {
								@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-40", Size: selectcomp.SizeSm}) {
									@selectcomp.Value()
								}
								@selectcomp.Content() {
									@selectcomp.Group() {
										for _, person := range tableExamplePeople {
											@selectcomp.Item(selectcomp.ItemProps{Value: person.Value}) {
												{ person.Label }
											}
										}
									}
								}
							}
						}
						@table.Cell() {
							{ task.Status }
						}
					}
				}
			}
		}
	}
}

templ tableExampleWithInput() {
	@tableExampleSection("With Input") {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Product
					}
					@table.Head() {
						Quantity
					}
					@table.Head() {
						Price
					}
				}
			}
			@table.Body() {
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						Wireless Mouse
					}
					@table.Cell() {
						@input.Input(input.Props{
							Type:       "number",
							Value:      "1",
							Class:      "h-8 w-20",
							Attributes: templ.Attributes{"min": "0"},
						})
					}
					@table.Cell() {
						$29.99
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						Mechanical Keyboard
					}
					@table.Cell() {
						@input.Input(input.Props{
							Type:       "number",
							Value:      "2",
							Class:      "h-8 w-20",
							Attributes: templ.Attributes{"min": "0"},
						})
					}
					@table.Cell() {
						$129.99
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium"}) {
						USB-C Hub
					}
					@table.Cell() {
						@input.Input(input.Props{
							Type:       "number",
							Value:      "1",
							Class:      "h-8 w-20",
							Attributes: templ.Attributes{"min": "0"},
						})
					}
					@table.Cell() {
						$49.99
					}
				}
			}
		}
	}
}
