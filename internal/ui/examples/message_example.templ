package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/attachment"
	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/example"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/marker"
	"github.com/axadrn/shadcn-templ/v2/components/message"
	"github.com/axadrn/shadcn-templ/v2/components/spinner"
)

// messageExampleLogs is the Group Chat log excerpt, whitespace kept.
const messageExampleLogs = `I found the following error in the logs:

- Error: No users found
- Stack trace:
  - at src/users/services/user-service.ts:123
  - at src/users/services/get-user.ts:230

Can you check if the users are being created?`

// MessageExample is message-example.tsx. Its messagePartsChat and
// MessageTextPart are declared upstream but never rendered, so only the
// eight examples are ported. IconPlaceholder renders its lucide icon.
templ MessageExample() {
	@example.Wrapper() {
		@messageExampleDefault()
		@messageExampleWithAvatar()
		@messageExampleGroup()
		@messageExampleGroupChat()
		@messageExampleHeaderFooter()
		@messageExampleActions()
		@messageExampleAttachment()
		@messageExampleAttachmentGroup()
	}
}

// messageExampleAvatar is <Avatar><AvatarImage/><AvatarFallback/></Avatar>,
// without the image when src is empty.
templ messageExampleAvatar(src, alt, class, fallback string) {
	@avatar.Avatar() {
		if src != "" {
			@avatar.Image(avatar.ImageProps{Src: src, Alt: alt, Class: class})
		}
		@avatar.Fallback() {
			{ fallback }
		}
	}
}

templ messageExampleDefault() {
	@example.Example(example.Props{Title: "Message"}) {
		<div class="flex w-full max-w-md min-w-0 flex-col gap-10">
			@message.Message(message.Props{Align: message.AlignEnd}) {
				@message.Content() {
					@bubble.Bubble() {
						@bubble.Content() {
							Deploying to prod real quick.
						}
					}
				}
			}
			@message.Message() {
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							It's 4:55 PM. On a Friday.
						}
					}
				}
			}
			@message.Message(message.Props{Align: message.AlignEnd}) {
				@message.Content() {
					@bubble.Bubble() {
						@bubble.Content() {
							It's a one-line change.
						}
					}
				}
			}
			@message.Message() {
				@message.Content() {
					@bubble.Group() {
						@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
							@bubble.Content() {
								It's always a one-line change 😭. Make sure to run the
								tests this time.
							}
						}
						@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
							@bubble.Content() {
								Alright, go for it.
							}
						}
					}
				}
			}
		</div>
	}
}

templ messageExampleWithAvatar() {
	@example.Example(example.Props{Title: "Avatar"}) {
		<div class="flex w-full max-w-md flex-col gap-10">
			@message.Message() {
				@message.Avatar() {
					@messageExampleAvatar("https://github.com/shadcn.png", "@shadcn", "grayscale", "CN")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							Something went wrong. Any idea?
						}
					}
				}
			}
			@message.Message() {
				@message.Avatar() {
					@messageExampleAvatar("https://github.com/evilrabbit.png", "@evilrabbit", "", "ER")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							I checked the latest deployment and found the build failed
							during dependency installation.
						}
					}
				}
			}
			@message.Message(message.Props{Align: message.AlignEnd}) {
				@message.Avatar() {
					@messageExampleAvatar("https://github.com/evilrabbit.png", "@evilrabbit", "", "ER")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content() {
							Something went wrong. Any idea?
						}
					}
				}
			}
			@message.Message() {
				@message.Avatar() {
					@messageExampleAvatar("https://avatar.vercel.sh/shadcn", "@shadcn", "", "CN")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
						@bubble.Content(bubble.ContentProps{Class: "space-y-2"}) {
							<div>
								I checked the latest deployment and found the build failed
								during dependency installation.
							</div>
							<div>Can you share the exact error message from the logs?</div>
						}
					}
				}
			}
			@message.Message() {
				@message.Avatar() {
					@messageExampleAvatar("", "", "", "CN")
				}
				@message.Content() {
					@bubble.Bubble(bubble.Props{Variant: bubble.VariantDestructive}) {
						@bubble.Content() {
							Something went wrong. Any idea?
						}
					}
				}
			}
		</div>
	}
}

