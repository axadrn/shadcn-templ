package carousel

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/carousel"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ carouselExampleSection(title string, class string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class={ utils.CN("flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full", class) }>
			{ children... }
		</div>
	</div>
}

templ CarouselExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class={ utils.CN("mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl", "lg:grid-cols-1") }>
			@carouselExampleBasic()
			@carouselExampleMultiple()
			@carouselExampleWithGap()
		</div>
	</div>
}

templ carouselExampleBasic() {
	@carouselExampleSection("Basic", "") {
		@carousel.Carousel(carousel.Props{Class: "mx-auto max-w-xs sm:max-w-sm"}) {
			@carousel.Content() {
				for i := 1; i <= 5; i++ {
					@carousel.Item() {
						<div class="p-1 style-luma:p-2.5">
							@card.Card() {
								@card.Content(card.ContentProps{
									Class: "flex aspect-square items-center justify-center p-6",
								}) {
									<span class="text-4xl font-semibold">{ strconv.Itoa(i) }</span>
								}
							}
						</div>
					}
				}
			}
			@carousel.Previous(carousel.PreviousProps{Class: "hidden sm:inline-flex"})
			@carousel.Next(carousel.NextProps{Class: "hidden sm:inline-flex"})
		}
	}
}

templ carouselExampleMultiple() {
	@carouselExampleSection("Multiple", "") {
		@carousel.Carousel(carousel.Props{
			Class: "mx-auto max-w-xs sm:max-w-sm",
			Align: carousel.AlignStart,
		}) {
			@carousel.Content() {
				for i := 1; i <= 5; i++ {
					@carousel.Item(carousel.ItemProps{Class: "sm:basis-1/2 lg:basis-1/3"}) {
						<div class="p-1 style-luma:p-2.5">
							@card.Card() {
								@card.Content(card.ContentProps{
									Class: "flex aspect-square items-center justify-center p-6",
								}) {
									<span class="text-3xl font-semibold">{ strconv.Itoa(i) }</span>
								}
							}
						</div>
					}
				}
			}
			@carousel.Previous(carousel.PreviousProps{Class: "hidden sm:inline-flex"})
			@carousel.Next(carousel.NextProps{Class: "hidden sm:inline-flex"})
		}
	}
}

templ carouselExampleWithGap() {
	@carouselExampleSection("With Gap", "") {
		@carousel.Carousel(carousel.Props{Class: "mx-auto max-w-xs sm:max-w-sm"}) {
			@carousel.Content(carousel.ContentProps{Class: "-ml-1"}) {
				for i := 1; i <= 5; i++ {
					@carousel.Item(carousel.ItemProps{Class: "pl-1 md:basis-1/2"}) {
						<div class="p-1 style-luma:p-2.5">
							@card.Card() {
								@card.Content(card.ContentProps{
									Class: "flex aspect-square items-center justify-center p-6",
								}) {
									<span class="text-2xl font-semibold">{ strconv.Itoa(i) }</span>
								}
							}
						</div>
					}
				}
			}
			@carousel.Previous(carousel.PreviousProps{Class: "hidden sm:inline-flex"})
			@carousel.Next(carousel.NextProps{Class: "hidden sm:inline-flex"})
		}
	}
}
