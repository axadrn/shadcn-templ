package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/checkbox"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/table"
)

templ checkboxExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ CheckboxExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@checkboxExampleBasic()
			@checkboxExampleWithDescription()
			@checkboxExampleInvalid()
			@checkboxExampleDisabled()
			@checkboxExampleWithTitle()
			@checkboxExampleInTable()
			@checkboxExampleGroup()
		</div>
	</div>
}

templ checkboxExampleBasic() {
	@checkboxExampleSection("Basic") {
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-terms"})
			@field.Label(field.LabelProps{For: "checkbox-example-terms"}) {
				Accept terms and conditions
			}
		}
	}
}

templ checkboxExampleWithDescription() {
	@checkboxExampleSection("With Description") {
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-terms-2", DefaultChecked: true})
			@field.Content() {
				@field.Label(field.LabelProps{For: "checkbox-example-terms-2"}) {
					Accept terms and conditions
				}
				@field.Description() {
					By clicking this checkbox, you agree to the terms and conditions.
				}
			}
		}
	}
}

templ checkboxExampleInvalid() {
	@checkboxExampleSection("Invalid") {
		@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-invalid": "true"}}) {
			@checkbox.Checkbox(checkbox.Props{
				ID:         "checkbox-example-terms-3",
				Attributes: templ.Attributes{"aria-invalid": "true"},
			})
			@field.Label(field.LabelProps{For: "checkbox-example-terms-3"}) {
				Accept terms and conditions
			}
		}
	}
}

templ checkboxExampleDisabled() {
	@checkboxExampleSection("Disabled") {
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-toggle", Disabled: true})
			@field.Label(field.LabelProps{For: "checkbox-example-toggle"}) {
				Enable notifications
			}
		}
	}
}

templ checkboxExampleWithTitle() {
	@checkboxExampleSection("With Title") {
		@field.Group() {
			@field.Label(field.LabelProps{For: "checkbox-example-toggle-2"}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-toggle-2", DefaultChecked: true})
					@field.Content() {
						@field.Title() {
							Enable notifications
						}
						@field.Description() {
							You can enable or disable notifications at any time.
						}
					}
				}
			}
			@field.Label(field.LabelProps{For: "checkbox-example-toggle-4"}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal, Attributes: templ.Attributes{"data-disabled": "true"}}) {
					@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-toggle-4", Disabled: true})
					@field.Content() {
						@field.Title() {
							Enable notifications
						}
						@field.Description() {
							You can enable or disable notifications at any time.
						}
					}
				}
			}
		}
	}
}

type checkboxExampleRow struct {
	ID    string
	Name  string
	Email string
	Role  string
}

var checkboxExampleTableData = []checkboxExampleRow{
	{ID: "1", Name: "Sarah Chen", Email: "sarah.chen@example.com", Role: "Admin"},
	{ID: "2", Name: "Marcus Rodriguez", Email: "marcus.rodriguez@example.com", Role: "User"},
	{ID: "3", Name: "Priya Patel", Email: "priya.patel@example.com", Role: "User"},
	{ID: "4", Name: "David Kim", Email: "david.kim@example.com", Role: "Editor"},
}

templ checkboxExampleInTable() {
	@checkboxExampleSection("In Table") {
		<div data-checkbox-example-table>
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head(table.HeadProps{Class: "w-8"}) {
							@checkbox.Checkbox(checkbox.Props{
								ID:         "checkbox-example-select-all",
								Attributes: templ.Attributes{"data-select-all": true},
							})
						}
						@table.Head() {
							Name
						}
						@table.Head() {
							Email
						}
						@table.Head() {
							Role
						}
					}
				}
				@table.Body() {
					for _, row := range checkboxExampleTableData {
						@table.Row(table.RowProps{
							Attributes: templ.Attributes{"data-state": templ.KV("selected", row.ID == "1")},
						}) {
							@table.Cell() {
								@checkbox.Checkbox(checkbox.Props{
									ID:             "checkbox-example-row-" + row.ID,
									DefaultChecked: row.ID == "1",
								})
							}
							@table.Cell(table.CellProps{Class: "font-medium"}) {
								{ row.Name }
							}
							@table.Cell() {
								{ row.Email }
							}
							@table.Cell() {
								{ row.Role }
							}
						}
					}
				}
			}
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			// The checkbox renders a span root with a hidden native input beside it;
			// dispatching change after a programmatic check lets checkbox.js sync
			// the root's state attributes.
			let updatingCheckboxExampleTable = false;
			document.addEventListener('change', (e) => {
				const demo = e.target.closest('[data-checkbox-example-table]');
				if (!demo || !e.target.matches('[data-slot=checkbox] + input') || updatingCheckboxExampleTable) return;
				const all = demo.querySelector('[data-select-all]')?.nextElementSibling;
				const rows = [...demo.querySelectorAll('tbody [data-slot=checkbox] + input')];
				const setChecked = (input, checked) => {
					if (input.checked === checked) return;
					input.checked = checked;
					input.dispatchEvent(new Event('change', { bubbles: true }));
				};
				// The dispatched change events re-enter this handler; the guard keeps
				// them from reacting to the half-updated state.
				updatingCheckboxExampleTable = true;
				if (e.target === all) {
					rows.forEach((row) => setChecked(row, all.checked));
				} else {
					setChecked(all, rows.every((row) => row.checked));
				}
				updatingCheckboxExampleTable = false;
				rows.forEach((row) => {
					row.closest('tr').toggleAttribute('data-state', row.checked);
					if (row.checked) row.closest('tr').setAttribute('data-state', 'selected');
				});
			});
		</script>
	}
}

templ checkboxExampleGroup() {
	@checkboxExampleSection("Group") {
		@field.Field() {
			@field.Label() {
				Show these items on the desktop:
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-finder-pref-9k2-hard-disks-ljj"})
				@field.Label(field.LabelProps{For: "checkbox-example-finder-pref-9k2-hard-disks-ljj", Class: "font-normal"}) {
					Hard disks
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-finder-pref-9k2-external-disks-1yg"})
				@field.Label(field.LabelProps{For: "checkbox-example-finder-pref-9k2-external-disks-1yg", Class: "font-normal"}) {
					External disks
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-finder-pref-9k2-cds-dvds-fzt"})
				@field.Label(field.LabelProps{For: "checkbox-example-finder-pref-9k2-cds-dvds-fzt", Class: "font-normal"}) {
					CDs, DVDs, and iPods
				}
			}
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "checkbox-example-finder-pref-9k2-connected-servers-6l2"})
				@field.Label(field.LabelProps{For: "checkbox-example-finder-pref-9k2-connected-servers-6l2", Class: "font-normal"}) {
					Connected servers
				}
			}
		}
	}
}
