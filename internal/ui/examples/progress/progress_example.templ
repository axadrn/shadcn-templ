package progress

import (
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/item"
	"github.com/axadrn/shadcn-templ/v2/components/progress"
	"github.com/axadrn/shadcn-templ/v2/components/slider"
)

templ progressExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ProgressExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@progressExampleValues()
			@progressExampleWithLabel()
			@progressExampleControlled()
			@progressExampleFileUploadList()
		</div>
	</div>
}

templ progressExampleValues() {
	@progressExampleSection("Progress Bar") {
		<div class="flex w-full flex-col gap-4">
			@progress.Progress(progress.Props{Value: 0})
			@progress.Progress(progress.Props{Value: 25, Class: "w-full"})
			@progress.Progress(progress.Props{Value: 50})
			@progress.Progress(progress.Props{Value: 75})
			@progress.Progress(progress.Props{Value: 100})
		</div>
	}
}

templ progressExampleWithLabel() {
	@progressExampleSection("With Label") {
		@progress.Progress(progress.Props{Value: 56}) {
			@progress.Label() {
				Upload progress
			}
			@progress.Value()
		}
	}
}

// The slider drives the progress bar.
templ progressExampleControlled() {
	@progressExampleSection("Controlled") {
		<div class="flex w-full flex-col gap-4">
			@progress.Progress(progress.Props{Value: 50, Class: "w-full"})
			@slider.Slider(slider.Props{
				Value: []float64{50},
				Min:   0,
				Max:   100,
				Step:  1,
			})
		</div>
		@progressControlledState()
	}
}

type progressExampleFile struct {
	Name          string
	Progress      int
	TimeRemaining string
}

var progressExampleFiles = []progressExampleFile{
	{"document.pdf", 45, "2m 30s"},
	{"presentation.pptx", 78, "45s"},
	{"spreadsheet.xlsx", 12, "5m 12s"},
	{"image.jpg", 100, "Complete"},
}

templ progressExampleFileUploadList() {
	@progressExampleSection("File Upload List") {
		@item.Group() {
			for _, file := range progressExampleFiles {
				@item.Item(item.Props{Size: item.SizeXs, Class: "px-0"}) {
					@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
						@icon.File(icon.Props{Class: "size-5"})
					}
					@item.Content(item.ContentProps{Class: "inline-block truncate"}) {
						@item.Title(item.TitleProps{Class: "inline"}) {
							{ file.Name }
						}
					}
					@item.Content() {
						@progress.Progress(progress.Props{Value: file.Progress, Class: "w-32"})
					}
					@item.Actions(item.ActionsProps{Class: "w-16 justify-end"}) {
						<span class="text-sm text-muted-foreground">{ file.TimeRemaining }</span>
					}
				}
			}
		}
	}
}
