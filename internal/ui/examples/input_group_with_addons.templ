package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
)

templ InputGroupWithAddons() {
	@field.Group() {
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-icon-left-05"}) {
				Addon (inline-start)
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-left-05"})
				@inputgroup.Addon() {
					@icon.Search(icon.Props{Class: "text-muted-foreground"})
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-icon-right-07"}) {
				Addon (inline-end)
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-right-07"})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					@icon.EyeOff()
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-icon-both-09"}) {
				Addon (inline-start and inline-end)
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-both-09"})
				@inputgroup.Addon() {
					@icon.Mic(icon.Props{Class: "text-muted-foreground"})
				}
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					@icon.Radio(icon.Props{Class: "animate-pulse text-red-500"})
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-addon-20"}) {
				Addon (block-start)
			}
			@inputgroup.InputGroup(inputgroup.Props{Class: "h-auto"}) {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-addon-20"})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockStart}) {
					@inputgroup.Text() {
						First Name
					}
					@icon.Info(icon.Props{Class: "ml-auto text-muted-foreground"})
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-addon-21"}) {
				Addon (block-end)
			}
			@inputgroup.InputGroup(inputgroup.Props{Class: "h-auto"}) {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-addon-21"})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
					@inputgroup.Text() {
						20/240 characters
					}
					@icon.Info(icon.Props{Class: "ml-auto text-muted-foreground"})
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-icon-both-10"}) {
				Multiple Icons
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-both-10"})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					@icon.Star()
					@inputgroup.Button(inputgroup.ButtonProps{Size: inputgroup.ButtonSizeIconXs}) {
						@icon.Copy()
					}
				}
				@inputgroup.Addon() {
					@icon.Radio(icon.Props{Class: "animate-pulse text-red-500"})
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-description-10"}) {
				Description
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-description-10"})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					@icon.Info()
				}
			}
			@field.Description() {
				This is a description of the input group.
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "input-label-10"}) {
				Label
			}
			@inputgroup.InputGroup() {
				@inputgroup.Addon() {
					@field.Label(field.LabelProps{For: "input-label-10"}) {
						Label
					}
				}
				@inputgroup.Input(inputgroup.InputProps{ID: "input-label-10"})
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-optional-12", Attributes: templ.Attributes{"aria-label": "Optional"}})
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					@inputgroup.Text() {
						(optional)
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// onClick: the example calls sonner's toast, which shadcn-templ does
			// not port; the toast manager shows the same message.
			const demo = document.currentScript.previousElementSibling;
			demo.querySelector('[data-slot="input-group-addon"] [data-slot="button"]').addEventListener("click", () =>
				window.templ.toast.add({ description: "Copied to clipboard" }),
			);
		})();
	</script>
}
