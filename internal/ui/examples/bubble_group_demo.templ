package examples

import "github.com/axadrn/shadcn-templ/v2/components/bubble"

templ BubbleGroupDemo() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				Can you tell me what's the issue?
			}
		}
		@bubble.Group() {
			@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
				@bubble.Content() {
					You tell me!
				}
			}
			@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
				@bubble.Content() {
					It worked yesterday. You broke it!
				}
			}
			@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
				@bubble.Content() {
					Find the bug and fix it.
				}
				@bubble.Reactions(bubble.ReactionsProps{Align: bubble.AlignStart, Attributes: templ.Attributes{"aria-label": "Reactions: eyes"}}) {
					<span>👀</span>
				}
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
			@bubble.Content() {
				Want me to diff yesterday's you against today's you?
				It's a bit embarrassing.
			}
		}
	</div>
}
