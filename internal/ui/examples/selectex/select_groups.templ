package selectex

import (
	"slices"

	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
)

var selectGroupFruits = []selectcomp.ItemData{
	{Label: "Apple", Value: "apple"},
	{Label: "Banana", Value: "banana"},
	{Label: "Blueberry", Value: "blueberry"},
}

var selectGroupVegetables = []selectcomp.ItemData{
	{Label: "Carrot", Value: "carrot"},
	{Label: "Broccoli", Value: "broccoli"},
	{Label: "Spinach", Value: "spinach"},
}

var selectGroupItems = slices.Concat(
	[]selectcomp.ItemData{{Label: "Select a fruit", Value: ""}},
	selectGroupFruits,
	selectGroupVegetables,
)

templ SelectGroupsExample() {
	@selectcomp.Select(selectcomp.Props{Items: selectGroupItems}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full max-w-48"}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				@selectcomp.Label() {
					Fruits
				}
				for _, item := range selectGroupFruits {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
			@selectcomp.Separator()
			@selectcomp.Group() {
				@selectcomp.Label() {
					Vegetables
				}
				for _, item := range selectGroupVegetables {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
		}
	}
}
