package selectex

import (
	"slices"

	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
)

var selectTimezonesNorthAmerica = []selectcomp.ItemData{
	{Label: "Eastern Standard Time", Value: "est"},
	{Label: "Central Standard Time", Value: "cst"},
	{Label: "Mountain Standard Time", Value: "mst"},
	{Label: "Pacific Standard Time", Value: "pst"},
	{Label: "Alaska Standard Time", Value: "akst"},
	{Label: "Hawaii Standard Time", Value: "hst"},
}

var selectTimezonesEuropeAfrica = []selectcomp.ItemData{
	{Label: "Greenwich Mean Time", Value: "gmt"},
	{Label: "Central European Time", Value: "cet"},
	{Label: "Eastern European Time", Value: "eet"},
	{Label: "Western European Summer Time", Value: "west"},
	{Label: "Central Africa Time", Value: "cat"},
	{Label: "East Africa Time", Value: "eat"},
}

var selectTimezonesAsia = []selectcomp.ItemData{
	{Label: "Moscow Time", Value: "msk"},
	{Label: "India Standard Time", Value: "ist"},
	{Label: "China Standard Time", Value: "cst_china"},
	{Label: "Japan Standard Time", Value: "jst"},
	{Label: "Korea Standard Time", Value: "kst"},
	{Label: "Indonesia Central Standard Time", Value: "ist_indonesia"},
}

var selectTimezonesAustraliaPacific = []selectcomp.ItemData{
	{Label: "Australian Western Standard Time", Value: "awst"},
	{Label: "Australian Central Standard Time", Value: "acst"},
	{Label: "Australian Eastern Standard Time", Value: "aest"},
	{Label: "New Zealand Standard Time", Value: "nzst"},
	{Label: "Fiji Time", Value: "fjt"},
}

var selectTimezonesSouthAmerica = []selectcomp.ItemData{
	{Label: "Argentina Time", Value: "art"},
	{Label: "Bolivia Time", Value: "bot"},
	{Label: "Brasilia Time", Value: "brt"},
	{Label: "Chile Standard Time", Value: "clt"},
}

var selectTimezones = slices.Concat(
	[]selectcomp.ItemData{{Label: "Select a timezone", Value: ""}},
	selectTimezonesNorthAmerica,
	selectTimezonesEuropeAfrica,
	selectTimezonesAsia,
	selectTimezonesAustraliaPacific,
	selectTimezonesSouthAmerica,
)

templ SelectScrollable() {
	@selectcomp.Select(selectcomp.Props{Items: selectTimezones}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full max-w-64"}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				@selectcomp.Label() {
					North America
				}
				for _, item := range selectTimezonesNorthAmerica {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
			@selectcomp.Group() {
				@selectcomp.Label() {
					Europe & Africa
				}
				for _, item := range selectTimezonesEuropeAfrica {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
			@selectcomp.Group() {
				@selectcomp.Label() {
					Asia
				}
				for _, item := range selectTimezonesAsia {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
			@selectcomp.Group() {
				@selectcomp.Label() {
					Australia & Pacific
				}
				for _, item := range selectTimezonesAustraliaPacific {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
			@selectcomp.Group() {
				@selectcomp.Label() {
					South America
				}
				for _, item := range selectTimezonesSouthAmerica {
					@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
						{ item.Label.(string) }
					}
				}
			}
		}
	}
}
