package messagescroller

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/hovercard"
	"github.com/axadrn/shadcn-templ/v2/components/messagescroller"
)

var msVisibilityMessages = []msMessage{
	{ID: "vis-brief", Role: "user", Text: "Review the incident handoff and tell me what to read first."},
	{ID: "msg-1", Role: "assistant", Text: "Start with the summary and the impact section. The regression affected the upload queue, but the recovery path completed for every queued job."},
	{ID: "vis-impact", Role: "user", Text: "What was the customer impact?"},
	{ID: "msg-2", Role: "assistant", Text: "Impact was limited to delayed processing.\n\nNo records were dropped, and the reconciliation worker confirmed each retry batch. Support saw confusion from two customers, but there were no checkout or billing errors."},
	{ID: "vis-actions", Role: "user", Text: "What actions are open?"},
	{ID: "msg-3", Role: "assistant", Text: "Keep the retry window enabled until the next deploy, then add a queue-depth alert as the long-term fix.\n\nThe alert should fire on sustained queue growth, not a single short spike."},
	{ID: "vis-checklist", Role: "user", Text: "Give me the follow-up checklist."},
	{ID: "msg-4", Role: "assistant", Text: "After that, compare the queue recovery graph with the deploy timeline so the handoff shows exactly when processing returned to baseline. That makes it easier for support and engineering to answer the same customer questions without re-reading the whole incident thread.\n\nI would also add a short owner note beside each follow-up item. The checklist is small, but ownership keeps the retry-window decision, alert tuning, and support macro from drifting into separate follow-up conversations.\n\nKeep the retry window enabled until the next deploy, then add a queue-depth alert as the long-term fix.\n\nThe alert should fire on sustained queue growth, not a single short spike."},
}

templ MessageScrollerVisibility() {
	@messagescroller.Provider(messagescroller.ProviderProps{ScrollMargin: 12}) {
		<div class="relative flex flex-col gap-4">
			<div class="relative mx-auto w-full max-w-sm">
				@card.Card(card.Props{Class: "h-140 w-full gap-0"}) {
					@card.Header(card.HeaderProps{Class: "gap-1 border-b"}) {
						@card.Title() {
							Transcript Outline
						}
						@card.Description() {
							Track the current anchored turn.
						}
					}
					@card.Content(card.ContentProps{Class: "flex-1 overflow-hidden p-0"}) {
						@msTranscript(msVisibilityMessages)
					}
				}
				<div class="absolute top-1/2 -right-12 -translate-y-1/2">
					@hovercard.HoverCard() {
						<button
							type="button"
							aria-label="Open transcript outline"
							class="flex h-9 w-9 flex-col items-center justify-center gap-1 rounded-md transition-colors outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
							{ hovercard.Trigger(ctx)... }
						>
							for range msUserMessages(msVisibilityMessages) {
								<span data-current="false" class="h-0.5 w-4 rounded-full bg-muted-foreground/40 data-[current=true]:bg-foreground"></span>
							}
						</button>
						@hovercard.Content(hovercard.ContentProps{
							Align:      hovercard.AlignCenter,
							Side:       hovercard.SideLeft,
							SideOffset: -28,
							Class:      "flex w-64 flex-col gap-1 rounded-2xl p-1",
						}) {
							for _, m := range msUserMessages(msVisibilityMessages) {
								<button
									type="button"
									class="flex min-h-7 items-center rounded-xl px-2 py-1.5 text-left text-sm transition-colors outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground aria-current:bg-accent aria-current:text-accent-foreground"
								>
									<span class="line-clamp-1 min-w-0">{ msTrimmed(m.Text) }</span>
								</button>
							}
						}
					}
				</div>
			</div>
			<div class="mx-auto max-w-sm px-0.5 text-center text-xs text-muted-foreground">
				Open the outline to jump between anchored turns as you read.
			</div>
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			(() => {
				// TranscriptOutline: useMessageScrollerVisibility's currentAnchorId
				// marks the outline, useMessageScroller's scrollToMessage jumps.
				// The outline marks and the jump buttons follow ids in order; they
				// are taken before the hover card moves its popup out.
				const demo = document.currentScript.previousElementSibling;
				const ids = {{ msIDs(msUserMessages(msVisibilityMessages)) }};
				const root = demo.querySelector('[data-slot="message-scroller"]');
				const marks = [...demo.querySelectorAll('[aria-label="Open transcript outline"] > span')];
				const jumps = [...demo.querySelectorAll('[data-slot="hover-card-content"] button')];
				const paint = ({ currentAnchorId }) => {
					marks.forEach((el, i) => el.setAttribute("data-current", String(ids[i] === currentAnchorId)));
					jumps.forEach((el, i) => {
						if (ids[i] === currentAnchorId) el.setAttribute("aria-current", "location");
						else el.removeAttribute("aria-current");
					});
				};
				jumps.forEach((el, i) => el.addEventListener("click", () => window.templ.messageScroller.scrollToMessage(root, ids[i], { align: "start", behavior: "smooth" })));
				const init = () => {
					paint(window.templ.messageScroller.visibility(root));
					window.templ.messageScroller.onVisibilityChange(root, paint);
				};
				if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
				else init();
			})();
		</script>
	}
}
