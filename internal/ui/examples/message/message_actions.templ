package message

import (
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/message"
)

templ MessageActions() {
	<div class="flex w-full max-w-sm flex-col gap-8 py-12">
		@message.Message() {
			@message.Content() {
				@bubble.Bubble(bubble.Props{Variant: bubble.VariantMuted}) {
					@bubble.Content() {
						The install failure is coming from the workspace package.
					}
				}
				@message.Footer() {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"aria-label": "Copy", "title": "Copy"}}) {
						@icon.Copy()
					}
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"aria-label": "Like", "title": "Like"}}) {
						@icon.ThumbsUp()
					}
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"aria-label": "Dislike", "title": "Dislike"}}) {
						@icon.ThumbsDown()
					}
				}
			}
		}
		@message.Message(message.Props{Align: message.AlignEnd}) {
			@message.Content() {
				@bubble.Bubble() {
					@bubble.Content() {
						Okay drop me a link. Taking a look...
					}
				}
				@message.Footer(message.FooterProps{Class: "gap-2"}) {
					<span class="font-normal text-destructive">Failed to send</span>
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconXs, Attributes: templ.Attributes{"title": "Retry", "aria-label": "Retry"}}) {
						@icon.RefreshCcw()
					}
				}
			}
		}
	</div>
}
