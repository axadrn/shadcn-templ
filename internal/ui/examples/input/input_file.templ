package input

import (
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/input"
)

templ InputFile() {
	@field.Field() {
		@field.Label(field.LabelProps{For: "picture"}) {
			Picture
		}
		@input.Input(input.Props{
			ID:   "picture",
			Type: "file",
		})
		@field.Description() {
			Select a picture to upload.
		}
	}
}
