package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"

	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/collapsible"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/item"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

// Full-page icon-collapsible sidebar with team switcher, collapsible nav,
// and a user footer menu.

var sidebarIconExampleUser = struct {
	Name   string
	Email  string
	Avatar string
}{
	Name:   "Axel Adrian",
	Email:  "m@example.com",
	Avatar: "https://github.com/axadrn.png",
}

type sidebarIconExampleTeam struct {
	Name string
	Plan string
}

var sidebarIconExampleTeams = []sidebarIconExampleTeam{
	{Name: "Acme Inc", Plan: "Enterprise"},
	{Name: "Acme Corp.", Plan: "Startup"},
	{Name: "Evil Corp.", Plan: "Free"},
}

type sidebarIconExampleNavItem struct {
	Title    string
	URL      string
	Icon     func(...icon.Props) templ.Component
	IsActive bool
	Items    []sidebarExampleNavItem
}

var sidebarIconExampleNavMain = []sidebarIconExampleNavItem{
	{
		Title: "Playground", URL: "#", Icon: icon.SquareTerminal, IsActive: true,
		Items: []sidebarExampleNavItem{
			{Title: "History", URL: "#"},
			{Title: "Starred", URL: "#"},
			{Title: "Settings", URL: "#"},
		},
	},
	{
		Title: "Models", URL: "#", Icon: icon.Bot,
		Items: []sidebarExampleNavItem{
			{Title: "Genesis", URL: "#"},
			{Title: "Explorer", URL: "#"},
			{Title: "Quantum", URL: "#"},
		},
	},
	{
		Title: "Documentation", URL: "#", Icon: icon.BookOpen,
		Items: []sidebarExampleNavItem{
			{Title: "Introduction", URL: "#"},
			{Title: "Get Started", URL: "#"},
			{Title: "Tutorials", URL: "#"},
			{Title: "Changelog", URL: "#"},
		},
	},
	{
		Title: "Settings", URL: "#", Icon: icon.Settings2,
		Items: []sidebarExampleNavItem{
			{Title: "General", URL: "#"},
			{Title: "Team", URL: "#"},
			{Title: "Billing", URL: "#"},
			{Title: "Limits", URL: "#"},
		},
	},
}

type sidebarIconExampleProject struct {
	Name string
	URL  string
	Icon func(...icon.Props) templ.Component
}

var sidebarIconExampleProjects = []sidebarIconExampleProject{
	{Name: "Design Engineering", URL: "#", Icon: icon.Frame},
	{Name: "Sales & Marketing", URL: "#", Icon: icon.ChartPie},
	{Name: "Travel", URL: "#", Icon: icon.Map},
}

templ sidebarIconExampleTeamSwitcher() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "sidebar-icon-example-team-menu"}) {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-open:bg-sidebar-accent data-open:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					// Button size="icon-sm" render={<span />} nativeButton={false}.
					<span data-slot="button" role="button" tabindex="0" class={ button.Variants(button.Props{Size: button.SizeIconSm, Class: "size-8"}) }>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
							<rect width="256" height="256" fill="none"></rect>
							<line x1="208" y1="128" x2="128" y2="208" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></line>
							<line x1="192" y1="40" x2="40" y2="192" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></line>
						</svg>
					</span>
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-medium">{ sidebarIconExampleTeams[0].Name }</span>
						<span class="truncate text-xs">{ sidebarIconExampleTeams[0].Plan }</span>
					</div>
					@icon.ChevronsUpDown()
				}
				@dropdownmenu.Content() {
					@dropdownmenu.Group() {
						@dropdownmenu.Label() {
							Teams
						}
					}
					@dropdownmenu.Group() {
						for _, team := range sidebarIconExampleTeams {
							@dropdownmenu.Item() {
								{ team.Name }
							}
						}
					}
				}
			}
		}
	}
}

templ sidebarIconExampleNavMainGroup() {
	@sidebar.Group() {
		@sidebar.GroupLabel() {
			Platform
		}
		@sidebar.Menu() {
			for _, navItem := range sidebarIconExampleNavMain {
				@collapsible.Collapsible(collapsible.Props{
					DefaultOpen: navItem.IsActive,
					Class:       "group/collapsible",
				}) {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Tooltip:    navItem.Title,
							Attributes: collapsible.Trigger(ctx),
						}) {
							@navItem.Icon()
							<span>{ navItem.Title }</span>
							@icon.ChevronRight(icon.Props{Class: "ml-auto transition-transform duration-100 group-data-open/collapsible:rotate-90"})
						}
						@collapsible.Content() {
							@sidebar.MenuSub() {
								for _, subItem := range navItem.Items {
									@sidebar.MenuSubItem() {
										@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{Href: subItem.URL}) {
											{ subItem.Title }
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ sidebarIconExampleNavProjects() {
	@sidebar.Group(sidebar.GroupProps{Class: "group-data-[collapsible=icon]:hidden"}) {
		@sidebar.GroupLabel() {
			Projects
		}
		@sidebar.Menu() {
			for _, project := range sidebarIconExampleProjects {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{Href: project.URL}) {
						@project.Icon()
						{ project.Name }
					}
				}
			}
		}
	}
}

templ sidebarIconExampleNavUser() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					@avatar.Avatar() {
						@avatar.Image(avatar.ImageProps{Src: sidebarIconExampleUser.Avatar, Alt: sidebarIconExampleUser.Name})
						@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
							AA
						}
					}
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-medium">{ sidebarIconExampleUser.Name }</span>
						<span class="truncate text-xs">{ sidebarIconExampleUser.Email }</span>
					</div>
					@icon.ChevronsUpDown()
				}
				@dropdownmenu.Content() {
					@dropdownmenu.Group() {
						@dropdownmenu.Label() {
							@item.Item(item.Props{Size: item.SizeXs}) {
								@item.Media() {
									@avatar.Avatar() {
										@avatar.Image(avatar.ImageProps{Src: sidebarIconExampleUser.Avatar, Alt: sidebarIconExampleUser.Name})
										@avatar.Fallback() {
											AA
										}
									}
								}
								@item.Content() {
									@item.Title() {
										{ sidebarIconExampleUser.Name }
									}
									@item.Description() {
										{ sidebarIconExampleUser.Email }
									}
								}
							}
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							Account
						}
						@dropdownmenu.Item() {
							Billing
						}
						@dropdownmenu.Item() {
							Settings
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							Log out
						}
					}
				}
			}
		}
	}
}

templ SidebarIconExample() {
	@sidebar.Provider() {
		@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
			@sidebar.Header() {
				@sidebarIconExampleTeamSwitcher()
			}
			@sidebar.Content() {
				@sidebarIconExampleNavMainGroup()
				@sidebarIconExampleNavProjects()
			}
			@sidebar.Footer() {
				@sidebarIconExampleNavUser()
			}
			@sidebar.Rail()
		}
		@sidebar.Inset() {
			<header class="flex h-16 shrink-0 items-center gap-2 border-b transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-12">
				<div class="flex items-center gap-2 px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
				</div>
			</header>
			<div class="flex flex-1 flex-col gap-4 p-4 pt-0">
				<div class="grid auto-rows-min gap-4 md:grid-cols-3">
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
				</div>
				<div class="min-h-[100vh] flex-1 rounded-xl bg-muted/50 md:min-h-min"></div>
			</div>
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The activeTeam state: an item's onClick sets it, the trigger renders
		// it.
		(() => {
			const teams = {{ sidebarIconExampleTeams }};
			const menu = document.getElementById("sidebar-icon-example-team-menu");
			const [name, plan] = document.getElementById("sidebar-icon-example-team-menu-trigger").querySelectorAll(":scope > div > span");
			menu.querySelectorAll('[data-slot="dropdown-menu-item"]').forEach((item, i) => {
				item.addEventListener("click", () => {
					name.textContent = teams[i].Name;
					plan.textContent = teams[i].Plan;
				});
			});
		})();
	</script>
}
