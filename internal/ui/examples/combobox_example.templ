templ comboboxExampleWithGroups() {
	@comboboxExampleSection("With Groups", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Select a timezone"})
			@combobox.Content() {
				@combobox.Empty() {
					No timezones found.
				}
				@combobox.List() {
					for _, group := range comboboxExampleTimezones {
						@combobox.Group() {
							@combobox.Label() {
								{ group.Value }
							}
							for _, tz := range group.Items {
								@combobox.Item(combobox.ItemProps{Value: tz.Value, Label: tz.Label}) {
									{ tz.Label }
								}
							}
						}
					}
				}
			}
		}
	}
}

