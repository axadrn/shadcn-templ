templ comboboxExampleLargeList() {
	@comboboxExampleSection("Large List (100 items)", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Search from 100 items"})
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					for i := 1; i <= 100; i++ {
						@combobox.Item(combobox.ItemProps{Value: fmt.Sprintf("Item %d", i)}) {
							{ fmt.Sprintf("Item %d", i) }
						}
					}
				}
			}
		}
	}
}

