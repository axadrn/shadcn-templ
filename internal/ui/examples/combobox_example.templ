package examples

import (
	"fmt"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/combobox"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/item"
	selectcomp "github.com/axadrn/shadcn-templ/v2/components/select"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ comboboxExampleSection(title string, containerClass string) {
	<div data-slot="example" class={ utils.CN("mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass) }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ ComboboxExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@comboboxExampleBasic()
			@comboboxExampleDisabled()
			@comboboxExampleSides()
			@comboboxExampleInvalid()
			@comboboxExampleWithClear()
			@comboboxExampleAutoHighlight()
			@comboboxExampleWithGroups()
			@comboboxExampleWithGroupsAndSeparator()
			@comboboxExampleLargeList()
			@comboboxExampleInputAddon()
			@comboboxExampleInPopup()
			@comboboxExampleWithForm()
			@comboboxExampleMultiple()
			@comboboxExampleMultipleDisabled()
			@comboboxExampleMultipleInvalid()
			@comboboxExampleMultipleNoRemove()
			@comboboxExampleWithCustomItems()
			@comboboxExampleInDialog()
			@comboboxExampleWithOtherInputs()
			@comboboxExampleDisabledItems()
		</div>
	</div>
}

type comboboxExampleFramework struct {
	Value string
	Label string
}

var comboboxExampleFrameworks = []comboboxExampleFramework{
	{"templ", "templ"},
	{"htmx", "htmx"},
	{"gin", "Gin"},
	{"echo", "Echo"},
	{"chi", "Chi"},
}

type comboboxExampleTimezoneGroup struct {
	Value string
	Items []comboboxExampleFramework
}

var comboboxExampleTimezones = []comboboxExampleTimezoneGroup{
	{"Americas", []comboboxExampleFramework{
		{"new-york", "(GMT-5) New York"},
		{"los-angeles", "(GMT-8) Los Angeles"},
		{"chicago", "(GMT-6) Chicago"},
		{"toronto", "(GMT-5) Toronto"},
		{"vancouver", "(GMT-8) Vancouver"},
		{"sao-paulo", "(GMT-3) São Paulo"},
	}},
	{"Europe", []comboboxExampleFramework{
		{"london", "(GMT+0) London"},
		{"paris", "(GMT+1) Paris"},
		{"berlin", "(GMT+1) Berlin"},
		{"rome", "(GMT+1) Rome"},
		{"madrid", "(GMT+1) Madrid"},
		{"amsterdam", "(GMT+1) Amsterdam"},
	}},
	{"Asia/Pacific", []comboboxExampleFramework{
		{"tokyo", "(GMT+9) Tokyo"},
		{"shanghai", "(GMT+8) Shanghai"},
		{"singapore", "(GMT+8) Singapore"},
		{"dubai", "(GMT+4) Dubai"},
		{"sydney", "(GMT+11) Sydney"},
		{"seoul", "(GMT+9) Seoul"},
	}},
}

templ comboboxExampleFrameworkItems() {
	for _, fw := range comboboxExampleFrameworks {
		@combobox.Item(combobox.ItemProps{Value: fw.Value, Label: fw.Label}) {
			{ fw.Label }
		}
	}
}

templ comboboxExampleBasic() {
	@comboboxExampleSection("Basic", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Select a framework"})
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					@comboboxExampleFrameworkItems()
				}
			}
		}
	}
}

templ comboboxExampleDisabled() {
	@comboboxExampleSection("Disabled", "") {
		@combobox.Combobox(combobox.Props{Disabled: true}) {
			@combobox.Input(combobox.InputProps{Placeholder: "Select a framework"})
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					@comboboxExampleFrameworkItems()
				}
			}
		}
	}
}

templ comboboxExampleSides() {
	@comboboxExampleSection("Sides", "col-span-2") {
		<div class="flex flex-wrap justify-center gap-2">
			@comboboxExampleSide("inline start", combobox.SideLeft)
			@comboboxExampleSide("left", combobox.SideLeft)
			@comboboxExampleSide("top", combobox.SideTop)
			@comboboxExampleSide("bottom", combobox.SideBottom)
			@comboboxExampleSide("right", combobox.SideRight)
			@comboboxExampleSide("inline end", combobox.SideRight)
		</div>
	}
}

templ comboboxExampleSide(placeholder string, side combobox.Side) {
	@combobox.Combobox() {
		@combobox.Input(combobox.InputProps{
			Placeholder: placeholder,
			Class:       "w-32 **:data-[slot=input-group-control]:capitalize",
		})
		@combobox.Content(combobox.ContentProps{Side: side}) {
			@combobox.Empty() {
				No items found.
			}
			@combobox.List() {
				@comboboxExampleFrameworkItems()
			}
		}
	}
}

templ comboboxExampleInvalid() {
	@comboboxExampleSection("Invalid", "") {
		<div class="flex flex-col gap-4">
			@combobox.Combobox() {
				@combobox.Input(combobox.InputProps{
					Placeholder: "Select a framework",
					Attributes:  templ.Attributes{"aria-invalid": "true"},
				})
				@combobox.Content() {
					@combobox.Empty() {
						No items found.
					}
					@combobox.List() {
						@comboboxExampleFrameworkItems()
					}
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "combobox-example-framework-invalid"}) {
					Framework
				}
				@combobox.Combobox() {
					@combobox.Input(combobox.InputProps{
						ID:          "combobox-example-framework-invalid",
						Placeholder: "Select a framework",
						Attributes:  templ.Attributes{"aria-invalid": "true"},
					})
					@combobox.Content() {
						@combobox.Empty() {
							No items found.
						}
						@combobox.List() {
							@comboboxExampleFrameworkItems()
						}
					}
				}
				@field.Description() {
					Please select a valid framework.
				}
				@field.Error() {
					This field is required.
				}
			}
		</div>
	}
}

