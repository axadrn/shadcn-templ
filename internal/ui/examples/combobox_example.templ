								@combobox.Item(combobox.ItemProps{Value: tz.Value, Label: tz.Label}) {
									{ tz.Label }
								}
							}
						}
					}
				}
			}
		}
	}
}

templ comboboxExampleInPopup() {
	@comboboxExampleSection("Combobox in Popup", "") {
		@combobox.Combobox() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "w-64 justify-between font-normal",
				Attributes: combobox.Trigger(ctx),
			}) {
				@combobox.Value(combobox.ValueProps{Placeholder: "Select country"})
				@icon.ChevronDown(icon.Props{Class: "pointer-events-none size-4 text-muted-foreground"})
			}
			@combobox.Content() {
				@combobox.Input(combobox.InputProps{
					Placeholder: "Search",
					HideTrigger: true,
				})
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					for _, country := range comboboxCountries {
						@combobox.Item(combobox.ItemProps{Value: country.Value, Label: country.Label}) {
							{ country.Label }
						}
					}
				}
			}
		}
	}
}

templ comboboxExampleWithForm() {
	@comboboxExampleSection("Form with Combobox", "") {
		@card.Card(card.Props{Class: "w-full max-w-sm", Size: card.SizeSm}) {
			@card.Content() {
				<form id="combobox-example-form" class="w-full">
					@field.Group() {
						@field.Field() {
							@field.Label(field.LabelProps{For: "combobox-example-framework"}) {
								Framework
							}
							@combobox.Combobox(combobox.Props{Name: "framework"}) {
								@combobox.Input(combobox.InputProps{
									ID:          "combobox-example-framework",
									Placeholder: "Select a framework",
									Attributes:  templ.Attributes{"required": true},
								})
								@combobox.Content() {
									@combobox.Empty() {
										No items found.
									}
									@combobox.List() {
										@comboboxExampleFrameworkItems()
									}
								}
							}
						}
					}
				</form>
			}
			@card.Footer() {
				@button.Button(button.Props{Type: button.TypeSubmit, Form: "combobox-example-form"}) {
					Submit
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the demo's onSubmit toast.
		document.addEventListener("submit", (e) => {
			if (e.target.id !== "combobox-example-form") return;
			e.preventDefault();
			const framework = new FormData(e.target).get("framework");
			window.templ.toast.add({ title: `You selected ${framework} as your framework.` });
		});
	</script>
}

templ comboboxExampleMultiple() {
	@comboboxExampleSection("Combobox Multiple", "") {
		@combobox.Combobox(combobox.Props{
			Multiple:      true,
			AutoHighlight: true,
			DefaultValues: []string{"templ"},
		}) {
			@combobox.Chips() {
				@combobox.Value()
				@combobox.ChipsInput()
			}
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					@comboboxExampleFrameworkItems()
				}
			}
		}
	}
}

