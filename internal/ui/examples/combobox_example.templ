templ comboboxExampleMultipleInvalid() {
	@comboboxExampleSection("Combobox Multiple Invalid", "") {
		<div class="flex flex-col gap-4">
			@combobox.Combobox(combobox.Props{
				Multiple:      true,
				AutoHighlight: true,
				DefaultValues: []string{"templ", "htmx"},
			}) {
				@combobox.Chips() {
					@combobox.Value()
					@combobox.ChipsInput(combobox.ChipsInputProps{Attributes: templ.Attributes{"aria-invalid": "true"}})
				}
				@combobox.Content() {
					@combobox.Empty() {
						No items found.
					}
					@combobox.List() {
						@comboboxExampleFrameworkItems()
					}
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "combobox-example-multiple-invalid"}) {
					Frameworks
				}
				@combobox.Combobox(combobox.Props{
					Multiple:      true,
					AutoHighlight: true,
					DefaultValues: []string{"templ", "htmx", "gin"},
				}) {
					@combobox.Chips() {
						@combobox.Value()
						@combobox.ChipsInput(combobox.ChipsInputProps{
							ID:         "combobox-example-multiple-invalid",
							Attributes: templ.Attributes{"aria-invalid": "true"},
						})
					}
					@combobox.Content() {
						@combobox.Empty() {
							No items found.
						}
						@combobox.List() {
							@comboboxExampleFrameworkItems()
						}
					}
				}
				@field.Description() {
					Please select at least one framework.
				}
				@field.Error() {
					This field is required.
				}
			}
		</div>
	}
}

templ comboboxExampleMultipleNoRemove() {
	@comboboxExampleSection("Combobox Multiple (No Remove)", "") {
		@combobox.Combobox(combobox.Props{
			Multiple:      true,
			AutoHighlight: true,
			DefaultValues: []string{"templ", "htmx"},
		}) {
			@combobox.Chips(combobox.ChipsProps{Class: "[&_[data-slot=combobox-chip-remove]]:hidden"}) {
				@combobox.Value()
				@combobox.ChipsInput()
			}
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					@comboboxExampleFrameworkItems()
				}
			}
		}
	}
}

templ comboboxExampleWithCustomItems() {
	@comboboxExampleSection("With Custom Item Rendering", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Search countries..."})
			@combobox.Content() {
				@combobox.Empty() {
					No countries found.
				}
				@combobox.List() {
					for _, country := range comboboxCountries {
						@combobox.Item(combobox.ItemProps{Value: country.Value, Label: country.Label}) {
							@item.Item(item.Props{Size: item.SizeXs, Class: "p-0"}) {
								@item.Content() {
									@item.Title(item.TitleProps{Class: "whitespace-nowrap"}) {
										{ country.Label }
									}
									@item.Description() {
										{ country.Continent } ({ country.Code })
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ comboboxExampleInDialog() {
	@comboboxExampleSection("Combobox in Dialog", "") {
		@dialog.Dialog() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.Trigger(ctx),
			}) {
				Open Dialog
			}
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-[425px]"}) {
				@dialog.Header() {
					@dialog.Title() {
						Select Framework
					}
					@dialog.Description() {
						Choose your preferred framework from the list below.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "combobox-example-framework-dialog", Class: "sr-only"}) {
						Framework
					}
					@combobox.Combobox() {
						@combobox.Input(combobox.InputProps{
							ID:          "combobox-example-framework-dialog",
							Placeholder: "Select a framework",
						})
						@combobox.Content() {
							@combobox.Empty() {
								No items found.
							}
							@combobox.List() {
								@comboboxExampleFrameworkItems()
							}
						}
					}
				}
				@dialog.Footer() {
					@button.Button(button.Props{
						Type:       button.TypeButton,
						Variant:    button.VariantOutline,
						Attributes: dialog.Close(ctx),
					}) {
						Cancel
					}
					@button.Button(button.Props{
						Type:       button.TypeButton,
						Attributes: utils.MergeAttributes(dialog.Close(ctx), templ.Attributes{"id": "combobox-example-dialog-confirm"}),
					}) {
						Confirm
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		// The vanilla pendant of the demo's confirm toast.
		document.addEventListener("click", (e) => {
			if (!(e.target instanceof Element) || !e.target.closest("#combobox-example-dialog-confirm")) return;
			window.templ.toast.add({ title: "Framework selected." });
		});
	</script>
}

templ comboboxExampleWithOtherInputs() {
	@comboboxExampleSection("With Other Inputs", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Select a framework", Class: "w-52"})
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					@comboboxExampleFrameworkItems()
				}
			}
		}
		@selectcomp.Select() {
			@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-52"}) {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a framework"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					for _, fw := range comboboxExampleFrameworks {
						@selectcomp.Item(selectcomp.ItemProps{Value: fw.Value, Label: fw.Label}) {
							{ fw.Label }
						}
					}
				}
			}
		}
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Class:   "w-52 justify-between font-normal text-muted-foreground",
		}) {
			Select a framework
			@icon.ChevronDown()
		}
		@input.Input(input.Props{Placeholder: "Select a framework", Class: "w-52"})
		@inputgroup.InputGroup(inputgroup.Props{Class: "w-52"}) {
			@inputgroup.Input(inputgroup.InputProps{Placeholder: "Select a framework"})
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				@icon.ChevronDown()
			}
		}
	}
}

templ comboboxExampleDisabledItems() {
	@comboboxExampleSection("Disabled Items", "") {
		@combobox.Combobox() {
			@combobox.Input(combobox.InputProps{Placeholder: "Select a framework"})
			@combobox.Content() {
				@combobox.Empty() {
					No items found.
				}
				@combobox.List() {
					for _, fw := range comboboxExampleFrameworks {
						@combobox.Item(combobox.ItemProps{
							Value:    fw.Value,
							Label:    fw.Label,
							Disabled: fw.Value == "gin" || fw.Value == "echo",
						}) {
							{ fw.Label }
						}
					}
				}
			}
		}
	}
}
