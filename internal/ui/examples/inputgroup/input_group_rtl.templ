package inputgroup

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/spinner"
)

// The upstream example's Arabic translation, its default language.
templ InputGroupRtl() {
	<div class="grid w-full max-w-sm gap-6">
		@inputgroup.InputGroup(inputgroup.Props{Class: "max-w-xs"}) {
			@inputgroup.Input(inputgroup.InputProps{Placeholder: "بحث..."})
			@inputgroup.Addon() {
				@icon.Search()
			}
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				١٢ نتيجة
			}
		}
		@inputgroup.InputGroup() {
			@inputgroup.Input(inputgroup.InputProps{Placeholder: "جاري البحث..."})
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				@spinner.Spinner()
			}
		}
		@inputgroup.InputGroup() {
			@inputgroup.Input(inputgroup.InputProps{Placeholder: "جاري حفظ التغييرات..."})
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				@inputgroup.Text() {
					جاري الحفظ...
				}
				@spinner.Spinner()
			}
		}
		@field.Group(field.GroupProps{Class: "max-w-sm"}) {
			@field.Field() {
				@field.Label(field.LabelProps{For: "rtl-textarea"}) {
					منطقة النص
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "rtl-textarea",
						Placeholder: "اكتب تعليقًا...",
					})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
						@inputgroup.Text() {
							٠/٢٨٠
						}
						@inputgroup.Button(inputgroup.ButtonProps{Variant: button.VariantDefault, Size: inputgroup.ButtonSizeSm, Class: "ms-auto"}) {
							نشر
						}
					}
				}
				@field.Description() {
					تذييل موضع أسفل منطقة النص.
				}
			}
		}
	</div>
}
