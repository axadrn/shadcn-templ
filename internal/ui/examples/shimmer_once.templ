package examples

import "github.com/axadrn/shadcn-templ/v2/components/button"

templ ShimmerOnce() {
	<div class="flex flex-col items-center gap-4">
		<p class="shimmer text-sm text-muted-foreground shimmer-duration-1100 shimmer-once">
			Generating response&hellip;
		</p>
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
			Replay
		}
	</div>
	@shimmerOnceState()
}

// shimmerOnceState is the example's key state: Replay bumps the key, which
// remounts the text and so restarts its one shot animation.
templ shimmerOnceState() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const demo = document.currentScript.previousElementSibling;
			demo.querySelector('[data-slot="button"]').addEventListener("click", () => {
				const text = demo.querySelector("p");
				text.replaceWith(text.cloneNode(true));
			});
		})();
	</script>
}
