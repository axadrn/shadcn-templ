package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/item"
	"github.com/axadrn/shadcn-templ/v2/components/spinner"
)

// The upstream example's Arabic translation, its default language.
templ SpinnerRtl() {
	<div class="flex w-full max-w-xs flex-col gap-4 [--radius:1rem]" dir="rtl">
		@item.Item(item.Props{Variant: item.VariantMuted, Attributes: templ.Attributes{"dir": "rtl"}}) {
			@item.Media() {
				@spinner.Spinner()
			}
			@item.Content() {
				@item.Title(item.TitleProps{Class: "line-clamp-1"}) {
					جاري معالجة الدفع...
				}
			}
			@item.Content(item.ContentProps{Class: "flex-none justify-end"}) {
				<span class="text-sm tabular-nums">١٠٠.٠٠ دولار</span>
			}
		}
	</div>
}
