package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/buttongroup"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/kbd"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
	"github.com/axadrn/shadcn-templ/v2/components/spinner"
	"github.com/axadrn/shadcn-templ/v2/components/textarea"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
)

templ inputGroupExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ InputGroupExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl min-w-0">
			@inputGroupExampleBasic()
			@inputGroupExampleWithAddons()
			@inputGroupExampleWithButtons()
			@inputGroupExampleWithTooltip()
			@inputGroupExampleWithKbd()
			@inputGroupExampleInCard()
			@inputGroupExampleTextarea()
		</div>
	</div>
}

templ inputGroupExampleBasic() {
	@inputGroupExampleSection("Basic") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-default-01"}) {
					Default (No Input Group)
				}
				@input.Input(input.Props{ID: "input-default-01", Placeholder: "Placeholder"})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-group-02"}) {
					Input Group
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-group-02", Placeholder: "Placeholder"})
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "input-disabled-03"}) {
					Disabled
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{
						ID:          "input-disabled-03",
						Placeholder: "This field is disabled",
						Disabled:    true,
					})
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "input-invalid-04"}) {
					Invalid
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{
						ID:          "input-invalid-04",
						Placeholder: "This field is invalid",
						Attributes:  templ.Attributes{"aria-invalid": "true"},
					})
				}
			}
		}
	}
}

templ inputGroupExampleWithAddons() {
	@inputGroupExampleSection("With Addons") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-icon-left-05"}) {
					Addon (inline-start)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-left-05"})
					@inputgroup.Addon() {
						@icon.Search(icon.Props{Class: "text-muted-foreground"})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-icon-right-07"}) {
					Addon (inline-end)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-right-07"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@icon.EyeOff()
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-icon-both-09"}) {
					Addon (inline-start and inline-end)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-both-09"})
					@inputgroup.Addon() {
						@icon.Mic(icon.Props{Class: "text-muted-foreground"})
					}
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@icon.Radio(icon.Props{Class: "animate-pulse text-red-500"})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-addon-20"}) {
					Addon (block-start)
				}
				@inputgroup.InputGroup(inputgroup.Props{Class: "h-auto"}) {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-addon-20"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockStart}) {
						@inputgroup.Text() {
							First Name
						}
						@icon.Info(icon.Props{Class: "ml-auto text-muted-foreground"})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-addon-21"}) {
					Addon (block-end)
				}
				@inputgroup.InputGroup(inputgroup.Props{Class: "h-auto"}) {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-addon-21"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
						@inputgroup.Text() {
							20/240 characters
						}
						@icon.Info(icon.Props{Class: "ml-auto text-muted-foreground"})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-icon-both-10"}) {
					Multiple Icons
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-icon-both-10"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@icon.Star()
						@inputgroup.Button(inputgroup.ButtonProps{Size: inputgroup.ButtonSizeIconXs}) {
							@icon.Copy()
						}
					}
					@inputgroup.Addon() {
						@icon.Radio(icon.Props{Class: "animate-pulse text-red-500"})
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-description-10"}) {
					Description
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-description-10"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@icon.Info()
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-label-10"}) {
					Label
				}
				@inputgroup.InputGroup() {
					@inputgroup.Addon() {
						@field.Label(field.LabelProps{For: "input-label-10"}) {
							Label
						}
					}
					@inputgroup.Input(inputgroup.InputProps{ID: "input-label-10"})
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{
						ID:         "input-optional-12",
						Attributes: templ.Attributes{"aria-label": "Optional"},
					})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@inputgroup.Text() {
							(optional)
						}
					}
				}
			}
		}
	}
}

templ inputGroupExampleWithButtons() {
	@inputGroupExampleSection("With Buttons") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-button-13"}) {
					Button
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-13"})
					@inputgroup.Addon() {
						@inputgroup.Button() {
							Default
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-14"})
					@inputgroup.Addon() {
						@inputgroup.Button(inputgroup.ButtonProps{Variant: button.VariantOutline}) {
							Outline
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-15"})
					@inputgroup.Addon() {
						@inputgroup.Button(inputgroup.ButtonProps{Variant: button.VariantSecondary}) {
							Secondary
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-16"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@inputgroup.Button(inputgroup.ButtonProps{Variant: button.VariantSecondary}) {
							Button
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-17"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@inputgroup.Button(inputgroup.ButtonProps{Size: inputgroup.ButtonSizeIconXs}) {
							@icon.Copy()
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-button-18"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@inputgroup.Button(inputgroup.ButtonProps{
							Variant: button.VariantSecondary,
							Size:    inputgroup.ButtonSizeIconXs,
						}) {
							@icon.Trash()
						}
					}
				}
			}
		}
	}
}

templ inputGroupExampleWithTooltip() {
	@inputGroupExampleSection("With Tooltip, Dropdown, Popover") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-tooltip-20"}) {
					Tooltip
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-tooltip-20"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@tooltip.Tooltip() {
							@inputgroup.Button(inputgroup.ButtonProps{
								Class:      "rounded-full",
								Size:       inputgroup.ButtonSizeIconXs,
								Attributes: tooltip.Trigger(ctx),
							}) {
								@icon.Info()
							}
							@tooltip.Content() {
								This is content in a tooltip.
							}
						}
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-dropdown-21"}) {
					Dropdown
				}
				<div data-templ-inputgroup-example-country-field>
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{ID: "input-dropdown-21"})
						@inputgroup.Addon() {
							@dropdownmenu.DropdownMenu() {
								@inputgroup.Button(inputgroup.ButtonProps{
									Class:      "text-muted-foreground tabular-nums",
									Attributes: dropdownmenu.Trigger(ctx),
								}) {
									<span data-templ-inputgroup-example-country>+1</span>
									@icon.ChevronDown()
								}
								@dropdownmenu.Content(dropdownmenu.ContentProps{
									Align:       dropdownmenu.AlignStart,
									Class:       "min-w-16",
									SideOffset:  10,
									AlignOffset: -8,
								}) {
									@dropdownmenu.Item() {
										+1
									}
									@dropdownmenu.Item() {
										+44
									}
									@dropdownmenu.Item() {
										+46
									}
								}
							}
						}
					}
				</div>
				// The vanilla pendant of the demo's country state: clicking a
				// menu item writes its label into the trigger.
				<script nonce={ templ.GetNonce(ctx) }>
					document.addEventListener('click', (e) => {
						const item = e.target.closest?.('[data-slot="dropdown-menu-item"]');
						const root = e.target.closest?.('[data-templ-inputgroup-example-country-field]');
						if (!item || !root) return;
						const label = root.querySelector('[data-templ-inputgroup-example-country]');
						if (label) label.textContent = item.textContent.trim();
					});
				</script>
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-secure-19"}) {
					Popover
				}
				@inputgroup.InputGroup() {
					@popover.Popover() {
						@inputgroup.Addon(inputgroup.AddonProps{Attributes: popover.Trigger(ctx)}) {
							@inputgroup.Button(inputgroup.ButtonProps{
								Variant: button.VariantSecondary,
								Size:    inputgroup.ButtonSizeIconXs,
							}) {
								@icon.Info()
							}
						}
						@popover.Content(popover.ContentProps{Align: popover.AlignStart}) {
							@popover.Header() {
								@popover.Title() {
									Your connection is not secure.
								}
								@popover.Description() {
									You should not enter any sensitive information on this site.
								}
							}
						}
					}
					@inputgroup.Addon(inputgroup.AddonProps{Class: "pl-1 text-muted-foreground"}) {
						https://
					}
					@inputgroup.Input(inputgroup.InputProps{ID: "input-secure-19"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@inputgroup.Button(inputgroup.ButtonProps{Size: inputgroup.ButtonSizeIconXs}) {
							@icon.Star()
						}
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "url"}) {
					Button Group
				}
				@buttongroup.ButtonGroup() {
					@buttongroup.Text() {
						https://
					}
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{ID: "url"})
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@icon.Info()
						}
					}
					@buttongroup.Text() {
						.com
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
		}
	}
}

templ inputGroupExampleWithKbd() {
	@inputGroupExampleSection("With Kbd") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-kbd-22"}) {
					Input Group with Kbd
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-kbd-22"})
					@inputgroup.Addon() {
						@kbd.Kbd() {
							⌘K
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-kbd-23"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@kbd.Kbd() {
							⌘K
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-search-apps-24", Placeholder: "Search for Apps..."})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						Ask AI
					}
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@kbd.Kbd() {
							Tab
						}
					}
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-search-type-25", Placeholder: "Type to search..."})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineStart}) {
						@icon.Sparkles()
					}
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@kbd.Group() {
							@kbd.Kbd() {
								Ctrl
							}
							@kbd.Kbd() {
								C
							}
						}
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "input-username-26"}) {
					Username
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-username-26", Value: "axadrn"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						<div class="flex size-4 items-center justify-center rounded-full bg-green-500 dark:bg-green-800">
							@icon.Check(icon.Props{Class: "size-3 text-white"})
						</div>
					}
				}
				@field.Description(field.DescriptionProps{Class: "text-green-700"}) {
					This username is available.
				}
			}
			@inputgroup.InputGroup() {
				@inputgroup.Input(inputgroup.InputProps{ID: "input-search-docs-27", Placeholder: "Search documentation..."})
				@inputgroup.Addon() {
					@icon.Search()
				}
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					12 results
				}
			}
			@inputgroup.InputGroup(inputgroup.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@inputgroup.Input(inputgroup.InputProps{
					ID:          "input-search-disabled-28",
					Placeholder: "Search documentation...",
					Disabled:    true,
				})
				@inputgroup.Addon() {
					@icon.Search()
				}
				@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
					Disabled
				}
			}
			@field.Group(field.GroupProps{Class: "grid grid-cols-2 gap-4"}) {
				@field.Field() {
					@field.Label(field.LabelProps{For: "input-group-11"}) {
						First Name
					}
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{ID: "input-group-11", Placeholder: "First Name"})
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@icon.Info()
						}
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "input-group-12"}) {
						Last Name
					}
					@inputgroup.InputGroup() {
						@inputgroup.Input(inputgroup.InputProps{ID: "input-group-12", Placeholder: "Last Name"})
						@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
							@icon.Info()
						}
					}
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "input-group-29"}) {
					{ `Loading ("data-disabled="true")` }
				}
				@inputgroup.InputGroup() {
					@inputgroup.Input(inputgroup.InputProps{ID: "input-group-29", Disabled: true, Value: "axadrn"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
						@spinner.Spinner()
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
		}
	}
}

templ inputGroupExampleInCard() {
	@inputGroupExampleSection("In Card") {
		@card.Card(card.Props{Class: "w-full"}) {
			@card.Header() {
				@card.Title() {
					Card with Input Group
				}
				@card.Description() {
					This is a card with an input group.
				}
			}
			@card.Content() {
				@field.Group() {
					@field.Field() {
						@field.Label(field.LabelProps{For: "email-input"}) {
							Email Address
						}
						@inputgroup.InputGroup() {
							@inputgroup.Input(inputgroup.InputProps{
								ID:          "email-input",
								Type:        "email",
								Placeholder: "you@example.com",
							})
							@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
								@icon.Mail()
							}
						}
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "website-input"}) {
							Website URL
						}
						@inputgroup.InputGroup() {
							@inputgroup.Addon() {
								@inputgroup.Text() {
									https://
								}
							}
							@inputgroup.Input(inputgroup.InputProps{ID: "website-input", Placeholder: "example.com"})
							@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
								@icon.ExternalLink()
							}
						}
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "feedback-textarea"}) {
							Feedback & Comments
						}
						@inputgroup.InputGroup() {
							@inputgroup.Textarea(inputgroup.TextareaProps{
								ID:          "feedback-textarea",
								Placeholder: "Share your thoughts...",
								Class:       "min-h-[100px]",
							})
							@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
								@inputgroup.Text() {
									0/500 characters
								}
							}
						}
					}
				}
			}
			@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Cancel
				}
				@button.Button() {
					Submit
				}
			}
		}
	}
}

templ inputGroupExampleTextarea() {
	@inputGroupExampleSection("Textarea") {
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-header-footer-12"}) {
					Default Textarea (No Input Group)
				}
				@textarea.Textarea(textarea.Props{
					ID:          "textarea-header-footer-12",
					Placeholder: "Enter your text here...",
				})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-header-footer-13"}) {
					Input Group
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-header-footer-13",
						Placeholder: "Enter your text here...",
					})
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-invalid": "true"}}) {
				@field.Label(field.LabelProps{For: "textarea-header-footer-14"}) {
					Invalid
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-header-footer-14",
						Placeholder: "Enter your text here...",
						Attributes:  templ.Attributes{"aria-invalid": "true"},
					})
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field(field.Props{Attributes: templ.Attributes{"data-disabled": "true"}}) {
				@field.Label(field.LabelProps{For: "textarea-header-footer-15"}) {
					Disabled
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-header-footer-15",
						Placeholder: "Enter your text here...",
						Disabled:    true,
					})
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "prompt-31"}) {
					Addon (block-start)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{ID: "prompt-31"})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockStart}) {
						@inputgroup.Text() {
							Ask, Search or Chat...
						}
						@icon.Info(icon.Props{Class: "ml-auto text-muted-foreground"})
					}
				}
				@field.Description() {
					This is a description of the input group.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-header-footer-30"}) {
					Addon (block-end)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-header-footer-30",
						Placeholder: "Enter your text here...",
					})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
						@inputgroup.Text() {
							0/280 characters
						}
						@inputgroup.Button(inputgroup.ButtonProps{
							Variant: button.VariantDefault,
							Size:    inputgroup.ButtonSizeIconXs,
							Class:   "ml-auto rounded-full",
						}) {
							@icon.ArrowUp()
							<span class="sr-only">Send</span>
						}
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-comment-31"}) {
					Addon (Buttons)
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-comment-31",
						Placeholder: "Share your thoughts...",
						Class:       "min-h-[120px]",
					})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
						@inputgroup.Button(inputgroup.ButtonProps{
							Variant: button.VariantGhost,
							Class:   "ml-auto",
							Size:    inputgroup.ButtonSizeSm,
						}) {
							Cancel
						}
						@inputgroup.Button(inputgroup.ButtonProps{
							Variant: button.VariantDefault,
							Size:    inputgroup.ButtonSizeSm,
						}) {
							Post Comment
						}
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "textarea-code-32"}) {
					Code Editor
				}
				@inputgroup.InputGroup() {
					@inputgroup.Textarea(inputgroup.TextareaProps{
						ID:          "textarea-code-32",
						Placeholder: `fmt.Println("Hello, world!")`,
						Class:       "min-h-[300px] py-3",
					})
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockStart, Class: "border-b"}) {
						@inputgroup.Text(inputgroup.TextProps{Class: "font-mono font-medium"}) {
							@icon.Code()
							main.go
						}
						@inputgroup.Button(inputgroup.ButtonProps{
							Size:  inputgroup.ButtonSizeIconXs,
							Class: "ml-auto",
						}) {
							@icon.RefreshCw()
						}
						@inputgroup.Button(inputgroup.ButtonProps{
							Size:    inputgroup.ButtonSizeIconXs,
							Variant: button.VariantGhost,
						}) {
							@icon.Copy()
						}
					}
					@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd, Class: "border-t"}) {
						@inputgroup.Text() {
							Line 1, Column 1
						}
						@inputgroup.Text(inputgroup.TextProps{Class: "ml-auto"}) {
							Go
						}
					}
				}
			}
		}
	}
}
