package examples

import (
	"time"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/calendar"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// The multiple-date section is omitted because the calendar has no multiple mode.
templ calendarExampleSection(title string, containerClass string, class string) {
	<div data-slot="example" class={ utils.CN("mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none", containerClass) }>
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class={ utils.CN("flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full", class) }>
			{ children... }
		</div>
	</div>
}

templ CalendarExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@calendarExampleSingle()
			@calendarExampleWeekNumbers()
			@calendarExampleBookedDates()
			@calendarExampleRange()
			@calendarExampleRangeMultipleMonths()
			@calendarExampleWithTime()
			@calendarExampleWithPresets()
			@calendarExampleCustomDays()
			@calendarExampleDatePickerSimple()
			@calendarExampleDatePickerWithDropdowns()
			@calendarExampleDatePickerWithRange()
			@calendarExampleInCard()
			@calendarExampleInPopover()
		</div>
	</div>
}

templ calendarExampleSingle() {
	{{ selected := time.Date(time.Now().Year(), time.Now().Month(), 12, 0, 0, 0, 0, time.Local) }}
	@calendarExampleSection("Single", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Selected:         selected,
					CaptionLayout: calendar.CaptionLayoutDropdown,
				})
			}
		}
	}
}

templ calendarExampleWeekNumbers() {
	{{ selected := time.Date(time.Now().Year(), 2, 3, 0, 0, 0, 0, time.Local) }}
	@calendarExampleSection("Week Numbers", "", "justify-center") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Selected:           selected,
					ShowWeekNumber: true,
				})
			}
		}
	}
}

templ calendarExampleBookedDates() {
	{{
		selected := time.Date(time.Now().Year(), 2, 3, 0, 0, 0, 0, time.Local)
		booked := make([]time.Time, 15)
		for i := range booked {
			booked[i] = time.Date(time.Now().Year(), 2, 12+i, 0, 0, 0, 0, time.Local)
		}
	}}
	@calendarExampleSection("Booked Dates", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Selected:       selected,
					BookedDates: booked,
				})
			}
		}
	}
}

templ calendarExampleRange() {
	{{
		from := time.Date(time.Now().Year(), 1, 12, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 30)
	}}
	@calendarExampleSection("Range", "lg:col-span-full 2xl:col-span-full", "p-12") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:           calendar.ModeRange,
					Selected:          from,
					EndValue:       to,
					NumberOfMonths: 2,
					MinDate:        time.Date(1900, 1, 1, 0, 0, 0, 0, time.Local),
					MaxDate:        time.Now(),
				})
			}
		}
	}
}

templ calendarExampleRangeMultipleMonths() {
	{{
		from := time.Date(time.Now().Year(), 4, 12, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 60)
	}}
	@calendarExampleSection("Range Multiple Months", "lg:col-span-full 2xl:col-span-full", "p-12") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					Mode:           calendar.ModeRange,
					Selected:          from,
					EndValue:       to,
					NumberOfMonths: 3,
					Locale:      "es",
					FixedWeeks:     true,
				})
			}
		}
	}
}

templ calendarExampleWithTime() {
	{{ selected := time.Date(time.Now().Year(), time.Now().Month(), 12, 0, 0, 0, 0, time.Local) }}
	@calendarExampleSection("With Time", "", "") {
		@card.Card(card.Props{Size: card.SizeSm, Class: "mx-auto w-fit"}) {
			@card.Content() {
				@calendar.Calendar(calendar.Props{
					Selected: selected,
					Class: "p-0",
				})
			}
			@card.Footer(card.FooterProps{Class: "border-t bg-card"}) {
				@field.Group() {
					@field.Field() {
						@field.Label(field.LabelProps{For: "calendar-example-time-from"}) {
							Start Time
						}
						@inputgroup.InputGroup() {
							@inputgroup.Input(inputgroup.InputProps{
								ID:    "calendar-example-time-from",
								Type:  "time",
								Value: "10:30:00",
								Class: "appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none",
								Attributes: templ.Attributes{
									"step": "1",
								},
							})
							@inputgroup.Addon() {
								@icon.Clock2(icon.Props{Class: "text-muted-foreground"})
							}
						}
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "calendar-example-time-to"}) {
							End Time
						}
						@inputgroup.InputGroup() {
							@inputgroup.Input(inputgroup.InputProps{
								ID:    "calendar-example-time-to",
								Type:  "time",
								Value: "12:30:00",
								Class: "appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none",
								Attributes: templ.Attributes{
									"step": "1",
								},
							})
							@inputgroup.Addon() {
								@icon.Clock2(icon.Props{Class: "text-muted-foreground"})
							}
						}
					}
				}
			}
		}
	}
}

templ calendarExampleWithPresets() {
	{{ selected := time.Date(time.Now().Year(), 2, 12, 0, 0, 0, 0, time.Local) }}
	{{
		presets := []struct {
			Label string
			Days  string
		}{
			{"Today", "0"},
			{"Tomorrow", "1"},
			{"In 3 days", "3"},
			{"In a week", "7"},
			{"In 2 weeks", "14"},
		}
	}}
	@calendarExampleSection("With Presets", "", "") {
		@card.Card(card.Props{
			Size:  card.SizeSm,
			Class: "mx-auto w-fit max-w-[300px]",
		}) {
			@card.Content() {
				@calendar.Calendar(calendar.Props{
					ID:         "calendar-example-presets",
					Selected:      selected,
					FixedWeeks: true,
					Class:      "p-0 [--cell-size:--spacing(9.5)]",
				})
			}
			@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2 border-t"}) {
				for _, preset := range presets {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "flex-1",
						Attributes: templ.Attributes{
							"data-example-preset-days": preset.Days,
						},
					}) {
						{ preset.Label }
					}
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const calendar = () => document.getElementById("calendar-example-presets");
			document.querySelectorAll("[data-example-preset-days]").forEach((btn) => {
				btn.addEventListener("click", () => {
					const date = new Date();
					date.setDate(date.getDate() + parseInt(btn.dataset.examplePresetDays, 10));
					const iso = date.toLocaleDateString("sv-SE");
					calendar().dispatchEvent(
						new CustomEvent("calendar-set", { bubbles: true, detail: { date: iso } }),
					);
				});
			});
		})();
	</script>
}

templ calendarExampleCustomDays() {
	{{
		from := time.Date(time.Now().Year(), 12, 8, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 10)
	}}
	@calendarExampleSection("Custom Days", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar(calendar.Props{
					ID:            "calendar-example-custom-days",
					Mode:          calendar.ModeRange,
					Selected:         from,
					EndValue:      to,
					CaptionLayout: calendar.CaptionLayoutDropdown,
					Class:         "[--cell-size:--spacing(10)] md:[--cell-size:--spacing(12)]",
				})
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const root = () => document.getElementById("calendar-example-custom-days");
			function decorate() {
				root().querySelectorAll("td[data-day] > button").forEach((btn) => {
					if (btn.querySelector("span") || btn.getAttribute("data-outside") === "true") return;
					const date = new Date(btn.parentElement.getAttribute("data-day"));
					const weekend = date.getDay() === 0 || date.getDay() === 6;
					const price = document.createElement("span");
					price.textContent = weekend ? "$120" : "$100";
					btn.appendChild(price);
				});
			}
			root().addEventListener("calendar-rendered", decorate);
			decorate();
		})();
	</script>
}

templ calendarExampleDatePickerSimple() {
	@calendarExampleSection("Date Picker Simple", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@field.Label(field.LabelProps{For: "calendar-example-date-picker-simple-trigger"}) {
				Date
			}
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-simple"}) {
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "calendar-example-date-picker-simple-trigger"
				}}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "justify-start px-2.5 font-normal",
					Attributes: triggerAttrs,
				}) {
					<span data-icon="inline-start" class="contents">
						@icon.Calendar()
					</span>
					<span>Pick a date</span>
				}
				@popover.Content(popover.ContentProps{
					Class: "w-auto p-0",
					Side:  popover.SideBottom, Align: popover.AlignStart,
				}) {
					@calendar.Calendar()
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const fmt = (d) => {
				const day = d.getDate();
				const suf = day % 10 === 1 && day !== 11 ? "st" : day % 10 === 2 && day !== 12 ? "nd" : day % 10 === 3 && day !== 13 ? "rd" : "th";
				return d.toLocaleDateString("en-US", { month: "long" }) + " " + day + suf + ", " + d.getFullYear();
			};
			// Delegated: the popover content is portaled to <body> at init, so it
			// is looked up per event instead of captured at parse time.
			document.addEventListener("calendar-change", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("#calendar-example-date-picker-simple")) return;
				const trigger = document.querySelector('[aria-controls="calendar-example-date-picker-simple"]');
				trigger.querySelector("span:not([data-icon])").textContent = e.detail.value ? fmt(e.detail.value) : "Pick a date";
			});
		})();
	</script>
}

templ calendarExampleDatePickerWithDropdowns() {
	@calendarExampleSection("Date Picker with Dropdowns", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@field.Label(field.LabelProps{For: "calendar-example-date-picker-dropdowns-trigger"}) {
				Date
			}
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-dropdowns"}) {
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "calendar-example-date-picker-dropdowns-trigger"
				}}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "justify-start px-2.5 font-normal",
					Attributes: triggerAttrs,
				}) {
					<span>Pick a date</span>
					<span data-icon="inline-start" class="contents">
						@icon.ChevronDown(icon.Props{Class: "ml-auto"})
					</span>
				}
				@popover.Content(popover.ContentProps{
					Class: "w-auto p-0",
					Side:  popover.SideBottom, Align: popover.AlignStart,
				}) {
					@calendar.Calendar(calendar.Props{
						CaptionLayout: calendar.CaptionLayoutDropdown,
					})
					<div class="flex gap-2 border-t p-2">
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeSm,
							Class:      "w-full",
							Attributes: templ.Attributes{"data-example-date-picker-done": true},
						}) {
							Done
						}
					</div>
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const fmt = (d) => {
				const day = d.getDate();
				const suf = day % 10 === 1 && day !== 11 ? "st" : day % 10 === 2 && day !== 12 ? "nd" : day % 10 === 3 && day !== 13 ? "rd" : "th";
				return d.toLocaleDateString("en-US", { month: "long" }) + " " + day + suf + ", " + d.getFullYear();
			};
			// Delegated: the popover content is portaled to <body> at init, so it
			// is looked up per event instead of captured at parse time.
			document.addEventListener("calendar-change", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("#calendar-example-date-picker-dropdowns")) return;
				const trigger = document.querySelector('[aria-controls="calendar-example-date-picker-dropdowns"]');
				trigger.querySelector("span:not([data-icon])").textContent = e.detail.value ? fmt(e.detail.value) : "Pick a date";
			});
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("[data-example-date-picker-done]")) return;
				window.templ.popover.close("calendar-example-date-picker-dropdowns");
			});
		})();
	</script>
}

templ calendarExampleDatePickerWithRange() {
	{{
		from := time.Date(time.Now().Year(), 1, 20, 0, 0, 0, 0, time.Local)
		to := from.AddDate(0, 0, 20)
	}}
	@calendarExampleSection("Date Picker Range", "", "") {
		@field.Field(field.Props{Class: "mx-auto w-72"}) {
			@field.Label(field.LabelProps{For: "calendar-example-date-picker-range-trigger"}) {
				Date Picker Range
			}
			@popover.Popover(popover.Props{ID: "calendar-example-date-picker-range"}) {
				{{
					triggerAttrs := popover.Trigger(ctx)
					triggerAttrs["id"] = "calendar-example-date-picker-range-trigger"
				}}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "justify-start px-2.5 font-normal",
					Attributes: triggerAttrs,
				}) {
					<span data-icon="inline-start" class="contents">
						@icon.Calendar()
					</span>
					<span>
						{ from.Format("Jan 02, 2006") } - { to.Format("Jan 02, 2006") }
					</span>
				}
				@popover.Content(popover.ContentProps{
					Class: "w-auto p-0",
					Side:  popover.SideBottom, Align: popover.AlignStart,
				}) {
					@calendar.Calendar(calendar.Props{
						Mode:           calendar.ModeRange,
						Selected:          from,
						EndValue:       to,
						NumberOfMonths: 2,
					})
				}
			}
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const fmt = (d) => d.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
			// Delegated: the popover content is portaled to <body> at init, so it
			// is looked up per event instead of captured at parse time.
			document.addEventListener("calendar-change", (e) => {
				if (!(e.target instanceof Element) || !e.target.closest("#calendar-example-date-picker-range")) return;
				const trigger = document.querySelector('[aria-controls="calendar-example-date-picker-range"]');
				const display = trigger.querySelector("span:not([data-icon])");
				if (e.detail.value && e.detail.endValue) {
					display.textContent = fmt(e.detail.value) + " - " + fmt(e.detail.endValue);
				} else if (e.detail.value) {
					display.textContent = fmt(e.detail.value);
				} else {
					display.textContent = "Pick a date";
				}
			});
		})();
	</script>
}

templ calendarExampleInCard() {
	@calendarExampleSection("In Card", "", "") {
		@card.Card(card.Props{Class: "mx-auto w-fit p-0"}) {
			@card.Content(card.ContentProps{Class: "p-0"}) {
				@calendar.Calendar()
			}
		}
	}
}

templ calendarExampleInPopover() {
	@calendarExampleSection("In Popover", "", "") {
		@popover.Popover(popover.Props{ID: "calendar-example-in-popover"}) {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "px-2.5 font-normal",
				Attributes: popover.Trigger(ctx),
			}) {
				<span data-icon="inline-start" class="contents">
					@icon.Calendar()
				</span>
				Open Calendar
			}
			@popover.Content(popover.ContentProps{
				Class: "w-auto p-0",
				Side:  popover.SideBottom, Align: popover.AlignStart,
			}) {
				@calendar.Calendar()
			}
		}
	}
}
