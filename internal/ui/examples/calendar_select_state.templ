package examples

// calendarSelectState is an example's onSelect={setDate}: the selection
// state of the owner, which renders the calendar again. It follows the
// calendar or the element holding it.
templ calendarSelectState() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const prev = document.currentScript.previousElementSibling;
			const calendar = prev.matches('[data-slot="calendar"]') ? prev : prev.querySelector('[data-slot="calendar"]');
			calendar.addEventListener("calendar-select", (e) => window.templ.calendar.setSelected(calendar, e.detail.selected));
		})();
	</script>
}
