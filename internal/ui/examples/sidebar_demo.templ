package examples

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/collapsible"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

// This is sample data.
type sidebarDemoTeam struct {
	Name string
	Logo func(...icon.Props) templ.Component
	Plan string
}

type sidebarDemoNavItem struct {
	Title    string
	URL      string
	Icon     func(...icon.Props) templ.Component
	IsActive bool
	Items    []sidebarDemoNavSubItem
}

type sidebarDemoNavSubItem struct {
	Title string
	URL   string
}

type sidebarDemoProject struct {
	Name string
	URL  string
	Icon func(...icon.Props) templ.Component
}

var sidebarDemoUser = struct {
	Name   string
	Email  string
	Avatar string
}{
	Name:   "Axel Adrian",
	Email:  "m@example.com",
	Avatar: "https://github.com/axadrn.png",
}

var sidebarDemoTeams = []sidebarDemoTeam{
	{Name: "Acme Inc", Logo: icon.GalleryVerticalEnd, Plan: "Enterprise"},
	{Name: "Acme Corp.", Logo: icon.AudioWaveform, Plan: "Startup"},
	{Name: "Evil Corp.", Logo: icon.Command, Plan: "Free"},
}

