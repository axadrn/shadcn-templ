templ sidebarDemoTeamSwitcher() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "sidebar-demo-team-menu"}) {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					<div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
						// Render every logo up front; the demo script shows the active one.
						for i, team := range sidebarDemoTeams {
							@team.Logo(icon.Props{
								Class:      "size-4" + logoHidden(i),
								Attributes: templ.Attributes{"data-team-logo": strconv.Itoa(i)},
							})
						}
					</div>
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-medium" data-team-name>{ sidebarDemoTeams[0].Name }</span>
						<span class="truncate text-xs" data-team-plan>{ sidebarDemoTeams[0].Plan }</span>
					</div>
					@icon.ChevronsUpDown(icon.Props{Class: "ml-auto"})
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{
					Class:      "min-w-56 rounded-lg",
					Align:      dropdownmenu.AlignStart,
					Side:       dropdownmenu.SideRight,
					SideOffset: 4,
				}) {
					@dropdownmenu.Group() {
						@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "text-xs text-muted-foreground"}) {
							Teams
						}
						for i, team := range sidebarDemoTeams {
							@dropdownmenu.Item(dropdownmenu.ItemProps{
								Class:      "gap-2 p-2",
								Attributes: templ.Attributes{"data-team-index": strconv.Itoa(i)},
							}) {
								<div class="flex size-6 items-center justify-center rounded-md border">
									@team.Logo(icon.Props{Class: "size-3.5 shrink-0"})
								</div>
								{ team.Name }
								@dropdownmenu.Shortcut() {
									⌘{ strconv.Itoa(i + 1) }
								}
							}
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item(dropdownmenu.ItemProps{Class: "gap-2 p-2"}) {
							<div class="flex size-6 items-center justify-center rounded-md border bg-transparent">
								@icon.Plus(icon.Props{Class: "size-4"})
							</div>
							<div class="font-medium text-muted-foreground">Add team</div>
						}
					}
				}
			}
		}
	}
	<script type="module" nonce={ templ.GetNonce(ctx) }>
		// The pendant of useSidebar().isMobile in the block: the menu reads
		// its side when it opens, onMobileChange keeps it current until the
		// block is swapped out.
		// side={isMobile ? "bottom" : "right"}
		const menu = document.getElementById("sidebar-demo-team-menu");
		window.templ.sidebar.onMobileChange((isMobile) => {
			if (!menu?.isConnected) return false;
			menu.setAttribute("data-templ-side", isMobile ? "bottom" : "right");
		});
	</script>
}

func logoHidden(i int) string {
	if i == 0 {
		return ""
	}
	return " hidden"
}

templ sidebarDemoNavMainGroup() {
	@sidebar.Group() {
		@sidebar.GroupLabel() {
			Platform
		}
		@sidebar.Menu() {
			for _, item := range sidebarDemoNavMain {
				@collapsible.Collapsible(collapsible.Props{
					DefaultOpen: item.IsActive,
					Class:       "group/collapsible",
				}) {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Tooltip:    item.Title,
							Attributes: collapsible.Trigger(ctx),
						}) {
							@item.Icon()
							<span>{ item.Title }</span>
							@icon.ChevronRight(icon.Props{Class: "ml-auto transition-transform duration-200 group-data-open/collapsible:rotate-90"})
						}
						@collapsible.Content() {
							@sidebar.MenuSub() {
								for _, subItem := range item.Items {
									@sidebar.MenuSubItem() {
										@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{Href: subItem.URL}) {
											<span>{ subItem.Title }</span>
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ sidebarDemoNavProjects() {
	@sidebar.Group(sidebar.GroupProps{Class: "group-data-[collapsible=icon]:hidden"}) {
		@sidebar.GroupLabel() {
			Projects
		}
		@sidebar.Menu() {
			for i, item := range sidebarDemoProjects {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{Href: item.URL}) {
						@item.Icon()
						<span>{ item.Name }</span>
					}
					@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "sidebar-demo-sidebar-demo-menu-" + strconv.Itoa(i)}) {
						@sidebar.MenuAction(sidebar.MenuActionProps{
							ShowOnHover: true,
							Attributes:  dropdownmenu.Trigger(ctx),
						}) {
							@icon.Ellipsis()
							<span class="sr-only">More</span>
						}
						@dropdownmenu.Content(dropdownmenu.ContentProps{
							Class: "w-48 rounded-lg",
							Side:  dropdownmenu.SideRight,
							Align: dropdownmenu.AlignStart,
						}) {
							@dropdownmenu.Item() {
								@icon.Folder(icon.Props{Class: "text-muted-foreground"})
								<span>View Project</span>
							}
							@dropdownmenu.Item() {
								@icon.Forward(icon.Props{Class: "text-muted-foreground"})
								<span>Share Project</span>
							}
							@dropdownmenu.Separator()
							@dropdownmenu.Item() {
								@icon.Trash2(icon.Props{Class: "text-muted-foreground"})
								<span>Delete Project</span>
							}
						}
					}
				}
			}
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{Class: "text-sidebar-foreground/70"}) {
					@icon.Ellipsis(icon.Props{Class: "text-sidebar-foreground/70"})
					<span>More</span>
				}
			}
		}
	}
	<script type="module" nonce={ templ.GetNonce(ctx) }>
		// The pendant of useSidebar().isMobile in the block: the menu reads
		// its side when it opens, onMobileChange keeps it current until the
		// block is swapped out.
		// side={isMobile ? "bottom" : "right"} align={isMobile ? "end" : "start"}
		const menus = [...document.querySelectorAll('[id^="sidebar-demo-sidebar-demo-menu-"][data-templ-side]')];
		window.templ.sidebar.onMobileChange((isMobile) => {
			if (!menus[0]?.isConnected) return false;
			menus.forEach((menu) => {
				menu.setAttribute("data-templ-side", isMobile ? "bottom" : "right");
				menu.setAttribute("data-templ-align", isMobile ? "end" : "start");
			});
		});
	</script>
}

templ sidebarDemoNavUser() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "sidebar-demo-sidebar-demo-menu"}) {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					@avatar.Avatar(avatar.Props{Class: "h-8 w-8 rounded-lg"}) {
						@avatar.Image(avatar.ImageProps{Src: sidebarDemoUser.Avatar, Alt: sidebarDemoUser.Name})
						@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
							AA
						}
					}
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-medium">{ sidebarDemoUser.Name }</span>
						<span class="truncate text-xs">{ sidebarDemoUser.Email }</span>
					</div>
					@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{
					Class:      "min-w-56 rounded-lg",
					Side:       dropdownmenu.SideRight,
					Align:      dropdownmenu.AlignEnd,
					SideOffset: 4,
				}) {
					@dropdownmenu.Group() {
						@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "p-0 font-normal"}) {
							<div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
								@avatar.Avatar(avatar.Props{Class: "h-8 w-8 rounded-lg"}) {
									@avatar.Image(avatar.ImageProps{Src: sidebarDemoUser.Avatar, Alt: sidebarDemoUser.Name})
									@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
										AA
									}
								}
								<div class="grid flex-1 text-left text-sm leading-tight">
									<span class="truncate font-medium">{ sidebarDemoUser.Name }</span>
									<span class="truncate text-xs">{ sidebarDemoUser.Email }</span>
								</div>
							</div>
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							@icon.Sparkles()
							Upgrade to Pro
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							@icon.BadgeCheck()
							Account
						}
						@dropdownmenu.Item() {
							@icon.CreditCard()
							Billing
						}
						@dropdownmenu.Item() {
							@icon.Bell()
							Notifications
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							@icon.LogOut()
							Log out
						}
					}
				}
			}
		}
	}
	<script type="module" nonce={ templ.GetNonce(ctx) }>
		// The pendant of useSidebar().isMobile in the block: the menu reads
		// its side when it opens, onMobileChange keeps it current until the
		// block is swapped out.
		// side={isMobile ? "bottom" : "right"}
		const menu = document.getElementById("sidebar-demo-sidebar-demo-menu");
		window.templ.sidebar.onMobileChange((isMobile) => {
			if (!menu?.isConnected) return false;
			menu.setAttribute("data-templ-side", isMobile ? "bottom" : "right");
		});
	</script>
}

templ SidebarDemo() {
	@sidebar.Provider() {
		@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
			@sidebar.Header() {
				@sidebarDemoTeamSwitcher()
			}
			@sidebar.Content() {
				@sidebarDemoNavMainGroup()
				@sidebarDemoNavProjects()
			}
			@sidebar.Footer() {
				@sidebarDemoNavUser()
			}
			@sidebar.Rail()
		}
		@sidebar.Inset() {
			<header class="flex h-16 shrink-0 items-center gap-2 transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-12">
				<div class="flex items-center gap-2 px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
				</div>
			</header>
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// Keep the selected team details in sync.
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				const item = e.target.closest("#sidebar-demo-team-menu [data-team-index]");
				if (!item) return;
				const i = item.getAttribute("data-team-index");
				const name = item.textContent.trim().replace(/⌘\d$/, "").trim();
				const plan = ["Enterprise", "Startup", "Free"][parseInt(i, 10)];
				document.querySelectorAll("[data-team-logo]").forEach((logo) => {
					logo.classList.toggle("hidden", logo.getAttribute("data-team-logo") !== i);
				});
				const nameEl = document.querySelector("[data-team-name]");
				const planEl = document.querySelector("[data-team-plan]");
				if (nameEl) nameEl.textContent = name;
				if (planEl) planEl.textContent = plan;
			});
		})();
	</script>
}
