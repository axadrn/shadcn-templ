	{
		Title: "Playground", URL: "#", Icon: icon.SquareTerminal, IsActive: true,
		Items: []sidebarDemoNavSubItem{
			{Title: "History", URL: "#"},
			{Title: "Starred", URL: "#"},
			{Title: "Settings", URL: "#"},
		},
	},
	{
		Title: "Models", URL: "#", Icon: icon.Bot,
		Items: []sidebarDemoNavSubItem{
			{Title: "Genesis", URL: "#"},
			{Title: "Explorer", URL: "#"},
			{Title: "Quantum", URL: "#"},
		},
	},
	{
		Title: "Documentation", URL: "#", Icon: icon.BookOpen,
		Items: []sidebarDemoNavSubItem{
			{Title: "Introduction", URL: "#"},
			{Title: "Get Started", URL: "#"},
			{Title: "Tutorials", URL: "#"},
			{Title: "Changelog", URL: "#"},
		},
	},
	{
		Title: "Settings", URL: "#", Icon: icon.Settings2,
		Items: []sidebarDemoNavSubItem{
			{Title: "General", URL: "#"},
			{Title: "Team", URL: "#"},
			{Title: "Billing", URL: "#"},
