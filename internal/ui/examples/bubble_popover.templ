package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/bubble"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/popover"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

templ BubblePopoverDemo() {
	<div class="flex w-full max-w-sm flex-col gap-4 py-12">
		@bubble.Bubble(bubble.Props{Align: bubble.AlignEnd}) {
			@bubble.Content() {
				Run the build script.
			}
		}
		@bubble.Bubble(bubble.Props{Variant: bubble.VariantDestructive}) {
			@bubble.Content() {
				Failed to run the command.
			}
			@bubble.Reactions() {
				@popover.Popover() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIconXs,
						Class:      "aria-expanded:text-destructive",
						Attributes: utils.MergeAttributes(serverRendered(popover.Trigger(ctx)), templ.Attributes{"aria-label": "Show error details"}),
					}) {
						@icon.Info()
					}
					@popover.Content() {
						@popover.Header() {
							@popover.Title(popover.TitleProps{Class: "text-sm"}) {
								Command failed with exit code 1
							}
							@popover.Description(popover.DescriptionProps{Class: "text-sm"}) {
								ENOENT: no such file or directory, open pnpm-lock.yaml
							}
						}
					}
				}
			}
		}
	</div>
}
