package examples

import "github.com/axadrn/shadcn-templ/v2/components/inputgroup"

templ InputGroupCustom() {
	<div class="grid w-full max-w-sm gap-6">
		@inputgroup.InputGroup() {
			<textarea
				id="input-group-custom-textarea"
				data-slot="input-group-control"
				class="flex field-sizing-content min-h-16 w-full resize-none rounded-md bg-transparent px-3 py-2.5 text-base transition-[color,box-shadow] outline-none md:text-sm"
				placeholder="Autoresize textarea..."
			></textarea>
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignBlockEnd}) {
				@inputgroup.Button(inputgroup.ButtonProps{Class: "ml-auto", Size: inputgroup.ButtonSizeSm, Variant: "default"}) {
					Submit
				}
			}
		}
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		// Port of react-textarea-autosize 8.5.9, the example's TextareaAutosize:
		// a hidden textarea in <body> measures the content (the value, else the
		// placeholder) with the node's sizing styles, the node gets that height.
		(() => {
			const node = document.getElementById("input-group-custom-textarea");
			if (!node) return;
			const HIDDEN = { "min-height": "0", "max-height": "none", height: "0", visibility: "hidden", overflow: "hidden", position: "absolute", "z-index": "-1000", top: "0", right: "0", display: "block" };
			const SIZING = ["borderBottomWidth", "borderLeftWidth", "borderRightWidth", "borderTopWidth", "boxSizing", "fontFamily", "fontSize", "fontStyle", "fontWeight", "letterSpacing", "lineHeight", "paddingBottom", "paddingLeft", "paddingRight", "paddingTop", "tabSize", "textIndent", "textRendering", "textTransform", "width", "wordBreak", "wordSpacing", "scrollbarGutter"];
			let hidden = null;
			let lastHeight = 0;
			const forceHidden = (el) => Object.keys(HIDDEN).forEach((k) => el.style.setProperty(k, HIDDEN[k], "important"));
			const resize = () => {
				const style = getComputedStyle(node);
				if (style.boxSizing === "") return;
				const sizing = {};
				SIZING.forEach((k) => (sizing[k] = style[k]));
				const padding = parseFloat(style.paddingBottom) + parseFloat(style.paddingTop);
				const border = parseFloat(style.borderBottomWidth) + parseFloat(style.borderTopWidth);
				if (!hidden) {
					hidden = document.createElement("textarea");
					hidden.setAttribute("tabindex", "-1");
					hidden.setAttribute("aria-hidden", "true");
					forceHidden(hidden);
				}
				if (hidden.parentNode === null) document.body.appendChild(hidden);
				Object.keys(sizing).forEach((k) => (hidden.style[k] = sizing[k]));
				forceHidden(hidden);
				const measure = () => hidden.scrollHeight + (sizing.boxSizing === "border-box" ? border : -padding);
				hidden.value = node.value || node.placeholder || "x";
				let height = measure();
				hidden.value = "x";
				const rowHeight = hidden.scrollHeight - padding;
				let minHeight = rowHeight;
				if (sizing.boxSizing === "border-box") minHeight += padding + border;
				height = Math.max(minHeight, height);
				if (height !== lastHeight) {
					lastHeight = height;
					node.style.setProperty("height", height + "px", "important");
				}
			};
			resize();
			node.addEventListener("input", resize);
			window.addEventListener("resize", resize);
			document.fonts?.addEventListener("loadingdone", resize);
		})();
	</script>
}
