package kbd

import "github.com/axadrn/shadcn-templ/v2/components/kbd"

templ KbdDemo() {
	<div class="flex flex-col items-center gap-4">
		@kbd.Group() {
			@kbd.Kbd() {
				⌘
			}
			@kbd.Kbd() {
				⇧
			}
			@kbd.Kbd() {
				⌥
			}
			@kbd.Kbd() {
				⌃
			}
		}
		@kbd.Group() {
			@kbd.Kbd() {
				Ctrl
			}
			<span>+</span>
			@kbd.Kbd() {
				B
			}
		}
	</div>
}
