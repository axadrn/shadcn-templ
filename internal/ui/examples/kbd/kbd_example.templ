package kbd

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/inputgroup"
	"github.com/axadrn/shadcn-templ/v2/components/kbd"
	"github.com/axadrn/shadcn-templ/v2/components/tooltip"
)

templ kbdExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ KbdExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@kbdExampleBasic()
			@kbdExampleModifierKeys()
			@kbdExampleGroup()
			@kbdExampleArrowKeys()
			@kbdExampleWithIcons()
			@kbdExampleWithIconsAndText()
			@kbdExampleInInputGroup()
			@kbdExampleInTooltip()
			@kbdExampleWithSamp()
		</div>
	</div>
}

templ kbdExampleBasic() {
	@kbdExampleSection("Basic") {
		<div class="flex items-center gap-2">
			@kbd.Kbd() {
				Ctrl
			}
			@kbd.Kbd() {
				⌘K
			}
			@kbd.Kbd() {
				Ctrl + B
			}
		</div>
	}
}

templ kbdExampleModifierKeys() {
	@kbdExampleSection("Modifier Keys") {
		<div class="flex items-center gap-2">
			@kbd.Kbd() {
				⌘
			}
			@kbd.Kbd() {
				C
			}
		</div>
	}
}

templ kbdExampleGroup() {
	@kbdExampleSection("KbdGroup") {
		@kbd.Group() {
			@kbd.Kbd() {
				Ctrl
			}
			@kbd.Kbd() {
				Shift
			}
			@kbd.Kbd() {
				P
			}
		}
	}
}

templ kbdExampleArrowKeys() {
	@kbdExampleSection("Arrow Keys") {
		<div class="flex items-center gap-2">
			@kbd.Kbd() {
				↑
			}
			@kbd.Kbd() {
				↓
			}
			@kbd.Kbd() {
				←
			}
			@kbd.Kbd() {
				→
			}
		</div>
	}
}

templ kbdExampleWithIcons() {
	@kbdExampleSection("With Icons") {
		@kbd.Group() {
			@kbd.Kbd() {
				@icon.CircleDashed()
			}
			@kbd.Kbd() {
				@icon.ArrowLeft()
			}
			@kbd.Kbd() {
				@icon.ArrowRight()
			}
		}
	}
}

templ kbdExampleWithIconsAndText() {
	@kbdExampleSection("With Icons and Text") {
		@kbd.Group() {
			@kbd.Kbd() {
				@icon.ArrowLeft()
				Left
			}
			@kbd.Kbd() {
				@icon.CircleDashed()
				Voice Enabled
			}
		}
	}
}

templ kbdExampleInInputGroup() {
	@kbdExampleSection("InputGroup") {
		@inputgroup.InputGroup() {
			@inputgroup.Input()
			@inputgroup.Addon() {
				@kbd.Kbd() {
					Space
				}
			}
		}
	}
}

templ kbdExampleInTooltip() {
	@kbdExampleSection("Tooltip") {
		@tooltip.Tooltip() {
			@button.Button(button.Props{
				Size:       button.SizeIconSm,
				Variant:    button.VariantOutline,
				Attributes: tooltip.Trigger(ctx),
			}) {
				@icon.Save()
			}
			@tooltip.Content(tooltip.ContentProps{Class: "pr-1.5"}) {
				<div class="flex items-center gap-2">
					Save Changes
					@kbd.Kbd() {
						S
					}
				</div>
			}
		}
	}
}

templ kbdExampleWithSamp() {
	@kbdExampleSection("With samp") {
		@kbd.Kbd() {
			<samp>File</samp>
		}
	}
}
