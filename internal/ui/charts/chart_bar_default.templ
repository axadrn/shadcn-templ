package charts

import (
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/chart"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
)

// The pendant of chart-bar-default.tsx.

var chartBarDefaultData = []chart.Datum{
	{"month": "January", "desktop": 186},
	{"month": "February", "desktop": 305},
	{"month": "March", "desktop": 237},
	{"month": "April", "desktop": 73},
	{"month": "May", "desktop": 209},
	{"month": "June", "desktop": 214},
}

var chartBarDefaultConfig = chart.Config{
	{Key: "desktop", Label: "Desktop", Color: "var(--chart-1)"},
}

func barDefaultMonthShort(v any) string {
	return v.(string)[:3]
}

templ ChartBarDefault() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Bar Chart
			}
			@card.Description() {
				January - June 2024
			}
		}
		@card.Content() {
			@chart.Container(chart.ContainerProps{ID: "bar-default", Config: chartBarDefaultConfig}) {
				@chart.BarChart(chart.BarChartProps{
					AccessibilityLayer: true,
					Data:               chartBarDefaultData,
				}) {
					@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
					@chart.XAxis(chart.XAxisProps{
						DataKey:       "month",
						TickMargin:    10,
						TickFormatter: barDefaultMonthShort,
					})
					@chart.Tooltip(chart.TooltipProps{
						Cursor:  chart.Bool(false),
						Content: chart.TooltipContentProps{HideLabel: true},
					})
					@chart.Bar(chart.BarProps{DataKey: "desktop", Fill: "var(--color-desktop)", Radius: 8})
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col items-start gap-2 text-sm"}) {
			<div class="flex gap-2 leading-none font-medium">
				Trending up by 5.2% this month
				@icon.TrendingUp(icon.Props{Class: "h-4 w-4"})
			</div>
			<div class="leading-none text-muted-foreground">
				Showing total visitors for the last 6 months
			</div>
		}
	}
}
